	mixHoldActive = false
	local sx, sy = makeSafeHoldScreenPoint()

	if mixHoldFakeInput then
		local endedConns = findResearchLabInputConns(UserInputService.InputEnded)
		invokeSignalConns(endedConns, mixHoldFakeInput, false)
		mixHoldFakeInput = nil
	end

	if mixHoldViaVim then
		mixHoldViaVim = false
		local okGui, inset = pcall(function()
			return GuiService:GetGuiInset()
		end)
		local insetY = if okGui and inset then inset.Y else 0
		pcall(function()
			local vim = game:GetService("VirtualInputManager")
			vim:SendMouseButtonEvent(sx, sy + insetY, 0, false, game, 0)
		end)
	end
end

local function sendLabClick(screenX: number, screenY: number, vpX: number?, vpY: number?)
	local beganConns = findResearchLabInputConns(UserInputService.InputBegan)
	local endedConns = findResearchLabInputConns(UserInputService.InputEnded)
	if #beganConns > 0 then
		local fakeInput = {
			UserInputType = Enum.UserInputType.MouseButton1,
			UserInputState = Enum.UserInputState.Begin,
			Position = Vector3.new(screenX, screenY, 0),
			KeyCode = Enum.KeyCode.Unknown,
		}
		if invokeSignalConns(beganConns, fakeInput, true) then
			if #endedConns > 0 then
				invokeSignalConns(endedConns, fakeInput, false)
			end
			return true
		end
	end

	local okGui, inset = pcall(function()
		return GuiService:GetGuiInset()
	end)
	local insetY = if okGui and inset then inset.Y else 0
	local tx = vpX or screenX
	local ty = vpY or (screenY + insetY)

	local okVim = pcall(function()
		local vim = game:GetService("VirtualInputManager")
		vim:SendMouseButtonEvent(tx, ty, 0, true, game, 0)
		vim:SendMouseButtonEvent(tx, ty, 0, false, game, 0)
	end)
	return okVim
end

local function sendLabHold(holdDown: boolean, screenX: number, screenY: number)
	if not holdDown then
		releaseMixHold()
		return
	end
	if mixHoldActive then
		return
	end

	local beganConns = findResearchLabInputConns(UserInputService.InputBegan)
	if #beganConns > 0 then
		local fakeInput = {
			UserInputType = Enum.UserInputType.MouseButton1,
			UserInputState = Enum.UserInputState.Begin,
			Position = Vector3.new(screenX, screenY, 0),
			KeyCode = Enum.KeyCode.Unknown,
		}
		if invokeSignalConns(beganConns, fakeInput, true) then
			mixHoldActive = true
			mixHoldFakeInput = fakeInput
			return
		end
	end

	local okGui, inset = pcall(function()
		return GuiService:GetGuiInset()
	end)
	local insetY = if okGui and inset then inset.Y else 0
	local okVim = pcall(function()
		local vim = game:GetService("VirtualInputManager")
		vim:SendMouseButtonEvent(screenX, screenY + insetY, 0, true, game, 0)
	end)
	if okVim then
		mixHoldActive = true
		mixHoldViaVim = true
	end
