		local mod = ReplicatedStorage:FindFirstChild("GameData") or ReplicatedStorage:WaitForChild("GameData", 3)
		if mod and mod:IsA("ModuleScript") then
			local ok, gd = pcall(require, mod)
			if ok and type(gd) == "table" then
				cachedGameData = gd
			end
		end
	end
	return cachedGameData
end

local function decodeAttrTable(attrName: string): { [any]: any }
	local raw = LocalPlayer:GetAttribute(attrName)
	if type(raw) ~= "string" or raw == "" then
		return {}
	end
	if attrRawCache[attrName] == raw and attrDecCache[attrName] ~= nil then
		return attrDecCache[attrName]
	end
	local ok, res = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	local decoded = if ok and type(res) == "table" then res else {}
	attrRawCache[attrName] = raw
	attrDecCache[attrName] = decoded
	return decoded
end

local function getCharParts(): (Model?, Humanoid?, BasePart?)
	local char = LocalPlayer.Character
	if not char then
		return nil, nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
	if not hum or not root or not root:IsA("BasePart") then
		return char, hum, nil
	end
	return char, hum, root
end

local function isHouseDescendant(inst: Instance): boolean
	local cur: Instance? = inst
	while cur and cur ~= workspace do
		if cur.Name:sub(1, 10) == "SmithHouse" or cur.Name == "CloneCapsules" or CollectionService:HasTag(cur, "PlayerBase") then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function isSafePointInWorld(pos: Vector3, allowAirFallback: boolean?): (boolean, Vector3?)
	if matMod and type(matMod.IsPositionSafeForMove) == "function" then
		local ok, reason = matMod:IsPositionSafeForMove(pos, false)
		if not ok then
			return false, nil
		end
	elseif pos.Y < -20500 then
		return false, nil
	end

	local char = LocalPlayer.Character
	local rp = getSafeRayParams(char)

	local hit = workspace:Raycast(pos + Vector3.new(0, 26, 0), Vector3.new(0, -130, 0), rp)
	if hit and hit.Instance then
		return true, hit.Position
	end
	if allowAirFallback then
		return true, pos
	end
	return false, nil
end

local function isHostileMob(m: Instance): (boolean, string, Humanoid?, BasePart?)
	if not m or not m:IsA("Model") or not m:IsDescendantOf(workspace) then
		return false, "", nil, nil
	end
	if m == LocalPlayer.Character or Players:GetPlayerFromCharacter(m) then
		return false, "", nil, nil
	end
	if m.Name == "FloatingClone" or isHouseDescendant(m) then
		return false, "", nil, nil
	end

	local hum = m:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false, "", nil, nil
	end

	local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Head")
	if not root or not root:IsA("BasePart") then
		return false, "", nil, nil
	end

	local gd = getGameData()
	local isTaggedEnemy = CollectionService:HasTag(m, "Enemy")
	local hasEnemyAttr = m:GetAttribute("Enemy") ~= nil or m:GetAttribute("EnemyType") ~= nil or m:GetAttribute("EnemyId") ~= nil or m:GetAttribute("HuntTarget") ~= nil
	local enemyKey = tostring(m:GetAttribute("EnemyType") or m:GetAttribute("EnemyId") or m.Name)
	local knownInData = (gd and gd.Enemies and gd.Enemies[enemyKey] ~= nil) or false

	if not (isTaggedEnemy or hasEnemyAttr or knownInData) then
		return false, "", nil, nil
	end

	return true, enemyKey, hum, root
end

local function scanMobs(filterEnemyId: string?, maxDist: number?, requireSafeBounds: boolean?, ignoreSkipped: boolean?): { { model: Model, id: string, displayName: string, hum: Humanoid, root: BasePart, dist: number, isRanged: boolean } }
	local _, _, myRoot = getCharParts()
	local originPos = if myRoot then myRoot.Position else (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or Vector3.zero)
	local limit = maxDist or mobConfig.MaxHuntDist
	local wantFilter = filterEnemyId and filterEnemyId ~= "" and filterEnemyId ~= "ALL"
	local gd = getGameData()
	local nowSkip = if ignoreSkipped then os.clock() else 0

	local seen: { [Model]: boolean } = {}
	local out = {}

	local function consider(m: Instance)
		if not m:IsA("Model") or seen[m] then
			return
		end
		seen[m] = true
		if ignoreSkipped and skippedMobs[m] then
			if skippedMobs[m] > nowSkip then
				return
			end
			skippedMobs[m] = nil
		end
		local okMob, eId, hum, mRoot = isHostileMob(m)
		if not okMob or not hum or not mRoot then
			return
		end
		if wantFilter and eId ~= filterEnemyId and m.Name ~= filterEnemyId then
			return
		end
		local dist = (mRoot.Position - originPos).Magnitude
		if dist > limit then
			return
		end
		if requireSafeBounds then
			local safeOk = isSafePointInWorld(mRoot.Position, false)
			if not safeOk then
				return
			end
		end

		local meta = gd and gd.Enemies and gd.Enemies[eId]
		local dName = if meta and meta.name then tostring(meta.name) else eId
		local isRanged = meta and meta.attack == "ranged" or false
		table.insert(out, {
			model = m,
			id = eId,
			displayName = dName,
			hum = hum,
			root = mRoot,
			dist = dist,
			isRanged = isRanged,
		})
	end

	for _, tagged in ipairs(CollectionService:GetTagged("Enemy")) do
		consider(tagged)
	end
	if #out == 0 then
		local now = os.clock()
		if now - lastFallbackMobScanClock >= 0.7 then
			lastFallbackMobScanClock = now
			for _, ch in ipairs(workspace:GetChildren()) do
				if ch:IsA("Model") then
					consider(ch)
				elseif ch:IsA("Folder") or ch.Name:sub(1, 4) == "Dim_" or ch.Name:sub(1, 5) == "Proc_" then
					for _, sub in ipairs(ch:GetChildren()) do
						if sub:IsA("Model") then
							consider(sub)
						end
					end
				end
			end
		end
	end

	table.sort(out, function(a, b)
		return a.dist < b.dist
	end)
	return out
end

