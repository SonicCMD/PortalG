-- AUTO AIM (PG_AimLock + CAMERA + FACING) & AIM SHOOT
--====================================================
local function getMobAimPart(targetModel: Model?, fallbackRoot: BasePart?): BasePart?
	if not targetModel or not targetModel.Parent then
		return nil
	end
	local head = targetModel:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	local torso = targetModel:FindFirstChild("UpperTorso") or targetModel:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	return fallbackRoot or targetModel.PrimaryPart
end

local function uninstallAimHook()
	currentAimModel = nil
	currentAimPart = nil
	pcall(function()
		LocalPlayer:SetAttribute("AimCenter", nil)
	end)
	if ourAimLockFn and rawget(_G, "PG_AimLock") == ourAimLockFn then
		rawset(_G, "PG_AimLock", savedPrevAimLock)
	end
	ourAimLockFn = nil
	savedPrevAimLock = nil
end

local function installAimHook()
	if ourAimLockFn and rawget(_G, "PG_AimLock") == ourAimLockFn then
		return
	end
	local existing = rawget(_G, "PG_AimLock")
	if existing ~= nil and existing ~= ourAimLockFn then
		savedPrevAimLock = existing
	end
	ourAimLockFn = function(): Vector3?
		if not destroyed and (mobConfig.AutoAim or mobConfig.AutoHunt) and currentAimModel and currentAimModel.Parent then
			local mh = currentAimModel:FindFirstChildOfClass("Humanoid")
			if mh and mh.Health > 0 then
				local p = currentAimPart
				if not p or not p.Parent then
					p = getMobAimPart(currentAimModel, nil)
					currentAimPart = p
				end
				if p then
					return p.Position
				end
			end
		end
		if type(savedPrevAimLock) == "function" then
			local ok, res = pcall(savedPrevAimLock)
			if ok then
				return res
			end
		end
		return nil
	end
	rawset(_G, "PG_AimLock", ourAimLockFn)
end

local function getLosRayParams(char: Model?): RaycastParams
	local cam = workspace.CurrentCamera
	if char ~= cachedLosChar or cam ~= cachedLosCam then
		cachedLosChar = char
		cachedLosCam = cam
		local list = {}
		if char then table.insert(list, char) end
		if cam then table.insert(list, cam) end
		sharedLosRayParams.FilterDescendantsInstances = list
	end
	return sharedLosRayParams
end

local function getLosBackParams(char: Model?, targetModel: Model?): RaycastParams
	local cam = workspace.CurrentCamera
	if char ~= cachedBackChar or targetModel ~= cachedBackTarget or cam ~= cachedBackCam then
		cachedBackChar = char
		cachedBackTarget = targetModel
		cachedBackCam = cam
		local list = {}
		if char then table.insert(list, char) end
		if targetModel then table.insert(list, targetModel) end
		if cam then table.insert(list, cam) end
		sharedLosBackParams.FilterDescendantsInstances = list
	end
	return sharedLosBackParams
end

local function getWallOverlapParams(char: Model?, targetModel: Model?): OverlapParams
	if char ~= cachedWallChar or targetModel ~= cachedWallTarget then
		cachedWallChar = char
		cachedWallTarget = targetModel
		local list = {}
		if char then table.insert(list, char) end
		if targetModel then table.insert(list, targetModel) end
		sharedWallParams.FilterDescendantsInstances = list
	end
	return sharedWallParams
end

local function isPartShotBlocker(part: BasePart, targetModel: Model): boolean
	if part:IsDescendantOf(targetModel) then
		return false
	end
	if not part.CanCollide then
		return false
	end
	if part.Transparency >= 0.95 then
		return false
	end
	return true
end

-- Two-way raycast (shooter -> target AND target -> shooter) prevents both front walls and single-sided mesh walls
local function hasClearShotToTarget(fromStandPos: Vector3, targetModel: Model, targetRoot: BasePart, char: Model): boolean
	if not targetModel.Parent or not targetRoot.Parent then
		return false
	end
	local rpFwd = getLosRayParams(char)
	local rpBack = getLosBackParams(char, targetModel)
	local eyeOrigin = fromStandPos + Vector3.new(0, 1.5, 0)

	local aimPart = getMobAimPart(targetModel, targetRoot)
	local points = {}
	if aimPart then
		table.insert(points, aimPart.Position)
	end
	if targetRoot and (not aimPart or aimPart ~= targetRoot) then
		table.insert(points, targetRoot.Position + Vector3.new(0, 0.5, 0))
	end

	for _, pt in ipairs(points) do
		local delta = pt - eyeOrigin
		local dLen = delta.Magnitude
		if dLen <= 0.6 then
			return true
		end
		local hitFwd = workspace:Raycast(eyeOrigin, delta, rpFwd)
		local fwdClear = (hitFwd == nil) or (not isPartShotBlocker(hitFwd.Instance :: BasePart, targetModel))
		if fwdClear then
			local hitBack = workspace:Raycast(pt, -delta, rpBack)
			local backClear = (hitBack == nil) or (not hitBack.Instance:IsA("BasePart")) or (not (hitBack.Instance :: BasePart).CanCollide)
			if backClear then
				return true
			end
		end
	end
	return false
end

local function isSpotFreeOfSolidWall(standPos: Vector3, char: Model, targetModel: Model?): boolean
	local ov = getWallOverlapParams(char, targetModel)
	-- Center probe at chest/shoulder height (+1.55 above HRP) so flat or thick floors never false-trigger
	local probeCenter = standPos + Vector3.new(0, 1.55, 0)
	local hits = workspace:GetPartBoundsInRadius(probeCenter, 1.0, ov)
	for _, p in ipairs(hits) do
		if p:IsA("BasePart") and p.CanCollide then
			if p ~= workspace.Terrain then
				local topY = p.Position.Y + p.Size.Y * 0.5
				if topY > standPos.Y - 0.6 then
					return false
				end
			else
				local tHit = workspace:Raycast(standPos + Vector3.new(0, 3.0, 0), Vector3.new(0, -2.5, 0), getLosBackParams(char, targetModel))
				if tHit and tHit.Position.Y > standPos.Y + 0.2 then
					return false
				end
			end
		end
	end
	local rpBack = getLosBackParams(char, targetModel)
	local headCheck = workspace:Raycast(standPos + Vector3.new(0, 0.4, 0), Vector3.new(0, 3.2, 0), rpBack)
	if headCheck and headCheck.Instance and headCheck.Instance:IsA("BasePart") and (headCheck.Instance :: BasePart).CanCollide then
		return false
	end
	return true
end

-- Raycast strictly from just above mob height downward so characters stay inside the room instead of snapping onto roofs
local function resolveRoomFloorY(candXZ: Vector3, refMobY: number, char: Model, targetModel: Model): (boolean, number)
	local probeStart = Vector3.new(candXZ.X, refMobY + 3.0, candXZ.Z)
	if matMod and type(matMod.IsPositionSafeForMove) == "function" then
		local okSafe = matMod:IsPositionSafeForMove(Vector3.new(candXZ.X, refMobY, candXZ.Z), false)
		if not okSafe then
			return false, refMobY
		end
	elseif refMobY < -20500 then
		return false, refMobY
	end

	local rpBack = getLosBackParams(char, targetModel)
	local floorHit = workspace:Raycast(probeStart, Vector3.new(0, -18, 0), rpBack)
	if floorHit and floorHit.Instance then
		local candY = math.max(floorHit.Position.Y + 3.1, refMobY - 0.5)
		if math.abs(candY - refMobY) <= 10 then
			return true, candY
		end
	end

	-- Fallback downward check when mob stands on a steep edge, keeping elevation bounded near mob
	local deeperHit = workspace:Raycast(probeStart, Vector3.new(0, -65, 0), rpBack)
	if deeperHit and deeperHit.Instance then
		return true, refMobY + 0.5
	end
	return isSafePointInWorld(Vector3.new(candXZ.X, refMobY + 0.5, candXZ.Z), true), refMobY + 0.5
end

