		b.LightEmission = 1
		b.LightInfluence = 0
		b.Transparency = NumberSequence.new(0.15)
		b.Parent = folder
		beamObj = b
	end

	if beamObj and beamA0 and beamA1 then
		beamObj.Attachment0 = beamA0
		beamObj.Attachment1 = beamA1
		beamObj.Color = ColorSequence.new(color or Color3.fromRGB(56, 189, 248))
	end
end

local function updateVisuals()
	if not (config.ScanEsp or config.ShowBeam) then
		clearAllVisuals()
		return
	end

	local folder = getVisualFolder()
	if not folder then
		return
	end

	local matches, countsByName = scanMatchingNodes(true)
	local root = getRootPart()
	local originPos = if root then root.Position else Vector3.zero

	-- Update scan summary
	local topParts: { string } = {}
	for k, c in pairs(countsByName) do
		table.insert(topParts, ("%s x%d"):format(k, c))
	end
	table.sort(topParts)
	local shownList = {}
	for i = 1, math.min(4, #topParts) do
		table.insert(shownList, topParts[i])
	end

	local nearestInfo = matches[1]
	if nearestInfo then
		lastSummaryText = ("Available: %d | Nearest: %s (%.0fm)\nNearby: %s"):format(
			#matches,
			nearestInfo.name,
			nearestInfo.dist,
			if #shownList > 0 then table.concat(shownList, ", ") else "None"
		)
	else
		lastSummaryText = ("No %s found within %.0fm"):format(
			if config.SelectedItem == "ALL" then "materials" else (getItemMeta(config.SelectedItem)),
			config.MaxDistance
		)
	end

	-- Remove visuals for nodes no longer present in the scan list
	local activeSet: { [Instance]: boolean } = {}
	for _, info in ipairs(matches) do
		activeSet[info.node] = true
	end
	for node, vis in pairs(nodeVisuals) do
		if not activeSet[node] or not node.Parent then
			vis.bb:Destroy()
			if vis.hl then
				vis.hl:Destroy()
			end
			nodeVisuals[node] = nil
		end
	end

	if config.ScanEsp then
		for idx, info in ipairs(matches) do
			local vis = nodeVisuals[info.node]
			local adornee: Instance = info.anchorPart or info.node
			if not vis then
				local bb = Instance.new("BillboardGui")
				bb.Name = "MatMarker_" .. info.itemId
				bb.AlwaysOnTop = true
				bb.LightInfluence = 0
				bb.Size = UDim2.fromOffset(170, 34)
				bb.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
				bb.MaxDistance = config.MaxDistance
				bb.Adornee = adornee
				bb.Parent = folder

				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.fromScale(1, 1)
				lbl.BackgroundTransparency = 1
				lbl.Font = Enum.Font.GothamBold
				lbl.TextSize = 13
				lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
				lbl.TextStrokeTransparency = 0.25
				lbl.TextColor3 = info.color
				lbl.Parent = bb

				vis = { bb = bb, lbl = lbl, hl = nil }
				nodeVisuals[info.node] = vis
			end

			vis.bb.Adornee = adornee
			vis.bb.MaxDistance = config.MaxDistance
			vis.lbl.TextColor3 = info.color
			vis.lbl.Text = ("%s [%.0fm]"):format(info.name, info.dist)

			if idx <= MAX_HIGHLIGHTS and info.node:IsA("Model") then
				if not vis.hl or not vis.hl.Parent then
					local hl = Instance.new("Highlight")
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.FillColor = info.color
					hl.OutlineColor = Color3.new(1, 1, 1)
					hl.FillTransparency = 0.6
					hl.OutlineTransparency = 0.15
					hl.Adornee = info.node
					hl.Parent = folder
					vis.hl = hl
				else
					vis.hl.FillColor = info.color
				end
			elseif vis.hl then
				vis.hl:Destroy()
				vis.hl = nil
			end
		end
	else
		for node, vis in pairs(nodeVisuals) do
			vis.bb:Destroy()
			if vis.hl then
				vis.hl:Destroy()
			end
			nodeVisuals[node] = nil
		end
	end

	-- If a Wild Lands ore (Magma/Frost/Quartz) is selected before any node streams in, guide toward its Biome!
	local biomeTargetPos: Vector3? = nil
	local biomeColor: Color3? = nil
	local biomeKey = WILD_BIOMES[config.SelectedItem]
	if not nearestInfo and biomeKey then
		local bPos, bDist = findNearestBiomeTarget(biomeKey, originPos)
		if bPos and bDist then
			biomeTargetPos = bPos
			local itemName, col = getItemMeta(config.SelectedItem)
			biomeColor = col
			lastSummaryText = ("No streamed %s nodes nearby.\nHeading to %s: %.0fm"):format(
				itemName,
				BIOME_LABELS[biomeKey] or biomeKey,
				bDist
			)

			if config.ScanEsp then
				if not biomeVisual or not biomeVisual.part.Parent then
					local p = Instance.new("Part")
					p.Name = "BiomeBeaconAnchor"
					p.Anchored = true
					p.CanCollide = false
					p.CanQuery = false
					p.CanTouch = false
					p.Transparency = 1
					p.Size = Vector3.new(1, 1, 1)
					p.Parent = folder

					local bb = Instance.new("BillboardGui")
					bb.AlwaysOnTop = true
					bb.Size = UDim2.fromOffset(220, 40)
					bb.Adornee = p
					bb.Parent = folder

					local lbl = Instance.new("TextLabel")
					lbl.Size = UDim2.fromScale(1, 1)
					lbl.BackgroundTransparency = 1
					lbl.Font = Enum.Font.GothamBold
					lbl.TextSize = 14
					lbl.TextStrokeTransparency = 0.25
					lbl.Parent = bb

					biomeVisual = { bb = bb, part = p, lbl = lbl }
				end
				if biomeVisual then
					biomeVisual.part.CFrame = CFrame.new(bPos)
					biomeVisual.lbl.TextColor3 = col
					biomeVisual.lbl.Text = ("[%s • %.0fm]"):format(BIOME_LABELS[biomeKey] or biomeKey, bDist)
				end
			else
				clearBiomeVisual()
			end
		else
			clearBiomeVisual()
			local gd = getGameData()
			local meta = gd and gd.Items and gd.Items[config.SelectedItem]
			if meta and (meta.dim or meta.planet) then
				lastSummaryText = ("%s is in %s (travel there to scan nodes)."):format(
					tostring(meta.name or config.SelectedItem),
					tostring(meta.dim or meta.planet)
				)
			end
		end
	else
		clearBiomeVisual()
	end

	if nearestInfo then
		updateBeam(nearestInfo.pos, nearestInfo.color)
	elseif biomeTargetPos then
		updateBeam(biomeTargetPos, biomeColor)
	else
		updateBeam(nil, nil)
	end
end

local function refreshLoopState()
	local needsVisualLoop = (config.ScanEsp or config.ShowBeam) and not destroyed
	if needsVisualLoop and not renderConn then
		elapsedAcc = VISUAL_INTERVAL
		renderConn = RunService.RenderStepped:Connect(function(dt: number)
			elapsedAcc += dt
			if elapsedAcc < VISUAL_INTERVAL then
				return
			end
			elapsedAcc = 0
			updateVisuals()
		end)
	elseif not needsVisualLoop and renderConn then
		renderConn:Disconnect()
		renderConn = nil
		clearAllVisuals()
	end
end

local function setNoclipEnabled(enabled)
	if not enabled then
		if noclipConn then
			noclipConn:Disconnect()
			noclipConn = nil
		end
		for part, origCollide in pairs(savedCollide) do
			if part and part.Parent then
				part.CanCollide = origCollide
			end
		end
		table.clear(savedCollide)
		return
	end

	if not noclipConn then
		noclipConn = RunService.Stepped:Connect(function()
			if not flyActive or config.MoveMode ~= "FlyNoclip" or destroyed then
				return
			end
			local char = LocalPlayer.Character
			if not char then
				return
			end
			for _, desc in ipairs(char:GetDescendants()) do
				if desc:IsA("BasePart") then
					if savedCollide[desc] == nil then
						savedCollide[desc] = desc.CanCollide
					end
					desc.CanCollide = false
				end
			end
		end)
	end
end

local function startFlightSession(): boolean
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not char or not hum or not root or hum.Health <= 0 then
		return false
	end
	flyActive = true
	if hum.Sit then
		hum.Sit = false
	end
	hum.PlatformStand = true
	pcall(function()
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	setNoclipEnabled(config.MoveMode == "FlyNoclip")
	return true
end

local function stopFlightSession()
	local wasFlying = flyActive
	flyActive = false
	setNoclipEnabled(false)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	if wasFlying and hum and hum.Parent then
		hum.PlatformStand = false
		if hum.Health > 0 then
			pcall(function()
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end)
		end
	end
end

local function flyTowardsTarget(targetPos, reachDist, token, targetNode, targetPrompt, isBiomeTravel): (boolean, string)
	if not startFlightSession() then
		return false, "dead"
	end

	local root0 = getRootPart()
	if not root0 then
		return false, "dead"
	end

	local maxAct = if targetPrompt then (targetPrompt.MaxActivationDistance or 10) else 10
	local hoverY = if isBiomeTravel then 18 else math.min(2.6, math.max(1.2, maxAct * 0.38))
	local finalDest = targetPos + Vector3.new(0, hoverY, 0)
	local startPos = root0.Position
	local initialFlat = ((finalDest - startPos) * Vector3.new(1, 0, 1)).Magnitude
	local useCruise = initialFlat > 45
	local extraLift = if config.MoveMode == "FlySolid" then 26 else 14
	local cruiseY = math.max(startPos.Y, finalDest.Y + extraLift)

	local lastCheck = os.clock()
	local startClock = os.clock()

	while config.AutoCollect and token == autoLoopToken and not destroyed and config.MoveMode ~= "Walk" do
		local dt = math.min(RunService.Heartbeat:Wait(), 0.08)

		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = getRootPart()
		if not char or not hum or not root or hum.Health <= 0 then
			stopFlightSession()
			return false, "dead"
		end

		if targetNode then
			if not targetNode.Parent then
				return false, "gone"
			end
			if targetPrompt and (not targetPrompt.Parent or not targetPrompt.Enabled) then
				return false, "disabled"
			end
		end

		local curPos = root.Position
		local distToNode = (targetPos - curPos).Magnitude
		local distToHover = (finalDest - curPos).Magnitude

		if isBiomeTravel then
			if distToHover <= reachDist or Vector3.new(finalDest.X - curPos.X, 0, finalDest.Z - curPos.Z).Magnitude <= reachDist then
				return true, "reached"
			end
		elseif distToHover <= math.min(3.5, reachDist) and distToNode <= reachDist then
			return true, "reached"
		end

		if os.clock() - startClock > 35 then
			return false, "timeout"
		end

		if os.clock() - lastCheck >= 0.35 then
			lastCheck = os.clock()
			hum.PlatformStand = true
			setNoclipEnabled(config.MoveMode == "FlyNoclip")

			if isBiomeTravel then
				local found = scanMatchingNodes(false)
				if #found > 0 then
					return true, "node_streamed"
				end
			elseif distToHover > 50 then
				local found = scanMatchingNodes(false)
				local best = found[1]
				if best and best.node ~= targetNode and (best.dist + 20) < distToHover then
					return false, "retarget"
				end
			end
		end

		local horizRem = Vector3.new(finalDest.X - curPos.X, 0, finalDest.Z - curPos.Z).Magnitude
		local goal = if useCruise and horizRem > 34
			then Vector3.new(finalDest.X, cruiseY, finalDest.Z)
			else finalDest

		local diff = goal - curPos
		local distToGoal = diff.Magnitude
		local nextPos = if distToGoal <= 0.05
			then goal
			else (curPos + diff.Unit * math.min(distToGoal, config.FlySpeed * dt))

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		local lookVec = Vector3.new(finalDest.X - nextPos.X, 0, finalDest.Z - nextPos.Z)
		if lookVec.Magnitude > 0.25 then
			root.CFrame = CFrame.lookAt(nextPos, nextPos + lookVec)
		else
			local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
			if flatLook.Magnitude > 0.1 then
				root.CFrame = CFrame.lookAt(nextPos, nextPos + flatLook)
			else
				root.CFrame = CFrame.new(nextPos)
			end
		end
	end

	return false, "stopped"
end

local function moveTowardsTarget(targetPos: Vector3, stopDist: number, token: number, targetNode: Instance?): boolean
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not hum or not root or hum.Health <= 0 then
		return false
	end

	if (root.Position - targetPos).Magnitude <= stopDist then
		return true
	end

	-- Try PathfindingService first when far away (>30 studs); fall back to direct MoveTo if no path is found
	local waypoints: { PathWaypoint }? = nil
	if (root.Position - targetPos).Magnitude > 30 then
		local path = PathfindingService:CreatePath({
			AgentRadius = 2.5,
			AgentHeight = 5,
			AgentCanJump = true,
			WaypointSpacing = 8,
		})
		local okPath = pcall(function()
			path:ComputeAsync(root.Position, targetPos)
		end)
		if okPath and path.Status == Enum.PathStatus.Success then
			waypoints = path:GetWaypoints()
		end
	end

	local function walkToPoint(pt: Vector3, reachDist: number, maxWait: number): boolean
		local deadline = os.clock() + maxWait
		local lastPos = root.Position
		local stuckSince = os.clock()

		hum:MoveTo(pt)
		while config.AutoCollect and token == autoLoopToken and not destroyed do
			if not root.Parent or not hum.Parent or hum.Health <= 0 then
				return false
			end
			if targetNode and (not targetNode.Parent) then
				return false
			end
			local curDist = (root.Position - pt).Magnitude
			if curDist <= reachDist then
				return true
			end
			if os.clock() > deadline then
				return false
			end
			if (root.Position - lastPos).Magnitude > 1.2 then
				lastPos = root.Position
				stuckSince = os.clock()
			elseif os.clock() - stuckSince > 1.1 then
				hum.Jump = true
				hum:MoveTo(pt)
				if os.clock() - stuckSince > 3.2 then
					return false
				end
			end
			task.wait(0.1)
		end
		return false
	end

	if waypoints and #waypoints > 1 then
		for i = 2, #waypoints do
			if not config.AutoCollect or token ~= autoLoopToken or destroyed then
				return false
			end
			local wp = waypoints[i]
			if wp.Action == Enum.PathWaypointAction.Jump then
				hum.Jump = true
			end
			local isLast = (i == #waypoints)
			local okStep = walkToPoint(wp.Position, if isLast then stopDist else 4.5, 4)
			if not okStep then
				return false
			end
			if (root.Position - targetPos).Magnitude <= stopDist then
				return true
			end
		end
		return (root.Position - targetPos).Magnitude <= (stopDist + 2)
	else
		return walkToPoint(targetPos, stopDist, 6)
	end
end

local function triggerPromptSafe(targetInfo, token: number): boolean
	local prompt = targetInfo.prompt
	if not prompt or not prompt.Parent or not prompt.Enabled then
		return false
	end

	local triggered = false
	local conn = prompt.Triggered:Connect(function()
		triggered = true
	end)

	local origLOS = prompt.RequiresLineOfSight
	pcall(function()
		prompt.RequiresLineOfSight = false
	end)

	-- Maintain hover position & zero velocity during HoldDuration while using Fly mode
	local hoverConn = nil
	if config.MoveMode ~= "Walk" then
		local maxAct = prompt.MaxActivationDistance or 10
		local hoverY = math.min(2.6, math.max(1.2, maxAct * 0.38))
		local hoverPos = targetInfo.pos + Vector3.new(0, hoverY, 0)
		hoverConn = RunService.Heartbeat:Connect(function()
			if destroyed or not config.AutoCollect or token ~= autoLoopToken or config.MoveMode == "Walk" then
				return
			end
			local root = getRootPart()
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				local lookVec = Vector3.new(targetInfo.pos.X - root.Position.X, 0, targetInfo.pos.Z - root.Position.Z)
				if lookVec.Magnitude > 0.2 then
					root.CFrame = CFrame.lookAt(hoverPos, hoverPos + lookVec)
				else
					root.CFrame = CFrame.new(hoverPos)
				end
			end
		end)
	end

	local firePromptFn = resolveFirePromptFn()

	for attempt = 1, 2 do
		if destroyed or not config.AutoCollect or token ~= autoLoopToken or not prompt.Parent or not prompt.Enabled or triggered then
			break
		end

		if firePromptFn then
			pcall(firePromptFn, prompt)
			local fastWaitEnd = os.clock() + 0.18
			while os.clock() < fastWaitEnd do
				if triggered or not prompt.Parent or not prompt.Enabled or destroyed or not config.AutoCollect or token ~= autoLoopToken then
					break
				end
				task.wait(0.03)
			end
		end

		if not triggered and prompt.Parent and prompt.Enabled and config.AutoCollect and token == autoLoopToken and not destroyed then
			pcall(function()
				prompt:InputHoldBegin()
			end)

			local holdDur = math.max(0.08, prompt.HoldDuration + 0.14)
			local endWait = os.clock() + holdDur
			while os.clock() < endWait do
				if triggered or destroyed or not config.AutoCollect or token ~= autoLoopToken or not prompt.Parent or not prompt.Enabled then
					break
				end
				task.wait(0.04)
			end

			pcall(function()
				prompt:InputHoldEnd()
			end)
			task.wait(0.14)
		end

		if triggered or not prompt.Parent or not prompt.Enabled then
			break
		end
		if attempt == 1 then
			task.wait(0.08)
		end
	end

	if hoverConn then
		hoverConn:Disconnect()
		hoverConn = nil
	end
	pcall(function()
		if prompt.Parent then
			prompt.RequiresLineOfSight = origLOS
		end
	end)
	conn:Disconnect()
	return triggered or not prompt.Enabled or not prompt.Parent
end

function Material:ScanNow(): string
	local matches, countsByName = scanMatchingNodes(true)
	local first = matches[1]
	if first then
		lastSummaryText = ("Found %d • Nearest: %s (%.0fm)"):format(#matches, first.name, first.dist)
		return lastSummaryText
	end
	local root = getRootPart()
	local biomeKey = WILD_BIOMES[config.SelectedItem]
	if root and biomeKey then
		local _, bDist = findNearestBiomeTarget(biomeKey, root.Position)
		if bDist then
			lastSummaryText = ("Direction to %s: %.0fm"):format(BIOME_LABELS[biomeKey] or biomeKey, bDist)
			return lastSummaryText
		end
	end
	local countTypes = 0
	for _ in pairs(countsByName) do
		countTypes += 1
	end
	if countTypes > 0 then
		lastSummaryText = ("No %s nearby (%d other types around)."):format(getItemMeta(config.SelectedItem), countTypes)
	else
		lastSummaryText = "No materials found within scan radius."
	end
	return lastSummaryText
end

function Material:SetScanEsp(enabled: boolean)
	config.ScanEsp = enabled
	refreshLoopState()
end

function Material:SetShowBeam(enabled: boolean)
	config.ShowBeam = enabled
	refreshLoopState()
end

function Material:SetAutoCollect(enabled: boolean)
	config.AutoCollect = enabled
	autoLoopToken += 1
	local myToken = autoLoopToken
	if not enabled then
		stopFlightSession()
		lastCollectMsg = "Disabled"
		return
	end

	table.clear(skippedNodes)
	lastCollectMsg = "Scanning..."

	task.spawn(function()
		while config.AutoCollect and myToken == autoLoopToken and not destroyed do
			local matches = scanMatchingNodes(false)
			local target = matches[1]
			if not target then
				local root = getRootPart()
				local biomeKey = WILD_BIOMES[config.SelectedItem]
				if root and biomeKey then
					local bPos, bDist = findNearestBiomeTarget(biomeKey, root.Position)
					if bPos and bDist then
						local useFly = (config.MoveMode ~= "Walk")
						lastCollectMsg = ("%s %s (%.0fm)..."):format(
							if useFly then "Flying to" else "Walking to",
							BIOME_LABELS[biomeKey] or biomeKey,
							bDist
						)
						local stepDir = (bPos - root.Position) * Vector3.new(1, 0, 1)
						local hopDist = math.min(if useFly then 140 else 60, stepDir.Magnitude)
						if hopDist > 5 then
							local hopPos = root.Position + stepDir.Unit * hopDist
							if useFly then
								flyTowardsTarget(hopPos, 16, myToken, nil, nil, true)
							else
								moveTowardsTarget(hopPos, 8, myToken, nil)
							end
						end
						task.wait(0.15)
						continue
					end
				end
				stopFlightSession()
				lastCollectMsg = "Waiting for nearby materials..."
				task.wait(0.8)
				continue
			end

			local useFly = (config.MoveMode ~= "Walk")
			local maxAct = if target.prompt then (target.prompt.MaxActivationDistance or 10) else 8
			local reachDist = if target.prompt then math.max(5.5, maxAct - 1.5) else 6.5

			local reached = false
			local moveReason = ""
			if useFly then
				lastCollectMsg = ("Flying to: %s (%.0fm)"):format(target.name, target.dist)
				reached, moveReason = flyTowardsTarget(target.pos, reachDist, myToken, target.node, target.prompt, false)
			else
				lastCollectMsg = ("Walking to: %s (%.0fm)"):format(target.name, target.dist)
				reached = moveTowardsTarget(target.pos, reachDist, myToken, target.node)
			end

			if not config.AutoCollect or myToken ~= autoLoopToken or destroyed then
				break
			end

			if moveReason == "retarget" or moveReason == "gone" or moveReason == "disabled" then
				task.wait(0.05)
				continue
			end

			if reached and target.prompt and target.prompt.Parent and target.prompt.Enabled then
				lastCollectMsg = ("Collecting: %s..."):format(target.name)
				local okPick = triggerPromptSafe(target, myToken)
				if okPick then
					collectedCount += 1
					lastCollectMsg = ("Collected %s (Total: %d)"):format(target.name, collectedCount)
				else
					skippedNodes[target.node] = os.clock() + 4
				end
			else
				skippedNodes[target.node] = os.clock() + 6
				lastCollectMsg = ("Skipped unreachable node: %s"):format(target.name)
			end
			task.wait(0.1)
		end
		stopFlightSession()
	end)
end

function Material:SetMoveMode(mode: string)
	if mode == "FlyNoclip" or mode == "FlySolid" or mode == "Walk" then
		config.MoveMode = mode
		if mode == "Walk" then
			stopFlightSession()
		elseif flyActive then
			setNoclipEnabled(mode == "FlyNoclip")
		end
	end
end

function Material:SetFlySpeed(speed: number)
