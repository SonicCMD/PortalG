local function tryPortalGunToTarget(req: any): (boolean, string)
	if req.dimId == "FROOPYLAND" then
		local chalkPart = findChalkDoorForFroopy()
		local char = LocalPlayer.Character
		if chalkPart and char then
			releaseLootPhysics()
			char:PivotTo(CFrame.new(chalkPart.Position + Vector3.new(0, 2, 0)))
			task.wait(0.8)
			if isPlayerInWorldTarget(req) then
				return true, "Entered Froopyland via Magic Chalk door"
			end
		end
		return false, "Froopyland requires Magic Chalk door on Earth"
	end

	-- 1) Reuse any active portal in workspace pointing to req.dimId
	if req.dimId then
		local exPortal, exSide = findOpenPortalTo(req.dimId)
		if exPortal and exSide then
			local okC, msgC = crossPortalInstance(exPortal, exSide, req.dimId)
			if okC then
				return true, msgC
			end
		end
	end

	-- 2) Equip owned PortalGun / GoldenPortalGun & fire onto flat floor/wall ahead
	local pgTool, pgErr = findOwnedPortalGun(req.needGolden == true)
	if not pgTool then
		return false, pgErr
	end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not char or not hum or not root or hum.Health <= 0 then
		return false, "Character not ready"
	end

	local fluid = tonumber(pgTool:GetAttribute("Fluid"))
	if fluid ~= nil and fluid <= 0 then
		local rf = ReplicatedStorage:FindFirstChild("ReloadFluid")
		if rf and rf:IsA("RemoteEvent") then
			pcall(function() rf:FireServer() end)
			task.wait(0.25)
		end
		fluid = tonumber(pgTool:GetAttribute("Fluid"))
		if fluid ~= nil and fluid <= 0 then
			return false, "Portal Gun out of fluid"
		end
	end

	local portalCode = tostring(req.portalCode or "")
	if portalCode == "" then
		return false, "Missing portal code"
	end
	configurePortalGunTarget(portalCode)

	if pgTool.Parent ~= char then
		pcall(function() hum:EquipTool(pgTool) end)
		task.wait(0.18)
	end
	configurePortalGunTarget(portalCode)

	local portalsFolder = workspace:FindFirstChild("Portals")
	local existingPortals: { [Instance]: boolean } = {}
	if portalsFolder then
		for _, child in ipairs(portalsFolder:GetChildren()) do
			existingPortals[child] = true
		end
	end

	-- Aim downward onto clear ground/floor 7 studs in front of character
	releaseLootPhysics()
	sharedFloorParams.FilterDescendantsInstances = { char }
	local fwd = root.CFrame.LookVector
	local flatVec = Vector3.new(fwd.X, 0, fwd.Z)
	local flatFwd = if flatVec.Magnitude > 0.05 then flatVec.Unit else Vector3.new(0, 0, -1)
	local probeOrigin = root.Position + flatFwd * 7 + Vector3.new(0, 6, 0)
	local hitSurface = workspace:Raycast(probeOrigin, Vector3.new(0, -24, 0), sharedFloorParams)
	local aimSpot = if hitSurface then hitSurface.Position else (root.Position + (flatFwd * 7) - Vector3.new(0, 3.5, 0))

	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = hum
		local lookFrom = root.Position + Vector3.new(0, 3.5, 0) - flatFwd * 4
		if (aimSpot - lookFrom).Magnitude > 0.5 then
			cam.CFrame = CFrame.lookAt(lookFrom, aimSpot)
			cam.Focus = CFrame.new(aimSpot)
		end
	end
	char:PivotTo(CFrame.lookAt(root.Position, Vector3.new(aimSpot.X, root.Position.Y, aimSpot.Z)))
	task.wait(0.08)

	pcall(function()
		pgTool:Activate()
	end)
	local clickFn = rawget(_G, "mouse1click")
	if type(clickFn) == "function" then
		pcall(clickFn)
	end
	task.delay(0.08, function()
		pcall(function()
			if pgTool and pgTool.Parent == char then
				pgTool:Deactivate()
			end
		end)
	end)

	local spawnedPortal: Model? = nil
	local findDeadline = os.clock() + 3.2
	while os.clock() < findDeadline and not destroyed do
		if portalsFolder then
			for _, child in ipairs(portalsFolder:GetChildren()) do
				if child:IsA("Model") and not existingPortals[child] then
					local owner = tostring(child:GetAttribute("Owner") or "")
					local acf = child:GetAttribute("ACF")
					local nearShot = typeof(acf) == "CFrame" and (acf.Position - aimSpot).Magnitude <= 35
					if (owner == "" or owner == LocalPlayer.Name) and (nearShot or typeof(acf) == "CFrame") then
						spawnedPortal = child
						break
					end
				end
			end
		end
		if spawnedPortal then
			break
		end
		if isPlayerInWorldTarget(req) then
			return true, ("Entered %s via Portal Gun"):format(req.displayName)
		end
		task.wait(0.08)
	end

	if not spawnedPortal then
		return false, ("Portal did not open for %s (%s)"):format(req.displayName, portalCode)
	end

	return crossPortalInstance(spawnedPortal, "A", req.dimId)
end

local function bypassViaPlanetTravel(planetId: string, labelName: string): (boolean, string)
	local pt = ReplicatedStorage:FindFirstChild("PlanetTravel")
	if not pt or not pt:IsA("RemoteFunction") then
		return false, "RemoteFunction PlanetTravel not found"
	end

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not char or not hum or not root or hum.Health <= 0 then
		return false, "Character not ready"
	end

	releaseLootPhysics()
	hum.Sit = false
	hum.PlatformStand = false
	root.Anchored = false
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local okEnter, destPos, auxInfo = pcall(function()
		return pt:InvokeServer("enter", planetId)
	end)

	-- If server requires Orbit state first, leave current gravity well briefly then enter target planet
	if (not okEnter or typeof(destPos) ~= "Vector3") and LocalPlayer:GetAttribute("InOrbit") ~= true then
		pcall(function()
			return pt:InvokeServer("leave")
		end)
		task.wait(0.28)
		okEnter, destPos, auxInfo = pcall(function()
			return pt:InvokeServer("enter", planetId)
		end)
	end

	if not okEnter or typeof(destPos) ~= "Vector3" then
		return false, ("Planet bypass denied for %s: %s"):format(labelName, tostring(auxInfo or destPos or "unavailable"))
	end

	local dropPos = destPos - Vector3.new(0, 66, 0)
	root.Anchored = true
	char:PivotTo(CFrame.new(dropPos))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	task.spawn(function()
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(dropPos, 6)
		end)
	end)

	local spaceLocal = workspace:FindFirstChild("SpaceLocal")
	sharedFloorParams.FilterDescendantsInstances = if spaceLocal then { char, spaceLocal } else { char }

	local groundHit: RaycastResult? = nil
	local deadline = os.clock() + 5.0
	while os.clock() < deadline and not destroyed do
		local hit = workspace:Raycast(dropPos + Vector3.new(0, 500, 0), Vector3.new(0, -2200, 0), sharedFloorParams)
		if hit and hit.Instance then
			if hit.Instance == workspace.Terrain or (hit.Instance:IsA("BasePart") and hit.Instance.Anchored and hit.Instance.Size.X * hit.Instance.Size.Z >= 64) then
				groundHit = hit
				break
			end
		end
		task.wait(0.08)
	end

	local finalSpot = if groundHit then (groundHit.Position + Vector3.new(0, 4.5 * getCharacterScale(), 0)) else dropPos
	pcall(function()
		LocalPlayer:SetAttribute("InOrbit", nil)
	end)
	pivotCharacterSafely(finalSpot, finalSpot + Vector3.new(0, 0, -10))
	root = getRootPart()
	if root and root.Parent then
		root.Anchored = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	return true, ("Bypassed to planet %s"):format(labelName)
end

local function travelToWorldForMaterial(req: any): (boolean, string)
	if isPlayerInWorldTarget(req) then
		return true, "Already in " .. req.displayName
	end

	if req.kind == "home" then
		local okH, msgH = Material:ForceSendHomeNow()
		return okH, msgH
	end

	local mode = config.TravelMethod
	if req.kind == "planet" and req.planetId then
		if mode == "PortalGunOnly" then
			local okP, msgP = tryPortalGunToTarget(req)
			if okP then
				return true, msgP
			end
			return bypassViaPlanetTravel(req.planetId, req.displayName)
		elseif mode == "BypassOnly" then
			local okB, msgB = bypassViaPlanetTravel(req.planetId, req.displayName)
			if okB then
				return true, msgB
			end
			return false, msgB
		else
			-- SmartAuto: Instant PlanetTravel bypass first (no Golden gun / Cruiser flight needed), fallback Portal Gun
			local okB, msgB = bypassViaPlanetTravel(req.planetId, req.displayName)
			if okB then
				return true, msgB
			end
			return tryPortalGunToTarget(req)
		end
	end

	if req.kind == "dim" then
		return tryPortalGunToTarget(req)
	end

	return false, "Unsupported world target"
end

local function getProcExploreWaypoint(originPos: Vector3): (Vector3?, string?, Vector3?)
	local curDim = tostring(LocalPlayer:GetAttribute("CurrentDimension") or "")
	if curDim == "" then
		return nil, nil, nil
	end
	local proc = workspace:FindFirstChild("Proc_" .. curDim)
	if not proc then
		return nil, nil, nil
	end
	local zc = proc:GetAttribute("ZoneCenter")
	local zh = proc:GetAttribute("ZoneHalf")
	if typeof(zc) ~= "Vector3" or typeof(zh) ~= "Vector3" then
		return nil, nil, nil
	end
	exploreStepIdx = (exploreStepIdx % 8) + 1
	local ang = (exploreStepIdx - 1) * (math.pi / 4)
	local radius = math.clamp(math.min(zh.X, zh.Z) * 0.45, 160, 1400)
	local targetPos = Vector3.new(zc.X + math.cos(ang) * radius, originPos.Y, zc.Z + math.sin(ang) * radius)
	return targetPos, curDim, zc
end

function Material:SetAutoCollect(enabled: boolean)
	config.AutoCollect = enabled
	autoLoopToken += 1
	local myToken = autoLoopToken
	if not enabled then
		stopFlightSession()
		releaseLootPhysics()
		lastCollectMsg = "Disabled"
		return
	end

	table.clear(skippedNodes)
	table.clear(nodeFailCounts)
	consecutiveLootFails = 0
	holdNeedsRealHold = false
	lastCollectMsg = "Scanning..."
	local loopDim = LocalPlayer:GetAttribute("CurrentDimension")

	task.spawn(function()
		while config.AutoCollect and myToken == autoLoopToken and not destroyed do
			-- Yield cleanly if Force Home / Quick Interact teleport is currently in progress
			if teleportInProgress then
				releaseLootPhysics()
				lastCollectMsg = "Paused for Teleport..."
				task.wait(0.15)
				continue
			end

			-- Reset skip/cache cleanly if player dimension changed
			local curDimNow = LocalPlayer:GetAttribute("CurrentDimension")
			if curDimNow ~= loopDim then
				loopDim = curDimNow
				table.clear(skippedNodes)
				table.clear(nodeFailCounts)
				consecutiveLootFails = 0
				releaseLootPhysics()
			end

			local charNow = LocalPlayer.Character
			local humNow = charNow and charNow:FindFirstChildOfClass("Humanoid")
			if not charNow or not humNow or humNow.Health <= 0 then
				releaseLootPhysics()
				lastCollectMsg = "Waiting for character..."
				task.wait(0.35)
				continue
			end

			local activeWorldReq = if config.AutoCrossPlanet and config.SelectedItem ~= "ALL" then getItemWorldTarget(config.SelectedItem) else nil
			local needWorldTravel = activeWorldReq ~= nil and not isPlayerInWorldTarget(activeWorldReq)
			local matches = scanMatchingNodes(false)
			if needWorldTravel and #matches > 0 then
				local safeMatches = {}
				for _, m in ipairs(matches) do
					if isPositionSafeForDimension(m.pos, false) then
						table.insert(safeMatches, m)
					end
				end
				matches = safeMatches
			end
			local target = matches[1]
			if not target then
				releaseLootPhysics()
				local root = getRootPart()

				-- Auto Cross-Planet / Cross-Dimension travel when selected item belongs to another world
				if config.AutoCrossPlanet and config.SelectedItem ~= "ALL" then
					local worldReq = activeWorldReq or getItemWorldTarget(config.SelectedItem)
					if worldReq and not isPlayerInWorldTarget(worldReq) then
						local nowClock = os.clock()
						if lastTravelAttemptClock == 0 or (nowClock - lastTravelAttemptClock) >= 4.0 then
							lastTravelAttemptClock = nowClock
							lastCollectMsg = ("Traveling to %s..."):format(worldReq.displayName)
							local okTr, msgTr = travelToWorldForMaterial(worldReq)
							lastCollectMsg = msgTr
							if okTr then
								table.clear(skippedNodes)
								table.clear(nodeFailCounts)
								table.clear(nodeInfoCache)
								exploreStepIdx = 0
								task.wait(0.65)
								continue
							end
						else
							lastCollectMsg = ("Waiting to travel to %s..."):format(worldReq.displayName)
						end
					elseif worldReq and isPlayerInWorldTarget(worldReq) and root then
						-- Already on target planet/world, patrol chunk zones gently on verified solid ground to stream distant nodes
						local expPos, expDim, zoneCenter = getProcExploreWaypoint(root.Position)
						if expPos and expDim then
							local useTp = (config.MoveMode == "Teleport")
							lastCollectMsg = ("Exploring %s for %s..."):format(expDim, getItemMeta(config.SelectedItem))
							if useTp then
								pcall(function() LocalPlayer:RequestStreamAroundAsync(expPos, 2.0) end)
								local spaceLocal = workspace:FindFirstChild("SpaceLocal")
								sharedFloorParams.FilterDescendantsInstances = if spaceLocal then { charNow, spaceLocal } else { charNow }
								local baseY = if zoneCenter then math.max(expPos.Y, zoneCenter.Y) else expPos.Y
								local candidates = if zoneCenter then { expPos, zoneCenter:Lerp(expPos, 0.45), zoneCenter } else { expPos }
								local groundedSpot: Vector3? = nil
								for _, candXZ in ipairs(candidates) do
									local hit = workspace:Raycast(Vector3.new(candXZ.X, baseY + 120, candXZ.Z), Vector3.new(0, -320, 0), sharedFloorParams)
									if hit and hit.Instance and hit.Normal.Y >= 0.5 then
										groundedSpot = hit.Position + Vector3.new(0, 3.5 * getCharacterScale(), 0)
										break
									end
								end
								if groundedSpot then
									pivotCharacterSafely(groundedSpot, groundedSpot + Vector3.new(0, 0, -10))
								end
							else
								flyTowardsTarget(expPos, 18, myToken, nil, nil, true)
							end
							task.wait(0.35)
							continue
						end
					end
				end

				local biomeKey = WILD_BIOMES[config.SelectedItem]
				if root and biomeKey then
					local bPos, bDist = findNearestBiomeTarget(biomeKey, root.Position)
					if bPos and bDist then
						local useTp = (config.MoveMode == "Teleport")
						local useFly = (config.MoveMode == "FlyNoclip" or config.MoveMode == "FlySolid")
						lastCollectMsg = ("%s %s (%.0fm)..."):format(
							if useTp then "Teleporting to" elseif useFly then "Flying to" else "Walking to",
							BIOME_LABELS[biomeKey] or biomeKey,
							bDist
						)
						local stepDir = (bPos - root.Position) * Vector3.new(1, 0, 1)
						local hopDist = math.min(if useTp then 190 elseif useFly then 140 else 60, stepDir.Magnitude)
						if hopDist > 5 then
							local hopPos = root.Position + stepDir.Unit * hopDist
							if useTp then
								if isPositionSafeForDimension(hopPos, false) then
									pcall(function() LocalPlayer:RequestStreamAroundAsync(hopPos, 1.5) end)
									local safeHop = computeSafeLootStandPos(hopPos, nil)
									pivotCharacterSafely(safeHop, bPos)
								end
							elseif useFly then
								flyTowardsTarget(hopPos, 16, myToken, nil, nil, true)
							else
								moveTowardsTarget(hopPos, 8, myToken, nil)
							end
						end
						task.wait(0.15)
						continue
					end
				end
				stopFlightSession()
				lastCollectMsg = "Waiting for nearby materials..."
				task.wait(0.65)
				continue
			end

			local moveMode = config.MoveMode
			local useTp = (moveMode == "Teleport")
			local useFly = (moveMode == "FlyNoclip" or moveMode == "FlySolid")
			local maxAct = if target.prompt then (target.prompt.MaxActivationDistance or 10) else 8
			local reachDist = if target.prompt then math.max(5.5, maxAct - 1.5) else 6.5

			local reached = false
			local moveReason = ""
			if useTp then
				lastCollectMsg = ("Teleporting to: %s (%.0fm)"):format(target.name, target.dist)
				reached, moveReason = teleportToLootNode(target.pos, myToken, target.node, target.prompt)
			elseif useFly then
				lastCollectMsg = ("Flying to: %s (%.0fm)"):format(target.name, target.dist)
				reached, moveReason = flyTowardsTarget(target.pos, reachDist, myToken, target.node, target.prompt, false)
			else
				lastCollectMsg = ("Walking to: %s (%.0fm)"):format(target.name, target.dist)
				reached = moveTowardsTarget(target.pos, reachDist, myToken, target.node)
			end

			if not config.AutoCollect or myToken ~= autoLoopToken or destroyed then
				releaseLootPhysics()
				break
			end

			if moveReason == "retarget" or moveReason == "gone" or moveReason == "disabled" then
				releaseLootPhysics()
				task.wait(0.03)
				continue
			end

			if reached and target.prompt and target.prompt.Parent and target.prompt.Enabled then
				lastCollectMsg = ("Looting: %s..."):format(target.name)
				local okPick = triggerPromptSafe(target, myToken)
				if okPick then
					collectedCount += 1
					consecutiveLootFails = 0
					nodeFailCounts[target.node] = nil
					lastCollectMsg = ("Collected %s (Total: %d)"):format(target.name, collectedCount)
				else
					local fCount = (nodeFailCounts[target.node] or 0) + 1
					nodeFailCounts[target.node] = fCount
					local skipSecs = if fCount == 1 then 8 elseif fCount == 2 then 20 else 60
					skippedNodes[target.node] = os.clock() + skipSecs
					lastCollectMsg = ("Skipped stuck node: %s"):format(target.name)
					consecutiveLootFails += 1
					if consecutiveLootFails >= 3 then
						consecutiveLootFails = 0
						recoverFromLootHang("Auto-recovered from prompt hang...")
					end
				end
			else
				releaseLootPhysics()
				local fCount = (nodeFailCounts[target.node] or 0) + 1
				nodeFailCounts[target.node] = fCount
				local skipSecs = if fCount == 1 then 8 elseif fCount == 2 then 20 else 45
				skippedNodes[target.node] = os.clock() + skipSecs
				lastCollectMsg = ("Skipped unreachable node: %s"):format(target.name)
				consecutiveLootFails += 1
				if consecutiveLootFails >= 3 then
					consecutiveLootFails = 0
					recoverFromLootHang("Auto-recovered from stuck node...")
				end
			end

			local stepPause = if useTp then (if lowEndMode then math.max(config.LootDelay, 0.08) else config.LootDelay) else 0.08
			task.wait(stepPause)
		end
		stopFlightSession()
		releaseLootPhysics()
	end)
end

