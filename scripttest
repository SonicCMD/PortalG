function RayfieldLib:SetLowEndMode(enabled: boolean)
	lowEndMode = enabled == true
end

local function makeCorner(parent: Instance, radius: number): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

local function makeStroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = color or THEME.Stroke
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0
	stroke.Parent = parent
	return stroke
end

local function makePadding(parent: Instance, top: number, bottom: number, left: number, right: number): UIPadding
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, top)
	pad.PaddingBottom = UDim.new(0, bottom)
	pad.PaddingLeft = UDim.new(0, left)
	pad.PaddingRight = UDim.new(0, right)
	pad.Parent = parent
	return pad
end

local function tween(inst: Instance, info: TweenInfo, props: { [string]: any }): Tween?
	if lowEndMode then
		for k, v in pairs(props) do
			pcall(function()
				(inst :: any)[k] = v
			end)
		end
		return nil
	end
	local t = TweenService:Create(inst, info, props)
	t:Play()
	return t
end

local function roundToStep(value: number, minVal: number, maxVal: number, inc: number): number
	local snapped = math.round((value - minVal) / inc) * inc + minVal
	local clamped = math.clamp(snapped, minVal, maxVal)
	-- Remove floating-point precision noise (e.g. 0.6500000000000001)
	return math.round(clamped * 10000) / 10000
end

local function formatNumber(value: number, inc: number, suffix: string?): string
	local numStr: string
	if inc >= 1 then
		numStr = tostring(math.round(value))
	elseif inc >= 0.1 then
		numStr = string.format("%.1f", value)
	else
		numStr = string.format("%.2f", value)
		numStr = string.gsub(numStr, "(%.%d-)0+$", "%1")
		numStr = string.gsub(numStr, "%.$", "")
	end
	if suffix and suffix ~= "" then
		return numStr .. " " .. suffix
	end
	return numStr
end

function RayfieldLib:CreateWindow(config)
	local cfg = config or {}
	local windowTitle = cfg.Name or "Rayfield Menu"
	local windowSubtitle = cfg.Subtitle or "Client Utility"
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	local displayOrder = cfg.DisplayOrder or 500

	local connections: { RBXScriptConnection } = {}
	local function track(conn: RBXScriptConnection): RBXScriptConnection
		table.insert(connections, conn)
		return conn
	end

	local guiParent = resolveGuiParent()

	-- Remove older instance if re-executed (check both gethui/CoreGui and PlayerGui)
	for _, holder in ipairs({ guiParent, PlayerGui }) do
		local okFind, oldGui = pcall(function()
			return holder and holder:FindFirstChild("RayfieldMenuGui")
		end)
		if okFind and oldGui then
			oldGui:Destroy()
		end
	end

	local isMinimized = false
	local isVisible = true
	local destroyed = false

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "RayfieldMenuGui"
	screenGui.IgnoreGuiInset = true
	screenGui.ResetOnSpawn = false
	screenGui.DisplayOrder = displayOrder
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	protectGuiIfSupported(screenGui)
	screenGui.Parent = guiParent

	-- Keep ScreenGui Enabled even when other scripts (ResearchLab / AssemblyBench) batch-hide PlayerGui
	track(screenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if not destroyed and not screenGui.Enabled then
			task.defer(function()
				if not destroyed and screenGui.Parent and not screenGui.Enabled then
					screenGui.Enabled = true
				end
			end)
		end
	end))

	-- Notification stack (bottom-right)
	local notifyContainer = Instance.new("Frame")
	notifyContainer.Name = "Notifications"
	notifyContainer.AnchorPoint = Vector2.new(1, 1)
	notifyContainer.Position = UDim2.new(1, -18, 1, -18)
	notifyContainer.Size = UDim2.fromOffset(300, 340)
	notifyContainer.BackgroundTransparency = 1
	notifyContainer.Parent = screenGui

	local notifyLayout = Instance.new("UIListLayout")
	notifyLayout.SortOrder = Enum.SortOrder.LayoutOrder
	notifyLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	notifyLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	notifyLayout.Padding = UDim.new(0, 8)
	notifyLayout.Parent = notifyContainer

	-- Main Window
	local WINDOW_W = 550
	local WINDOW_H = 390
	local TOPBAR_H = 46

	local mainFrame = Instance.new("Frame")
	mainFrame.Name = "MainWindow"
	mainFrame.Active = true
	mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	mainFrame.Position = UDim2.fromScale(0.5, 0.5)
	mainFrame.Size = UDim2.fromOffset(WINDOW_W, WINDOW_H)
	mainFrame.BackgroundColor3 = THEME.WindowBg
	mainFrame.BorderSizePixel = 0
	mainFrame.ClipsDescendants = true
	mainFrame.Parent = screenGui
	makeCorner(mainFrame, 10)
	makeStroke(mainFrame, THEME.Stroke, 1, 0)

	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1
	uiScale.Parent = mainFrame

	local function updateResponsiveScale()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local vp = cam.ViewportSize
		local scaleX = (vp.X - 24) / WINDOW_W
		local scaleY = (vp.Y - 24) / WINDOW_H
		uiScale.Scale = math.clamp(math.min(1, scaleX, scaleY), 0.55, 1)
	end
	updateResponsiveScale()
	local function bindCameraScale()
		local cam = workspace.CurrentCamera
		if cam then
			track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsiveScale))
		end
	end
	bindCameraScale()
	track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		updateResponsiveScale()
		bindCameraScale()
	end))

	-- Topbar
	local topbar = Instance.new("Frame")
	topbar.Name = "Topbar"
	topbar.Active = true
	topbar.Size = UDim2.new(1, 0, 0, TOPBAR_H)
	topbar.BackgroundColor3 = THEME.TopbarBg
	topbar.BorderSizePixel = 0
	topbar.Parent = mainFrame
	makeCorner(topbar, 10)

	-- Cover bottom rounded corners of topbar so it sits flush with body
	local topbarMask = Instance.new("Frame")
	topbarMask.Size = UDim2.new(1, 0, 0, 12)
	topbarMask.Position = UDim2.new(0, 0, 1, -12)
	topbarMask.BackgroundColor3 = THEME.TopbarBg
	topbarMask.BorderSizePixel = 0
	topbarMask.Parent = topbar

	local topDivider = Instance.new("Frame")
	topDivider.Size = UDim2.new(1, 0, 0, 1)
	topDivider.Position = UDim2.new(0, 0, 1, -1)
	topDivider.BackgroundColor3 = THEME.Stroke
	topDivider.BorderSizePixel = 0
	topDivider.Parent = topbar

	local accentBar = Instance.new("Frame")
	accentBar.Size = UDim2.fromOffset(4, 22)
	accentBar.Position = UDim2.new(0, 14, 0.5, -11)
	accentBar.BackgroundColor3 = THEME.Accent
	accentBar.BorderSizePixel = 0
	accentBar.Parent = topbar
	makeCorner(accentBar, 2)

	local titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Position = UDim2.fromOffset(26, 5)
	titleLabel.Size = UDim2.new(1, -120, 0, 20)
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Text = windowTitle
	titleLabel.TextColor3 = THEME.Text
	titleLabel.TextSize = 15
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = topbar

	local subLabel = Instance.new("TextLabel")
	subLabel.BackgroundTransparency = 1
	subLabel.Position = UDim2.fromOffset(26, 24)
	subLabel.Size = UDim2.new(1, -120, 0, 16)
	subLabel.Font = Enum.Font.Gotham
	subLabel.Text = windowSubtitle
	subLabel.TextColor3 = THEME.SubText
	subLabel.TextSize = 11
	subLabel.TextXAlignment = Enum.TextXAlignment.Left
	subLabel.Parent = topbar

	local function makeHeaderBtn(text: string, offsetX: number): TextButton
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.fromOffset(28, 28)
		btn.AnchorPoint = Vector2.new(1, 0.5)
		btn.Position = UDim2.new(1, offsetX, 0.5, 0)
		btn.BackgroundColor3 = THEME.CardBg
		btn.Text = text
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 14
		btn.TextColor3 = THEME.SubText
		btn.AutoButtonColor = false
		btn.Parent = topbar
		makeCorner(btn, 6)
		makeStroke(btn, THEME.Stroke, 1, 0.4)

		if not isTouchOnly then
			track(btn.MouseEnter:Connect(function()
				tween(btn, TWEEN_FAST, { BackgroundColor3 = THEME.CardHover, TextColor3 = THEME.Text })
			end))
			track(btn.MouseLeave:Connect(function()
				tween(btn, TWEEN_FAST, { BackgroundColor3 = THEME.CardBg, TextColor3 = THEME.SubText })
			end))
		end
		return btn
	end

	local closeBtn = makeHeaderBtn("×", -10)
	local minimizeBtn = makeHeaderBtn("−", -44)

	-- Floating toggle pill (placed near upper-left so it never overlaps mobile thumbstick)
	local togglePill = Instance.new("TextButton")
	togglePill.Name = "TogglePill"
	togglePill.Active = true
	togglePill.Position = UDim2.new(0, 14, 0.16, 0)
	togglePill.Size = UDim2.fromOffset(112, 38)
	togglePill.BackgroundColor3 = THEME.TopbarBg
	togglePill.Text = "RF Menu"
	togglePill.Font = Enum.Font.GothamBold
	togglePill.TextSize = 13
	togglePill.TextColor3 = THEME.Text
	togglePill.AutoButtonColor = false
	togglePill.Visible = false
	togglePill.Parent = screenGui
	makeCorner(togglePill, 18)
	makeStroke(togglePill, THEME.Accent, 1.2, 0.25)

	-- Body container
	local bodyFrame = Instance.new("Frame")
	bodyFrame.Name = "Body"
	bodyFrame.Position = UDim2.fromOffset(0, TOPBAR_H)
	bodyFrame.Size = UDim2.new(1, 0, 1, -TOPBAR_H)
	bodyFrame.BackgroundTransparency = 1
	bodyFrame.Parent = mainFrame

	-- Left Sidebar
	local sidebar = Instance.new("Frame")
	sidebar.Name = "Sidebar"
	sidebar.Size = UDim2.new(0, 140, 1, 0)
	sidebar.BackgroundColor3 = THEME.SidebarBg
	sidebar.BorderSizePixel = 0
	sidebar.Parent = bodyFrame

	local sidebarDivider = Instance.new("Frame")
	sidebarDivider.Size = UDim2.new(0, 1, 1, 0)
	sidebarDivider.Position = UDim2.new(1, -1, 0, 0)
	sidebarDivider.BackgroundColor3 = THEME.Stroke
	sidebarDivider.BorderSizePixel = 0
	sidebarDivider.Parent = sidebar

	local tabList = Instance.new("ScrollingFrame")
	tabList.Name = "TabList"
	tabList.Size = UDim2.new(1, -1, 1, 0)
	tabList.BackgroundTransparency = 1
	tabList.BorderSizePixel = 0
	tabList.ScrollBarThickness = 2
	tabList.ScrollBarImageColor3 = THEME.Stroke
	tabList.CanvasSize = UDim2.new()
	tabList.AutomaticCanvasSize = Enum.AutomaticSize.Y
	tabList.Parent = sidebar
	makePadding(tabList, 10, 10, 8, 8)

	local tabLayout = Instance.new("UIListLayout")
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabLayout.Padding = UDim.new(0, 6)
	tabLayout.Parent = tabList

	-- Content Pages Holder
	local pagesHolder = Instance.new("Frame")
	pagesHolder.Name = "Pages"
	pagesHolder.Position = UDim2.fromOffset(140, 0)
	pagesHolder.Size = UDim2.new(1, -140, 1, 0)
	pagesHolder.BackgroundTransparency = 1
	pagesHolder.Parent = bodyFrame

	-- Dragging logic for MainWindow (safe for Mouse & Mobile Multi-Touch, free positioning)
	do
		local dragInput: InputObject? = nil
		local dragStart: Vector3
		local startPos: UDim2

		track(topbar.InputBegan:Connect(function(input: InputObject)
			if not dragInput and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				dragInput = input
				dragStart = input.Position
				startPos = mainFrame.Position
			end
		end))

		track(UserInputService.InputChanged:Connect(function(input: InputObject)
			if not dragInput then
				return
			end
			local isMatch = (dragInput.UserInputType == Enum.UserInputType.Touch and input == dragInput)
				or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
			if not isMatch then
				return
			end
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end))

		track(UserInputService.InputEnded:Connect(function(input: InputObject)
			if not dragInput then
				return
			end
			if input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
				dragInput = nil
			end
		end))
	end

	local activeTabName = ""
	local onTabChangedCb: ((string) -> ())? = nil
	local Window = {}

	-- Drag + click logic for TogglePill
	do
		local pillInput: InputObject? = nil
		local pillDragMoved = false
		local pillDragStart: Vector3
		local pillStartPos: UDim2

		track(togglePill.InputBegan:Connect(function(input: InputObject)
			if not pillInput and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
				pillInput = input
				pillDragMoved = false
				pillDragStart = input.Position
				pillStartPos = togglePill.Position
			end
		end))

		track(UserInputService.InputChanged:Connect(function(input: InputObject)
			if not pillInput then
				return
			end
			local isMatch = (pillInput.UserInputType == Enum.UserInputType.Touch and input == pillInput)
				or (pillInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
			if not isMatch then
				return
			end
			local delta = input.Position - pillDragStart
			if delta.Magnitude > 12 then
				pillDragMoved = true
			end
			if pillDragMoved then
				togglePill.Position = UDim2.new(
					pillStartPos.X.Scale,
					pillStartPos.X.Offset + delta.X,
					pillStartPos.Y.Scale,
					pillStartPos.Y.Offset + delta.Y
				)
			end
		end))

		track(UserInputService.InputEnded:Connect(function(input: InputObject)
			if not pillInput then
				return
			end
			if input == pillInput or (pillInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
				pillInput = nil
			end
		end))

		track(togglePill.Activated:Connect(function()
			if pillDragMoved then
				return
			end
			Window:SetVisible(true)
		end))
	end

	-- Window methods

	function Window:IsVisible(): boolean
		return (not destroyed) and isVisible
	end

	function Window:IsMinimized(): boolean
		return isMinimized
	end

	function Window:GetActiveTabName(): string
		return activeTabName
	end

	function Window:OnTabChanged(cb: (string) -> ())
		onTabChangedCb = cb
	end

	function Window:SetVisible(visible: boolean)
		if destroyed then
			return
		end
		isVisible = visible
		mainFrame.Visible = visible
		togglePill.Visible = not visible
		if visible and onTabChangedCb and activeTabName ~= "" then
			task.defer(onTabChangedCb, activeTabName)
		end
	end

	function Window:SetMinimized(minimized: boolean)
		if destroyed then
			return
		end
		isMinimized = minimized
		minimizeBtn.Text = if minimized then "+" else "−"
		local targetHeight = if minimized then TOPBAR_H else WINDOW_H
		tween(mainFrame, TWEEN_MED, { Size = UDim2.fromOffset(WINDOW_W, targetHeight) })
		if not minimized and onTabChangedCb and activeTabName ~= "" then
			task.defer(onTabChangedCb, activeTabName)
		end
	end

	function Window:Notify(notifyCfg)
		if destroyed then
			return
		end
		local title = notifyCfg.Title or "Notification"
		local content = notifyCfg.Content or ""
		local duration = notifyCfg.Duration or 3.5
		local accent = notifyCfg.Color or THEME.Accent

		local existingToasts = 0
		for _, ch in ipairs(notifyContainer:GetChildren()) do
			if ch:IsA("Frame") then
				existingToasts += 1
			end
		end
		if existingToasts >= 3 then
			for _, ch in ipairs(notifyContainer:GetChildren()) do
				if ch:IsA("Frame") then
					ch:Destroy()
					break
				end
			end
		end

		local card = Instance.new("Frame")
		card.Size = UDim2.new(1, 0, 0, 62)
		card.BackgroundColor3 = THEME.TopbarBg
		card.BackgroundTransparency = 1
		card.BorderSizePixel = 0
		card.Parent = notifyContainer
		makeCorner(card, 8)
		local stroke = makeStroke(card, accent, 1, 1)

		local strip = Instance.new("Frame")
		strip.Size = UDim2.new(0, 4, 1, -14)
		strip.Position = UDim2.fromOffset(8, 7)
		strip.BackgroundColor3 = accent
		strip.BackgroundTransparency = 1
		strip.BorderSizePixel = 0
		strip.Parent = card
		makeCorner(strip, 2)

		local nTitle = Instance.new("TextLabel")
		nTitle.BackgroundTransparency = 1
		nTitle.Position = UDim2.fromOffset(20, 8)
		nTitle.Size = UDim2.new(1, -28, 0, 18)
		nTitle.Font = Enum.Font.GothamBold
		nTitle.Text = title
		nTitle.TextColor3 = THEME.Text
		nTitle.TextTransparency = 1
		nTitle.TextSize = 13
		nTitle.TextXAlignment = Enum.TextXAlignment.Left
		nTitle.TextTruncate = Enum.TextTruncate.AtEnd
		nTitle.Parent = card

		local nBody = Instance.new("TextLabel")
		nBody.BackgroundTransparency = 1
		nBody.Position = UDim2.fromOffset(20, 27)
		nBody.Size = UDim2.new(1, -28, 0, 28)
		nBody.Font = Enum.Font.Gotham
		nBody.Text = content
		nBody.TextColor3 = THEME.SubText
		nBody.TextTransparency = 1
		nBody.TextSize = 12
		nBody.TextWrapped = true
		nBody.TextXAlignment = Enum.TextXAlignment.Left
		nBody.TextYAlignment = Enum.TextYAlignment.Top
		nBody.Parent = card

		tween(card, TWEEN_FAST, { BackgroundTransparency = 0.05 })
		tween(stroke, TWEEN_FAST, { Transparency = 0.25 })
		tween(strip, TWEEN_FAST, { BackgroundTransparency = 0 })
		tween(nTitle, TWEEN_FAST, { TextTransparency = 0 })
		tween(nBody, TWEEN_FAST, { TextTransparency = 0 })

		task.delay(duration, function()
			if not card.Parent then
				return
			end
			tween(card, TWEEN_FAST, { BackgroundTransparency = 1 })
			tween(stroke, TWEEN_FAST, { Transparency = 1 })
			tween(strip, TWEEN_FAST, { BackgroundTransparency = 1 })
			tween(nTitle, TWEEN_FAST, { TextTransparency = 1 })
			local fadeOut = tween(nBody, TWEEN_FAST, { TextTransparency = 1 })
			if fadeOut then
				fadeOut.Completed:Wait()
			end
			if card.Parent then
				card:Destroy()
			end
		end)
	end

	function Window:Destroy()
		if destroyed then
			return
		end
		destroyed = true
		for _, conn in ipairs(connections) do
			conn:Disconnect()
		end
		table.clear(connections)
		if screenGui.Parent then
			screenGui:Destroy()
		end
	end

	track(minimizeBtn.Activated:Connect(function()
		Window:SetMinimized(not isMinimized)
	end))

