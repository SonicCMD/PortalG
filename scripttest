	end

	function AutomationModule:SetFastAssemble(enabled: boolean)
		craftConfig.FastAssemble = enabled
	end

	function AutomationModule:SetAutoClampMax(enabled: boolean)
		craftConfig.AutoClampMax = enabled
	end

	function AutomationModule:SetCraftInterval(sec: number)
		craftConfig.Interval = math.clamp(sec, 0.25, 5)
	end

	function AutomationModule:GetRecipeOptions(): ({ string }, { [string]: string })
		local gd = getGameData()
		local options: { string } = {}
		local labelToId: { [string]: string } = {}
		if not gd or type(gd.Recipes) ~= "table" then
			options[1] = "Không có dữ liệu Recipes"
			return options, labelToId
		end
		for _, rec in ipairs(gd.Recipes) do
			local itemMeta = gd.Items and gd.Items[rec.result]
			local display = if itemMeta and itemMeta.name then itemMeta.name else tostring(rec.result or rec.id)
			local label = ("%s [%s]"):format(display, tostring(rec.id))
			table.insert(options, label)
			labelToId[label] = rec.id
		end
		if #options > 0 and craftConfig.SelectedId == "" then
			craftConfig.SelectedId = labelToId[options[1]] or ""
		end
		return options, labelToId
	end

	function AutomationModule:GetCraftStatusText(): string
		local gd = getGameData()
		if not gd or type(gd.Recipes) ~= "table" then
			return "Chưa tải được GameData.Recipes"
		end
		local recipe = findRecipeById(craftConfig.SelectedId)
		if not recipe then
			return "Chưa chọn công thức"
		end

		local itemMeta = gd.Items and gd.Items[recipe.result]
		local display = if itemMeta and itemMeta.name then itemMeta.name else tostring(recipe.result or recipe.id)
		local unlocked = knowsRecipe(gd, recipe)
		local afford = getAffordCount(recipe)
		local owned = inventory[recipe.result] or 0

		return ("Item: %s (đang có: %d)\nMở khóa: %s | Đủ nguyên liệu: tối đa %d lần"):format(
			display,
			owned,
			if unlocked then "Rồi" else "Chưa",
			afford
		)
	end

	function AutomationModule:Destroy()
		destroyed = true
		researchConfig.AutoEnabled = false
		craftConfig.AutoEnabled = false
		researchLoopToken += 1
		craftLoopToken += 1
		if inventoryConn then
			inventoryConn:Disconnect()
			inventoryConn = nil
		end
	end

	return AutomationModule
end)()

