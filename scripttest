local function getPromptWorldPos(prompt: ProximityPrompt): Vector3?
	local p = prompt.Parent
	if not p then
		return nil
	end
	if p:IsA("Attachment") then
		return p.WorldPosition
	elseif p:IsA("BasePart") then
		return p.Position
	end
	local model = p:FindFirstAncestorWhichIsA("Model")
	if model then
		local ok, cf = pcall(function()
			return model:GetPivot()
		end)
		if ok and cf then
			return cf.Position
		end
	end
	return nil
end

local function findPromptInContainer(container: Instance, promptNames: { string }): ProximityPrompt?
	for _, pName in ipairs(promptNames) do
		local found = container:FindFirstChild(pName, true)
		if found and found:IsA("ProximityPrompt") and found.Enabled then
			return found
		end
	end
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			return d
		end
	end
	return nil
end

local function findStationPromptInHouse(house: Model?, spec: any, nearRootPos: Vector3?): (ProximityPrompt?, Vector3?)
	if house then
		for _, mName in ipairs(spec.modelNames) do
			local model = house:FindFirstChild(mName, true)
			if model then
				local prompt = findPromptInContainer(model, spec.promptNames)
				if prompt then
					return prompt, getPromptWorldPos(prompt)
				end
			end
		end
	end
	if spec.tagFallback and nearRootPos then
		local bestPrompt: ProximityPrompt? = nil
		local bestPos: Vector3? = nil
		local bestDist = math.huge
		for _, inst in ipairs(CollectionService:GetTagged(spec.tagFallback)) do
			if inst:IsDescendantOf(workspace) then
				local prompt = findPromptInContainer(inst, spec.promptNames)
				local pPos = if prompt then getPromptWorldPos(prompt) else nil
				if prompt and pPos then
					local d = (pPos - nearRootPos).Magnitude
					if d < bestDist then
						bestDist = d
						bestPrompt = prompt
						bestPos = pPos
					end
				end
			end
		end
		if bestPrompt then
			return bestPrompt, bestPos
		end
	end
	return nil, nil
end

local function findCleanSpotNearTarget(
	house: Model,
	targetPos: Vector3,
	maxPromptDist: number,
	targetPrompt: ProximityPrompt?
): Vector3?
	local scale = getCharacterScale()
	local garage = house:FindFirstChild("Garage") or house:FindFirstChild("Garage", true)
	local container: Instance = garage or house

	local rivalPositions: { Vector3 } = {}
	if garage then
		local targetKey = if targetPrompt then targetPrompt.KeyboardKeyCode else Enum.KeyCode.E
		for _, d in ipairs(garage:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d ~= targetPrompt and d.Enabled and d.KeyboardKeyCode == targetKey then
				local pPos = getPromptWorldPos(d)
				if pPos and (pPos - targetPos).Magnitude <= 18 then
					table.insert(rivalPositions, pPos)
				end
			end
		end
	end

	local floorParts: { BasePart } = {}
	for _, ch in ipairs(container:GetDescendants()) do
		if ch:IsA("BasePart") and ch.Name == "Floor" and ch.CanCollide and (ch.Position - targetPos).Magnitude < 45 then
			table.insert(floorParts, ch)
		end
	end

	local floorY = targetPos.Y - 4.0
	if #floorParts > 0 then
		local sumY = 0
		for _, fp in ipairs(floorParts) do
			sumY += fp.Position.Y
		end
		floorY = sumY / #floorParts
	end

	sharedHouseParams.FilterDescendantsInstances = { house }
	local houseParams = sharedHouseParams

	sharedDownParams.FilterDescendantsInstances = { container }
	local downParams = sharedDownParams

	local feelDirs: { Vector3 } = {}
	for k = 0, 7 do
		local a = (k / 8) * math.pi * 2
		table.insert(feelDirs, Vector3.new(math.cos(a) * 1.3 * scale, 0, math.sin(a) * 1.3 * scale))
	end

	local bestTier = 99
	local bestDist = math.huge
	local bestSpot: Vector3? = nil

	local function testSurfaceHit(hit: RaycastResult?)
		if not hit or not hit.Instance or hit.Normal.Y < 0.85 then
			return
		end
		if hit.Position.Y < floorY - 1.5 or hit.Position.Y > targetPos.Y + 2.0 then
			return
		end
		local isElevated = (hit.Position.Y > targetPos.Y + 0.6)
		local surfName = hit.Instance.Name
		local isFloor = (surfName == "Floor" or surfName == "Cover") and not isElevated

		-- Bidirectional headroom check catches thin undersides even when ray origin is inside a mesh
		local upHit = workspace:Raycast(hit.Position + Vector3.new(0, 0.45, 0), Vector3.new(0, 5.4 * scale, 0), houseParams)
		if upHit then
			return
		end
		local downHeadHit = workspace:Raycast(hit.Position + Vector3.new(0, 5.6 * scale, 0), Vector3.new(0, -5.2 * scale, 0), houseParams)
		if downHeadHit then
			return
		end

		for _, hOff in ipairs({ 1.8 * scale, 3.2 * scale }) do
			local origin = hit.Position + Vector3.new(0, hOff, 0)
			for _, dir in ipairs(feelDirs) do
				local sideHit = workspace:Raycast(origin, dir, houseParams)
				if sideHit and sideHit.Instance and sideHit.Instance ~= hit.Instance and sideHit.Instance.Name ~= "Floor" and sideHit.Instance.Name ~= "Cover" then
					return
				end
			end
		end

		local candPos = hit.Position + Vector3.new(0, 3.1 * scale, 0)
		local dTarget = (candPos - targetPos).Magnitude
		if dTarget > maxPromptDist or dTarget < 1.6 then
			return
		end

		local winsPrompt = true
		for _, rPos in ipairs(rivalPositions) do
			if (candPos - rPos).Magnitude <= dTarget + 0.15 then
				winsPrompt = false
				break
			end
		end

		local tier = if isElevated
			then (if winsPrompt then 4 else 5)
			elseif winsPrompt and isFloor then 0
			elseif winsPrompt then 1
			elseif isFloor then 2
			else 3

		if tier < bestTier or (tier == bestTier and dTarget < bestDist) then
			bestTier = tier
			bestDist = dTarget
			bestSpot = candPos
		end
	end

	local radii = { 2.4, 3.1, 3.9, 4.8, 5.8, 7.0, 8.0 }
	for _, r in ipairs(radii) do
		if r <= maxPromptDist + 1.5 then
			for step = 0, 15 do
				local ang = (step / 16) * math.pi * 2
				local px = targetPos.X + math.cos(ang) * r
				local pz = targetPos.Z + math.sin(ang) * r
				local lowHit = workspace:Raycast(Vector3.new(px, floorY + 4.8, pz), Vector3.new(0, -8.5, 0), downParams)
				testSurfaceHit(lowHit)
				local highHit = workspace:Raycast(Vector3.new(px, targetPos.Y + 2.2, pz), Vector3.new(0, -10, 0), downParams)
				if highHit and (not lowHit or highHit.Instance ~= lowHit.Instance) then
					testSurfaceHit(highHit)
				end
			end
		end
	end

	if bestSpot then
		return bestSpot
	end

	-- Fallback toward Garage center so we never land inside outer walls or hovering above Floor
	local genPos = findGarageSpot(house)
	if genPos then
		if (genPos - targetPos).Magnitude <= maxPromptDist then
			return genPos
		end
		local dir = Vector3.new(genPos.X - targetPos.X, 0, genPos.Z - targetPos.Z)
		if dir.Magnitude > 0.2 then
			return Vector3.new(targetPos.X, floorY + 3.2 * scale, targetPos.Z) + dir.Unit * 3.0
		end
	end
	return Vector3.new(targetPos.X - 2.6, floorY + 3.2 * scale, targetPos.Z)
end

local function prepareForTeleport(disableAutoCollectMsg: string?): (boolean, string)
	if config.AutoCollect then
		config.AutoCollect = false
		autoLoopToken += 1
		lastCollectMsg = disableAutoCollectMsg or "Disabled (Teleported)"
		if beforeTeleportCallback then
			pcall(beforeTeleportCallback)
		end
		refreshLoopState()
	end
	stopFlightSession()

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not char or not hum or not root or hum.Health <= 0 then
		return false, "Character not ready"
	end
	if hum.Sit or hum.SeatPart then
		hum.Sit = false
		task.wait(0.08)
	end
	return true, "ok"
end

function Material:QuickInteract(stationKey: string): (boolean, string, boolean)
	if destroyed then
		return false, "Menu unloaded", false
	end
	local spec = QUICK_STATIONS[stationKey]
	if not spec then
		return false, "Unknown station: " .. tostring(stationKey), false
	end
	if teleportInProgress then
		return false, "Teleport already in progress", false
	end
	teleportInProgress = true

	local finalOk = false
	local finalMsg = "Quick interact failed"

	local runOk, runErr = pcall(function()
		local readyOk, readyErr = prepareForTeleport("Paused (Quick Interact)")
		if not readyOk then
			finalOk = false
			finalMsg = readyErr
			lastHomeMsg = finalMsg
			sendNotice("Quick Interact", finalMsg, Color3.fromRGB(248, 113, 113))
			return
		end

		local root = getRootPart()
		if not root then
			finalOk = false
			finalMsg = "HumanoidRootPart not found"
			return
		end

		local curDim = LocalPlayer:GetAttribute("CurrentDimension")
		local homeDim = LocalPlayer:GetAttribute("HomeDimension")
		local homePos = LocalPlayer:GetAttribute("HomePos")
		local inOrbit = LocalPlayer:GetAttribute("InOrbit") == true
		local inOtherDim = (homeDim ~= nil and curDim ~= nil and curDim ~= homeDim) or inOrbit

		local localHouse = findLocalPlayerBase()
		local nearPrompt, nearPos = findStationPromptInHouse(localHouse, spec, root.Position)
		if nearPrompt and nearPos and not inOtherDim then
			local nearMax = if nearPrompt.MaxActivationDistance > 1 then nearPrompt.MaxActivationDistance else spec.maxDist
			local maxAct = math.min(spec.maxDist, nearMax - 0.5)
			if (nearPos - root.Position).Magnitude <= maxAct then
				local okTrig = fireOrHoldPrompt(nearPrompt, function()
					return not destroyed
				end, false)
				finalOk = okTrig
				if okTrig then
					finalMsg = "Opened " .. spec.label
					lastHomeMsg = finalMsg
					sendNotice("Quick Interact", finalMsg, Color3.fromRGB(52, 211, 153))
				else
					finalMsg = "Could not trigger " .. spec.label .. " prompt"
					lastHomeMsg = finalMsg
					sendNotice("Quick Interact", finalMsg, Color3.fromRGB(248, 113, 113))
				end
				return
			end
		end

		-- Save return spot when teleporting from afar (> 28 studs from HomePos/House)
		local originHousePos: Vector3? = if typeof(homePos) == "Vector3"
			then homePos
			elseif localHouse then localHouse:GetPivot().Position
			else nil
		if inOtherDim or not originHousePos or (root.Position - originHousePos).Magnitude > 28 then
			savedReturnCFrame = root.CFrame
			savedReturnDim = curDim
		end

		if inOtherDim then
			local goHome = ReplicatedStorage:FindFirstChild("GoHome")
			if goHome and goHome:IsA("RemoteEvent") then
				pcall(function()
					goHome:FireServer("start")
				end)
				lastHomeMsg = "Returning home for " .. spec.label .. "..."
				sendNotice("Quick Interact", lastHomeMsg, Color3.fromRGB(56, 189, 248))

				local waitStart = os.clock()
				while not destroyed and os.clock() - waitStart < 8.5 do
					task.wait(0.2)
					local nowDim = LocalPlayer:GetAttribute("CurrentDimension")
					local nowOrbit = LocalPlayer:GetAttribute("InOrbit") == true
					if (homeDim == nil or nowDim == homeDim) and not nowOrbit and findLocalPlayerBase() then
						break
					end
				end
			end
		end

		local house = findLocalPlayerBase()
		if not house and typeof(homePos) == "Vector3" then
			lastHomeMsg = "Streaming Garage..."
			pcall(function()
				LocalPlayer:RequestStreamAroundAsync(homePos, 5)
			end)
			pivotCharacterSafely(homePos + Vector3.new(0, 6, 0), nil)
			root = getRootPart()
			if root then
				root.Anchored = true
				local tStart = os.clock()
				while not destroyed and os.clock() - tStart < 1.8 do
					house = findLocalPlayerBase()
					if house and (house:FindFirstChild("Garage") or house:FindFirstChild("Garage", true)) then
						break
					end
					task.wait(0.15)
				end
				if root.Parent then
					root.Anchored = false
				end
			end
		end

		local rNow = getRootPart()
		local prompt, stationPos = findStationPromptInHouse(house, spec, rNow and rNow.Position or nil)
		if not prompt or not stationPos then
			finalOk = false
			finalMsg = spec.label .. " prompt not found (must be built in Garage)"
			lastHomeMsg = finalMsg
			sendNotice("Quick Interact", finalMsg, Color3.fromRGB(248, 113, 113))
			return
		end

		local rawPromptMax = if prompt.MaxActivationDistance > 1 then prompt.MaxActivationDistance else spec.maxDist
		local maxUseDist = math.max(4.5, math.min(spec.maxDist, rawPromptMax - 0.8))
		local destPos = if house then findCleanSpotNearTarget(house, stationPos, maxUseDist, prompt) else (stationPos + Vector3.new(-3.2, 0.8, 0))
		if destPos then
			pcall(function()
				LocalPlayer:RequestStreamAroundAsync(destPos, 3)
			end)
			pivotCharacterSafely(destPos, stationPos)
			RunService.Heartbeat:Wait()
		end

		local rAfter = getRootPart()
		if rAfter then
			rAfter.Anchored = false
			rAfter.AssemblyLinearVelocity = Vector3.zero
			rAfter.AssemblyAngularVelocity = Vector3.zero
		end

		local okTrig = fireOrHoldPrompt(prompt, function()
			return not destroyed
		end, false)
		finalOk = okTrig
		if okTrig then
			finalMsg = "Opened " .. spec.label
			lastHomeMsg = finalMsg
			sendNotice("Quick Interact", finalMsg, Color3.fromRGB(52, 211, 153))
		else
			finalMsg = "Could not trigger " .. spec.label .. " prompt"
			lastHomeMsg = finalMsg
			sendNotice("Quick Interact", finalMsg, Color3.fromRGB(248, 113, 113))
		end
	end)

	teleportInProgress = false
	if not runOk then
		local rRecover = getRootPart()
		if rRecover then
			rRecover.Anchored = false
		end
		lastHomeMsg = "Error: " .. tostring(runErr)
		return false, lastHomeMsg, false
	end
	return finalOk, finalMsg, (finalOk and spec.opensFullUi == true)
end

function Material:ReturnToSavedSpot(): (boolean, string)
	if destroyed then
		return false, "Menu unloaded"
	end
	if not savedReturnCFrame then
		return false, "No previous spot saved yet"
	end
	if teleportInProgress then
		return false, "Teleport already in progress"
	end
	local curDim = LocalPlayer:GetAttribute("CurrentDimension")
	if savedReturnDim ~= nil and curDim ~= nil and curDim ~= savedReturnDim then
		return false, ("Switch back to dimension %s first"):format(tostring(savedReturnDim))
	end

	teleportInProgress = true
	local targetCF = savedReturnCFrame
	local finalOk = false
	local finalMsg = "Return failed"

	pcall(function()
		local readyOk, readyErr = prepareForTeleport("Paused (Returned)")
		if not readyOk then
			finalMsg = readyErr
			return
		end
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(targetCF.Position, 3)
		end)
		local moved = pivotCharacterSafely(targetCF.Position, targetCF.Position + targetCF.LookVector * 10)
		if moved then
			RunService.Heartbeat:Wait()
			savedReturnCFrame = nil
			savedReturnDim = nil
			finalOk = true
			finalMsg = "Returned to previous location"
			lastHomeMsg = finalMsg
			sendNotice("Return", finalMsg, Color3.fromRGB(52, 211, 153))
		end
	end)

	teleportInProgress = false
	return finalOk, finalMsg
end

function Material:ForceSendHomeNow(): (boolean, string)
	if destroyed then
		return false, "Menu unloaded"
	end

	-- Preempt any active AutoCollect or stalled teleport immediately
	teleportForceToken += 1
	local myForceToken = teleportForceToken
	teleportInProgress = true

	local finalOk = false
	local finalMsg = "Force Home failed"

	local runOk, runErr = pcall(function()
		local readyOk, readyErr = prepareForTeleport("Paused (Forced Home)")
		if not readyOk then
			finalMsg = readyErr
			lastHomeMsg = finalMsg
			sendNotice("Force Home", finalMsg, Color3.fromRGB(248, 113, 113))
			return
		end

		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = getRootPart()
		if not char or not hum or not root or hum.Health <= 0 then
			finalMsg = "Character not ready"
			return
		end

		-- Force-clear physics traps / ragdolls / zero-G before warping
		hum.Sit = false
		hum.PlatformStand = false
		pcall(function()
			char:SetAttribute("FallRagdoll", nil)
			char:SetAttribute("LocalLimp", nil)
			if workspace.Gravity < 100 then
				workspace.Gravity = 196.2
			end
		end)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		local curDim = LocalPlayer:GetAttribute("CurrentDimension")
		local homeDim = LocalPlayer:GetAttribute("HomeDimension")
		local homePos = LocalPlayer:GetAttribute("HomePos")
		local inOrbit = LocalPlayer:GetAttribute("InOrbit") == true
		local inOtherDim = (homeDim ~= nil and curDim ~= nil and curDim ~= homeDim) or inOrbit

		local localHouse = findLocalPlayerBase()
		if localHouse then
			local gSpot, gLook = findGarageSpot(localHouse)
			if gSpot then
				cachedGarageSpot = gSpot
				cachedGarageLook = gLook
			end
		end
		if typeof(homePos) == "Vector3" then
			cachedHomeOrigin = homePos
		end

		-- Save return spot when escaping from afar
		local originHousePos: Vector3? = if typeof(homePos) == "Vector3"
			then homePos
			elseif localHouse then localHouse:GetPivot().Position
			else cachedGarageSpot
		if inOtherDim or not originHousePos or (root.Position - originHousePos).Magnitude > 28 then
			savedReturnCFrame = root.CFrame
			savedReturnDim = curDim
		end

		local destPos: Vector3? = if localHouse then findGarageSpot(localHouse) else nil
		local lookPos: Vector3? = cachedGarageLook
		if not destPos then
			destPos = cachedGarageSpot
		end
		if not destPos and typeof(homePos) == "Vector3" then
			destPos = homePos + Vector3.new(0, 3.5 * getCharacterScale(), 0)
		end
		if not destPos and cachedHomeOrigin then
			destPos = cachedHomeOrigin + Vector3.new(0, 3.5 * getCharacterScale(), 0)
		end
		if not destPos and homeDim ~= nil then
			local wi = getWorldInfo()
			if wi and type(wi.origin) == "function" then
				local okO, wOrig = pcall(wi.origin, homeDim)
				if okO and typeof(wOrig) == "Vector3" then
					destPos = wOrig + Vector3.new(0, 5, 0)
				end
			end
		end

		if not destPos then
			-- Last resort: fire official server GoHome / CruiserHome cleanly
			if inOrbit then
				local ch = ReplicatedStorage:FindFirstChild("CruiserHome")
				if ch and ch:IsA("RemoteFunction") then
					task.spawn(function() pcall(function() ch:InvokeServer() end) end)
				end
			end
			local gh = ReplicatedStorage:FindFirstChild("GoHome")
			if gh and gh:IsA("RemoteEvent") then
				pcall(function() gh:FireServer("start") end)
			end
			finalOk = false
			finalMsg = "Home coords unavailable; triggered Server GoHome"
			lastHomeMsg = finalMsg
			return
		end

		-- Force-unveil dimension locally + dispatch server sync in parallel (0s client wait)
		if inOtherDim then
			task.spawn(function()
				if inOrbit then
					local ch = ReplicatedStorage:FindFirstChild("CruiserHome")
					if ch and ch:IsA("RemoteFunction") then
						local okC = pcall(function() ch:InvokeServer() end)
						if okC then
							return
						end
					end
				end
				local gh = ReplicatedStorage:FindFirstChild("GoHome")
				if gh and gh:IsA("RemoteEvent") then
					pcall(function() gh:FireServer("start") end)
				end
			end)
			pcall(function()
				LocalPlayer:SetAttribute("InOrbit", nil)
				if homeDim ~= nil then
					LocalPlayer:SetAttribute("CurrentDimension", homeDim)
				end
			end)
		end

		-- Unveil hidden house visibility if veiled by DimensionVisibility
		local hCheck = findLocalPlayerBase()
		if hCheck then
			if hCheck.Parent ~= workspace then
				hCheck.Parent = workspace
			end
			local gPart = hCheck:FindFirstChild("Garage")
			if gPart then
				for _, d in ipairs(gPart:GetDescendants()) do
					if d:IsA("BasePart") and d.LocalTransparencyModifier > 0.5 then
						d.LocalTransparencyModifier = 0
					end
				end
			end
		end

		-- Instant anchor + pre-stream + floor snap (Void-proof)
		root.Anchored = true
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(destPos :: Vector3, 4)
		end)
		pivotCharacterSafely((destPos :: Vector3) + Vector3.new(0, 1.5, 0), lookPos)

		sharedFloorParams.FilterDescendantsInstances = { char }
		local floorParams = sharedFloorParams

		local groundHit: RaycastResult? = nil
		local streamEnd = os.clock() + 1.0
		while not destroyed and myForceToken == teleportForceToken and os.clock() < streamEnd do
			local houseNow = findLocalPlayerBase()
			if houseNow then
				local cleanSpot, cleanLook = findGarageSpot(houseNow)
				if cleanSpot then
					destPos = cleanSpot
					lookPos = cleanLook
					cachedGarageSpot = cleanSpot
					cachedGarageLook = cleanLook
				end
			end
			groundHit = workspace:Raycast((destPos :: Vector3) + Vector3.new(0, 6, 0), Vector3.new(0, -18, 0), floorParams)
			if groundHit and groundHit.Instance then
				break
			end
			task.wait(0.04)
		end

		local scale = getCharacterScale()
		local finalSpot = if groundHit then (groundHit.Position + Vector3.new(0, 3.1 * scale, 0)) else (destPos :: Vector3)
		pivotCharacterSafely(finalSpot, lookPos)
		root = getRootPart()
		if root and root.Parent then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.Anchored = false
		end

		-- Post-warp stability lock (0.55s) prevents Void fall or leftover momentum
		task.spawn(function()
			local guardEnd = os.clock() + 0.55
			while not destroyed and myForceToken == teleportForceToken and os.clock() < guardEnd do
				local r = getRootPart()
				if not r then break end
				if (r.Position - finalSpot).Magnitude > 35 then
					break
				end
				if r.AssemblyLinearVelocity.Y < -20 then
					r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
					pivotCharacterSafely(finalSpot, lookPos)
				end
				task.wait(0.05)
			end
		end)

		finalOk = true
		finalMsg = if inOtherDim then "Forced Home (Garage) + Sync Sent" else "Force Warped to Garage!"
		lastHomeMsg = finalMsg
		sendNotice("Force Home", finalMsg, Color3.fromRGB(52, 211, 153))
	end)

	teleportInProgress = false
	if not runOk then
		local rRec = getRootPart()
		if rRec then
			rRec.Anchored = false
		end
		lastHomeMsg = "Force Home error: " .. tostring(runErr)
		return false, lastHomeMsg
	end
	return finalOk, finalMsg
end

