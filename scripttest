function Combat:SetAntiVoid(enabled: boolean)
	guardConfig.AntiVoid = enabled
	if enabled then
		local _, hum, root = getCharParts()
		if hum and root and hum.Health > 0 and not hum.SeatPart and hum.FloorMaterial ~= Enum.Material.Air then
			if isSafePointInWorld(root.Position, false) then
				lastSafeGroundCF = root.CFrame
				lastSafeGroundDim = LocalPlayer:GetAttribute("CurrentDimension")
			end
		end
	end
	refreshRuntimeLoop()
end

function Combat:SetAutoHeal(enabled: boolean, thresholdPct: number?)
	if thresholdPct ~= nil then
		self:SetHealAtPct(thresholdPct)
	end
	guardConfig.AutoHeal = enabled
	refreshRuntimeLoop()
end

function Combat:SetHealAtPct(pct: number)
	guardConfig.HealAtPct = math.clamp(math.round(pct), 15, 95)
end

