				optScroll.LayoutOrder = 2
				optScroll.Size = UDim2.new(1, 0, 0, math.min(math.max(#options, 1) * 32, 160))
				optScroll.BackgroundTransparency = 1
				optScroll.BorderSizePixel = 0
				optScroll.ScrollBarThickness = 4
				optScroll.ScrollBarImageColor3 = THEME.Stroke
				optScroll.CanvasSize = UDim2.new()
				optScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
				optScroll.Parent = optionsFrame

				local optLayout = Instance.new("UIListLayout")
				optLayout.SortOrder = Enum.SortOrder.LayoutOrder
				optLayout.Padding = UDim.new(0, 4)
				optLayout.Parent = optScroll

				local optButtons: { [string]: TextButton } = {}

				local function refreshOptionVisuals()
					selectedLbl.Text = selected
					for optName, optBtn in pairs(optButtons) do
						local isSel = (optName == selected)
						optBtn.BackgroundColor3 = if isSel then THEME.AccentDark else THEME.ControlBg
						optBtn.TextColor3 = THEME.Text
					end
				end

				local handle = {}
				function handle:Set(option: string, skipCallback: boolean?)
					if selected == option then
						return
					end
					selected = option
					refreshOptionVisuals()
					if not skipCallback and drpCfg.Callback then
						task.spawn(drpCfg.Callback, selected)
					end
				end

				function handle:Get(): string
					return selected
				end

				for i, optName in ipairs(options) do
					local optBtn = Instance.new("TextButton")
					optBtn.LayoutOrder = i
					optBtn.Size = UDim2.new(1, -6, 0, 28)
					optBtn.BackgroundColor3 = THEME.ControlBg
					optBtn.BorderSizePixel = 0
					optBtn.Font = Enum.Font.GothamMedium
					optBtn.Text = optName
					optBtn.TextSize = 12
					optBtn.TextColor3 = THEME.Text
					optBtn.TextTruncate = Enum.TextTruncate.AtEnd
					optBtn.AutoButtonColor = false
					optBtn.Parent = optScroll
					makeCorner(optBtn, 6)

					optButtons[optName] = optBtn

					track(optBtn.Activated:Connect(function()
						handle:Set(optName, false)
						open = false
						optionsFrame.Visible = false
						arrowLbl.Text = "▼"
					end))
				end

				if searchBox then
					track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
						local q = string.lower(searchBox.Text)
						for optName, optBtn in pairs(optButtons) do
							optBtn.Visible = (q == "" or string.find(string.lower(optName), q, 1, true) ~= nil)
						end
					end))
				end

				refreshOptionVisuals()

				track(headerBtn.Activated:Connect(function()
					open = not open
					optionsFrame.Visible = open
					arrowLbl.Text = if open then "▲" else "▼"
				end))

				return handle
			end

			return Tab
		end

		return Window
	end

	return RayfieldLib
end)()

