		TopbarBg = Color3.fromRGB(25, 28, 36),
		CardBg = Color3.fromRGB(29, 32, 41),
		CardHover = Color3.fromRGB(37, 41, 53),
		ControlBg = Color3.fromRGB(43, 48, 62),
