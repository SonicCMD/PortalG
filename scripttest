local frameCount = 0
local elapsed = 0
monitorConn = RunService.RenderStepped:Connect(function(dt: number)
	frameCount += 1
	elapsed += dt
	if elapsed < 0.5 then
		return
	end
	local fps = math.round(frameCount / elapsed)
	frameCount = 0
	elapsed = 0

	local memMb = math.round(Stats:GetTotalMemoryUsageMb())
	local activeCount = FixLag:GetActiveCount()
	local espState = if Esp:IsEnabled() then "BẬT" else "TẮT"

	perfStatus:Set({
		Content = ("FPS: %d | RAM: %d MB | Fix Lag: %d/4 | ESP: %s"):format(fps, memMb, activeCount, espState),
	})
	researchStatus:Set({
		Content = Automation:GetResearchStatusText(),
	})
	craftStatus:Set({
		Content = Automation:GetCraftStatusText(),
	})
end)

