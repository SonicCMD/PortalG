local function releaseLootPhysics()
	endActivePromptHold()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if char then
		pcall(function()
			if char:GetAttribute("FallRagdoll") then char:SetAttribute("FallRagdoll", nil) end
			if char:GetAttribute("LocalLimp") then char:SetAttribute("LocalLimp", nil) end
		end)
	end
	if root then
		if lootAnchoredSelf or root.Anchored then
			root.Anchored = false
		end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	lootAnchoredSelf = false
	if hum and hum.Parent then
		if hum.PlatformStand then
			hum.PlatformStand = false
		end
		if hum.Health > 0 then
			local st = hum:GetState()
			if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown then
				pcall(function()
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end)
			end
		end
	end
end

local function recoverFromLootHang(reason: string?)
	releaseLootPhysics()
	pcall(function()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not (hum and hum.SeatPart) then
			ProximityPromptService.Enabled = false
			RunService.Heartbeat:Wait()
			ProximityPromptService.Enabled = true
		end
	end)
	lastCollectMsg = reason or "Resetting prompt & physics state..."
	task.wait(0.18)
end

local function getBagCountForItem(itemId: string): number
	if itemId == "" then
		return 0
	end
	local raw = LocalPlayer:GetAttribute("Bag")
	if type(raw) ~= "string" or raw == "" then
		return 0
	end
	if raw ~= bagCacheRaw then
		bagCacheRaw = raw
		local ok, dec = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		bagCacheTbl = if ok and type(dec) == "table" then dec else {}
	end
	return tonumber(bagCacheTbl[itemId]) or 0
end

local function stopFlightSession()
	local wasFlying = flyActive
	flyActive = false
	setNoclipEnabled(false)
	endActivePromptHold()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if root then
		if lootAnchoredSelf then
			root.Anchored = false
		end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	lootAnchoredSelf = false
	if wasFlying and hum and hum.Parent then
		hum.PlatformStand = false
		if hum.Health > 0 then
			pcall(function()
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end)
		end
	end
end

local function flyTowardsTarget(targetPos, reachDist, token, targetNode, targetPrompt, isBiomeTravel): (boolean, string)
	if not startFlightSession() then
		return false, "dead"
	end

	local root0 = getRootPart()
	if not root0 then
		return false, "dead"
	end

	local maxAct = if targetPrompt then (targetPrompt.MaxActivationDistance or 10) else 10
	local hoverY = if isBiomeTravel then 18 else math.min(2.6, math.max(1.2, maxAct * 0.38))
	local finalDest = targetPos + Vector3.new(0, hoverY, 0)
	local startPos = root0.Position
	local initialFlat = ((finalDest - startPos) * Vector3.new(1, 0, 1)).Magnitude
	local useCruise = initialFlat > 45
	local extraLift = if config.MoveMode == "FlySolid" then 26 else 14
	local cruiseY = math.max(startPos.Y, finalDest.Y + extraLift)

	local lastCheck = os.clock()
	local startClock = os.clock()

	while config.AutoCollect and token == autoLoopToken and not destroyed and config.MoveMode ~= "Walk" do
		local dt = math.min(RunService.Heartbeat:Wait(), 0.08)

		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = getRootPart()
		if not char or not hum or not root or hum.Health <= 0 then
			stopFlightSession()
			return false, "dead"
		end

		if targetNode then
			if not targetNode.Parent then
				return false, "gone"
			end
			if targetPrompt and (not targetPrompt.Parent or not targetPrompt.Enabled) then
				return false, "disabled"
			end
		end

		local curPos = root.Position
		local distToNode = (targetPos - curPos).Magnitude
		local distToHover = (finalDest - curPos).Magnitude

		if isBiomeTravel then
			if distToHover <= reachDist or Vector3.new(finalDest.X - curPos.X, 0, finalDest.Z - curPos.Z).Magnitude <= reachDist then
				return true, "reached"
			end
		elseif distToHover <= math.min(3.5, reachDist) and distToNode <= reachDist then
			return true, "reached"
		end

		if os.clock() - startClock > 35 then
			return false, "timeout"
		end

		if os.clock() - lastCheck >= 0.35 then
			lastCheck = os.clock()
			hum.PlatformStand = true
			setNoclipEnabled(config.MoveMode == "FlyNoclip")

			if isBiomeTravel then
				local found = scanMatchingNodes(false)
				if #found > 0 then
					return true, "node_streamed"
				end
			elseif distToHover > 50 then
				local found = scanMatchingNodes(false)
				local best = found[1]
				if best and best.node ~= targetNode and (best.dist + 20) < distToHover then
					return false, "retarget"
				end
			end
		end

		local horizRem = Vector3.new(finalDest.X - curPos.X, 0, finalDest.Z - curPos.Z).Magnitude
		local goal = if useCruise and horizRem > 34
			then Vector3.new(finalDest.X, cruiseY, finalDest.Z)
			else finalDest

		local diff = goal - curPos
		local distToGoal = diff.Magnitude
		local nextPos = if distToGoal <= 0.05
			then goal
			else (curPos + diff.Unit * math.min(distToGoal, config.FlySpeed * dt))

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		local lookVec = Vector3.new(finalDest.X - nextPos.X, 0, finalDest.Z - nextPos.Z)
		if lookVec.Magnitude > 0.25 then
			root.CFrame = CFrame.lookAt(nextPos, nextPos + lookVec)
		else
			local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
			if flatLook.Magnitude > 0.1 then
				root.CFrame = CFrame.lookAt(nextPos, nextPos + flatLook)
			else
				root.CFrame = CFrame.new(nextPos)
			end
		end
	end

	return false, "stopped"
end

local function moveTowardsTarget(targetPos: Vector3, stopDist: number, token: number, targetNode: Instance?): boolean
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not hum or not root or hum.Health <= 0 then
		return false
	end

	if (root.Position - targetPos).Magnitude <= stopDist then
		return true
	end

	-- Try PathfindingService first when far away (>30 studs); fall back to direct MoveTo if no path is found
	local waypoints: { PathWaypoint }? = nil
	if (root.Position - targetPos).Magnitude > 30 then
		local path = PathfindingService:CreatePath({
			AgentRadius = 2.5,
			AgentHeight = 5,
			AgentCanJump = true,
			WaypointSpacing = 8,
		})
		local okPath = pcall(function()
			path:ComputeAsync(root.Position, targetPos)
		end)
		if okPath and path.Status == Enum.PathStatus.Success then
			waypoints = path:GetWaypoints()
		end
	end

	local function walkToPoint(pt: Vector3, reachDist: number, maxWait: number): boolean
		local deadline = os.clock() + maxWait
		local lastPos = root.Position
		local stuckSince = os.clock()

		hum:MoveTo(pt)
		while config.AutoCollect and token == autoLoopToken and not destroyed do
			if not root.Parent or not hum.Parent or hum.Health <= 0 then
				return false
			end
			if targetNode and (not targetNode.Parent) then
				return false
			end
			local curDist = (root.Position - pt).Magnitude
			if curDist <= reachDist then
				return true
			end
			if os.clock() > deadline then
				return false
			end
			if (root.Position - lastPos).Magnitude > 1.2 then
				lastPos = root.Position
				stuckSince = os.clock()
			elseif os.clock() - stuckSince > 1.1 then
				hum.Jump = true
				hum:MoveTo(pt)
				if os.clock() - stuckSince > 3.2 then
					return false
				end
			end
			task.wait(0.1)
		end
		return false
	end

	if waypoints and #waypoints > 1 then
		for i = 2, #waypoints do
			if not config.AutoCollect or token ~= autoLoopToken or destroyed then
				return false
			end
			local wp = waypoints[i]
			if wp.Action == Enum.PathWaypointAction.Jump then
				hum.Jump = true
			end
			local isLast = (i == #waypoints)
			local okStep = walkToPoint(wp.Position, if isLast then stopDist else 4.5, 4)
			if not okStep then
				return false
			end
			if (root.Position - targetPos).Magnitude <= stopDist then
				return true
			end
		end
		return (root.Position - targetPos).Magnitude <= (stopDist + 2)
	else
		return walkToPoint(targetPos, stopDist, 6)
	end
end

local function computeSafeLootStandPos(targetPos: Vector3, targetNode: Instance?): Vector3
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local scale = if char then math.clamp(char:GetScale(), 0.7, 2.5) else 1
	local filterList = {}
	if char then table.insert(filterList, char) end
	if targetNode then table.insert(filterList, targetNode) end
	sharedLootParams.FilterDescendantsInstances = filterList

	local offsets = {
		Vector3.new(0, 0, -3.4),
		Vector3.new(0, 0, 3.4),
		Vector3.new(3.4, 0, 0),
		Vector3.new(-3.4, 0, 0),
		Vector3.zero,
	}
	for _, off in ipairs(offsets) do
		local probe = targetPos + off
		local downHit = workspace:Raycast(probe + Vector3.new(0, 12, 0), Vector3.new(0, -24, 0), sharedLootParams)
		if downHit and downHit.Instance and downHit.Normal.Y >= 0.55 then
			local cand = downHit.Position + Vector3.new(0, 3.05 * scale, 0)
			if (cand - targetPos).Magnitude <= 8.5 then
				local upHit = workspace:Raycast(downHit.Position + Vector3.new(0, 0.6, 0), Vector3.new(0, 5.2 * scale, 0), sharedLootParams)
				if not upHit then
					return cand
				end
			end
		end
	end
	if hum and hum.Health > 0 then
		return targetPos + Vector3.new(0, 2.4 * scale, 0)
	end
	return targetPos + Vector3.new(0, 2.4, 0)
end

local function teleportToLootNode(targetPos: Vector3, token: number, targetNode: Instance?, targetPrompt: ProximityPrompt?): (boolean, string)
	if destroyed or not config.AutoCollect or token ~= autoLoopToken or config.MoveMode ~= "Teleport" then
		return false, "stopped"
	end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not char or not hum or not root or hum.Health <= 0 then
		return false, "dead"
	end
	if targetNode and not targetNode.Parent then
		return false, "gone"
	end
	if targetPrompt and (not targetPrompt.Parent or not targetPrompt.Enabled) then
		return false, "disabled"
	end
	local allowSpace = (LocalPlayer:GetAttribute("InOrbit") == true)
	local safeOk = isPositionSafeForDimension(targetPos, allowSpace)
	if not safeOk then
		return false, "unsafe"
	end

	-- Fast path: if already well inside prompt range, no teleport wait needed
	local maxAct = if targetPrompt then (targetPrompt.MaxActivationDistance or 10) else 10
	local curDist = (targetPos - root.Position).Magnitude
	if curDist <= math.max(5.5, math.min(maxAct - 1.5, 9)) then
		hum.Sit = false
		hum.PlatformStand = false
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		return true, "reached"
	end

	-- Non-blocking pre-stream burst for far jumps (>110 studs) with 0.35s timeout cap
	if curDist > 110 then
		local streamDone = false
		task.spawn(function()
			pcall(function()
				LocalPlayer:RequestStreamAroundAsync(targetPos, 1.5)
			end)
			streamDone = true
		end)
		local streamDeadline = os.clock() + 0.35
		while not streamDone and os.clock() < streamDeadline do
			if destroyed or not config.AutoCollect or token ~= autoLoopToken then
				return false, "stopped"
			end
			if targetNode and not targetNode.Parent then return false, "gone" end
			task.wait(0.03)
		end
	end

	char = LocalPlayer.Character
	hum = char and char:FindFirstChildOfClass("Humanoid")
	root = getRootPart()
	if not char or not hum or not root or hum.Health <= 0 then
		return false, "dead"
	end
	if targetNode and not targetNode.Parent then
		return false, "gone"
	end
	if targetPrompt and (not targetPrompt.Parent or not targetPrompt.Enabled) then
		return false, "disabled"
	end

	local standPos = computeSafeLootStandPos(targetPos, targetNode)
	local cam = workspace.CurrentCamera
	local relCam: CFrame? = nil
	if cam and (cam.CFrame.Position - root.Position).Magnitude <= 35 then
		relCam = root.CFrame:ToObjectSpace(cam.CFrame)
	end

	local flatTarget = Vector3.new(targetPos.X, standPos.Y, targetPos.Z)
	local destCF = if (flatTarget - standPos).Magnitude > 0.8
		then CFrame.lookAt(standPos, flatTarget)
		else (CFrame.new(standPos) * (root.CFrame - root.CFrame.Position))

	endActivePromptHold()
	hum.Sit = false
	hum.PlatformStand = false
	pcall(function()
		if char:GetAttribute("FallRagdoll") then char:SetAttribute("FallRagdoll", nil) end
		if char:GetAttribute("LocalLimp") then char:SetAttribute("LocalLimp", nil) end
	end)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	-- Keep root.Anchored = false during teleport so Roblox replicates Client->Server CFrame immediately
	char:PivotTo(destCF)
	root.Anchored = false
	lootAnchoredSelf = false
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	if cam then
		if relCam then
			local nextCamCF = root.CFrame * relCam
			local toTarget = targetPos - nextCamCF.Position
			if toTarget.Magnitude > 0.5 and nextCamCF.LookVector:Dot(toTarget.Unit) < 0.35 then
				nextCamCF = CFrame.lookAt(nextCamCF.Position, targetPos)
			end
			cam.CFrame = nextCamCF
		else
			cam.CameraType = Enum.CameraType.Custom
			cam.CameraSubject = hum
			local flatDir = Vector3.new(targetPos.X - standPos.X, 0, targetPos.Z - standPos.Z)
			local dirUnit = if flatDir.Magnitude > 0.5 then flatDir.Unit else destCF.LookVector
			local camPos = standPos - dirUnit * 11 + Vector3.new(0, 4.5, 0)
			if (targetPos - camPos).Magnitude > 0.25 then
				cam.CFrame = CFrame.lookAt(camPos, targetPos)
			end
		end
		cam.Focus = CFrame.new(targetPos)
	end

	-- Adaptive Client->Server replication + PromptShown settle (keeps velocity damped while unanchored)
	if curDist > 14 then
		local settleTime = if curDist > 60 then 0.26 elseif curDist > 28 then 0.20 else 0.14
		local settleDeadline = os.clock() + settleTime
		while os.clock() < settleDeadline do
			if not config.AutoCollect or token ~= autoLoopToken or destroyed then
				releaseLootPhysics()
				return false, "stopped"
			end
			if targetNode and not targetNode.Parent then
				releaseLootPhysics()
				return false, "gone"
			end
			if targetPrompt and (not targetPrompt.Parent or not targetPrompt.Enabled) then
				releaseLootPhysics()
				return false, "disabled"
			end
			local rNow = getRootPart()
			if rNow then
				rNow.AssemblyLinearVelocity = Vector3.zero
				rNow.AssemblyAngularVelocity = Vector3.zero
				if (rNow.Position - standPos).Magnitude > 4.0 and char.Parent then
					char:PivotTo(destCF)
					rNow.AssemblyLinearVelocity = Vector3.zero
				end
			end
			task.wait(0.03)
		end
	end

	if not config.AutoCollect or token ~= autoLoopToken or destroyed then
		releaseLootPhysics()
		return false, "stopped"
	end
	if targetNode and not targetNode.Parent then
		releaseLootPhysics()
		return false, "gone"
	end
	if targetPrompt and (not targetPrompt.Parent or not targetPrompt.Enabled) then
		releaseLootPhysics()
		return false, "disabled"
	end

	return true, "reached"
end

local function fireOrHoldPrompt(prompt: ProximityPrompt, shouldContinue: () -> boolean, acceptDisabledAsSuccess: boolean?, itemIdForBagCheck: string?): boolean
	if not prompt or not prompt.Parent or not prompt.Enabled then
		return false
	end

	-- Clear any stuck prompt from previous interaction before starting
	endActivePromptHold()

	local triggered = false
	local hiddenOrGone = false
	local bagBefore = if itemIdForBagCheck and itemIdForBagCheck ~= "" then getBagCountForItem(itemIdForBagCheck) else 0

	local connTrig = prompt.Triggered:Connect(function()
		triggered = true
	end)
	local connHidden = prompt.PromptHidden:Connect(function()
		if not prompt.Parent or not prompt.Enabled then
			hiddenOrGone = true
		end
	end)

	local origLOS = prompt.RequiresLineOfSight
	local origExcl = prompt.Exclusivity
	local origMaxDist = prompt.MaxActivationDistance
	local pParent = prompt.Parent
	local pWorldPos: Vector3? = if pParent:IsA("Attachment")
		then pParent.WorldPosition
		elseif pParent:IsA("BasePart") then pParent.Position
		else nil
	local rootPart = getRootPart()
	local rootPos: Vector3? = if rootPart then rootPart.Position else nil
	local neededDist = if rootPos and pWorldPos then math.max(12, (pWorldPos - rootPos).Magnitude + 4.5) else 14
	local bumpedDist = false

	local function ensurePromptReachable()
		if prompt.Parent and prompt.MaxActivationDistance < neededDist then
			pcall(function()
				prompt.MaxActivationDistance = neededDist
			end)
			bumpedDist = true
		end
	end

	pcall(function()
		if not ProximityPromptService.Enabled then
			local ch = LocalPlayer.Character
			local hm = ch and ch:FindFirstChildOfClass("Humanoid")
			if not (hm and hm.SeatPart) then
				ProximityPromptService.Enabled = true
			end
		end
		prompt.RequiresLineOfSight = false
		prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	end)
	local function getPromptWorldPosNow(): Vector3?
		local prt = prompt.Parent
		if not prt then
			return nil
		end
		if prt:IsA("Attachment") then
			return prt.WorldPosition
		elseif prt:IsA("BasePart") then
			return prt.Position
		elseif prt:IsA("Model") then
			return prt:GetPivot().Position
		end
		local baseAnc = prompt:FindFirstAncestorWhichIsA("BasePart")
		if baseAnc then
			return baseAnc.Position
		end
		local mdlAnc = prompt:FindFirstAncestorWhichIsA("Model")
		return if mdlAnc then mdlAnc:GetPivot().Position else nil
	end
	local camAdjusted = false
	pcall(function()
		local cam = workspace.CurrentCamera
		local ch = LocalPlayer.Character
		local hm = ch and ch:FindFirstChildOfClass("Humanoid")
		local rt = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
		local pPos = getPromptWorldPosNow()
		if cam and rt and pPos then
			local toPrompt = pPos - cam.CFrame.Position
			local camFar = toPrompt.Magnitude > 40
			local camFacingAway = toPrompt.Magnitude > 0.5 and cam.CFrame.LookVector:Dot(toPrompt.Unit) < 0.25
			if camFar or camFacingAway then
				if cam.CameraType ~= Enum.CameraType.Custom then
					cam.CameraType = Enum.CameraType.Custom
				end
				if hm and cam.CameraSubject ~= hm then
					cam.CameraSubject = hm
				end
				if camFar then
					local flatDir = Vector3.new(pPos.X - rt.Position.X, 0, pPos.Z - rt.Position.Z)
					local dirUnit = if flatDir.Magnitude > 0.5 then flatDir.Unit else rt.CFrame.LookVector
					local camPos = rt.Position - dirUnit * 11 + Vector3.new(0, 4.5, 0)
					if (pPos - camPos).Magnitude > 0.25 then
						cam.CFrame = CFrame.lookAt(camPos, pPos)
						camAdjusted = true
					end
				elseif (pPos - cam.CFrame.Position).Magnitude > 0.25 then
					cam.CFrame = CFrame.lookAt(cam.CFrame.Position, pPos)
					camAdjusted = true
				end
				cam.Focus = CFrame.new(pPos)
			end
		end
	end)
	if camAdjusted then
		task.wait()
	end
	ensurePromptReachable()

	local firePromptFn = resolveFirePromptFn()
	local holdDur = prompt.HoldDuration or 0
	local hardDeadline = os.clock() + math.clamp(holdDur + 1.4, 1.1, 4.5)

	if (bumpedDist or origMaxDist <= 0.2 or origExcl ~= Enum.ProximityPromptExclusivity.AlwaysShow) and not firePromptFn then
		RunService.Heartbeat:Wait()
		ensurePromptReachable()
	end

	local function isPickedUp(): boolean
		if triggered or hiddenOrGone or not prompt.Parent or not prompt.Enabled then
			return true
		end
		if itemIdForBagCheck and itemIdForBagCheck ~= "" then
			if getBagCountForItem(itemIdForBagCheck) > bagBefore then
				return true
			end
		end
		return false
	end

	-- Phase 1: Try instant executor trigger if supported (skip direct instant retry on hold>0 if previously ignored)
	if firePromptFn and (holdDur <= 0.05 or not holdNeedsRealHold) then
		if shouldContinue() and prompt.Parent and prompt.Enabled and os.clock() < hardDeadline then
			ensurePromptReachable()
			pcall(firePromptFn, prompt)
			local fastWaitEnd = os.clock() + (if holdDur <= 0.05 then 0.14 else 0.11)
			while os.clock() < fastWaitEnd and os.clock() < hardDeadline do
				if isPickedUp() or not shouldContinue() then
					break
				end
				ensurePromptReachable()
				task.wait(0.02)
			end
			if holdDur > 0.05 and not isPickedUp() then
				holdNeedsRealHold = true
			end
		end
	end

	-- Phase 2: Native InputHoldBegin -> HoldDuration -> InputHoldEnd (guarded by hardDeadline)
	if not isPickedUp() and shouldContinue() and os.clock() < hardDeadline then
		ensurePromptReachable()
		activeHeldPrompt = prompt
		pcall(function()
			prompt:InputHoldBegin()
		end)
		local targetHold = math.max(0.06, holdDur + 0.08)
		local endWait = math.min(hardDeadline - 0.12, os.clock() + targetHold)
		while os.clock() < endWait do
			if isPickedUp() or not shouldContinue() then
				break
			end
			ensurePromptReachable()
			task.wait(0.03)
		end
		endActivePromptHold()

		local settleEnd = math.min(hardDeadline, os.clock() + 0.12)
		while os.clock() < settleEnd do
			if isPickedUp() or not shouldContinue() then
				break
			end
			task.wait(0.03)
		end

		-- Fast 1-tick retry for instant prompts if first InputHoldBegin happened on frame transition
		if not isPickedUp() and holdDur <= 0.05 and shouldContinue() and prompt.Parent and prompt.Enabled and os.clock() + 0.16 < hardDeadline then
			RunService.Heartbeat:Wait()
			ensurePromptReachable()
			activeHeldPrompt = prompt
			pcall(function() prompt:InputHoldBegin() end)
			local rEnd = math.min(hardDeadline, os.clock() + 0.07)
			while os.clock() < rEnd do
				if isPickedUp() or not shouldContinue() then break end
				task.wait(0.02)
			end
			endActivePromptHold()
		end
	end

	endActivePromptHold()
	pcall(function()
		if prompt.Parent then
			prompt.RequiresLineOfSight = origLOS
			prompt.Exclusivity = origExcl
			if bumpedDist and origMaxDist > 0.5 then
				prompt.MaxActivationDistance = origMaxDist
			end
		end
	end)
	connTrig:Disconnect()
	connHidden:Disconnect()

	if triggered then
		return true
	end
	if itemIdForBagCheck and itemIdForBagCheck ~= "" and getBagCountForItem(itemIdForBagCheck) > bagBefore then
		return true
	end
	if acceptDisabledAsSuccess then
		return (not prompt.Enabled) or (not prompt.Parent)
	end
	return false
end

local function confirmResourceLooted(targetInfo, beforeBag: number): boolean
	local itemId = tostring(targetInfo.itemId or "")
	local node = targetInfo.node
	local prompt = targetInfo.prompt
	local function hasLootEvidence(): boolean
		if not node or not node.Parent then
			return true
		end
		if not prompt or not prompt.Parent or not prompt.Enabled then
			return true
		end
		if itemId ~= "" and getBagCountForItem(itemId) > beforeBag then
			return true
		end
		return false
	end
	if hasLootEvidence() then
		return true
	end
	-- Wait briefly (up to 0.22s) for Server replication of Destroy/Enabled=false/Bag after Triggered
	local deadline = os.clock() + 0.22
	while os.clock() < deadline do
		if destroyed or not config.AutoCollect then
			return false
		end
		if hasLootEvidence() then
			return true
		end
		task.wait(0.025)
	end
	return false
end

local function triggerPromptSafe(targetInfo, token: number): boolean
	local prompt = targetInfo.prompt
	if not prompt or not prompt.Parent or not prompt.Enabled then
		return false
	end

	local function stillActive(): boolean
		return (not destroyed) and config.AutoCollect and (token == autoLoopToken)
	end

	local beforeBag = if targetInfo.itemId and targetInfo.itemId ~= "" then getBagCountForItem(targetInfo.itemId) else 0

	-- In Fly modes maintain hover stability during HoldDuration; in Teleport mode root is already safely Anchored!
	local hoverConn = nil
	if config.MoveMode ~= "Walk" and config.MoveMode ~= "Teleport" then
		local maxAct = prompt.MaxActivationDistance or 10
		local hoverY = math.min(2.6, math.max(1.2, maxAct * 0.38))
		local hoverPos = targetInfo.pos + Vector3.new(0, hoverY, 0)
		hoverConn = RunService.Heartbeat:Connect(function()
			if not stillActive() or config.MoveMode == "Walk" or config.MoveMode == "Teleport" then
				return
			end
			local root = getRootPart()
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
				local lookVec = Vector3.new(targetInfo.pos.X - root.Position.X, 0, targetInfo.pos.Z - root.Position.Z)
				if lookVec.Magnitude > 0.2 then
					root.CFrame = CFrame.lookAt(hoverPos, hoverPos + lookVec)
				else
					root.CFrame = CFrame.new(hoverPos)
				end
			end
		end)
	end

	local confirmed = false
	local maxAttempts = if config.MoveMode == "Teleport" then 2 else 1
	local nodeObj = targetInfo.node
	local itemKey = tostring(targetInfo.itemId or "")
	for attempt = 1, maxAttempts do
		if (not nodeObj or not nodeObj.Parent) or not prompt.Parent or not prompt.Enabled or (itemKey ~= "" and getBagCountForItem(itemKey) > beforeBag) then
			confirmed = true
			break
		end
		if not stillActive() then
			break
		end
		if attempt > 1 then
			-- Wait briefly in-place so delayed ServerHRP replication finishes before retry
			local waitEnd = os.clock() + 0.16
			while os.clock() < waitEnd and stillActive() and prompt.Parent and prompt.Enabled do
				local rNow = getRootPart()
				if rNow then
					rNow.AssemblyLinearVelocity = Vector3.zero
					rNow.AssemblyAngularVelocity = Vector3.zero
				end
				task.wait(0.03)
			end
			if (not nodeObj or not nodeObj.Parent) or not prompt.Parent or not prompt.Enabled or (itemKey ~= "" and getBagCountForItem(itemKey) > beforeBag) then
				confirmed = true
				break
			end
			if not stillActive() then
				break
			end
		end

		fireOrHoldPrompt(prompt, stillActive, true, targetInfo.itemId)
		if confirmResourceLooted(targetInfo, beforeBag) then
			confirmed = true
			break
		end
	end

	if hoverConn then
		hoverConn:Disconnect()
		hoverConn = nil
	end
	if config.MoveMode == "Teleport" then
		releaseLootPhysics()
	end
	return confirmed
end

function Material:ScanNow(): string
	local matches, countsByName = scanMatchingNodes(true)
	local first = matches[1]
	if first then
		lastSummaryText = ("Found %d • Nearest: %s (%.0fm)"):format(#matches, first.name, first.dist)
		return lastSummaryText
	end
	local root = getRootPart()
	local biomeKey = WILD_BIOMES[config.SelectedItem]
	if root and biomeKey then
		local _, bDist = findNearestBiomeTarget(biomeKey, root.Position)
		if bDist then
			lastSummaryText = ("Direction to %s: %.0fm"):format(BIOME_LABELS[biomeKey] or biomeKey, bDist)
			return lastSummaryText
		end
	end
	local countTypes = 0
	for _ in pairs(countsByName) do
		countTypes += 1
	end
	if countTypes > 0 then
		lastSummaryText = ("No %s nearby (%d other types around)."):format(getItemMeta(config.SelectedItem), countTypes)
	else
		lastSummaryText = "No materials found within scan radius."
	end
	return lastSummaryText
end

