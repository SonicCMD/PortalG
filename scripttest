local function tryUseBestHeal(hpPct: number)
	local now = os.clock()
	if now - lastRegenClock >= 2.6 then
		lastRegenClock = now
		local reqRegen = ReplicatedStorage:FindFirstChild("RequestRegen")
		if reqRegen and reqRegen:IsA("RemoteEvent") then
			pcall(function()
				reqRegen:FireServer()
			end)
		end
	end

	local bag = decodeAttrTable("Bag")
	local char, hum = getCharParts()
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	local useItem = ReplicatedStorage:FindFirstChild("UseItem")

	for _, itemId in ipairs(HEAL_ITEMS) do
		if now - (lastItemClock[itemId] or 0) >= 5.0 then
			local inBag = (tonumber(bag[itemId]) or 0) > 0
			local toolObj = (char and char:FindFirstChild(itemId)) or (bp and bp:FindFirstChild(itemId))
			if inBag or toolObj then
				lastItemClock[itemId] = now
				if useItem and useItem:IsA("RemoteEvent") then
					pcall(function()
						useItem:FireServer(itemId)
					end)
				end
				if toolObj and toolObj:IsA("Tool") and char and hum and hum.Health > 0 then
					pcall(function()
						if toolObj.Parent ~= char then
							hum:EquipTool(toolObj)
						end
						toolObj:Activate()
					end)
				end
				break
			end
		end
	end
end

local function stepGuardian(dt: number)
	guardAcc += dt
	if guardAcc < guardInterval then
		return
	end
	guardAcc = 0

	local char, hum, root = getCharParts()
	if not char or not hum or not root or hum.Health <= 0 then
		return
	end

	local curDim = LocalPlayer:GetAttribute("CurrentDimension")
	local inOrbit = LocalPlayer:GetAttribute("InOrbit") == true
	local inLava = LocalPlayer:GetAttribute("InLava") == true
	local exposure = tonumber(LocalPlayer:GetAttribute("Exposure")) or 0
	local starHeat = tonumber(LocalPlayer:GetAttribute("StarHeat")) or 0
	local hpPct = (hum.Health / math.max(1, hum.MaxHealth)) * 100

	-- Track safe ground checkpoint whenever upright on solid floor
	if not hum.SeatPart and hum.FloorMaterial ~= Enum.Material.Air and not inLava and exposure < 65 then
		local okSafe = isSafePointInWorld(root.Position, false)
		if okSafe then
			lastSafeGroundCF = root.CFrame
			lastSafeGroundDim = curDim
		end
	end

	-- 1) Emergency Force-Home before dying or melting in hazard/void
	if guardConfig.AutoEscapeHome then
		local hazardCrit = guardConfig.EscapeOnHazard and (inLava or exposure >= 85 or starHeat >= 0.85)
		if (hpPct <= guardConfig.EscapeAtPct) or hazardCrit then
			if guardConfig.AutoHeal and hpPct <= guardConfig.HealAtPct then
				tryUseBestHeal(hpPct)
			end
			if os.clock() - lastEscapeClock >= 4.5 then
				lastEscapeClock = os.clock()
				if mobConfig.AutoHunt then
					Combat:SetAutoHunt(false)
				end
				if missionConfig.AutoEnabled then
					Combat:SetAutoMission(false)
				end
				if stateSyncCallback then
					task.defer(stateSyncCallback)
				end
				task.spawn(function()
					if matMod and type(matMod.ForceSendHomeNow) == "function" then
						matMod:ForceSendHomeNow()
					else
						local goHome = ReplicatedStorage:FindFirstChild("GoHome")
						if goHome and goHome:IsA("RemoteEvent") then
							pcall(function() goHome:FireServer("start") end)
						end
						local ch = ReplicatedStorage:FindFirstChild("CruiserHome")
						if ch and ch:IsA("RemoteFunction") then
							pcall(function() ch:InvokeServer() end)
						end
					end
				end)
				return
			end
		end
	end

	-- 2) Anti-Void, Fall-Damage Softener, Lava Lift, Ragdoll Recovery
	if guardConfig.AntiVoid then
		pcall(function()
			if char:GetAttribute("FallRagdoll") then
				char:SetAttribute("FallRagdoll", nil)
			end
			if char:GetAttribute("LocalLimp") then
				char:SetAttribute("LocalLimp", nil)
			end
		end)
		if hum.PlatformStand and not hum.SeatPart then
			hum.PlatformStand = false
		end

		if inLava then
			root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 45, root.AssemblyLinearVelocity.Z)
			root.CFrame = root.CFrame + Vector3.new(0, 6, 0)
		end

		local vel = root.AssemblyLinearVelocity
		if vel.Y < -60 then
			local rp = getSafeRayParams(char)
			local nearGround = workspace:Raycast(root.Position, Vector3.new(0, -16, 0), rp)
			if nearGround then
				root.AssemblyLinearVelocity = Vector3.new(vel.X, -22, vel.Z)
			end
		end

		local needVoidRescue = false
		if not inOrbit and not hum.SeatPart and LocalPlayer:GetAttribute("JetsFlying") ~= true then
			local safeCheck = if matMod and type(matMod.IsPositionSafeForMove) == "function"
				then select(1, matMod:IsPositionSafeForMove(root.Position, false))
				else (root.Position.Y > -20500)
			local dimAlt = if matMod and type(matMod.GetDimensionAltitude) == "function"
				then matMod:GetDimensionAltitude(root.Position)
				else nil
			if not safeCheck then
				needVoidRescue = true
			else
				local rp = getSafeRayParams(char)
				if dimAlt and dimAlt < -220 then
					local floorHit = workspace:Raycast(root.Position + Vector3.new(0, 8, 0), Vector3.new(0, -320, 0), rp)
					if not floorHit then
						needVoidRescue = true
					end
				elseif vel.Y < -45 then
					local below = workspace:Raycast(root.Position, Vector3.new(0, -550, 0), rp)
					if not below then
						needVoidRescue = true
					end
				end
			end
		end

		if needVoidRescue then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			if lastSafeGroundCF and (lastSafeGroundDim == nil or curDim == lastSafeGroundDim) then
				char:PivotTo(lastSafeGroundCF + Vector3.new(0, 2.5, 0))
				sendNotice("Guardian", "Rescued from Void fall!", Color3.fromRGB(52, 211, 153))
			elseif matMod and type(matMod.ForceSendHomeNow) == "function" then
				task.spawn(function()
					matMod:ForceSendHomeNow()
				end)
			end
		end
	end

	-- 3) Auto-Heal + Regen + Body-Armor Goo
	if guardConfig.AutoHeal and hpPct <= guardConfig.HealAtPct then
		tryUseBestHeal(hpPct)
	end
end

