function Material:GetHomeStatusText(): string
	local curDim = tostring(LocalPlayer:GetAttribute("CurrentDimension") or "C137")
	local homeDimAttr = LocalPlayer:GetAttribute("HomeDimension")
	local homeDim = if homeDimAttr ~= nil then tostring(homeDimAttr) else curDim

	local distText = "Not found"
	local root = getRootPart()
	local house = findLocalPlayerBase()
	local targetPos: Vector3? = nil
	if house then
		local garage = house:FindFirstChild("Garage") or house:FindFirstChild("Garage", true)
		if garage then
			local okG, gcf = pcall(function()
				return if garage:IsA("BasePart") then garage.CFrame else (garage :: Model):GetPivot()
			end)
			if okG and gcf then
				targetPos = gcf.Position
			end
		end
	end
	if targetPos and (homeDimAttr == nil or curDim == homeDim) then
		cachedGarageSpot = findGarageSpot(house) or targetPos
	end
	if not targetPos then
		local hp = LocalPlayer:GetAttribute("HomePos")
		if typeof(hp) == "Vector3" then
			targetPos = hp
			cachedHomeOrigin = hp
		end
	end

	if homeDimAttr ~= nil and curDim ~= homeDim then
		distText = "Other Dimension"
	elseif root and targetPos then
		local dist = math.floor((targetPos - root.Position).Magnitude)
		if dist <= 22 then
			distText = ("Inside / At Garage (%d m)"):format(dist)
		else
			distText = ("%d m away"):format(dist)
		end
	end

	return ("Home Dim: %s | Current: %s | Garage: %s\nStatus: %s"):format(homeDim, curDim, distText, lastHomeMsg)
end

function Material:TeleportToHome(useServerOnly: boolean?): (boolean, string)
	if destroyed then
		return false, "Menu unloaded"
	end
	if teleportInProgress then
		return false, "Teleport already in progress"
	end
	teleportInProgress = true

	local finalOk = false
	local finalMsg = "Teleport failed"

	local runOk, runErr = pcall(function()
		if config.AutoCollect then
			config.AutoCollect = false
			autoLoopToken += 1
			lastCollectMsg = "Disabled (Teleported Home)"
			if beforeTeleportCallback then
				pcall(beforeTeleportCallback)
			end
			refreshLoopState()
		end
		stopFlightSession()

		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = getRootPart()
		if not char or not hum or not root or hum.Health <= 0 then
			finalOk = false
			finalMsg = "Character not ready"
			lastHomeMsg = finalMsg
			sendNotice("Teleport to Home", finalMsg, Color3.fromRGB(248, 113, 113))
			return
		end

		if hum.Sit or hum.SeatPart then
			hum.Sit = false
			task.wait(0.08)
		end

		local curDim = LocalPlayer:GetAttribute("CurrentDimension")
		local homeDim = LocalPlayer:GetAttribute("HomeDimension")
		local homePos = LocalPlayer:GetAttribute("HomePos")
		local inOrbit = LocalPlayer:GetAttribute("InOrbit") == true
		local inOtherDim = (homeDim ~= nil and curDim ~= nil and curDim ~= homeDim) or inOrbit

		if useServerOnly == true or inOtherDim then
			local goHome = ReplicatedStorage:FindFirstChild("GoHome")
			if goHome and goHome:IsA("RemoteEvent") then
				pcall(function()
					goHome:FireServer("start")
				end)
				if useServerOnly == true then
					lastHomeMsg = "Server GoHome triggered"
					finalOk = true
					finalMsg = lastHomeMsg
					sendNotice("Server Go Home", "Sent official GoHome request to server.", Color3.fromRGB(56, 189, 248))
					return
				end

				lastHomeMsg = "Returning to Home dimension via GoHome..."
				sendNotice("Teleport to Home", lastHomeMsg, Color3.fromRGB(56, 189, 248))

				local waitStart = os.clock()
				while not destroyed and os.clock() - waitStart < 8.5 do
					task.wait(0.2)
					local nowDim = LocalPlayer:GetAttribute("CurrentDimension")
					local nowOrbit = LocalPlayer:GetAttribute("InOrbit") == true
					if (homeDim == nil or nowDim == homeDim) and not nowOrbit and findLocalPlayerBase() then
						break
					end
				end
			elseif useServerOnly == true then
				finalOk = false
				finalMsg = "GoHome remote not found"
				lastHomeMsg = finalMsg
				sendNotice("Server Go Home", finalMsg, Color3.fromRGB(248, 113, 113))
				return
			end
		end

		local stillOtherDim = (homeDim ~= nil and LocalPlayer:GetAttribute("CurrentDimension") ~= nil and LocalPlayer:GetAttribute("CurrentDimension") ~= homeDim)
			or (LocalPlayer:GetAttribute("InOrbit") == true)
		local house = findLocalPlayerBase()
		if stillOtherDim and not house then
			finalOk = false
			finalMsg = "GoHome sent; waiting for Home dimension to load"
			lastHomeMsg = finalMsg
			sendNotice("Teleport to Home", finalMsg, Color3.fromRGB(250, 204, 21))
			return
		end

		if not house and typeof(homePos) == "Vector3" then
			lastHomeMsg = "Streaming Home / Garage..."
			pcall(function()
				LocalPlayer:RequestStreamAroundAsync(homePos, 5)
			end)
			pivotCharacterSafely(homePos + Vector3.new(0, 6, 0), nil)
			root = getRootPart()
			if root then
				root.Anchored = true
				local streamStart = os.clock()
				while not destroyed and os.clock() - streamStart < 1.8 do
					house = findLocalPlayerBase()
					if house and (house:FindFirstChild("Garage") or house:FindFirstChild("Garage", true)) then
						break
					end
					task.wait(0.15)
				end
				if root.Parent then
					root.Anchored = false
				end
			end
		end

		local destPos, lookPos, spotLabel = findGarageSpot(house)
		if not destPos and typeof(homePos) == "Vector3" then
			local scale = getCharacterScale()
			destPos = homePos + Vector3.new(0, 4 * scale, 0)
			spotLabel = "Home Position"
		end

		if not destPos then
			finalOk = false
			finalMsg = "Home / Garage not found in workspace"
			lastHomeMsg = finalMsg
			sendNotice("Teleport to Home", finalMsg, Color3.fromRGB(248, 113, 113))
			return
		end

		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(destPos, 3)
		end)
		local moved = pivotCharacterSafely(destPos, lookPos)
		if not moved then
			finalOk = false
			finalMsg = "Failed to move character"
			lastHomeMsg = finalMsg
			sendNotice("Teleport to Home", finalMsg, Color3.fromRGB(248, 113, 113))
			return
		end

		RunService.Heartbeat:Wait()
		local rAfter = getRootPart()
		local cAfter = LocalPlayer.Character
		local hAfter = cAfter and cAfter:FindFirstChildOfClass("Humanoid")
		if rAfter then
			rAfter.Anchored = false
			rAfter.AssemblyLinearVelocity = Vector3.zero
			rAfter.AssemblyAngularVelocity = Vector3.zero
		end
		if hAfter then
			hAfter.PlatformStand = false
		end

		lastHomeMsg = "Teleported to " .. spotLabel
		finalOk = true
		finalMsg = lastHomeMsg
		sendNotice("Teleport to Home", "Arrived at " .. spotLabel .. ".", Color3.fromRGB(52, 211, 153))
	end)

	teleportInProgress = false
	if not runOk then
		local rRecover = getRootPart()
		if rRecover then
			rRecover.Anchored = false
		end
		lastHomeMsg = "Error: " .. tostring(runErr)
		return false, lastHomeMsg
	end
	return finalOk, finalMsg
end

