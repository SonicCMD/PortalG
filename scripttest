				selectTab(page)
			end

			local elemOrder = 0
			local function nextOrder(): number
				elemOrder += 1
				return elemOrder
			end

			local Tab = {}

			function Tab:CreateSection(sectionTitle: string)
				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(1, 0, 0, 22)
				label.LayoutOrder = nextOrder()
				label.BackgroundTransparency = 1
