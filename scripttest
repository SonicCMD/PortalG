		craftConfig.SelectedId = labelToId[options[1]] or ""
	end
	return options, labelToId
end

function Automation:GetCraftReadinessForItem(itemId: string): (boolean, string?, string?, string?)
	initInventorySync()
	refreshStash(false, false)
	local gd = getGameData()
	local recipe = findRecipeById(itemId)
	if not gd or not recipe then
		return false, nil, "Recipe not found for " .. tostring(itemId), nil
	end
	local reqResearch = gd.RecipeResearch and gd.RecipeResearch[recipe.id]
	if reqResearch and not knowsRecipe(gd, recipe) then
		return false, nil, "Research locked: " .. tostring(reqResearch), recipe.id
	end
	if hasInventoryData and type(recipe.ingredients) == "table" then
		for _, ing in ipairs(recipe.ingredients) do
			local need = ing.count or 1
			if totalOwned(ing.item) < need then
				return false, ing.item, ("Need %d more %s"):format(need - totalOwned(ing.item), tostring(ing.item)), recipe.id
			end
		end
	end
	local nearBench = getWorkbenchProximity()
	if not nearBench then
		return false, nil, "Need Workbench", recipe.id
	end
	return true, nil, "Ready", recipe.id
end

function Automation:GetCraftStatusText(): string
	initInventorySync()
	refreshStash(false, false)
	local gd = getGameData()
	if not gd or type(gd.Recipes) ~= "table" then
		return "GameData.Recipes not loaded"
	end
	local recipe = findRecipeById(craftConfig.SelectedId)
	if not recipe then
		return "No recipe selected"
	end

	local itemMeta = gd.Items and gd.Items[recipe.result]
	local display = if itemMeta and itemMeta.name then itemMeta.name else tostring(recipe.result or recipe.id)
	local unlocked = knowsRecipe(gd, recipe)
	local afford = if hasInventoryData then getAffordCount(recipe) else 0
	local owned = inventory[recipe.result] or 0
	local stashed = stash[recipe.result] or 0
	local _, benchStatus = getWorkbenchProximity()

	local craftableText = if not hasInventoryData
		then "Syncing Bag..."
		elseif afford > 0 then ("Up to %dx"):format(afford)
		else getMissingIngredientsSummary(gd, recipe)

	return ("Item: %s (Bag: %d | Stash: %d)\nUnlocked: %s | Bench: %s\nCraftable: %s\nStatus: %s"):format(
		display,
		owned,
		stashed,
		if unlocked then "Yes" else "No",
		benchStatus,
		craftableText,
		lastCraftMsg
	)
end

function Automation:Destroy()
	destroyed = true
	researchConfig.AutoEnabled = false
	craftConfig.AutoEnabled = false
	craftConfig.FastAssemble = false
	researchLoopToken += 1
	craftLoopToken += 1
