function Combat:EnableAllGameProtections(): (boolean, string)
	local pt = ReplicatedStorage:FindFirstChild("ProtectionToggle")
	if not pt or not pt:IsA("RemoteFunction") then
		return false, "ProtectionToggle remote not found"
	end
	local okCall, okRes, msgRes = pcall(function()
		return pt:InvokeServer("all", nil, true)
	end)
	if not okCall then
		return false, "Error: " .. tostring(okRes)
	end
	if okRes == false then
		return false, tostring(msgRes or "No unlocked protections yet")
	end
	return true, "Enabled all unlocked protections"
end

