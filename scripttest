	local function isResearchEligible(
		entry: any,
		known: { [string]: any },
		built: { [string]: any },
		researching: { [string]: any },
		researchingMore: { [string]: any },
		geniusLevel: number,
		geniusCap: number,
		qi: number,
		parallelLab: boolean
	): (boolean, string)
		if type(entry) ~= "table" or not entry.id then
			return false, "Dữ liệu không hợp lệ"
		end
		if known[entry.id] then
			return false, "Đã nghiên cứu xong"
		end
		if researching.id == entry.id or researchingMore[entry.id] ~= nil then
			return false, "Đang trong quá trình nghiên cứu"
		end
		if not parallelLab and researching.id ~= nil then
			return false, "Đang có nghiên cứu khác chạy"
		end
		if not built.Workbench then
			return false, "Chưa xây Workbench"
		end

		local reqLevel = entry.level or 1
		if reqLevel > geniusCap then
			return false, "Cần hạ Boss để mở giới hạn Level"
		end
		if reqLevel > geniusLevel then
			return false, ("Cần Genius Level %d (hiện tại %d)"):format(reqLevel, geniusLevel)
		end

		for _, reqId in ipairs(entry.requires or {}) do
			if not known[reqId] then
				return false, ("Thiếu research tiên quyết: %s"):format(tostring(reqId))
			end
		end

		local reqQi = entry.qi or 0
		if qi < reqQi then
			return false, ("Thiếu IQ (%d/%d)"):format(qi, reqQi)
		end

		if researchConfig.CheckItems and type(entry.items) == "table" then
			for _, cost in ipairs(entry.items) do
				local have = totalOwned(cost.item)
				if have < cost.count then
					return false, ("Thiếu %s (%d/%d)"):format(tostring(cost.item), have, cost.count)
				end
			end
		end

		return true, "Sẵn sàng"
	end

	local function pickEligibleResearch(): any?
		local gd = getGameData()
		if not gd or type(gd.Research) ~= "table" then
			return nil
		end

		refreshStash(false)

		local known = decodeAttrTable("Research")
		local built = decodeAttrTable("Built")
		local researching = decodeAttrTable("Researching")
		local researchingMore = decodeAttrTable("ResearchingMore")
		local parallelLab = LocalPlayer:GetAttribute("ParallelLab") == true
		local qi = tonumber(LocalPlayer:GetAttribute("QI")) or 0
		local totalQi = tonumber(LocalPlayer:GetAttribute("TotalQI")) or 0
		local geniusCap = tonumber(LocalPlayer:GetAttribute("GeniusCap")) or 45
		local geniusLevel = if gd.GeniusLevel then gd.GeniusLevel(totalQi) else 1

		local candidates: { any } = {}
		for _, entry in ipairs(gd.Research) do
			local ok = isResearchEligible(
				entry,
				known,
				built,
				researching,
				researchingMore,
				geniusLevel,
				geniusCap,
				qi,
				parallelLab
			)
			if ok then
				table.insert(candidates, entry)
			end
		end

		if #candidates == 0 then
			return nil
		end

		table.sort(candidates, function(a: any, b: any)
			local la = a.level or 1
			local lb = b.level or 1
			if la ~= lb then
				return la < lb
			end
			return (a.qi or 0) < (b.qi or 0)
		end)

		return candidates[1]
	end

	function AutomationModule:RunResearchOnce(targetId: string?): (boolean, string)
		if researchBusy then
			return false, "Đang xử lý yêu cầu Research..."
		end

		local gd = getGameData()
		if not gd or type(gd.Research) ~= "table" then
			return false, "Không tìm thấy GameData.Research"
		end

		local progressAction = ReplicatedStorage:FindFirstChild("ProgressAction")
		if not progressAction or not progressAction:IsA("RemoteFunction") then
			return false, "Không tìm thấy RemoteFunction ProgressAction"
		end

		initInventorySync()
		refreshStash(true)

		local chosenEntry: any = nil
		if targetId and targetId ~= "" then
			chosenEntry = gd.ResearchById and gd.ResearchById[targetId]
			if not chosenEntry then
				for _, r in ipairs(gd.Research) do
					if r.id == targetId then
						chosenEntry = r
						break
					end
				end
			end
			if not chosenEntry then
				return false, "Không tìm thấy Research: " .. tostring(targetId)
			end

			local known = decodeAttrTable("Research")
			local built = decodeAttrTable("Built")
			local researching = decodeAttrTable("Researching")
			local researchingMore = decodeAttrTable("ResearchingMore")
			local parallelLab = LocalPlayer:GetAttribute("ParallelLab") == true
			local qi = tonumber(LocalPlayer:GetAttribute("QI")) or 0
			local totalQi = tonumber(LocalPlayer:GetAttribute("TotalQI")) or 0
			local geniusCap = tonumber(LocalPlayer:GetAttribute("GeniusCap")) or 45
			local geniusLevel = if gd.GeniusLevel then gd.GeniusLevel(totalQi) else 1

			local eligible, reason = isResearchEligible(
				chosenEntry,
				known,
				built,
				researching,
				researchingMore,
				geniusLevel,
				geniusCap,
				qi,
				parallelLab
			)
			if not eligible then
				return false, reason
			end
		else
			chosenEntry = pickEligibleResearch()
			if not chosenEntry then
				return false, "Không có Research nào đủ điều kiện hoặc slot đang bận"
			end
		end

		researchBusy = true
		local okStart, started, tokenOrErr = pcall(function()
			return progressAction:InvokeServer("labstart", chosenEntry.id)
		end)

		if not okStart or not started then
			researchBusy = false
			return false, tostring(tokenOrErr or "labstart thất bại")
		end

		local okFinish, doneOk, msg = pcall(function()
			return progressAction:InvokeServer("research", chosenEntry.id, tokenOrErr)
		end)
		researchBusy = false

		if not okFinish then
			return false, "Lỗi gọi ProgressAction(research): " .. tostring(doneOk)
		end
		if not doneOk then
			return false, tostring(msg or "Server từ chối bắt đầu research")
		end

		return true, ("Đã bắt đầu nhanh: %s"):format(tostring(chosenEntry.name or chosenEntry.id))
	end

	function AutomationModule:CancelResearch(): (boolean, string)
		local progressAction = ReplicatedStorage:FindFirstChild("ProgressAction")
		if not progressAction or not progressAction:IsA("RemoteFunction") then
			return false, "Không tìm thấy ProgressAction"
		end
		local ok, res, msg = pcall(function()
			return progressAction:InvokeServer("cancelresearch")
		end)
		if not ok then
			return false, tostring(res)
		end
		return res == true, tostring(msg or (if res then "Đã hủy research" else "Không thể hủy"))
	end

