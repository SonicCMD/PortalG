function Combat:GetEnemyFilterOptions(): ({ string }, { [string]: string })
	local gd = getGameData()
	local options = { "All Hostile Mobs" }
	local labelToId: { [string]: string } = { ["All Hostile Mobs"] = "ALL" }
	if gd and type(gd.Enemies) == "table" then
		local temp = {}
		for id, meta in pairs(gd.Enemies) do
			local dName = if type(meta) == "table" and meta.name then tostring(meta.name) else tostring(id)
			local label = ("%s [%s]"):format(dName, tostring(id))
			table.insert(temp, { label = label, id = tostring(id) })
		end
		table.sort(temp, function(a, b) return a.label < b.label end)
		for _, item in ipairs(temp) do
			table.insert(options, item.label)
			labelToId[item.label] = item.id
		end
	end
	return options, labelToId
end

function Combat:SetAutoMission(enabled: boolean)
	missionConfig.AutoEnabled = enabled
	missionToken += 1
	local myToken = missionToken
	if not enabled then
		releaseMissionSubModes()
		lastMissionMsg = "Disabled"
		return
	end
	task.spawn(function()
		while missionConfig.AutoEnabled and myToken == missionToken and not destroyed do
			local ok, msg = stepAutoMissionOnce()
			lastMissionMsg = msg
			task.wait(if ok then 1.5 else 2.2)
		end
	end)
end

function Combat:RunMissionStepOnce(): (boolean, string)
	local ok, msg = stepAutoMissionOnce()
	lastMissionMsg = msg
	return ok, msg
end

