					sb.TextColor3 = THEME.Text
					sb.TextSize = 12
					sb.TextXAlignment = Enum.TextXAlignment.Left
					sb.Parent = optionsFrame
					makeCorner(sb, 6)
					makeStroke(sb, THEME.Stroke, 1, 0.3)
					makePadding(sb, 0, 0, 8, 8)
					searchBox = sb
				end

