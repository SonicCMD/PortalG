	function Automation:GetResearchStatusText(): string
		local gd = getGameData()
		if not gd or type(gd.Research) ~= "table" then
			return "Chưa tải được GameData.Research"
		end

		local known = decodeAttrTable("Research")
		local researching = decodeAttrTable("Researching")
		local qi = tonumber(LocalPlayer:GetAttribute("QI")) or 0
		local totalQi = tonumber(LocalPlayer:GetAttribute("TotalQI")) or 0
		local lv = if gd.GeniusLevel then gd.GeniusLevel(totalQi) else 1

		local doneCount = 0
		local totalCount = #gd.Research
		for _, r in ipairs(gd.Research) do
			if known[r.id] then
				doneCount += 1
			end
		end

		local activeStr = "Không có"
		if researching.id then
			local entry = gd.ResearchById and gd.ResearchById[researching.id]
			local rName = if entry then entry.name else tostring(researching.id)
			local ends = tonumber(researching.ends) or 0
			local remain = math.max(0, math.floor(ends - workspace:GetServerTimeNow()))
			activeStr = ("%s (còn %ds)"):format(tostring(rName), remain)
		end

		return ("Đã xong: %d/%d | Lv.%d | IQ: %d\nĐang chạy: %s\nLần cuối: %s"):format(
			doneCount,
			totalCount,
			lv,
			qi,
			activeStr,
			lastResearchMsg
		)
	end

	local function findRecipeById(recipeId: string): any?
		local gd = getGameData()
		if not gd or type(gd.Recipes) ~= "table" then
			return nil
		end
		for _, rec in ipairs(gd.Recipes) do
			if rec.id == recipeId or rec.result == recipeId then
				return rec
			end
		end
		return nil
	end

	local function knowsRecipe(gd: any, recipe: any): boolean
		local reqResearch = gd.RecipeResearch and gd.RecipeResearch[recipe.id]
		if not reqResearch then
			return true
		end
		local known = decodeAttrTable("Research")
		return known[reqResearch] == true
	end

	local function getAffordCount(recipe: any): number
		if type(recipe.ingredients) ~= "table" or #recipe.ingredients == 0 then
			return 50
		end
		local maxMake = 50
		for _, ing in ipairs(recipe.ingredients) do
			local need = ing.count or 1
			if need > 0 then
				local have = totalOwned(ing.item)
				maxMake = math.min(maxMake, math.floor(have / need))
			end
		end
		return math.max(0, maxMake)
	end

	function Automation:CraftOnce(targetRecipeId: string?): (boolean, string)
		if craftBusy then
			return false, "Đang xử lý craft..."
		end

		local gd = getGameData()
		if not gd or type(gd.Recipes) ~= "table" then
			return false, "Không tìm thấy GameData.Recipes"
		end

		local craftItem = ReplicatedStorage:FindFirstChild("CraftItem")
		if not craftItem or not craftItem:IsA("RemoteFunction") then
			return false, "Không tìm thấy RemoteFunction CraftItem"
		end

		initInventorySync()
		refreshStash(false)

		local recId = if targetRecipeId and targetRecipeId ~= "" then targetRecipeId else craftConfig.SelectedId
		local recipe = findRecipeById(recId)
		if not recipe then
			return false, "Chưa chọn công thức hợp lệ"
		end

		if not knowsRecipe(gd, recipe) then
			local reqId = gd.RecipeResearch[recipe.id]
			local rName = if gd.ResearchById and gd.ResearchById[reqId] then gd.ResearchById[reqId].name else tostring(reqId)
			return false, ("Chưa mở Research: %s"):format(tostring(rName))
		end

		local afford = getAffordCount(recipe)
		if afford <= 0 then
			return false, "Không đủ nguyên liệu để craft"
		end

		local finalQty = math.clamp(math.round(craftConfig.Quantity), 1, 50)
		if craftConfig.AutoClampMax then
			finalQty = math.clamp(math.min(finalQty, afford), 1, 50)
		elseif finalQty > afford then
			return false, ("Chỉ đủ nguyên liệu làm tối đa x%d"):format(afford)
		end

		craftBusy = true
		local itemMeta = gd.Items and gd.Items[recipe.result]
		local itemName = if itemMeta and itemMeta.name then itemMeta.name else tostring(recipe.result or recipe.id)

		local craftFinish = ReplicatedStorage:FindFirstChild("CraftFinish")
		if craftConfig.FastAssemble and craftFinish and craftFinish:IsA("RemoteFunction") then
			local okInv, okStart, tokenOrErr = pcall(function()
				return craftItem:InvokeServer(recipe.id, finalQty, "assemble")
			end)
			if not okInv or not okStart then
				craftBusy = false
				return false, tostring(tokenOrErr or "CraftItem(assemble) thất bại")
			end

			local okFin, finOk, finErr = pcall(function()
				return craftFinish:InvokeServer(tokenOrErr, "done")
			end)
			craftBusy = false

			if not okFin then
				return false, "Lỗi CraftFinish: " .. tostring(finOk)
			end
			if not finOk then
				return false, tostring(finErr or "CraftFinish thất bại")
			end
			return true, ("Fast Assemble x%d %s"):format(finalQty, itemName)
		else
			local okInv, craftOk, craftErr = pcall(function()
				return craftItem:InvokeServer(recipe.id, finalQty)
			end)
			craftBusy = false

			if not okInv then
				return false, "Lỗi CraftItem: " .. tostring(craftOk)
			end
			if not craftOk then
				return false, tostring(craftErr or "CraftItem thất bại")
			end
			return true, ("Đã craft x%d %s"):format(finalQty, itemName)
		end
	end

	function Automation:SetAutoCraft(enabled: boolean)
		craftConfig.AutoEnabled = enabled
		craftLoopToken += 1
		local myToken = craftLoopToken
		if not enabled then
			return
		end

		initInventorySync()
		hookAssemblyBench()

		task.spawn(function()
			local warnedOut = false
			while craftConfig.AutoEnabled and myToken == craftLoopToken and not destroyed do
				local ok, msg = self:CraftOnce(craftConfig.SelectedId)
				if ok then
					warnedOut = false
				elseif not warnedOut then
					warnedOut = true
					sendNotice("Auto Craft", msg, Color3.fromRGB(251, 191, 36))
				end
				task.wait(craftConfig.Interval)
			end
		end)
	end

