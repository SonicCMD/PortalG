local function findScriptInputConns(signal: RBXScriptSignal, scriptNeedle: string): { any }
	local gc = hasGetConnections()
	if not gc then
		return {}
	end
	local now = os.clock()
	local sigBucket = signalConnCache[signal]
	if sigBucket then
		local entry = sigBucket[scriptNeedle]
		if entry and (now - entry.clock) < 1.2 then
			local valid = true
			for _, c in ipairs(entry.conns) do
				if c and c.Connected == false then
					valid = false
					break
				end
			end
			if valid then
				return entry.conns
			end
		end
	else
		sigBucket = {}
		signalConnCache[signal] = sigBucket
	end

	local ok, conns = pcall(gc, signal)
	if not ok or type(conns) ~= "table" then
		return {}
	end
	local debugInfoFn = if type(debug) == "table" and type(debug.info) == "function" then debug.info else nil
	local debugGetInfoFn = if type(debug) == "table" and type(debug.getinfo) == "function" then debug.getinfo else getExecFunc("getinfo")
	local matched = {}
	for _, conn in ipairs(conns) do
		local fn = conn and conn.Function
		if type(fn) == "function" then
			local fnSrc: string? = nil
			if debugInfoFn then
				local okInfo, srcRes = pcall(debugInfoFn, fn, "s")
				if okInfo and type(srcRes) == "string" then
					fnSrc = srcRes
				end
			elseif type(debugGetInfoFn) == "function" then
				local okInfo, infoTbl = pcall(debugGetInfoFn, fn)
				if okInfo and type(infoTbl) == "table" and type(infoTbl.source) == "string" then
					fnSrc = infoTbl.source
				end
			end
			if fnSrc and string.find(fnSrc, scriptNeedle, 1, true) then
				table.insert(matched, conn)
			end
		end
	end
	sigBucket[scriptNeedle] = { clock = now, conns = matched }
	return matched
end

local function invokeSignalConns(conns: { any }, fakeInput: any, isBegan: boolean): boolean
	local fired = false
	for _, conn in ipairs(conns) do
		local fn = conn and conn.Function
		if type(fn) == "function" then
			local ok = if isBegan then pcall(fn, fakeInput, false) else pcall(fn, fakeInput)
			if ok then
				fired = true
			end
		end
	end
	return fired
end

local function makeSafeHoldScreenPoint(): (number, number)
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(800, 600)
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		local candidates = {
			{ vp.X * 0.86, vp.Y * 0.45 },
			{ vp.X * 0.5, vp.Y * 0.5 },
			{ vp.X * 0.18, vp.Y * 0.80 },
			{ vp.X * 0.85, vp.Y * 0.22 },
		}
		for _, pt in ipairs(candidates) do
			local cx, cy = math.round(pt[1]), math.round(pt[2])
			local okObjs, objs = pcall(function()
				return pg:GetGuiObjectsAtPosition(cx, cy)
			end)
			local blocked = false
			if okObjs and type(objs) == "table" then
				for _, g in ipairs(objs) do
					if g:IsA("GuiButton") and g.Visible then
						blocked = true
						break
					end
				end
			end
			if not blocked then
				return cx, cy
			end
		end
	end
	return math.round(vp.X * 0.86), math.round(vp.Y * 0.45)
end

