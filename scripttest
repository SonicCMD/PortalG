local function clearMobEsp()
	for m, vis in pairs(mobEspVisuals) do
		vis.bb:Destroy()
		vis.hl:Destroy()
		mobEspVisuals[m] = nil
	end
	if mobEspFolder then
		mobEspFolder:Destroy()
		mobEspFolder = nil
	end
end

local function updateMobEsp()
	if not mobConfig.MobEsp or destroyed then
		clearMobEsp()
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	if not mobEspFolder or mobEspFolder.Parent ~= cam then
		mobEspFolder = Instance.new("Folder")
		mobEspFolder.Name = "RayfieldMobESP"
		mobEspFolder.Parent = cam
	end

	local list = scanMobs(mobConfig.HuntFilter, mobConfig.MaxHuntDist, false)
	local active: { [Model]: boolean } = {}
	for i = 1, math.min(maxMobEspHighlights, #list) do
		local entry = list[i]
		active[entry.model] = true
		local vis = mobEspVisuals[entry.model]
		if not vis then
			local hl = Instance.new("Highlight")
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.FillColor = MOB_HL_FILL
			hl.OutlineColor = MOB_HL_OUTLINE
			hl.FillTransparency = 0.65
			hl.Adornee = entry.model
			hl.Parent = mobEspFolder

			local bb = Instance.new("BillboardGui")
			bb.AlwaysOnTop = true
			bb.LightInfluence = 0
			bb.Size = UDim2.fromOffset(180, 32)
			bb.StudsOffsetWorldSpace = Vector3.new(0, 3.6, 0)
			bb.MaxDistance = mobConfig.MaxHuntDist
			bb.Adornee = entry.root
			bb.Parent = mobEspFolder

			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.fromScale(1, 1)
			lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 13
			lbl.TextColor3 = MOB_HL_OUTLINE
			lbl.TextStrokeColor3 = COLOR_BLACK
			lbl.TextStrokeTransparency = 0.25
			lbl.Parent = bb

			vis = { bb = bb, lbl = lbl, hl = hl, lastTxt = "" }
			mobEspVisuals[entry.model] = vis
		end
		local nextTxt = ("%s [%.0f/%.0f] (%.0fm)"):format(entry.displayName, entry.hum.Health, entry.hum.MaxHealth, entry.dist)
		if nextTxt ~= vis.lastTxt then
			vis.lastTxt = nextTxt
			vis.lbl.Text = nextTxt
		end
	end
	for m, vis in pairs(mobEspVisuals) do
		if not active[m] or not m.Parent then
			vis.bb:Destroy()
			vis.hl:Destroy()
			mobEspVisuals[m] = nil
		end
	end
end

