local function isResearchEligible(
	entry: any,
	known: { [string]: any },
	built: { [string]: any },
	researching: { [string]: any },
	researchingMore: { [string]: any },
	geniusLevel: number,
	geniusCap: number,
	qi: number,
	parallelLab: boolean,
	nowClock: number
): (boolean, string)
	if type(entry) ~= "table" or not entry.id then
		return false, "Invalid data"
	end
	if known[entry.id] then
		return false, "Already researched"
	end
	if researching.id == entry.id or researchingMore[entry.id] ~= nil then
		return false, "Already researching"
	end
	if not parallelLab and researching.id ~= nil then
		return false, "Another research is active"
	end
	if not built.Workbench then
		return false, "Workbench not built"
	end

	local coolUntil = failedResearchCooldown[entry.id]
	if coolUntil and nowClock < coolUntil then
		return false, "Temporarily skipping failed entry"
	end

	local reqLevel = entry.level or 1
	if reqLevel > geniusCap then
		return false, "Defeat Boss to raise Level cap"
	end
	if reqLevel > geniusLevel then
		return false, ("Requires Genius Level %d (Current %d)"):format(reqLevel, geniusLevel)
	end

	for _, reqId in ipairs(entry.requires or {}) do
		if not known[reqId] then
			return false, ("Missing prerequisite: %s"):format(tostring(reqId))
		end
	end

	local reqQi = entry.qi or 0
	if qi < reqQi then
		return false, ("Not enough IQ (%d/%d)"):format(qi, reqQi)
	end

	if hasInventoryData and type(entry.items) == "table" then
		for _, cost in ipairs(entry.items) do
			local have = totalOwned(cost.item)
			if have < cost.count then
				return false, ("Missing %s (%d/%d)"):format(tostring(cost.item), have, cost.count)
			end
		end
	end

	return true, "Ready"
end

local function pickEligibleCandidates(): ({ any }, string)
	local gd = getGameData()
	if not gd or type(gd.Research) ~= "table" then
		return {}, "GameData.Research not found"
	end

	refreshStash(false)

	local known = decodeAttrTable("Research")
	local built = decodeAttrTable("Built")
	local researching = decodeAttrTable("Researching")
	local researchingMore = decodeAttrTable("ResearchingMore")
	local parallelLab = LocalPlayer:GetAttribute("ParallelLab") == true
	local qi = tonumber(LocalPlayer:GetAttribute("QI")) or 0
	local totalQi = tonumber(LocalPlayer:GetAttribute("TotalQI")) or 0
	local geniusCap = tonumber(LocalPlayer:GetAttribute("GeniusCap")) or 45
	local geniusLevel = if gd.GeniusLevel then gd.GeniusLevel(totalQi) else 1

	if not built.Workbench then
		return {}, "Workbench not built"
	end
	if not parallelLab and researching.id ~= nil then
		return {}, "Another research is active"
	end

	local nowClock = os.clock()
	local candidates: { any } = {}
	local allDone = true
	local bestFailLevel = math.huge
	local bestFailReason = "No eligible research found (IQ/Level/Items)"

	for _, entry in ipairs(gd.Research) do
		if type(entry) == "table" and entry.id and not known[entry.id] then
			allDone = false
		end
		local ok, reason = isResearchEligible(
			entry,
			known,
			built,
			researching,
			researchingMore,
			geniusLevel,
			geniusCap,
			qi,
			parallelLab,
			nowClock
		)
		if ok then
			table.insert(candidates, entry)
		elseif reason ~= "Already researched" then
			local lv = if type(entry) == "table" then (entry.level or 1) else 999
			if reason == "Temporarily skipping failed entry" then
				lv += 500
			end
			if lv < bestFailLevel then
				bestFailLevel = lv
				bestFailReason = reason
			end
		end
	end

	if #candidates == 0 then
		if allDone then
			return {}, "All research completed!"
		end
		return {}, bestFailReason
	end

	table.sort(candidates, function(a: any, b: any)
		local la = a.level or 1
		local lb = b.level or 1
		if la ~= lb then
			return la < lb
		end
		return (a.qi or 0) < (b.qi or 0)
	end)

	return candidates, "Ready"
end

function Automation:RunResearchOnce(): (boolean, string)
	if researchBusy or notebookLabBusy then
		return false, "Research request in progress..."
	end

	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if (pg and pg:FindFirstChild("ResearchLabHUD")) or workspace:FindFirstChild("ResearchLabLocal") then
		return false, "Solving active minigame..."
	end

	local gd = getGameData()
	if not gd or type(gd.Research) ~= "table" then
		return false, "GameData.Research not found"
	end

	local progressAction = ReplicatedStorage:FindFirstChild("ProgressAction")
	if not progressAction or not progressAction:IsA("RemoteFunction") then
		return false, "RemoteFunction ProgressAction not found"
	end

	initInventorySync()
	if not hasInventoryData then
		local deadline = os.clock() + 0.4
		while not hasInventoryData and os.clock() < deadline and not destroyed do
			task.wait(0.05)
		end
	end
	refreshStash(true)

	local candidates, emptyReason = pickEligibleCandidates()
	if #candidates == 0 then
		lastResearchMsg = emptyReason
		return false, emptyReason
	end

	local hasInputSim = detectInputCapability()
	if hasInputSim then
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then
			lastResearchMsg = "Waiting for character spawn..."
			return false, "Waiting for character spawn..."
		end
	end

	researchBusy = true
	local lastErr = emptyReason

	for _, chosenEntry in ipairs(candidates) do
		if destroyed or not researchConfig.AutoEnabled then
			researchBusy = false
			return false, "Auto Research stopped"
		end

		local entryLabel = tostring(chosenEntry.name or chosenEntry.id)
		local okStart, started, tokenOrErr = pcall(function()
			return progressAction:InvokeServer("labstart", chosenEntry.id)
		end)

		if not okStart or not started then
			failedResearchCooldown[chosenEntry.id] = os.clock() + 15
			lastErr = ("%s: %s"):format(entryLabel, tostring(tokenOrErr or "labstart failed"))
			continue
		end

		local labStartedAt = os.clock()
		local labSucceeded = true

		-- On DeltaX Mobile / executor, run the real 3-stage ResearchLab minigames and auto-solve them live
		if hasInputSim then
			local mod = ReplicatedStorage:FindFirstChild("ResearchLab")
			if mod and mod:IsA("ModuleScript") then
				local okMod, tbl = pcall(require, mod)
				if okMod and type(tbl) == "table" and type(tbl.run) == "function" then
					lastResearchMsg = ("Running 3 minigames: %s"):format(entryLabel)
					local okRun, labRes = pcall(function()
						return tbl.run({ research = chosenEntry })
					end)
					labSucceeded = (okRun and labRes == "done")
				end
			end
		end

		if not labSucceeded then
			failedResearchCooldown[chosenEntry.id] = os.clock() + 8
			lastErr = ("%s: Minigame stopped before completion"):format(entryLabel)
			continue
		end

		-- Top up only if completed faster than target pacing (without ever auto-canceling!)
		local targetDelay = if learnedMinDelay > 0
			then math.max(researchConfig.ConfirmDelay, learnedMinDelay)
			else researchConfig.ConfirmDelay
		local remainingDelay = targetDelay - (os.clock() - labStartedAt)
		if remainingDelay > 0 then
			waitExperimentWindow(remainingDelay, entryLabel, os.clock(), false)
		end

		if destroyed then
			researchBusy = false
			return false, "Auto Research stopped"
		end

		local MAX_EXPERIMENT_WAIT = 26
		local attemptSucceeded = false
		local attemptFatalErr = ""

		while not destroyed do
			local okFinish, doneOk, msg = pcall(function()
				return progressAction:InvokeServer("research", chosenEntry.id, tokenOrErr)
			end)

			if okFinish and doneOk then
				local totalElapsed = os.clock() - labStartedAt
				if totalElapsed > learnedMinDelay then
					learnedMinDelay = math.clamp(math.ceil(totalElapsed * 2) / 2, 0, 20)
				end
				attemptSucceeded = true
				break
			end

			local errText = if not okFinish
				then "ProgressAction(research) error: " .. tostring(doneOk)
				else tostring(msg or "Server rejected research")

			local elapsedSoFar = os.clock() - labStartedAt
			if okFinish and isTimingRejectMsg(errText) and elapsedSoFar < MAX_EXPERIMENT_WAIT then
				lastResearchMsg = ("Completing %s (%.1fs)..."):format(entryLabel, elapsedSoFar)
				task.wait(1.0)
			else
				attemptFatalErr = ("%s: %s"):format(entryLabel, errText)
				break
			end
		end

		if attemptSucceeded then
			researchBusy = false
			local okMsg = ("Started: %s"):format(entryLabel)
			lastResearchMsg = okMsg
			return true, okMsg
		end

		failedResearchCooldown[chosenEntry.id] = os.clock() + 15
		lastErr = if attemptFatalErr ~= "" then attemptFatalErr else ("%s: Experiment timed out"):format(entryLabel)
	end

	researchBusy = false
	lastResearchMsg = lastErr
	return false, lastErr
end

function Automation:SetAutoResearch(enabled: boolean)
	researchConfig.AutoEnabled = enabled
	researchLoopToken += 1
	local myToken = researchLoopToken
	if not enabled then
		stopMinigameSolver()
		return
	end

	table.clear(failedResearchCooldown)
	initInventorySync()
	hookResearchLab()
	startMinigameSolver()

	task.spawn(function()
		local lastNotifiedErr = ""
		while researchConfig.AutoEnabled and myToken == researchLoopToken and not destroyed do
			local ok, msg = self:RunResearchOnce()
			if ok then
				lastNotifiedErr = ""
				sendNotice("Auto Research", msg, Color3.fromRGB(52, 211, 153))
			elseif msg ~= "Another research is active"
				and msg ~= "Research request in progress..."
				and msg ~= "Solving active minigame..."
				and msg ~= "Waiting for character spawn..."
				and msg ~= "Auto Research stopped"
				and msg ~= lastNotifiedErr
			then
				lastNotifiedErr = msg
				sendNotice("Auto Research", msg, Color3.fromRGB(251, 191, 36))
			end
			task.wait(researchConfig.Interval)
		end
	end)
end

