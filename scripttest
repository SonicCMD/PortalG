	local function selectTab(targetPage: ScrollingFrame)
		for _, item in ipairs(tabs) do
			local wasVisible = item.page.Visible
			local active = (item.page == targetPage)
			if active then
				activeTabName = item.name
			end
			if wasVisible ~= active then
				item.page.Visible = active
				tween(item.button, TWEEN_FAST, {
					BackgroundColor3 = if active then THEME.CardBg else THEME.SidebarBg,
					TextColor3 = if active then THEME.Text else THEME.SubText,
				})
				tween(item.indicator, TWEEN_FAST, {
					BackgroundTransparency = if active then 0 else 1,
				})
			end
		end
		if onTabChangedCb and activeTabName ~= "" then
			task.spawn(onTabChangedCb, activeTabName)
		end
	end

