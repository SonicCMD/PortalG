function Material:GetMaterialOptions(): ({ string }, { [string]: string })
	local options: { string } = { "All Materials [ALL]" }
	local labelToId: { [string]: string } = {
		["All Materials [ALL]"] = "ALL",
	}
	local addedIds: { [string]: boolean } = {}

	local function pushItem(id: string, display: string?)
		if addedIds[id] then
			return
		end
		addedIds[id] = true
		local itemName = display or getItemMeta(id)
		local label = ("%s [%s]"):format(itemName, id)
		table.insert(options, label)
		labelToId[label] = id
	end

	local priority = {
		"Scrap",
		"Electronics",
		"BottledWater",
		"Beer",
		"MagmaShard",
		"FrostGem",
		"DeepQuartz",
		"UnstableOrganicFluid",
		"PlutonicQuarks",
		"PureCesium",
		"GreenCrystals",
		"Antimatter",
		"FroopyGoo",
		"KalaxianCrystal",
		"GearParts",
		"MoonRock",
		"RedOre",
		"CryoIce",
	}
	for _, id in ipairs(priority) do
		pushItem(id)
	end

	local gd = getGameData()
	if gd and type(gd.Items) == "table" then
		local extra: { { id: string, name: string } } = {}
		for id, meta in pairs(gd.Items) do
			if type(meta) == "table" and not addedIds[id] and not meta.gadget and not meta.gear and not meta.tool and id ~= "PortalFluid" then
				table.insert(extra, { id = id, name = tostring(meta.name or id) })
			end
		end
		table.sort(extra, function(a, b)
			return a.name < b.name
		end)
		for _, entry in ipairs(extra) do
			pushItem(entry.id, entry.name)
		end
	end

	return options, labelToId
end

local function findLocalPlayerBase(): Model?
	local candidates: { Model } = {}
	local seen: { [Instance]: boolean } = {}
	for _, inst in ipairs(CollectionService:GetTagged("PlayerBase")) do
		if inst:IsA("Model") and inst:IsDescendantOf(workspace) and not seen[inst] then
			seen[inst] = true
			table.insert(candidates, inst)
		end
	end
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Model") and not seen[child] and (child.Name:sub(1, 10) == "SmithHouse" or CollectionService:HasTag(child, "PlayerBase")) then
			seen[child] = true
			table.insert(candidates, child)
		end
	end

	local uid = LocalPlayer.UserId
	for _, m in ipairs(candidates) do
		if m:GetAttribute("OwnerId") == uid then
			return m
		end
	end

	local partnerId = LocalPlayer:GetAttribute("PartnerHostId")
	if partnerId ~= nil then
		for _, m in ipairs(candidates) do
			if m:GetAttribute("OwnerId") == partnerId then
				return m
			end
		end
	end

	local uidToken = "," .. tostring(uid) .. ","
	for _, m in ipairs(candidates) do
		local members = m:GetAttribute("MemberIds")
		if type(members) == "string" and string.find("," .. members .. ",", uidToken, 1, true) then
			return m
		end
	end

	local homePos = LocalPlayer:GetAttribute("HomePos")
	if typeof(homePos) == "Vector3" then
		for _, m in ipairs(candidates) do
			local offset = m:GetAttribute("Offset")
			if typeof(offset) == "Vector3" and (Vector3.new(139, 0, 82) + offset - homePos).Magnitude < 100 then
				return m
			end
			local okPivot, cf = pcall(function()
				return m:GetPivot()
			end)
			if okPivot and cf then
				local flatDist = Vector3.new(cf.Position.X - homePos.X, 0, cf.Position.Z - homePos.Z).Magnitude
				if flatDist < 160 then
					return m
				end
			end
		end
	elseif #candidates == 1 then
		return candidates[1]
	end

	return nil
end

local function isSafeGarageFloorPoint(house: Model, garage: Instance, floorY: number, cx: number, cz: number): (boolean, Vector3?)
	sharedDownParams.FilterDescendantsInstances = { garage }
	local downParams = sharedDownParams

	local downHit = workspace:Raycast(Vector3.new(cx, floorY + 6.5, cz), Vector3.new(0, -10, 0), downParams)
	if not downHit or not downHit.Instance then
		return false, nil
	end
	if downHit.Instance.Name ~= "Floor" then
		return false, nil
	end
	if math.abs(downHit.Position.Y - floorY) > 1.2 then
		return false, nil
	end

	sharedHouseParams.FilterDescendantsInstances = { house }
	local houseParams = sharedHouseParams

	local upHit = workspace:Raycast(downHit.Position + Vector3.new(0, 0.5, 0), Vector3.new(0, 6.2, 0), houseParams)
	if upHit then
		return false, nil
	end

	local feelDirs = {
		Vector3.new(1.35, 0, 0),
		Vector3.new(-1.35, 0, 0),
		Vector3.new(0, 0, 1.35),
		Vector3.new(0, 0, -1.35),
	}
	for _, hOff in ipairs({ 1.8, 3.4 }) do
		local origin = downHit.Position + Vector3.new(0, hOff, 0)
		for _, dir in ipairs(feelDirs) do
			local sideHit = workspace:Raycast(origin, dir, houseParams)
			if sideHit and sideHit.Instance and sideHit.Instance.Name ~= "Floor" then
				return false, nil
			end
		end
	end

	return true, downHit.Position
end

local function findGarageSpot(house: Model?): (Vector3?, Vector3?, string)
	local scale = getCharacterScale()
	if not house then
		return nil, nil, "Unknown"
	end

	local garage = house:FindFirstChild("Garage") or house:FindFirstChild("Garage", true)
	if not garage then
		local hp = LocalPlayer:GetAttribute("HomePos")
		if typeof(hp) == "Vector3" then
			return hp + Vector3.new(0, 4 * scale, 0), nil, "Home Position"
		end
		local okPivot, cf = pcall(function()
			return house:GetPivot()
		end)
		if okPivot and cf then
			return cf.Position + Vector3.new(0, 5 * scale, 0), nil, "Home Base"
		end
		return nil, nil, "Unknown"
	end

	local floorParts: { BasePart } = {}
	for _, ch in ipairs(garage:GetChildren()) do
		if ch:IsA("BasePart") and ch.Name == "Floor" and ch.CanCollide then
			table.insert(floorParts, ch)
		end
	end
	if #floorParts == 0 then
		for _, d in ipairs(garage:GetDescendants()) do
			if d:IsA("BasePart") and d.Name == "Floor" and d.CanCollide then
				table.insert(floorParts, d)
			end
		end
	end

	local workbench = garage:FindFirstChild("GarageWorkbench", true) or garage:FindFirstChild("GarageTerminal", true)
	local lookPos: Vector3? = nil
	if workbench then
		local okW, wcf = pcall(function()
			return if workbench:IsA("BasePart") then workbench.CFrame else (workbench :: Model):GetPivot()
		end)
		if okW and wcf then
			lookPos = wcf.Position
		end
	end

	if #floorParts > 0 then
		local minX, maxX = math.huge, -math.huge
		local minZ, maxZ = math.huge, -math.huge
		local sumY = 0
		local largestFloor: BasePart = floorParts[1]
		local largestArea = 0

		for _, fp in ipairs(floorParts) do
			local p = fp.Position
			local sx, sz = fp.Size.X, fp.Size.Z
			minX = math.min(minX, p.X - sx * 0.5)
			maxX = math.max(maxX, p.X + sx * 0.5)
			minZ = math.min(minZ, p.Z - sz * 0.5)
			maxZ = math.max(maxZ, p.Z + sz * 0.5)
			sumY += p.Y
			local area = sx * sz
			if area > largestArea then
				largestArea = area
				largestFloor = fp
			end
		end

		local floorY = sumY / #floorParts
		local centerX = (minX + maxX) * 0.5
		local centerZ = (minZ + maxZ) * 0.5
		local anchorX = if lookPos then (centerX * 0.65 + lookPos.X * 0.35) else centerX
		local anchorZ = if lookPos then (centerZ * 0.65 + lookPos.Z * 0.35) else centerZ

		local pts: { { x: number, z: number, score: number } } = {}
		local function pushPt(px: number, pz: number)
			local dx = px - anchorX
			local dz = pz - anchorZ
			table.insert(pts, { x = px, z = pz, score = dx * dx + dz * dz })
		end

		for _, fp in ipairs(floorParts) do
			if fp.Size.X >= 2.5 and fp.Size.Z >= 2.5 then
				pushPt(fp.Position.X, fp.Position.Z)
			end
		end
		for gx = math.floor(minX) + 2, math.ceil(maxX) - 2, 3 do
			for gz = math.floor(minZ) + 2, math.ceil(maxZ) - 2, 3 do
				pushPt(gx, gz)
			end
		end
		table.sort(pts, function(a, b)
			return a.score < b.score
		end)

		for _, pt in ipairs(pts) do
			local safe, hitPos = isSafeGarageFloorPoint(house, garage, floorY, pt.x, pt.z)
			if safe and hitPos then
				local standPos = hitPos + Vector3.new(0, 3.2 * scale, 0)
				return standPos, lookPos, "Garage Interior"
			end
		end

		local fallbackPos = largestFloor.Position + Vector3.new(0, largestFloor.Size.Y * 0.5 + 3.4 * scale, 0)
		return fallbackPos, lookPos, "Garage Floor"
	end

	local okG, gcf = pcall(function()
		return if garage:IsA("BasePart") then garage.CFrame else (garage :: Model):GetPivot()
	end)
	if okG and gcf then
		return gcf.Position + Vector3.new(0, 3.4 * scale, 0), lookPos, "Garage"
	end
	return nil, nil, "Unknown"
end

