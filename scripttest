local function getCachedLabels(container: Instance, cacheRef: Instance?, cacheClock: number, cacheList: { TextLabel }): ({ TextLabel }, Instance, number)
	local now = os.clock()
	if cacheRef == container and (now - cacheClock) < 0.45 and #cacheList > 0 then
		return cacheList, container, cacheClock
	end
	table.clear(cacheList)
	for _, desc in ipairs(container:GetDescendants()) do
		if desc:IsA("TextLabel") then
			table.insert(cacheList, desc)
		end
	end
	return cacheList, container, now
end

local function detectLabStageAndProgress(labFolder: Instance, hud: Instance): (string?, number?, number?)
	local stage: string? = nil
	local doneCount: number? = nil
	local totalCount: number? = nil

	local hudLabels: { TextLabel }
	hudLabels, cachedLabHudRef, cachedLabHudClock = getCachedLabels(hud, cachedLabHudRef, cachedLabHudClock, cachedLabLabels)

	for _, desc in ipairs(hudLabels) do
		if desc.Parent then
			local txt = desc.Text
			if txt and txt ~= "" then
				local lower = string.lower(txt)
				if string.find(lower, "breakthrough", 1, true) then
					return "breakthrough", doneCount, totalCount
				elseif string.find(lower, "burning spots", 1, true) then
					stage = "scan"
				elseif string.find(lower, "gold node", 1, true) then
					stage = "circuit"
				elseif string.find(lower, "marker lights up", 1, true) then
					stage = "gyro"
				elseif string.find(lower, "green band", 1, true) then
					stage = "mix"
				end
				local d, t = txt:match("^(%d+)%s*/%s*(%d+)$")
				if d and t then
					doneCount = tonumber(d)
					totalCount = tonumber(t)
				end
			end
		end
	end

	if not stage then
		local folderLabels: { TextLabel }
		folderLabels, cachedLabFolderRef, cachedLabFolderClock = getCachedLabels(labFolder, cachedLabFolderRef, cachedLabFolderClock, cachedLabFolderLabels)
		for _, desc in ipairs(folderLabels) do
			if desc.Parent then
				local upper = string.upper(desc.Text or "")
				if string.find(upper, "BREAKTHROUGH", 1, true) then
					return "breakthrough", doneCount, totalCount
				elseif string.find(upper, "SCAN", 1, true) then
					stage = "scan"
				elseif string.find(upper, "CIRCUIT", 1, true) then
					stage = "circuit"
				elseif string.find(upper, "CALIBRATION", 1, true) then
					stage = "gyro"
				elseif string.find(upper, "COMPOUND", 1, true) then
					stage = "mix"
				end
			end
		end
	end

	return stage, doneCount, totalCount
end

local function stepMinigameSolver()
	if destroyed or not researchConfig.AutoEnabled then
		return
	end

	local labFolder = workspace:FindFirstChild("ResearchLabLocal")
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local hud = pg and pg:FindFirstChild("ResearchLabHUD")
	local cam = workspace.CurrentCamera
	if not labFolder or not hud or not cam then
		releaseMixHold()
		table.clear(finishedMixLabels)
		table.clear(clickedScanAt)
		table.clear(clickedCircuitIdxAt)
		return
	end

	local stage, doneCount = detectLabStageAndProgress(labFolder, hud)
	if not stage or stage == "breakthrough" then
		releaseMixHold()
		return
	end

	if stage ~= "mix" and mixHoldActive then
		releaseMixHold()
	end

	local now = os.clock()
	lastResearchMsg = ("Solving minigame: %s"):format(string.upper(stage))

	if stage == "scan" then
		if now - lastClickClock < 0.08 then
			return
		end
		for _, desc in ipairs(labFolder:GetChildren()) do
			if desc:IsA("Part")
				and desc.Shape == Enum.PartType.Ball
				and desc.Transparency < 0.95
				and (desc.Size - Vector3.new(0.42, 0.42, 0.42)).Magnitude < 0.05
				and desc:FindFirstChildOfClass("PointLight") ~= nil
			then
				if now - (clickedScanAt[desc] or 0) > 0.22 then
					local sp = cam:WorldToScreenPoint(desc.Position)
					local vp = cam:WorldToViewportPoint(desc.Position)
					if sp.Z > 0 then
						clickedScanAt[desc] = now
						lastClickClock = now
						sendLabClick(sp.X, sp.Y, vp.X, vp.Y)
						return
					end
				end
			end
		end
	elseif stage == "circuit" then
		if now - lastClickClock < 0.09 then
			return
		end
		local nextIdx = (doneCount or 0) + 1
		if now - (clickedCircuitIdxAt[nextIdx] or 0) < 0.16 then
			return
		end

		local targetBall: BasePart? = nil
		for _, desc in ipairs(labFolder:GetChildren()) do
			if desc:IsA("Part")
				and desc.Shape == Enum.PartType.Ball
				and (desc.Size - Vector3.new(0.45, 0.45, 0.45)).Magnitude < 0.05
			then
				local bb = desc:FindFirstChildOfClass("BillboardGui")
				local lbl = bb and bb:FindFirstChildOfClass("TextLabel")
				if lbl and lbl.Text == tostring(nextIdx) then
					targetBall = desc
					break
				end
			end
		end

		if targetBall then
			local sp = cam:WorldToScreenPoint(targetBall.Position)
			local vp = cam:WorldToViewportPoint(targetBall.Position)
			if sp.Z > 0 then
				clickedCircuitIdxAt[nextIdx] = now
				lastClickClock = now
				sendLabClick(sp.X, sp.Y, vp.X, vp.Y)
			end
		end
	elseif stage == "gyro" then
		if now - lastGyroClickClock < 0.20 then
			return
		end
		for _, desc in ipairs(labFolder:GetChildren()) do
			if desc:IsA("WedgePart") then
				local bb = desc:FindFirstChildOfClass("BillboardGui")
				if bb and bb.Enabled then
					lastGyroClickClock = now
					lastClickClock = now
					local gx, gy = makeSafeHoldScreenPoint()
					sendLabClick(gx, gy)
					return
				end
			end
		end
	elseif stage == "mix" then
		local activeLabel: TextLabel? = nil
		local fallbackHold: TextLabel? = nil
		for _, desc in ipairs(labFolder:GetChildren()) do
			if desc:IsA("Part")
				and desc.Shape == Enum.PartType.Cylinder
				and (desc.Size - Vector3.new(2.2, 0.95, 0.95)).Magnitude < 0.12
			then
				local bb = desc:FindFirstChildOfClass("BillboardGui")
				local lbl = bb and bb:FindFirstChildOfClass("TextLabel")
				if lbl and not finishedMixLabels[lbl] then
					if lbl.Text == "LET GO!" or lbl.Text == "POURING..." then
						activeLabel = lbl
						break
					elseif lbl.Text == "HOLD" and not fallbackHold then
						fallbackHold = lbl
					end
				end
			end
		end

		local targetLbl = activeLabel or fallbackHold
		if targetLbl then
			local txt = targetLbl.Text
			if txt == "LET GO!" then
				releaseMixHold()
				finishedMixLabels[targetLbl] = true
			elseif txt == "POURING..." then
				if not mixHoldActive then
					local sx, sy = makeSafeHoldScreenPoint()
					sendLabHold(true, sx, sy)
				end
			elseif txt == "HOLD" then
				if mixHoldActive and (now - lastMixHoldStartClock >= 0.35) then
					releaseMixHold()
				end
				if not mixHoldActive and (now - lastMixHoldStartClock >= 0.14) then
					lastMixHoldStartClock = now
					local sx, sy = makeSafeHoldScreenPoint()
					sendLabHold(true, sx, sy)
				end
			end
		end
	end
end

local function releaseAssemblyHold()
	if assemblyHoldFakeInput then
		local endedConns = findScriptInputConns(UserInputService.InputEnded, "AssemblyBench")
		invokeSignalConns(endedConns, assemblyHoldFakeInput, false)
		assemblyHoldFakeInput = nil
	end
	assemblyHoldStage = nil
end

local function detectAssemblyStage(hud: Instance): string?
	local labels: { TextLabel }
	labels, cachedAsmHudRef, cachedAsmHudClock = getCachedLabels(hud, cachedAsmHudRef, cachedAsmHudClock, cachedAsmLabels)
	for _, desc in ipairs(labels) do
		if desc.Parent then
			local txt = desc.Text
			if txt and txt ~= "" then
				local lower = string.lower(txt)
				if string.find(lower, "assembled!", 1, true) then
					return "done"
				elseif string.find(lower, "power it on", 1, true) then
					return "power"
				elseif string.find(lower, "screw", 1, true) then
					return "screws"
				elseif string.find(lower, "glowing place", 1, true)
					or string.find(lower, "shining piece", 1, true)
					or string.find(lower, "each piece", 1, true)
				then
					return "pieces"
				end
			end
		end
	end
	return nil
end

local function stepAssemblySolver()
	if destroyed or not (craftConfig.AutoEnabled or craftConfig.FastAssemble) then
		releaseAssemblyHold()
		return
	end

	local benchFolder = workspace:FindFirstChild("AssemblyBenchLocal")
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	local hud = pg and pg:FindFirstChild("AssemblyHUD")
	if not benchFolder or not hud then
		releaseAssemblyHold()
		return
	end

	local stage = detectAssemblyStage(hud)
	if not stage or stage == "done" then
		releaseAssemblyHold()
		return
	end

	local beganConns = findScriptInputConns(UserInputService.InputBegan, "AssemblyBench")
	if #beganConns == 0 then
		return
	end

	lastCraftMsg = ("Solving Workbench: %s"):format(string.upper(stage))

	if stage ~= assemblyHoldStage and assemblyHoldStage ~= nil then
		releaseAssemblyHold()
	end

	local now = os.clock()
	if stage == "pieces" then
		if now - lastAssemblyPieceClock < 0.18 then
			return
		end
		lastAssemblyPieceClock = now
		local fakeInput = {
			UserInputType = Enum.UserInputType.Gamepad1,
			UserInputState = Enum.UserInputState.Begin,
			KeyCode = Enum.KeyCode.ButtonA,
			Position = Vector3.zero,
		}
		invokeSignalConns(beganConns, fakeInput, true)
		local endedConns = findScriptInputConns(UserInputService.InputEnded, "AssemblyBench")
		if #endedConns > 0 then
			invokeSignalConns(endedConns, fakeInput, false)
		end
	elseif stage == "screws" or stage == "power" then
		if assemblyHoldStage ~= stage then
			local fakeInput = {
				UserInputType = Enum.UserInputType.Gamepad1,
				UserInputState = Enum.UserInputState.Begin,
				KeyCode = Enum.KeyCode.ButtonA,
				Position = Vector3.zero,
			}
			if invokeSignalConns(beganConns, fakeInput, true) then
				assemblyHoldStage = stage
				assemblyHoldFakeInput = fakeInput
			end
		end
	end
end

local function stepAllSolvers()
	if destroyed then
		return
	end
	if researchConfig.AutoEnabled then
		stepMinigameSolver()
	end
	if craftConfig.AutoEnabled or craftConfig.FastAssemble then
		stepAssemblySolver()
	end
end

local function refreshSolverState()
	local needSolver = (not destroyed) and (researchConfig.AutoEnabled or craftConfig.AutoEnabled or craftConfig.FastAssemble)
	if not needSolver then
		if solverConn then
			solverConn:Disconnect()
			solverConn = nil
		end
		releaseMixHold()
		releaseAssemblyHold()
		table.clear(finishedMixLabels)
		table.clear(clickedScanAt)
		table.clear(clickedCircuitIdxAt)
		table.clear(signalConnCache)
		cachedLabHudRef = nil
		cachedLabFolderRef = nil
		cachedAsmHudRef = nil
		table.clear(cachedLabLabels)
		table.clear(cachedLabFolderLabels)
		table.clear(cachedAsmLabels)
		return
	end
	if not solverConn then
		table.clear(finishedMixLabels)
		table.clear(clickedScanAt)
		table.clear(clickedCircuitIdxAt)
		solverAcc = solverInterval
		solverConn = RunService.Heartbeat:Connect(function(dt: number)
			solverAcc += dt
			if solverAcc < solverInterval then
				return
			end
			solverAcc = 0
			stepAllSolvers()
		end)
	end
end

local function stopMinigameSolver()
	refreshSolverState()
end

local function startMinigameSolver()
	refreshSolverState()
end

