	end

	local function getGameData(): any
		if not gameDataChecked then
			gameDataChecked = true
			local mod = ReplicatedStorage:FindFirstChild("GameData") or ReplicatedStorage:WaitForChild("GameData", 3)
			if mod and mod:IsA("ModuleScript") then
				local ok, data = pcall(require, mod)
				if ok and type(data) == "table" then
					cachedGameData = data
				end
			end
		end
		return cachedGameData
	end

	local function getItemMeta(itemId: string): (string, Color3)
		local gd = getGameData()
		local meta = gd and gd.Items and gd.Items[itemId]
		if type(meta) == "table" then
			return tostring(meta.name or itemId), meta.color or Color3.fromRGB(56, 189, 248)
		end
		return itemId, Color3.fromRGB(56, 189, 248)
	end

	local function getRootPart(): BasePart?
		local char = LocalPlayer.Character
		if not char then
			return nil
		end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			return hrp
		end
		return nil
	end

	local function resolveNodePartAndPrompt(node: Instance): (BasePart?, ProximityPrompt?, Vector3?)
		local prompt = node:FindFirstChild("HarvestPrompt", true)
		local validPrompt: ProximityPrompt? = if prompt and prompt:IsA("ProximityPrompt") then prompt else nil

		if node:IsA("BasePart") then
			return node, validPrompt, node.Position
		end

		local anchor = node:FindFirstChild("HarvestAnchor", true)
		if anchor then
			if anchor:IsA("Attachment") and anchor.Parent and anchor.Parent:IsA("BasePart") then
				return anchor.Parent, validPrompt, anchor.WorldPosition
			elseif anchor:IsA("BasePart") then
				return anchor, validPrompt, anchor.Position
			end
		end

		if validPrompt and validPrompt.Parent then
			if validPrompt.Parent:IsA("Attachment") and validPrompt.Parent.Parent and validPrompt.Parent.Parent:IsA("BasePart") then
				return validPrompt.Parent.Parent, validPrompt, validPrompt.Parent.WorldPosition
			elseif validPrompt.Parent:IsA("BasePart") then
				return validPrompt.Parent, validPrompt, validPrompt.Parent.Position
			end
		end

		if node:IsA("Model") then
			local part = node.PrimaryPart or node:FindFirstChildWhichIsA("BasePart", true)
			if part then
				return part, validPrompt, part.Position
			end
		end

		return nil, validPrompt, nil
	end

	local function findNearestBiomeTarget(biomeKey: string, originPos: Vector3): (Vector3?, number?)
		local curDim = tostring(LocalPlayer:GetAttribute("CurrentDimension") or "C137")
		local proc = workspace:FindFirstChild("Proc_" .. curDim)
		if not proc then
			return nil, nil
		end

		local bestPos: Vector3? = nil
		local bestDist: number? = nil

		for i = 1, 4 do
			local attr = proc:GetAttribute(("Biome_%s_%d"):format(biomeKey, i))
			if typeof(attr) ~= "Vector3" and i == 1 then
				attr = proc:GetAttribute("Biome_" .. biomeKey)
			end
			if typeof(attr) == "Vector3" then
				local delta = attr - originPos
				local dx = (delta.X + 6000) % 12000 - 6000
				local dz = (delta.Z + 6000) % 12000 - 6000
				local dist = math.sqrt(dx * dx + dz * dz)
				if not bestDist or dist < bestDist then
					bestDist = dist
					bestPos = Vector3.new(originPos.X + dx, originPos.Y + 4, originPos.Z + dz)
				end
			end
		end

		return bestPos, bestDist
	end

	local function scanMatchingNodes(includeSkipped: boolean): ({ NodeInfo }, { [string]: number })
		local root = getRootPart()
		local origin = if root then root.Position else nil
		if not origin then
			local cam = workspace.CurrentCamera
			origin = if cam then cam.CFrame.Position else Vector3.zero
		end

		local results: { NodeInfo } = {}
		local countsByName: { [string]: number } = {}
		local now = os.clock()

		for _, node in ipairs(CollectionService:GetTagged("ResourceNode")) do
			if not node:IsDescendantOf(workspace) then
				continue
			end

			local itemId = tostring(node:GetAttribute("Item") or "")
			if itemId == "" then
				continue
			end
			if not includeSkipped and skippedNodes[node] and skippedNodes[node] > now then
				continue
			end

			local anchorPart, prompt, pos = resolveNodePartAndPrompt(node)
			if not pos then
				continue
			end
			if prompt and not prompt.Enabled then
				continue
			end

			local dist = (pos - (origin :: Vector3)).Magnitude
			if dist > config.MaxDistance then
				continue
			end

			local itemName, itemColor = getItemMeta(itemId)
			countsByName[itemName] = (countsByName[itemName] or 0) + 1

			if config.SelectedItem == "ALL" or config.SelectedItem == itemId then
				table.insert(results, {
					node = node,
					itemId = itemId,
					name = itemName,
					color = itemColor,
					anchorPart = anchorPart,
					prompt = prompt,
					pos = pos,
					dist = dist,
				})
			end
		end

		table.sort(results, function(a, b)
			return a.dist < b.dist
		end)

		return results, countsByName
	end

	local function getVisualFolder(): Folder?
		local cam = workspace.CurrentCamera
		if not cam then
			return nil
		end
		if visualFolder and visualFolder.Parent == cam then
			return visualFolder
		end
		if visualFolder then
			visualFolder:Destroy()
		end
		local folder = Instance.new("Folder")
		folder.Name = "RayfieldMaterialESP"
		folder.Parent = cam
		visualFolder = folder
		return folder
	end

	local function clearBeam()
		if beamObj then
			beamObj:Destroy()
			beamObj = nil
		end
		if beamA0 then
			beamA0:Destroy()
			beamA0 = nil
		end
		if beamA1 then
			beamA1:Destroy()
			beamA1 = nil
		end
		if beamTargetPart then
			beamTargetPart:Destroy()
			beamTargetPart = nil
		end
	end

	local function clearBiomeVisual()
		if biomeVisual then
			biomeVisual.bb:Destroy()
			biomeVisual.part:Destroy()
			biomeVisual = nil
		end
	end

	local function clearAllVisuals()
		for _, vis in pairs(nodeVisuals) do
			vis.bb:Destroy()
			if vis.hl then
				vis.hl:Destroy()
			end
		end
		table.clear(nodeVisuals)
		clearBiomeVisual()
		clearBeam()
		if visualFolder then
			visualFolder:Destroy()
			visualFolder = nil
		end
	end

	local function updateBeam(targetPos: Vector3?, color: Color3?)
		if not config.ShowBeam or not targetPos then
			clearBeam()
			return
		end
		local root = getRootPart()
		local folder = getVisualFolder()
		if not root or not folder then
			clearBeam()
			return
		end

		if not beamA0 or beamA0.Parent ~= root then
			if beamA0 then
				beamA0:Destroy()
			end
			local a0 = Instance.new("Attachment")
			a0.Name = "RF_MatBeamStart"
			a0.Parent = root
			beamA0 = a0
		end

		if not beamTargetPart or beamTargetPart.Parent ~= folder then
			local p = Instance.new("Part")
			p.Name = "RF_MatBeamTarget"
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Transparency = 1
			p.Size = Vector3.new(0.2, 0.2, 0.2)
			p.Parent = folder
			beamTargetPart = p

			local a1 = Instance.new("Attachment")
			a1.Parent = p
			beamA1 = a1
		end

		if beamTargetPart then
			beamTargetPart.CFrame = CFrame.new(targetPos)
		end

		if not beamObj or not beamObj.Parent then
			local b = Instance.new("Beam")
			b.Name = "RF_MatGuideBeam"
			b.FaceCamera = true
			b.Width0 = 0.22
			b.Width1 = 0.36
			b.LightEmission = 1
			b.LightInfluence = 0
			b.Transparency = NumberSequence.new(0.15)
			b.Parent = folder
			beamObj = b
		end

		if beamObj and beamA0 and beamA1 then
			beamObj.Attachment0 = beamA0
			beamObj.Attachment1 = beamA1
			beamObj.Color = ColorSequence.new(color or Color3.fromRGB(56, 189, 248))
		end
	end

	local function updateVisuals()
		if not (config.ScanEsp or config.ShowBeam) then
			clearAllVisuals()
			return
		end

		local folder = getVisualFolder()
		if not folder then
			return
		end

		local matches, countsByName = scanMatchingNodes(true)
		local root = getRootPart()
		local originPos = if root then root.Position else Vector3.zero

		local topParts: { string } = {}
		for k, c in pairs(countsByName) do
			table.insert(topParts, ("%s x%d"):format(k, c))
		end
		table.sort(topParts)
		local shownList = {}
		for i = 1, math.min(4, #topParts) do
			table.insert(shownList, topParts[i])
		end

		local nearestInfo = matches[1]
		if nearestInfo then
			lastSummaryText = ("Khả dụng: %d | Gần nhất: %s (%.0fm)\nTrong vùng: %s"):format(
				#matches,
				nearestInfo.name,
				nearestInfo.dist,
				if #shownList > 0 then table.concat(shownList, ", ") else "Không có"
			)
		else
			lastSummaryText = ("Không thấy %s quanh %.0fm"):format(
				if config.SelectedItem == "ALL" then "material nào" else (getItemMeta(config.SelectedItem)),
				config.MaxDistance
			)
		end

		local activeSet: { [Instance]: boolean } = {}
		for _, info in ipairs(matches) do
			activeSet[info.node] = true
		end
		for node, vis in pairs(nodeVisuals) do
			if not activeSet[node] or not node.Parent then
				vis.bb:Destroy()
				if vis.hl then
					vis.hl:Destroy()
				end
				nodeVisuals[node] = nil
			end
		end

		if config.ScanEsp then
			for idx, info in ipairs(matches) do
				local vis = nodeVisuals[info.node]
				local adornee: Instance = info.anchorPart or info.node
				if not vis then
					local bb = Instance.new("BillboardGui")
					bb.Name = "MatMarker_" .. info.itemId
					bb.AlwaysOnTop = true
					bb.LightInfluence = 0
					bb.Size = UDim2.fromOffset(170, 34)
					bb.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
					bb.MaxDistance = config.MaxDistance
					bb.Adornee = adornee
					bb.Parent = folder

					local lbl = Instance.new("TextLabel")
					lbl.Size = UDim2.fromScale(1, 1)
					lbl.BackgroundTransparency = 1
					lbl.Font = Enum.Font.GothamBold
					lbl.TextSize = 13
					lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
					lbl.TextStrokeTransparency = 0.25
					lbl.TextColor3 = info.color
					lbl.Parent = bb

					vis = { bb = bb, lbl = lbl, hl = nil }
					nodeVisuals[info.node] = vis
				end

				vis.bb.Adornee = adornee
				vis.bb.MaxDistance = config.MaxDistance
				vis.lbl.TextColor3 = info.color
				vis.lbl.Text = ("%s [%.0fm]"):format(info.name, info.dist)

				if idx <= MAX_HIGHLIGHTS and info.node:IsA("Model") then
					if not vis.hl or not vis.hl.Parent then
						local hl = Instance.new("Highlight")
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.FillColor = info.color
						hl.OutlineColor = Color3.new(1, 1, 1)
						hl.FillTransparency = 0.6
						hl.OutlineTransparency = 0.15
						hl.Adornee = info.node
						hl.Parent = folder
						vis.hl = hl
					else
						vis.hl.FillColor = info.color
					end
				elseif vis.hl then
					vis.hl:Destroy()
					vis.hl = nil
				end
			end
		else
			for node, vis in pairs(nodeVisuals) do
				vis.bb:Destroy()
				if vis.hl then
					vis.hl:Destroy()
				end
				nodeVisuals[node] = nil
			end
		end

		local biomeTargetPos: Vector3? = nil
		local biomeColor: Color3? = nil
		local biomeKey = WILD_BIOMES[config.SelectedItem]
		if not nearestInfo and biomeKey then
			local bPos, bDist = findNearestBiomeTarget(biomeKey, originPos)
			if bPos and bDist then
				biomeTargetPos = bPos
				local itemName, col = getItemMeta(config.SelectedItem)
				biomeColor = col
				lastSummaryText = ("Chưa có node %s đã load.\nHướng dẫn đường tới %s: %.0fm"):format(
					itemName,
					BIOME_LABELS[biomeKey] or biomeKey,
					bDist
				)

				if config.ScanEsp then
					if not biomeVisual or not biomeVisual.part.Parent then
						local p = Instance.new("Part")
						p.Name = "BiomeBeaconAnchor"
						p.Anchored = true
						p.CanCollide = false
						p.CanQuery = false
						p.CanTouch = false
						p.Transparency = 1
						p.Size = Vector3.new(1, 1, 1)
						p.Parent = folder

						local bb = Instance.new("BillboardGui")
						bb.AlwaysOnTop = true
						bb.Size = UDim2.fromOffset(220, 40)
						bb.Adornee = p
						bb.Parent = folder

						local lbl = Instance.new("TextLabel")
						lbl.Size = UDim2.fromScale(1, 1)
						lbl.BackgroundTransparency = 1
						lbl.Font = Enum.Font.GothamBold
						lbl.TextSize = 14
						lbl.TextStrokeTransparency = 0.25
						lbl.Parent = bb

						biomeVisual = { bb = bb, part = p, lbl = lbl }
					end
					if biomeVisual then
						biomeVisual.part.CFrame = CFrame.new(bPos)
						biomeVisual.lbl.TextColor3 = col
						biomeVisual.lbl.Text = ("[%s • %.0fm]"):format(BIOME_LABELS[biomeKey] or biomeKey, bDist)
					end
				else
					clearBiomeVisual()
				end
			else
				clearBiomeVisual()
				local gd = getGameData()
				local meta = gd and gd.Items and gd.Items[config.SelectedItem]
				if meta and (meta.dim or meta.planet) then
					lastSummaryText = ("%s ở %s (hãy dịch chuyển tới đó để dò node)."):format(
						tostring(meta.name or config.SelectedItem),
						tostring(meta.dim or meta.planet)
					)
				end
			end
		else
			clearBiomeVisual()
		end

		if nearestInfo then
			updateBeam(nearestInfo.pos, nearestInfo.color)
		elseif biomeTargetPos then
			updateBeam(biomeTargetPos, biomeColor)
		else
			updateBeam(nil, nil)
		end
	end

	local function refreshLoopState()
		local needsVisualLoop = (config.ScanEsp or config.ShowBeam) and not destroyed
		if needsVisualLoop and not renderConn then
			elapsedAcc = VISUAL_INTERVAL
			renderConn = RunService.RenderStepped:Connect(function(dt: number)
				elapsedAcc += dt
				if elapsedAcc < VISUAL_INTERVAL then
					return
				end
				elapsedAcc = 0
				updateVisuals()
			end)
		elseif not needsVisualLoop and renderConn then
			renderConn:Disconnect()
			renderConn = nil
			clearAllVisuals()
		end
	end

	local function moveTowardsTarget(targetPos: Vector3, stopDist: number, token: number, targetNode: Instance?): boolean
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = getRootPart()
		if not hum or not root or hum.Health <= 0 then
			return false
		end

		if (root.Position - targetPos).Magnitude <= stopDist then
			return true
		end

		local waypoints: { PathWaypoint }? = nil
		if (root.Position - targetPos).Magnitude > 30 then
			local path = PathfindingService:CreatePath({
				AgentRadius = 2.5,
				AgentHeight = 5,
				AgentCanJump = true,
				WaypointSpacing = 8,
			})
			local okPath = pcall(function()
				path:ComputeAsync(root.Position, targetPos)
			end)
			if okPath and path.Status == Enum.PathStatus.Success then
				waypoints = path:GetWaypoints()
			end
		end

		local function walkToPoint(pt: Vector3, reachDist: number, maxWait: number): boolean
			local deadline = os.clock() + maxWait
			local lastPos = root.Position
			local stuckSince = os.clock()

			hum:MoveTo(pt)
			while config.AutoCollect and token == autoLoopToken and not destroyed do
				if not root.Parent or not hum.Parent or hum.Health <= 0 then
					return false
				end
				if targetNode and (not targetNode.Parent) then
					return false
				end
				local curDist = (root.Position - pt).Magnitude
				if curDist <= reachDist then
					return true
				end
				if os.clock() > deadline then
					return false
				end
				if (root.Position - lastPos).Magnitude > 1.2 then
					lastPos = root.Position
					stuckSince = os.clock()
				elseif os.clock() - stuckSince > 1.1 then
					hum.Jump = true
					hum:MoveTo(pt)
					if os.clock() - stuckSince > 3.2 then
						return false
					end
				end
				task.wait(0.1)
			end
			return false
		end

		if waypoints and #waypoints > 1 then
			for i = 2, #waypoints do
				if not config.AutoCollect or token ~= autoLoopToken or destroyed then
					return false
				end
				local wp = waypoints[i]
				if wp.Action == Enum.PathWaypointAction.Jump then
					hum.Jump = true
				end
				local isLast = (i == #waypoints)
				local okStep = walkToPoint(wp.Position, if isLast then stopDist else 4.5, 4)
				if not okStep then
					return false
				end
				if (root.Position - targetPos).Magnitude <= stopDist then
					return true
				end
			end
			return (root.Position - targetPos).Magnitude <= (stopDist + 2)
		else
			return walkToPoint(targetPos, stopDist, 6)
		end
	end

	local function triggerPromptSafe(prompt: ProximityPrompt, token: number): boolean
		if not prompt.Parent or not prompt.Enabled then
			return false
		end
		local triggered = false
		local conn = prompt.Triggered:Connect(function()
			triggered = true
		end)

		pcall(function()
			prompt:InputHoldBegin()
		end)

		local holdDur = math.max(0.08, prompt.HoldDuration + 0.12)
		local endWait = os.clock() + holdDur
		while os.clock() < endWait do
			if destroyed or not config.AutoCollect or token ~= autoLoopToken or not prompt.Parent or not prompt.Enabled then
				break
			end
			task.wait(0.05)
		end

		pcall(function()
			prompt:InputHoldEnd()
		end)
		task.wait(0.15)
		conn:Disconnect()
		return triggered or not prompt.Enabled
	end

	function Material:ScanNow(): string
		local matches, countsByName = scanMatchingNodes(true)
		local first = matches[1]
		if first then
			lastSummaryText = ("Tìm thấy %d mục • Gần nhất: %s (%.0fm)"):format(#matches, first.name, first.dist)
			return lastSummaryText
		end
		local root = getRootPart()
		local biomeKey = WILD_BIOMES[config.SelectedItem]
		if root and biomeKey then
			local _, bDist = findNearestBiomeTarget(biomeKey, root.Position)
			if bDist then
				lastSummaryText = ("Hướng %s cách %.0fm"):format(BIOME_LABELS[biomeKey] or biomeKey, bDist)
				return lastSummaryText
			end
		end
		local countTypes = 0
		for _ in pairs(countsByName) do
			countTypes += 1
		end
		if countTypes > 0 then
			lastSummaryText = ("Không thấy %s quanh đây (có %d loại khác gần bạn)."):format(getItemMeta(config.SelectedItem), countTypes)
		else
			lastSummaryText = "Chưa thấy material nào trong bán kính đã đặt."
		end
		return lastSummaryText
	end

	function Material:SetScanEsp(enabled: boolean)
		config.ScanEsp = enabled
		refreshLoopState()
	end

	function Material:SetShowBeam(enabled: boolean)
		config.ShowBeam = enabled
		refreshLoopState()
	end

	function Material:SetAutoCollect(enabled: boolean)
		config.AutoCollect = enabled
		autoLoopToken += 1
		local myToken = autoLoopToken
		if not enabled then
			lastCollectMsg = "Đã tắt"
			return
		end

		table.clear(skippedNodes)
		lastCollectMsg = "Đang dò tìm..."

		task.spawn(function()
			while config.AutoCollect and myToken == autoLoopToken and not destroyed do
				local matches = scanMatchingNodes(false)
				local target = matches[1]
				if not target then
					local root = getRootPart()
					local biomeKey = WILD_BIOMES[config.SelectedItem]
					if root and biomeKey then
						local bPos, bDist = findNearestBiomeTarget(biomeKey, root.Position)
						if bPos and bDist then
							lastCollectMsg = ("Đang tiến về %s (%.0fm)..."):format(BIOME_LABELS[biomeKey] or biomeKey, bDist)
							local stepDir = (bPos - root.Position) * Vector3.new(1, 0, 1)
							local hopDist = math.min(60, stepDir.Magnitude)
							if hopDist > 5 then
								local hopPos = root.Position + stepDir.Unit * hopDist
								moveTowardsTarget(hopPos, 8, myToken, nil)
							end
							task.wait(0.2)
							continue
						end
					end
					lastCollectMsg = "Đang chờ material spawn quanh đây..."
					task.wait(0.8)
					continue
				end

				lastCollectMsg = ("Đang tới: %s (%.0fm)"):format(target.name, target.dist)
				local reachDist = if target.prompt then math.max(5.5, target.prompt.MaxActivationDistance - 2) else 6.5
				local reached = moveTowardsTarget(target.pos, reachDist, myToken, target.node)
				if not config.AutoCollect or myToken ~= autoLoopToken or destroyed then
					break
				end

				if reached and target.prompt and target.prompt.Parent and target.prompt.Enabled then
					lastCollectMsg = ("Đang nhặt: %s..."):format(target.name)
					local okPick = triggerPromptSafe(target.prompt, myToken)
					if okPick then
						collectedCount += 1
						lastCollectMsg = ("Đã nhặt %s (tổng: %d)"):format(target.name, collectedCount)
					else
						skippedNodes[target.node] = os.clock() + 8
					end
				else
					skippedNodes[target.node] = os.clock() + 10
					lastCollectMsg = ("Bỏ qua node bị kẹt: %s"):format(target.name)
				end
				task.wait(0.2)
			end
		end)
	end

	function Material:SetSelectedItem(itemId: string)
		config.SelectedItem = itemId
		table.clear(skippedNodes)
		if config.ScanEsp or config.ShowBeam then
			updateVisuals()
		end
	end

	function Material:SetMaxDistance(dist: number)
		config.MaxDistance = math.max(100, dist)
		if config.ScanEsp or config.ShowBeam then
			updateVisuals()
		end
	end

	function Material:GetMaterialOptions(): ({ string }, { [string]: string })
		local options: { string } = { "Tất cả Material [ALL]" }
		local labelToId: { [string]: string } = {
			["Tất cả Material [ALL]"] = "ALL",
		}
		local addedIds: { [string]: boolean } = {}

		local function pushItem(id: string, display: string?)
			if addedIds[id] then
				return
			end
			addedIds[id] = true
			local itemName = display or getItemMeta(id)
			local label = ("%s [%s]"):format(itemName, id)
			table.insert(options, label)
			labelToId[label] = id
		end

		local priority = {
			"Scrap",
			"Electronics",
			"BottledWater",
			"Beer",
			"MagmaShard",
			"FrostGem",
			"DeepQuartz",
			"UnstableOrganicFluid",
			"PlutonicQuarks",
			"PureCesium",
			"GreenCrystals",
			"Antimatter",
			"FroopyGoo",
			"KalaxianCrystal",
			"GearParts",
			"MoonRock",
			"RedOre",
			"CryoIce",
		}
		for _, id in ipairs(priority) do
			pushItem(id)
		end

		local gd = getGameData()
		if gd and type(gd.Items) == "table" then
			local extra: { { id: string, name: string } } = {}
			for id, meta in pairs(gd.Items) do
				if type(meta) == "table" and not addedIds[id] and not meta.gadget and not meta.gear and not meta.tool and id ~= "PortalFluid" then
					table.insert(extra, { id = id, name = tostring(meta.name or id) })
				end
			end
			table.sort(extra, function(a, b)
				return a.name < b.name
			end)
			for _, entry in ipairs(extra) do
				pushItem(entry.id, entry.name)
			end
		end

		return options, labelToId
	end

	function Material:GetStatusText(): string
		if not (config.ScanEsp or config.ShowBeam or config.AutoCollect) then
			local _, countsByName = scanMatchingNodes(true)
			local totalAvail = 0
			for _, c in pairs(countsByName) do
				totalAvail += c
			end
			return ("Quanh bạn: %d material sẵn sàng | Đã nhặt: %d\nTrạng thái: Đang TẮT"):format(totalAvail, collectedCount)
		end
		return ("%s\nAuto nhặt: %s (đã nhặt: %d)"):format(lastSummaryText, lastCollectMsg, collectedCount)
	end

	function Material:Destroy()
		destroyed = true
		config.ScanEsp = false
		config.ShowBeam = false
		config.AutoCollect = false
		autoLoopToken += 1
		refreshLoopState()
		clearAllVisuals()
	end

	return Material
end)()

--====================================================
-- 3. ESP MODULE
--====================================================
local Esp = (function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")

	local LocalPlayer = Players.LocalPlayer
	local MAX_HIGHLIGHTS = 24
	local UPDATE_INTERVAL = 0.08

	local Esp = {}

	local config = {
		Enabled = false,
		ShowHighlight = false,
		ShowNameDistance = false,
		ShowHealth = false,
		TeamCheck = false,
		UseTeamColor = false,
		Color = Color3.fromRGB(56, 189, 248),
		MaxDistance = 2000,
		FillTransparency = 0.65,
		OutlineTransparency = 0.1,
	}

	type PlayerEntry = {
		player: Player,
		character: Model?,
		highlight: Highlight?,
		billboard: BillboardGui?,
		nameLabel: TextLabel?,
		hpContainer: Frame?,
		hpFill: Frame?,
		conns: { RBXScriptConnection },
	}

	local entries: { [Player]: PlayerEntry } = {}
	local espFolder: Folder? = nil
	local globalConns: { RBXScriptConnection } = {}
	local renderConn: RBXScriptConnection? = nil
	local elapsedAcc = 0
	local destroyed = false

	local function getEspFolder(): Folder?
		local cam = workspace.CurrentCamera
		if not cam then
			return nil
		end
		if espFolder and espFolder.Parent == cam then
			return espFolder
		end
		if espFolder then
			espFolder:Destroy()
		end
		local folder = Instance.new("Folder")
		folder.Name = "RayfieldESP"
		folder.Parent = cam
		espFolder = folder
		return folder
	end

	local function clearVisuals(entry: PlayerEntry)
		if entry.highlight then
			entry.highlight:Destroy()
			entry.highlight = nil
		end
		if entry.billboard then
			entry.billboard:Destroy()
			entry.billboard = nil
		end
		entry.nameLabel = nil
		entry.hpContainer = nil
		entry.hpFill = nil
	end

	local function resolveAdorneePart(character: Model): BasePart?
		local head = character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			return head
		end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			return hrp
		end
		if character.PrimaryPart then
			return character.PrimaryPart
		end
		return character:FindFirstChildWhichIsA("BasePart")
	end

	local function getTargetColor(player: Player): Color3
		if config.UseTeamColor and not player.Neutral and player.Team then
			return player.TeamColor.Color
		end
		return config.Color
	end

	local function isTeammate(player: Player): boolean
		if not config.TeamCheck then
			return false
		end
		if LocalPlayer.Neutral or player.Neutral then
			return false
		end
		return LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team
	end

	local function ensureBillboard(entry: PlayerEntry, character: Model)
		if entry.billboard and entry.billboard.Parent then
			return
		end
		local folder = getEspFolder()
		if not folder then
			return
		end
		local adornee = resolveAdorneePart(character)
		if not adornee then
			return
		end

		local bb = Instance.new("BillboardGui")
		bb.Name = "ESP_" .. entry.player.Name
		bb.Adornee = adornee
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.MaxDistance = config.MaxDistance
		bb.Size = UDim2.fromOffset(170, 44)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0)
		bb.ResetOnSpawn = false
		bb.Enabled = false
		bb.Parent = folder

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Name = "Info"
		nameLbl.BackgroundTransparency = 1
		nameLbl.Position = UDim2.fromOffset(0, 0)
		nameLbl.Size = UDim2.new(1, 0, 0, 24)
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextSize = 13
		nameLbl.TextColor3 = getTargetColor(entry.player)
		nameLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
		nameLbl.TextStrokeTransparency = 0.25
		nameLbl.Text = entry.player.DisplayName
		nameLbl.Parent = bb

		local hpBg = Instance.new("Frame")
		hpBg.Name = "HPBar"
		hpBg.AnchorPoint = Vector2.new(0.5, 0)
		hpBg.Position = UDim2.new(0.5, 0, 0, 26)
		hpBg.Size = UDim2.fromOffset(82, 5)
		hpBg.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
		hpBg.BorderSizePixel = 0
		hpBg.Parent = bb

		local hpCorner = Instance.new("UICorner")
		hpCorner.CornerRadius = UDim.new(0, 3)
		hpCorner.Parent = hpBg

		local hpStroke = Instance.new("UIStroke")
		hpStroke.Color = Color3.new(0, 0, 0)
		hpStroke.Thickness = 1
		hpStroke.Transparency = 0.35
		hpStroke.Parent = hpBg

		local hpFill = Instance.new("Frame")
		hpFill.Name = "Fill"
		hpFill.Size = UDim2.fromScale(1, 1)
		hpFill.BackgroundColor3 = Color3.fromRGB(74, 222, 128)
		hpFill.BorderSizePixel = 0
		hpFill.Parent = hpBg

		local fillCorner = Instance.new("UICorner")
		fillCorner.CornerRadius = UDim.new(0, 3)
		fillCorner.Parent = hpFill

		entry.billboard = bb
		entry.nameLabel = nameLbl
		entry.hpContainer = hpBg
		entry.hpFill = hpFill
	end

	local function ensureHighlight(entry: PlayerEntry, character: Model)
		if entry.highlight and entry.highlight.Parent then
			if entry.highlight.Adornee ~= character then
				entry.highlight.Adornee = character
			end
			return
		end
		local folder = getEspFolder()
		if not folder then
			return
		end

		local hl = Instance.new("Highlight")
		hl.Name = "HL_" .. entry.player.Name
		hl.Adornee = character
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillColor = getTargetColor(entry.player)
		hl.OutlineColor = Color3.new(1, 1, 1)
		hl.FillTransparency = config.FillTransparency
		hl.OutlineTransparency = config.OutlineTransparency
		hl.Enabled = true
		hl.Parent = folder
		entry.highlight = hl
	end

	local function bindCharacter(entry: PlayerEntry, character: Model?)
		clearVisuals(entry)
		entry.character = character
		if not config.Enabled or not character then
			return
		end
		ensureBillboard(entry, character)
	end

	local function registerPlayer(player: Player)
		if player == LocalPlayer or entries[player] then
			return
		end

		local entry: PlayerEntry = {
			player = player,
			character = player.Character,
			highlight = nil,
			billboard = nil,
			nameLabel = nil,
			hpContainer = nil,
			hpFill = nil,
			conns = {},
		}
		entries[player] = entry

		table.insert(entry.conns, player.CharacterAdded:Connect(function(char: Model)
			bindCharacter(entry, char)
		end))
		table.insert(entry.conns, player.CharacterRemoving:Connect(function()
			bindCharacter(entry, nil)
		end))

		if config.Enabled and player.Character then
			bindCharacter(entry, player.Character)
		end
	end

	local function unregisterPlayer(player: Player)
		local entry = entries[player]
		if not entry then
			return
		end
		for _, conn in ipairs(entry.conns) do
			conn:Disconnect()
		end
		table.clear(entry.conns)
		clearVisuals(entry)
		entries[player] = nil
	end

	local function getOriginPosition(): Vector3?
		local char = LocalPlayer.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") then
				return hrp.Position
			end
		end
		local cam = workspace.CurrentCamera
		if cam then
			return cam.CFrame.Position
		end
		return nil
	end

	local function updateAllEntries()
		if not config.Enabled then
			return
		end

		local origin = getOriginPosition()
		local visibleCandidates: { { entry: PlayerEntry, dist: number } } = {}

		for _, entry in pairs(entries) do
			local char = entry.character
			if not char or not char.Parent then
				char = entry.player.Character
				entry.character = char
			end

			if not char or not char.Parent or isTeammate(entry.player) then
				if entry.billboard then
					entry.billboard.Enabled = false
				end
				if entry.highlight then
					entry.highlight:Destroy()
					entry.highlight = nil
				end
				continue
			end

			local adornee = resolveAdorneePart(char)
			if not adornee then
				if entry.billboard then
					entry.billboard.Enabled = false
				end
				continue
			end

			local dist = if origin then (adornee.Position - origin).Magnitude else 0
			if dist > config.MaxDistance then
				if entry.billboard then
					entry.billboard.Enabled = false
				end
				if entry.highlight then
					entry.highlight:Destroy()
					entry.highlight = nil
				end
				continue
			end

			ensureBillboard(entry, char)
			local color = getTargetColor(entry.player)

			if entry.billboard then
				entry.billboard.Adornee = adornee
				entry.billboard.MaxDistance = config.MaxDistance
				entry.billboard.Enabled = config.ShowNameDistance or config.ShowHealth
			end

			if entry.nameLabel then
				entry.nameLabel.Visible = config.ShowNameDistance
				if config.ShowNameDistance then
					entry.nameLabel.TextColor3 = color
					entry.nameLabel.Text = ("%s [%dm]"):format(entry.player.DisplayName, math.round(dist))
				end
			end

			if entry.hpContainer and entry.hpFill then
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				local showHp = config.ShowHealth and humanoid ~= nil and humanoid.MaxHealth > 0
				entry.hpContainer.Visible = showHp
				if showHp and humanoid then
					local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
					entry.hpFill.Size = UDim2.fromScale(ratio, 1)
					if ratio > 0.6 then
						entry.hpFill.BackgroundColor3 = Color3.fromRGB(74, 222, 128)
					elseif ratio > 0.3 then
						entry.hpFill.BackgroundColor3 = Color3.fromRGB(250, 204, 21)
					else
						entry.hpFill.BackgroundColor3 = Color3.fromRGB(248, 113, 113)
					end
				end
			end

			if config.ShowHighlight then
				table.insert(visibleCandidates, { entry = entry, dist = dist })
			elseif entry.highlight then
				entry.highlight:Destroy()
				entry.highlight = nil
			end
		end

		if config.ShowHighlight and #visibleCandidates > 0 then
			table.sort(visibleCandidates, function(a, b)
				return a.dist < b.dist
			end)
			for idx, item in ipairs(visibleCandidates) do
				local entry = item.entry
				local char = entry.character
				if idx <= MAX_HIGHLIGHTS and char then
					ensureHighlight(entry, char)
					if entry.highlight then
						local color = getTargetColor(entry.player)
						entry.highlight.FillColor = color
						entry.highlight.OutlineColor = Color3.new(1, 1, 1)
						entry.highlight.FillTransparency = config.FillTransparency
						entry.highlight.OutlineTransparency = config.OutlineTransparency
						entry.highlight.Enabled = true
					end
				elseif entry.highlight then
					entry.highlight:Destroy()
					entry.highlight = nil
				end
			end
		end
	end

	local function startLoop()
		if renderConn or destroyed then
			return
		end
		getEspFolder()
		for _, plr in ipairs(Players:GetPlayers()) do
			registerPlayer(plr)
			local entry = entries[plr]
			if entry then
				bindCharacter(entry, plr.Character)
			end
		end
		elapsedAcc = UPDATE_INTERVAL
		renderConn = RunService.RenderStepped:Connect(function(dt: number)
			elapsedAcc += dt
			if elapsedAcc < UPDATE_INTERVAL then
				return
			end
			elapsedAcc = 0
			updateAllEntries()
		end)
	end

	local function stopLoop()
		if renderConn then
			renderConn:Disconnect()
			renderConn = nil
		end
		for _, entry in pairs(entries) do
			clearVisuals(entry)
		end
		if espFolder then
			espFolder:Destroy()
			espFolder = nil
		end
	end

	table.insert(globalConns, Players.PlayerAdded:Connect(registerPlayer))
	table.insert(globalConns, Players.PlayerRemoving:Connect(unregisterPlayer))
	table.insert(globalConns, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		if config.Enabled then
			stopLoop()
			startLoop()
		end
	end))

	function Esp:SetEnabled(enabled: boolean)
		if config.Enabled == enabled then
			return
		end
		config.Enabled = enabled
		if enabled then
			startLoop()
		else
			stopLoop()
		end
	end

	function Esp:SetShowHighlight(enabled: boolean)
		config.ShowHighlight = enabled
		if config.Enabled then updateAllEntries() end
	end

	function Esp:SetShowNameDistance(enabled: boolean)
		config.ShowNameDistance = enabled
		if config.Enabled then updateAllEntries() end
	end

	function Esp:SetShowHealth(enabled: boolean)
		config.ShowHealth = enabled
		if config.Enabled then updateAllEntries() end
	end

	function Esp:SetTeamCheck(enabled: boolean)
		config.TeamCheck = enabled
		if config.Enabled then updateAllEntries() end
	end

	function Esp:SetColor(color: Color3)
		config.Color = color
		if config.Enabled then updateAllEntries() end
	end

	function Esp:SetMaxDistance(distance: number)
		config.MaxDistance = math.max(50, distance)
		if config.Enabled then updateAllEntries() end
	end

	function Esp:IsEnabled(): boolean
		return config.Enabled
	end

	function Esp:Destroy()
		destroyed = true
		config.Enabled = false
		stopLoop()
		for _, conn in ipairs(globalConns) do
			conn:Disconnect()
		end
		table.clear(globalConns)
		for plr in pairs(entries) do
			unregisterPlayer(plr)
		end
	end

	return Esp
end)()

--====================================================
-- 4. AUTOMATION MODULE (AUTO RESEARCH 3 BƯỚC & FAST CRAFT)
--====================================================
local Automation = (function()
	local HttpService = game:GetService("HttpService")
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local LocalPlayer = Players.LocalPlayer

	local Automation = {}

	local cachedGameData: any = nil
	local gameDataChecked = false

	local inventory: { [string]: number } = {}
	local stash: { [string]: number } = {}
	local hasInventoryData = false
	local lastStashRefresh = 0
	local inventoryConn: RBXScriptConnection? = nil
	local destroyed = false

	local researchBusy = false
	local notebookLabBusy = false
	local craftBusy = false
	local failedResearchCooldown: { [string]: number } = {}
	local learnedMinDelay = 0

	local researchConfig = {
		AutoEnabled = false,
		Interval = 1.2,
		ConfirmDelay = 11.5,
	}

	local lastResearchMsg = "Chưa chạy"

	local craftConfig = {
		AutoEnabled = false,
		SelectedId = "",
		Quantity = 1,
		FastAssemble = false,
		AutoClampMax = false,
		Interval = 0.5,
	}

	local researchLoopToken = 0
	local craftLoopToken = 0
	local notifyCallback: ((string, string, Color3?) -> ())? = nil

	local researchLabMod: any = nil
	local origResearchRun: any = nil
	local assemblyBenchMod: any = nil
	local origAssemblyRun: any = nil

	local function sendNotice(title: string, msg: string, color: Color3?)
		if notifyCallback then
			notifyCallback(title, msg, color)
		end
	end

	local function isTimingRejectMsg(msgText: string): boolean
		local lower = string.lower(msgText)
		return string.find(lower, "not finished", 1, true) ~= nil
			or string.find(lower, "unfinished", 1, true) ~= nil
			or string.find(lower, "too fast", 1, true) ~= nil
			or string.find(lower, "too early", 1, true) ~= nil
			or string.find(lower, "wait", 1, true) ~= nil
			or string.find(lower, "in progress", 1, true) ~= nil
	end

	local function waitExperimentWindow(targetSec: number, labelName: string, startClock: number, requireAutoEnabled: boolean): boolean
		if targetSec <= 0 then
			return true
		end
		local jitter = if targetSec >= 5 then (math.random(15, 45) / 100) else 0
		local effectiveTarget = targetSec + jitter

		while not destroyed do
			if requireAutoEnabled and not researchConfig.AutoEnabled then
				return false
			end
			local elapsed = os.clock() - startClock
			local remain = effectiveTarget - elapsed
			if remain <= 0 then
				return true
			end
			local progress = math.clamp(elapsed / effectiveTarget, 0, 1)
			local stepLabel = if progress < 0.32
				then "Bước 1/3 (Quét điểm)"
				elseif progress < 0.64 then "Bước 2/3 (Nối mạch)"
				elseif progress < 0.92 then "Bước 3/3 (Cân chỉnh/Pha)"
				else "Hoàn tất thí nghiệm"
			lastResearchMsg = ("%s - %s (còn %.1fs)"):format(stepLabel, labelName, remain)
			task.wait(math.min(0.25, remain))
		end
		return false
	end

	local function abortActiveLabMinigame(): boolean
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		local hasHud = pg ~= nil and pg:FindFirstChild("ResearchLabHUD") ~= nil
		local hasLocal = workspace:FindFirstChild("ResearchLabLocal") ~= nil
		if not hasHud and not hasLocal then
			return false
		end
		local mod = ReplicatedStorage:FindFirstChild("ResearchLab")
		if mod and mod:IsA("ModuleScript") then
			local ok, tbl = pcall(require, mod)
			if ok and type(tbl) == "table" and type(tbl.abort) == "function" then
				pcall(tbl.abort)
				return true
			end
		end
		return false
	end

	local function hookResearchLab()
		if origResearchRun then
			return
		end
		local mod = ReplicatedStorage:FindFirstChild("ResearchLab")
		if mod and mod:IsA("ModuleScript") then
			local ok, tbl = pcall(require, mod)
			if ok and type(tbl) == "table" and type(tbl.run) == "function" then
				researchLabMod = tbl
				origResearchRun = tbl.run
				tbl.run = function(args: any)
					if not destroyed and researchConfig.AutoEnabled then
						notebookLabBusy = true
						local r = if type(args) == "table" then args.research else nil
						local rName = tostring(if type(r) == "table" then (r.name or r.id) else "Research")
						local waitSec = math.max(researchConfig.ConfirmDelay, learnedMinDelay, 11.5)
						local okWait = waitExperimentWindow(waitSec, rName, os.clock(), true)
						notebookLabBusy = false
						if not okWait then
							return "cancel"
						end
						lastResearchMsg = ("Hoàn tất minigame 3 bước: %s"):format(rName)
						sendNotice("Auto Research", lastResearchMsg, Color3.fromRGB(52, 211, 153))
						return "done"
					end
					return origResearchRun(args)
				end
			end
		end
	end

	local function hookAssemblyBench()
		if origAssemblyRun then
			return
		end
		local mod = ReplicatedStorage:FindFirstChild("AssemblyBench")
		if mod and mod:IsA("ModuleScript") then
			local ok, tbl = pcall(require, mod)
			if ok and type(tbl) == "table" and type(tbl.run) == "function" then
				assemblyBenchMod = tbl
				origAssemblyRun = tbl.run
				tbl.run = function(args: any)
					if not destroyed and (craftConfig.FastAssemble or craftConfig.AutoEnabled) then
						local resName = if type(args) == "table" then args.result else "Item"
						sendNotice("Fast Craft", ("Bỏ qua minigame: %s"):format(tostring(resName)), Color3.fromRGB(52, 211, 153))
						return "done"
					end
					return origAssemblyRun(args)
				end
			end
		end
	end

	local function getGameData(): any
		if not gameDataChecked then
			gameDataChecked = true
			local mod = ReplicatedStorage:FindFirstChild("GameData") or ReplicatedStorage:WaitForChild("GameData", 3)
			if mod and mod:IsA("ModuleScript") then
				local ok, data = pcall(require, mod)
				if ok and type(data) == "table" then
					cachedGameData = data
				end
			end
		end
		return cachedGameData
	end

	local function decodeAttrTable(attrName: string): { [string]: any }
		local raw = LocalPlayer:GetAttribute(attrName)
		if type(raw) ~= "string" or raw == "" then
			return {}
		end
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if ok and type(decoded) == "table" then
			return decoded
		end
		return {}
	end

	local function initInventorySync()
		if inventoryConn or destroyed then
			return
		end
		local invSync = ReplicatedStorage:FindFirstChild("InventorySync")
		if invSync and invSync:IsA("RemoteEvent") then
			inventoryConn = invSync.OnClientEvent:Connect(function(payload: any)
				if type(payload) == "table" then
					inventory = payload
					hasInventoryData = true
				end
			end)
			pcall(function()
				invSync:FireServer()
			end)
		end
	end

	local function refreshStash(force: boolean?)
		if not force and (os.clock() - lastStashRefresh < 2.5) then
			return
		end
		lastStashRefresh = os.clock()
		task.spawn(function()
			local stashAction = ReplicatedStorage:FindFirstChild("StashAction")
