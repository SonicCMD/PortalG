local function getExecGlobal(name)
	local okEnv, genv = pcall(function()
		return getgenv and getgenv()
	end)
	if okEnv and type(genv) == "table" and genv[name] ~= nil then
		return genv[name]
	end
	return rawget(_G, name)
end

local function resolveGuiParent()
	local gethuiFn = getExecGlobal("gethui")
	if type(gethuiFn) ~= "function" then
		local okDirect, direct = pcall(function()
			return typeof(gethui) == "function" and gethui or nil
		end)
		if okDirect and type(direct) == "function" then
			gethuiFn = direct
		end
	end
	if type(gethuiFn) == "function" then
		local okHui, hui = pcall(gethuiFn)
		if okHui and typeof(hui) == "Instance" then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local okAccess = pcall(function()
			return coreGui:FindFirstChild("RayfieldMenuGui")
		end)
		if okAccess then
			return coreGui
		end
	end

	return PlayerGui
end

local function protectGuiIfSupported(gui)
	local synTbl = getExecGlobal("syn")
	if type(synTbl) == "table" and type(synTbl.protect_gui) == "function" then
		pcall(synTbl.protect_gui, gui)
		return
	end
	local protectFn = getExecGlobal("protect_gui") or getExecGlobal("protectgui")
	if type(protectFn) == "function" then
		pcall(protectFn, gui)
	end
end

