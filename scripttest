local function resolveFirePromptFn()
	local okEnv, genv = pcall(function()
		return getgenv and getgenv()
	end)
	if okEnv and type(genv) == "table" and type(genv.fireproximityprompt) == "function" then
		return genv.fireproximityprompt
	end
	local rawFn = rawget(_G, "fireproximityprompt")
	if type(rawFn) == "function" then
		return rawFn
	end
	local okDirect, direct = pcall(function()
		return typeof(fireproximityprompt) == "function" and fireproximityprompt or nil
	end)
	if okDirect and type(direct) == "function" then
		return direct
	end
	return nil
end

