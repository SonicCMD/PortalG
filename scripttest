local function waitExperimentWindow(targetSec: number, labelName: string, startClock: number, requireAutoEnabled: boolean): boolean
	if targetSec <= 0 then
		return true
	end
	local jitter = if targetSec >= 5 then (math.random(15, 45) / 100) else 0
	local effectiveTarget = targetSec + jitter

	while not destroyed do
		if requireAutoEnabled and not researchConfig.AutoEnabled then
			return false
		end
		local elapsed = os.clock() - startClock
		local remain = effectiveTarget - elapsed
		if remain <= 0 then
			return true
		end
		local progress = math.clamp(elapsed / effectiveTarget, 0, 1)
		local stepLabel = if progress < 0.32
			then "Stage 1/3 (Scanning)"
			elseif progress < 0.64 then "Stage 2/3 (Circuit)"
			elseif progress < 0.92 then "Stage 3/3 (Calibration)"
			else "Finishing Experiment"
		lastResearchMsg = ("%s - %s (%.1fs left)"):format(stepLabel, labelName, remain)
		task.wait(math.min(0.25, remain))
	end
	return false
end

local function hookResearchLab()
	if origResearchRun then
		return
	end
	local mod = ReplicatedStorage:FindFirstChild("ResearchLab")
	if mod and mod:IsA("ModuleScript") then
		local ok, tbl = pcall(require, mod)
		if ok and type(tbl) == "table" and type(tbl.run) == "function" then
			researchLabMod = tbl
			origResearchRun = tbl.run
			tbl.run = function(args: any)
				-- Only intercept with fast stage-paced runner when platform has no input injector (e.g. plain Studio LocalScript).
				-- On DeltaX Mobile, let the real ResearchLab minigames run and solve them live via stepMinigameSolver()!
				if not destroyed and researchConfig.AutoEnabled and not detectInputCapability() then
					notebookLabBusy = true
					local r = if type(args) == "table" then args.research else nil
					local rName = tostring(if type(r) == "table" then (r.name or r.id) else "Research")
					local waitSec = math.max(researchConfig.ConfirmDelay, learnedMinDelay, 9.5)
					local okWait = waitExperimentWindow(waitSec, rName, os.clock(), false)
					notebookLabBusy = false
					if not okWait then
						return "done"
					end
					lastResearchMsg = ("Completed 3 stages: %s"):format(rName)
					sendNotice("Auto Research", lastResearchMsg, Color3.fromRGB(52, 211, 153))
					return "done"
				end
				return origResearchRun(args)
			end
		end
	end
end

local function hookAssemblyBench()
	if origAssemblyRun then
		return
	end
	local mod = ReplicatedStorage:FindFirstChild("AssemblyBench")
	if mod and mod:IsA("ModuleScript") then
		local ok, tbl = pcall(require, mod)
		if ok and type(tbl) == "table" and type(tbl.run) == "function" then
			assemblyBenchMod = tbl
			origAssemblyRun = tbl.run
			tbl.run = function(args: any)
