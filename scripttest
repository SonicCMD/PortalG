function Combat:GetCombatStatusText(): string
	local char, hum = getCharParts()
	local hpStr = if hum then ("%d/%d (%.0f%%)"):format(math.floor(hum.Health), math.floor(hum.MaxHealth), (hum.Health / math.max(1, hum.MaxHealth)) * 100) else "N/A"
	local mobs = scanMobs(mobConfig.HuntFilter, mobConfig.MaxHuntDist, false)
	local nearestStr = if mobs[1] then ("%s (%.0fm)"):format(mobs[1].displayName, mobs[1].dist) else "None"
	return ("HP: %s | Mobs: %d | Nearest: %s\nGuardian: Void=%s Heal=%s AutoHome=%s | Kills: %d\nAimLock: %s | Farm Status: %s"):format(
		hpStr,
		#mobs,
		nearestStr,
		if guardConfig.AntiVoid then "ON" else "OFF",
		if guardConfig.AutoHeal then "ON" else "OFF",
		if guardConfig.AutoEscapeHome then "ON" else "OFF",
		killedCount,
		if (mobConfig.AutoAim or mobConfig.AutoHunt) then "ACTIVE" else "OFF",
		lastMobMsg
	)
end

function Combat:GetMissionStatusText(): string
	local info = self:GetActiveMissionInfo()
	local curDim = tostring(LocalPlayer:GetAttribute("CurrentDimension") or "?")
	local safetyNote = "Safe"
	if info.requiredDim and info.requiredDim ~= "" and info.requiredDim ~= curDim then
		local homeDim = tostring(LocalPlayer:GetAttribute("HomeDimension") or curDim)
		if not ((info.requiredDim == "C137" or info.requiredDim == "Earth") and curDim == homeDim) then
			safetyNote = "Need Portal: " .. info.requiredDim
		end
	elseif info.requiredSuit and not info.suitOk then
		safetyNote = "Need Suit: " .. info.requiredSuit
	end
	return ("%s: %s (%d/%d)\nGoal: %s | Safety: %s\nStatus: %s"):format(
		info.source,
		info.title,
		info.have,
		info.need,
		info.goalText,
		safetyNote,
		lastMissionMsg
	)
end

function Combat:Destroy()
	destroyed = true
	guardConfig.AntiVoid = false
	guardConfig.AutoHeal = false
	guardConfig.AutoEscapeHome = false
	mobConfig.AutoAim = false
	mobConfig.AutoHunt = false
	mobConfig.MobEsp = false
	missionConfig.AutoEnabled = false
	huntToken += 1
	missionToken += 1
	table.clear(skippedMobs)
	table.clear(mobSkipCounts)
	releaseMissionSubModes()
	clearMobEsp()
	uninstallAimHook()
	refreshRuntimeLoop()
end

return Combat

end)()

