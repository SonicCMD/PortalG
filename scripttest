-- 2. FIX LAG CONTROLLER (Reversible Optimizer)
--====================================================
local FixLag = (function()
	local FixLagModule = {}

	local config = {
		ShadowsAndPostFX = false,
		ParticlesAndTrails = false,
		MaterialsAndTextures = false,
		LowTerrain = false,
		SkipCharacters = true,
	}

	local savedLighting: { [string]: any } = {}
	local savedTerrain: { [string]: any } = {}
	local savedPostFx = setmetatable({}, { __mode = "k" }) :: { [Instance]: boolean }
	local savedLightShadows = setmetatable({}, { __mode = "k" }) :: { [Instance]: boolean }
	local savedParticles = setmetatable({}, { __mode = "k" }) :: { [Instance]: boolean }
	local savedPartProps = setmetatable({}, { __mode = "k" }) :: { [BasePart]: { Material: Enum.Material, CastShadow: boolean } }
	local savedDecalTransp = setmetatable({}, { __mode = "k" }) :: { [Decal]: number }
	local savedSurfaceAppearance: { [SurfaceAppearance]: Instance } = {}

	local workspaceConn: RBXScriptConnection? = nil
	local lightingConn: RBXScriptConnection? = nil
	local scanToken = 0
	local destroyed = false

	local PARTICLE_CLASSES = {
		ParticleEmitter = true,
		Trail = true,
		Beam = true,
		Smoke = true,
		Fire = true,
		Sparkles = true,
	}

	local function isProtectedInstance(inst: Instance): boolean
		local cam = workspace.CurrentCamera
		if cam and inst:IsDescendantOf(cam) then
			return true
		end
		if config.SkipCharacters then
			for _, plr in ipairs(Players:GetPlayers()) do
				local char = plr.Character
				if char and (inst == char or inst:IsDescendantOf(char)) then
					return true
				end
			end
		end
		return false
	end

	local function applyPostFxItem(inst: Instance)
		if not config.ShadowsAndPostFX then
			return
		end
		if inst:IsA("PostEffect") then
			if savedPostFx[inst] == nil then
				savedPostFx[inst] = inst.Enabled
			end
			inst.Enabled = false
		elseif inst:IsA("Light") then
			if savedLightShadows[inst] == nil then
				savedLightShadows[inst] = inst.Shadows
			end
			inst.Shadows = false
		end
	end

	local function applyParticleItem(inst: Instance)
		if not config.ParticlesAndTrails then
			return
		end
		if PARTICLE_CLASSES[inst.ClassName] then
			if isProtectedInstance(inst) then
				return
			end
			local anyInst = inst :: any
			if savedParticles[inst] == nil then
				savedParticles[inst] = anyInst.Enabled
			end
			anyInst.Enabled = false
		end
	end

	local function applyMaterialItem(inst: Instance)
		if not config.MaterialsAndTextures then
			return
		end
		if isProtectedInstance(inst) then
			return
		end

		if inst:IsA("BasePart") and not inst:IsA("Terrain") then
			if savedPartProps[inst] == nil then
				savedPartProps[inst] = {
					Material = inst.Material,
					CastShadow = inst.CastShadow,
				}
			end
			inst.Material = Enum.Material.SmoothPlastic
			inst.CastShadow = false
		elseif inst:IsA("Decal") then
			if savedDecalTransp[inst] == nil then
				savedDecalTransp[inst] = inst.Transparency
			end
			inst.Transparency = 1
		elseif inst:IsA("SurfaceAppearance") then
			local parent = inst.Parent
			if parent and savedSurfaceAppearance[inst] == nil then
				local ok = pcall(function()
					inst.Parent = nil
				end)
				if ok then
					savedSurfaceAppearance[inst] = parent
				end
			end
		end
	end

	local function processInstance(inst: Instance)
		applyPostFxItem(inst)
		applyParticleItem(inst)
		applyMaterialItem(inst)
	end

	local function applyLightingAndPostFX()
		if config.ShadowsAndPostFX then
			if savedLighting.GlobalShadows == nil then
				savedLighting.GlobalShadows = Lighting.GlobalShadows
				savedLighting.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
				savedLighting.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
				pcall(function()
					savedLighting.ShadowSoftness = Lighting.ShadowSoftness
				end)
			end
			Lighting.GlobalShadows = false
			Lighting.EnvironmentDiffuseScale = 0
			Lighting.EnvironmentSpecularScale = 0
			pcall(function()
				Lighting.ShadowSoftness = 0
			end)

			for _, child in ipairs(Lighting:GetDescendants()) do
				applyPostFxItem(child)
			end
			local cam = workspace.CurrentCamera
			if cam then
				for _, child in ipairs(cam:GetChildren()) do
					if child:IsA("PostEffect") then
						applyPostFxItem(child)
					end
				end
			end
		else
			if savedLighting.GlobalShadows ~= nil then
				Lighting.GlobalShadows = savedLighting.GlobalShadows
				Lighting.EnvironmentDiffuseScale = savedLighting.EnvironmentDiffuseScale
				Lighting.EnvironmentSpecularScale = savedLighting.EnvironmentSpecularScale
				if savedLighting.ShadowSoftness ~= nil then
					pcall(function()
						Lighting.ShadowSoftness = savedLighting.ShadowSoftness
					end)
				end
				table.clear(savedLighting)
			end

			for inst, origEnabled in pairs(savedPostFx) do
				if inst.Parent then
					pcall(function()
						(inst :: PostEffect).Enabled = origEnabled
					end)
				end
			end
			table.clear(savedPostFx)

			for inst, origShadow in pairs(savedLightShadows) do
				if inst.Parent then
					pcall(function()
						(inst :: Light).Shadows = origShadow
					end)
				end
			end
			table.clear(savedLightShadows)
		end
	end

	local function applyTerrain()
		local terrain = workspace.Terrain
		if not terrain then
			return
		end
		if config.LowTerrain then
			if savedTerrain.WaterWaveSize == nil then
				savedTerrain.WaterWaveSize = terrain.WaterWaveSize
				savedTerrain.WaterWaveSpeed = terrain.WaterWaveSpeed
				savedTerrain.WaterReflectance = terrain.WaterReflectance
				savedTerrain.WaterTransparency = terrain.WaterTransparency
				pcall(function()
					savedTerrain.Decoration = (terrain :: any).Decoration
				end)
			end
			terrain.WaterWaveSize = 0
			terrain.WaterWaveSpeed = 0
			terrain.WaterReflectance = 0
			terrain.WaterTransparency = 0
			pcall(function()
				(terrain :: any).Decoration = false
			end)
		else
			if savedTerrain.WaterWaveSize ~= nil then
				terrain.WaterWaveSize = savedTerrain.WaterWaveSize
				terrain.WaterWaveSpeed = savedTerrain.WaterWaveSpeed
				terrain.WaterReflectance = savedTerrain.WaterReflectance
				terrain.WaterTransparency = savedTerrain.WaterTransparency
				if savedTerrain.Decoration ~= nil then
					pcall(function()
						(terrain :: any).Decoration = savedTerrain.Decoration
					end)
				end
				table.clear(savedTerrain)
			end
		end
	end

	local function restoreParticles()
		for inst, origEnabled in pairs(savedParticles) do
			if inst.Parent then
				pcall(function()
					(inst :: any).Enabled = origEnabled
				end)
			end
		end
		table.clear(savedParticles)
	end

	local function restoreMaterialsAndTextures()
		for part, props in pairs(savedPartProps) do
			if part.Parent then
				pcall(function()
					part.Material = props.Material
					part.CastShadow = props.CastShadow
				end)
			end
		end
		table.clear(savedPartProps)

		for decal, origTransp in pairs(savedDecalTransp) do
			if decal.Parent then
				pcall(function()
					decal.Transparency = origTransp
				end)
			end
		end
		table.clear(savedDecalTransp)

		for sa, origParent in pairs(savedSurfaceAppearance) do
			if origParent.Parent then
				pcall(function()
					sa.Parent = origParent
				end)
			end
		end
		table.clear(savedSurfaceAppearance)
	end

	local function refreshListeners()
		local needsWorkspaceWatch = config.ShadowsAndPostFX or config.ParticlesAndTrails or config.MaterialsAndTextures

		if needsWorkspaceWatch and not workspaceConn and not destroyed then
			workspaceConn = workspace.DescendantAdded:Connect(function(inst: Instance)
				processInstance(inst)
			end)
		elseif not needsWorkspaceWatch and workspaceConn then
			workspaceConn:Disconnect()
			workspaceConn = nil
		end

		if config.ShadowsAndPostFX and not lightingConn and not destroyed then
			lightingConn = Lighting.DescendantAdded:Connect(function(inst: Instance)
				applyPostFxItem(inst)
			end)
		elseif not config.ShadowsAndPostFX and lightingConn then
			lightingConn:Disconnect()
			lightingConn = nil
		end
	end

	function FixLagModule:RescanWorkspaceAsync()
		if destroyed then
			return
		end
		if not (config.ShadowsAndPostFX or config.ParticlesAndTrails or config.MaterialsAndTextures) then
			return
		end

		scanToken += 1
		local myToken = scanToken

		task.spawn(function()
			local descendants = workspace:GetDescendants()
			local count = 0
			for _, inst in ipairs(descendants) do
				if myToken ~= scanToken or destroyed then
					return
				end
				processInstance(inst)
				count += 1
				if count >= 350 then
					count = 0
					RunService.Heartbeat:Wait()
				end
			end
		end)
	end

	function FixLagModule:SetShadowsAndPostFX(enabled: boolean)
		config.ShadowsAndPostFX = enabled
		applyLightingAndPostFX()
		refreshListeners()
		if enabled then self:RescanWorkspaceAsync() end
	end

	function FixLagModule:SetParticlesAndTrails(enabled: boolean)
		config.ParticlesAndTrails = enabled
		if not enabled then restoreParticles() end
		refreshListeners()
		if enabled then self:RescanWorkspaceAsync() end
	end

	function FixLagModule:SetMaterialsAndTextures(enabled: boolean)
		config.MaterialsAndTextures = enabled
		if not enabled then restoreMaterialsAndTextures() end
		refreshListeners()
		if enabled then self:RescanWorkspaceAsync() end
	end

	function FixLagModule:SetLowTerrain(enabled: boolean)
		config.LowTerrain = enabled
		applyTerrain()
	end

	function FixLagModule:SetSkipCharacters(enabled: boolean)
		if config.SkipCharacters == enabled then
			return
		end
		config.SkipCharacters = enabled
		if config.ParticlesAndTrails then restoreParticles() end
		if config.MaterialsAndTextures then restoreMaterialsAndTextures() end
		self:RescanWorkspaceAsync()
	end

	function FixLagModule:SetAll(enabled: boolean)
		config.ShadowsAndPostFX = enabled
		config.ParticlesAndTrails = enabled
		config.MaterialsAndTextures = enabled
		config.LowTerrain = enabled

		applyLightingAndPostFX()
		applyTerrain()
		if not enabled then
			scanToken += 1
			restoreParticles()
			restoreMaterialsAndTextures()
		end
		refreshListeners()
		if enabled then self:RescanWorkspaceAsync() end
	end

	function FixLagModule:GetActiveCount(): number
		local n = 0
		if config.ShadowsAndPostFX then n += 1 end
		if config.ParticlesAndTrails then n += 1 end
		if config.MaterialsAndTextures then n += 1 end
		if config.LowTerrain then n += 1 end
		return n
	end

	function FixLagModule:Destroy()
		destroyed = true
		self:SetAll(false)
		if workspaceConn then
			workspaceConn:Disconnect()
			workspaceConn = nil
		end
		if lightingConn then
			lightingConn:Disconnect()
			lightingConn = nil
		end
	end

	return FixLagModule
end)()

--====================================================
-- 3. ESP CONTROLLER (Highlight + BillboardGui)
--====================================================
local Esp = (function()
	local MAX_HIGHLIGHTS = 24
	local UPDATE_INTERVAL = 0.08
	local EspModule = {}

	local config = {
		Enabled = false,
		ShowHighlight = true,
		ShowNameDistance = true,
		ShowHealth = true,
		TeamCheck = false,
		UseTeamColor = true,
		Color = Color3.fromRGB(56, 189, 248),
		MaxDistance = 2000,
		FillTransparency = 0.65,
		OutlineTransparency = 0.1,
	}

	type PlayerEntry = {
		player: Player,
		character: Model?,
		highlight: Highlight?,
		billboard: BillboardGui?,
		nameLabel: TextLabel?,
		hpContainer: Frame?,
		hpFill: Frame?,
		conns: { RBXScriptConnection },
	}

	local entries: { [Player]: PlayerEntry } = {}
	local espFolder: Folder? = nil
	local globalConns: { RBXScriptConnection } = {}
	local renderConn: RBXScriptConnection? = nil
	local elapsedAcc = 0
	local destroyed = false

	local function getEspFolder(): Folder?
		local cam = workspace.CurrentCamera
		if not cam then
			return nil
		end
		if espFolder and espFolder.Parent == cam then
			return espFolder
		end
		if espFolder then
			espFolder:Destroy()
		end
		local folder = Instance.new("Folder")
		folder.Name = "RayfieldESP"
		folder.Parent = cam
		espFolder = folder
		return folder
	end

	local function clearVisuals(entry: PlayerEntry)
		if entry.highlight then
			entry.highlight:Destroy()
			entry.highlight = nil
		end
		if entry.billboard then
			entry.billboard:Destroy()
			entry.billboard = nil
		end
		entry.nameLabel = nil
		entry.hpContainer = nil
		entry.hpFill = nil
	end

	local function resolveAdorneePart(character: Model): BasePart?
		local head = character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			return head
		end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			return hrp
		end
		if character.PrimaryPart then
			return character.PrimaryPart
		end
		return character:FindFirstChildWhichIsA("BasePart")
	end

	local function getTargetColor(player: Player): Color3
		if config.UseTeamColor and not player.Neutral and player.Team then
			return player.TeamColor.Color
		end
		return config.Color
	end

	local function isTeammate(player: Player): boolean
		if not config.TeamCheck then
			return false
		end
		if LocalPlayer.Neutral or player.Neutral then
			return false
		end
		return LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team
	end

	local function ensureBillboard(entry: PlayerEntry, character: Model)
		if entry.billboard and entry.billboard.Parent then
			return
		end
		local folder = getEspFolder()
		if not folder then
			return
		end
		local adornee = resolveAdorneePart(character)
		if not adornee then
			return
		end

		local bb = Instance.new("BillboardGui")
		bb.Name = "ESP_" .. entry.player.Name
		bb.Adornee = adornee
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.MaxDistance = config.MaxDistance
		bb.Size = UDim2.fromOffset(170, 44)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 2.8, 0)
		bb.ResetOnSpawn = false
		bb.Enabled = false
		bb.Parent = folder

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Name = "Info"
		nameLbl.BackgroundTransparency = 1
		nameLbl.Size = UDim2.new(1, 0, 0, 24)
		nameLbl.Font = Enum.Font.GothamBold
		nameLbl.TextSize = 13
		nameLbl.TextColor3 = getTargetColor(entry.player)
		nameLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
		nameLbl.TextStrokeTransparency = 0.25
		nameLbl.Text = entry.player.DisplayName
		nameLbl.Parent = bb

		local hpBg = Instance.new("Frame")
		hpBg.Name = "HPBar"
		hpBg.AnchorPoint = Vector2.new(0.5, 0)
		hpBg.Position = UDim2.new(0.5, 0, 0, 26)
		hpBg.Size = UDim2.fromOffset(82, 5)
		hpBg.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
		hpBg.BorderSizePixel = 0
		hpBg.Parent = bb

		local hpCorner = Instance.new("UICorner")
		hpCorner.CornerRadius = UDim.new(0, 3)
		hpCorner.Parent = hpBg

		local hpStroke = Instance.new("UIStroke")
		hpStroke.Color = Color3.new(0, 0, 0)
		hpStroke.Thickness = 1
		hpStroke.Transparency = 0.35
		hpStroke.Parent = hpBg

		local hpFill = Instance.new("Frame")
		hpFill.Name = "Fill"
		hpFill.Size = UDim2.fromScale(1, 1)
		hpFill.BackgroundColor3 = Color3.fromRGB(74, 222, 128)
		hpFill.BorderSizePixel = 0
		hpFill.Parent = hpBg

		local fillCorner = Instance.new("UICorner")
		fillCorner.CornerRadius = UDim.new(0, 3)
		fillCorner.Parent = hpFill

		entry.billboard = bb
		entry.nameLabel = nameLbl
		entry.hpContainer = hpBg
		entry.hpFill = hpFill
	end

	local function ensureHighlight(entry: PlayerEntry, character: Model)
		if entry.highlight and entry.highlight.Parent then
			if entry.highlight.Adornee ~= character then
				entry.highlight.Adornee = character
			end
			return
		end
		local folder = getEspFolder()
		if not folder then
			return
		end

		local hl = Instance.new("Highlight")
		hl.Name = "HL_" .. entry.player.Name
		hl.Adornee = character
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillColor = getTargetColor(entry.player)
		hl.OutlineColor = Color3.new(1, 1, 1)
		hl.FillTransparency = config.FillTransparency
		hl.OutlineTransparency = config.OutlineTransparency
		hl.Enabled = true
		hl.Parent = folder
		entry.highlight = hl
	end

	local function bindCharacter(entry: PlayerEntry, character: Model?)
		clearVisuals(entry)
		entry.character = character
		if not config.Enabled or not character then
			return
		end
		ensureBillboard(entry, character)
	end

	local function registerPlayer(player: Player)
		if player == LocalPlayer or entries[player] then
			return
		end
		local entry: PlayerEntry = {
			player = player,
			character = player.Character,
			highlight = nil,
			billboard = nil,
			nameLabel = nil,
			hpContainer = nil,
			hpFill = nil,
			conns = {},
		}
		entries[player] = entry

		table.insert(entry.conns, player.CharacterAdded:Connect(function(char: Model)
			bindCharacter(entry, char)
		end))
		table.insert(entry.conns, player.CharacterRemoving:Connect(function()
			bindCharacter(entry, nil)
		end))

		if config.Enabled and player.Character then
			bindCharacter(entry, player.Character)
		end
	end

	local function unregisterPlayer(player: Player)
		local entry = entries[player]
		if not entry then
			return
		end
		for _, conn in ipairs(entry.conns) do
			conn:Disconnect()
		end
		table.clear(entry.conns)
		clearVisuals(entry)
		entries[player] = nil
	end

	local function getOriginPosition(): Vector3?
		local char = LocalPlayer.Character
		if char then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") then
				return hrp.Position
			end
		end
		local cam = workspace.CurrentCamera
		if cam then
			return cam.CFrame.Position
		end
		return nil
	end

	local function updateAllEntries()
		if not config.Enabled then
			return
		end
		local origin = getOriginPosition()
		local visibleCandidates: { { entry: PlayerEntry, dist: number } } = {}

		for _, entry in pairs(entries) do
			local char = entry.character
			if not char or not char.Parent then
				char = entry.player.Character
				entry.character = char
			end

			if not char or not char.Parent or isTeammate(entry.player) then
				if entry.billboard then
					entry.billboard.Enabled = false
				end
				if entry.highlight then
					entry.highlight:Destroy()
					entry.highlight = nil
				end
				continue
			end

			local adornee = resolveAdorneePart(char)
			if not adornee then
				if entry.billboard then
					entry.billboard.Enabled = false
				end
				continue
			end

			local dist = if origin then (adornee.Position - origin).Magnitude else 0
			if dist > config.MaxDistance then
				if entry.billboard then
					entry.billboard.Enabled = false
				end
				if entry.highlight then
					entry.highlight:Destroy()
					entry.highlight = nil
				end
				continue
			end

			ensureBillboard(entry, char)
			local color = getTargetColor(entry.player)

			if entry.billboard then
				entry.billboard.Adornee = adornee
				entry.billboard.MaxDistance = config.MaxDistance
				entry.billboard.Enabled = config.ShowNameDistance or config.ShowHealth
			end

			if entry.nameLabel then
				entry.nameLabel.Visible = config.ShowNameDistance
				if config.ShowNameDistance then
					entry.nameLabel.TextColor3 = color
					entry.nameLabel.Text = ("%s [%dm]"):format(entry.player.DisplayName, math.round(dist))
				end
			end

			if entry.hpContainer and entry.hpFill then
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				local showHp = config.ShowHealth and humanoid ~= nil and humanoid.MaxHealth > 0
				entry.hpContainer.Visible = showHp
				if showHp and humanoid then
					local ratio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
					entry.hpFill.Size = UDim2.fromScale(ratio, 1)
					if ratio > 0.6 then
						entry.hpFill.BackgroundColor3 = Color3.fromRGB(74, 222, 128)
					elseif ratio > 0.3 then
						entry.hpFill.BackgroundColor3 = Color3.fromRGB(250, 204, 21)
					else
						entry.hpFill.BackgroundColor3 = Color3.fromRGB(248, 113, 113)
					end
				end
			end

			if config.ShowHighlight then
				table.insert(visibleCandidates, { entry = entry, dist = dist })
			elseif entry.highlight then
				entry.highlight:Destroy()
				entry.highlight = nil
			end
		end

		if config.ShowHighlight and #visibleCandidates > 0 then
			table.sort(visibleCandidates, function(a, b)
				return a.dist < b.dist
			end)
			for idx, item in ipairs(visibleCandidates) do
				local entry = item.entry
				local char = entry.character
				if idx <= MAX_HIGHLIGHTS and char then
					ensureHighlight(entry, char)
					if entry.highlight then
						entry.highlight.FillColor = getTargetColor(entry.player)
						entry.highlight.OutlineColor = Color3.new(1, 1, 1)
						entry.highlight.FillTransparency = config.FillTransparency
						entry.highlight.OutlineTransparency = config.OutlineTransparency
						entry.highlight.Enabled = true
					end
				elseif entry.highlight then
					entry.highlight:Destroy()
					entry.highlight = nil
				end
			end
		end
	end

	local function startLoop()
		if renderConn or destroyed then
			return
		end
		getEspFolder()
		for _, plr in ipairs(Players:GetPlayers()) do
			registerPlayer(plr)
			local entry = entries[plr]
			if entry then
				bindCharacter(entry, plr.Character)
			end
		end
		elapsedAcc = UPDATE_INTERVAL
		renderConn = RunService.RenderStepped:Connect(function(dt: number)
			elapsedAcc += dt
			if elapsedAcc < UPDATE_INTERVAL then
				return
			end
			elapsedAcc = 0
			updateAllEntries()
		end)
	end

	local function stopLoop()
		if renderConn then
			renderConn:Disconnect()
			renderConn = nil
		end
		for _, entry in pairs(entries) do
			clearVisuals(entry)
		end
		if espFolder then
			espFolder:Destroy()
			espFolder = nil
		end
	end

	table.insert(globalConns, Players.PlayerAdded:Connect(registerPlayer))
	table.insert(globalConns, Players.PlayerRemoving:Connect(unregisterPlayer))
	table.insert(globalConns, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		if config.Enabled then
			stopLoop()
			startLoop()
		end
	end))

	function EspModule:SetEnabled(enabled: boolean)
		if config.Enabled == enabled then
			return
		end
		config.Enabled = enabled
		if enabled then startLoop() else stopLoop() end
	end

	function EspModule:SetShowHighlight(enabled: boolean)
		config.ShowHighlight = enabled
		if config.Enabled then updateAllEntries() end
	end

	function EspModule:SetShowNameDistance(enabled: boolean)
		config.ShowNameDistance = enabled
		if config.Enabled then updateAllEntries() end
	end

	function EspModule:SetShowHealth(enabled: boolean)
		config.ShowHealth = enabled
		if config.Enabled then updateAllEntries() end
	end

	function EspModule:SetTeamCheck(enabled: boolean)
		config.TeamCheck = enabled
		if config.Enabled then updateAllEntries() end
	end

	function EspModule:SetUseTeamColor(enabled: boolean)
		config.UseTeamColor = enabled
		if config.Enabled then updateAllEntries() end
	end

	function EspModule:SetColor(color: Color3)
		config.Color = color
		if config.Enabled then updateAllEntries() end
	end

	function EspModule:SetMaxDistance(distance: number)
		config.MaxDistance = math.max(50, distance)
		if config.Enabled then updateAllEntries() end
	end

	function EspModule:SetFillTransparency(transparency: number)
		config.FillTransparency = math.clamp(transparency, 0, 1)
		if config.Enabled then updateAllEntries() end
	end

	function EspModule:IsEnabled(): boolean
		return config.Enabled
	end

	function EspModule:Destroy()
		destroyed = true
		config.Enabled = false
		stopLoop()
		for _, conn in ipairs(globalConns) do
			conn:Disconnect()
		end
		table.clear(globalConns)
		for plr in pairs(entries) do
			unregisterPlayer(plr)
		end
	end

	return EspModule
end)()

--====================================================
-- 4. AUTO RESEARCH & FAST CRAFT MODULE
--====================================================
local Automation = (function()
	local AutomationModule = {}

	local cachedGameData: any = nil
	local gameDataChecked = false

	local inventory: { [string]: number } = {}
	local stash: { [string]: number } = {}
	local lastStashRefresh = 0
	local inventoryConn: RBXScriptConnection? = nil
	local destroyed = false

	local researchBusy = false
	local craftBusy = false

	local researchConfig = {
		AutoEnabled = false,
		AutoPickNext = true,
		CheckItems = true,
		SelectedId = "",
		Interval = 1.2,
	}

	local craftConfig = {
		AutoEnabled = false,
		SelectedId = "",
		Quantity = 1,
		FastAssemble = true,
		AutoClampMax = true,
		Interval = 0.5,
	}

	local researchLoopToken = 0
	local craftLoopToken = 0
	local notifyCallback: ((string, string, Color3?) -> ())? = nil

	local function getGameData(): any
		if not gameDataChecked then
			gameDataChecked = true
			local mod = ReplicatedStorage:FindFirstChild("GameData") or ReplicatedStorage:WaitForChild("GameData", 3)
			if mod and mod:IsA("ModuleScript") then
				local ok, data = pcall(require, mod)
				if ok and type(data) == "table" then
					cachedGameData = data
				end
			end
