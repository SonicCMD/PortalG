local function findRecipeById(recipeId: string): any?
	local gd = getGameData()
	if not gd or type(gd.Recipes) ~= "table" then
		return nil
	end
	for _, rec in ipairs(gd.Recipes) do
		if rec.id == recipeId or rec.result == recipeId then
			return rec
		end
	end
	return nil
end

local function knowsRecipe(gd: any, recipe: any): boolean
	local reqResearch = gd.RecipeResearch and gd.RecipeResearch[recipe.id]
	if not reqResearch then
		return true
	end
	local known = decodeAttrTable("Research")
	return known[reqResearch] == true
end

local function getAffordCount(recipe: any): number
	if type(recipe.ingredients) ~= "table" or #recipe.ingredients == 0 then
		return 50
	end
	local maxMake = 50
	for _, ing in ipairs(recipe.ingredients) do
		local need = ing.count or 1
		if need > 0 then
			local have = totalOwned(ing.item)
			maxMake = math.min(maxMake, math.floor(have / need))
		end
	end
	return math.max(0, maxMake)
end

local function getRemainingCraftCapacity(gd: any, recipe: any): number
	local itemMeta = gd.Items and gd.Items[recipe.result]
	if not itemMeta or not (itemMeta.gadget or itemMeta.gear) then
		return 50
	end
	local stack = tonumber(itemMeta.stack) or 1
	local cap = if stack <= 1 then 9 else stack
	local owned = inventory[recipe.result] or 0
	local perCraft = math.max(1, tonumber(recipe.amount) or 1)
	return math.max(0, math.floor((cap - owned) / perCraft))
end

local function getMissingIngredientsSummary(gd: any, recipe: any): string
	if type(recipe.ingredients) ~= "table" then
		return "Not enough materials"
	end
	local parts: { string } = {}
	for _, ing in ipairs(recipe.ingredients) do
		local need = ing.count or 1
		local have = totalOwned(ing.item)
		if have < need then
			local meta = gd.Items and gd.Items[ing.item]
			local name = if meta and meta.name then tostring(meta.name) else tostring(ing.item)
			table.insert(parts, ("%s (%d/%d)"):format(name, have, need))
			if #parts >= 2 then
				break
			end
		end
	end
	if #parts > 0 then
		return "Missing: " .. table.concat(parts, ", ")
	end
	return "Not enough materials to craft"
end

local function getWorkbenchProximity(): (boolean, string)
	if LocalPlayer:GetAttribute("PocketWorkbench") == true or LocalPlayer:GetAttribute("RickEyeOn") == true then
		return true, "Pocket Active"
	end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hrp:IsA("BasePart") then
		return false, "No Character"
	end
	for _, station in ipairs(CollectionService:GetTagged("CraftingStation")) do
		if station:IsA("Model") and station:IsDescendantOf(workspace) then
			local okP, cf = pcall(function()
				return station:GetPivot()
			end)
			if okP and cf and (cf.Position - hrp.Position).Magnitude < 22 then
				return true, "In Range"
			end
		end
	end
	return false, "Too Far (Go Home -> Garage)"
end

function Automation:CraftOnce(targetRecipeId: string?): (boolean, string)
	if craftBusy or LocalPlayer:GetAttribute("Crafting") == true then
		return false, "Craft already in progress..."
	end

	local gd = getGameData()
	if not gd or type(gd.Recipes) ~= "table" then
		lastCraftMsg = "GameData.Recipes not found"
		return false, lastCraftMsg
	end

	local craftItem = ReplicatedStorage:FindFirstChild("CraftItem")
	if not craftItem or not craftItem:IsA("RemoteFunction") then
		lastCraftMsg = "RemoteFunction CraftItem not found"
		return false, lastCraftMsg
	end

	ensureInventoryAndStashSynced(0.85)

	local recId = if targetRecipeId and targetRecipeId ~= "" then targetRecipeId else craftConfig.SelectedId
	local recipe = findRecipeById(recId)
	if not recipe then
		lastCraftMsg = "No valid recipe selected"
		return false, lastCraftMsg
	end

	if not knowsRecipe(gd, recipe) then
		local reqId = gd.RecipeResearch[recipe.id]
		local rName = if gd.ResearchById and gd.ResearchById[reqId] then gd.ResearchById[reqId].name else tostring(reqId)
		lastCraftMsg = ("Research locked: %s"):format(tostring(rName))
		return false, lastCraftMsg
	end

	local afford = if hasInventoryData then getAffordCount(recipe) else 50
	if hasInventoryData and afford <= 0 then
		lastCraftMsg = getMissingIngredientsSummary(gd, recipe)
		return false, lastCraftMsg
	end

	local room = if hasInventoryData then getRemainingCraftCapacity(gd, recipe) else 50
	if hasInventoryData and room <= 0 then
		local owned = inventory[recipe.result] or 0
		lastCraftMsg = ("Max owned reached (%d)"):format(owned)
		return false, lastCraftMsg
	end

	local requestedQty = math.clamp(math.round(craftConfig.Quantity), 1, 50)
	local finalQty = requestedQty
	if craftConfig.AutoClampMax then
		finalQty = math.clamp(math.min(requestedQty, afford, room), 1, 50)
	elseif hasInventoryData and requestedQty > afford then
		lastCraftMsg = ("Enough materials for max x%d"):format(afford)
		return false, lastCraftMsg
	end

	craftBusy = true
	LocalPlayer:SetAttribute("Crafting", true)

	local itemMeta = gd.Items and gd.Items[recipe.result]
	local itemName = if itemMeta and itemMeta.name then itemMeta.name else tostring(recipe.result or recipe.id)

	local finalOk = false
	local finalMsg = "Craft failed"

	local runOk, runErr = pcall(function()
		local craftFinish = ReplicatedStorage:FindFirstChild("CraftFinish")
		if craftConfig.FastAssemble and craftFinish and craftFinish:IsA("RemoteFunction") then
			lastCraftMsg = ("Starting assembly: x%d %s..."):format(finalQty, itemName)
			local okInv, okStart, tokenOrErr = pcall(function()
				return craftItem:InvokeServer(recipe.id, finalQty, "assemble")
			end)
			if not okInv then
				finalOk = false
				finalMsg = "CraftItem(assemble) error: " .. tostring(okStart)
				return
			end
			if not okStart then
				finalOk = false
				finalMsg = tostring(tokenOrErr or "CraftItem(assemble) rejected")
				return
			end

			local assembleStartedAt = os.clock()
			local targetDelay = math.max(craftConfig.AssembleDelay, learnedMinAssembleDelay)
			if targetDelay > 0 then
				local okWait = waitAssemblyWindow(targetDelay, itemName, tokenOrErr)
				if not okWait or destroyed then
					pcall(function()
						craftFinish:InvokeServer(tokenOrErr, "cancel")
					end)
					finalOk = false
					finalMsg = "Assembly paused (materials refunded)"
					return
				end
			end

			local maxAssembleWait = math.max((tonumber(recipe.time) or 4) * 2.0, 20)
			while not destroyed do
				local okFin, finOk, finErr = pcall(function()
					return craftFinish:InvokeServer(tokenOrErr, "done")
				end)
				if okFin and finOk then
					local totalElapsed = os.clock() - assembleStartedAt
					if totalElapsed > learnedMinAssembleDelay and learnedMinAssembleDelay > 0 then
						learnedMinAssembleDelay = math.clamp(math.ceil(totalElapsed * 2) / 2, 0, 15)
					end
					finalOk = true
					finalMsg = ("Fast Assembled x%d %s"):format(finalQty, itemName)
					requestInventorySync(true)
					refreshStash(true, false)
					return
				end

				local errStr = if not okFin then ("CraftFinish error: " .. tostring(finOk)) else tostring(finErr or "CraftFinish failed")
				local elapsedNow = os.clock() - assembleStartedAt
				if okFin and isTimingRejectMsg(errStr) and elapsedNow < maxAssembleWait then
					learnedMinAssembleDelay = math.clamp(math.ceil((elapsedNow + 0.8) * 2) / 2, 0.5, 15)
					lastCraftMsg = ("Completing assembly %s (%.1fs)..."):format(itemName, elapsedNow)
					task.wait(0.8)
				else
					finalOk = false
					finalMsg = errStr
					return
				end
			end
		else
			lastCraftMsg = ("Crafting x%d %s (Server Auto)..."):format(finalQty, itemName)
			local okInv, craftOk, craftErr = pcall(function()
				return craftItem:InvokeServer(recipe.id, finalQty)
			end)
			if not okInv then
				finalOk = false
				finalMsg = "CraftItem error: " .. tostring(craftOk)
				return
			end
			if not craftOk then
				finalOk = false
				finalMsg = tostring(craftErr or "CraftItem rejected")
				return
			end
			finalOk = true
			finalMsg = ("Crafted x%d %s"):format(finalQty, itemName)
			requestInventorySync(true)
			refreshStash(true, false)
		end
	end)

	LocalPlayer:SetAttribute("Crafting", false)
	craftBusy = false

	if not runOk then
		lastCraftMsg = "Craft error: " .. tostring(runErr)
		return false, lastCraftMsg
	end
	lastCraftMsg = finalMsg
	return finalOk, finalMsg
end

function Automation:SetAutoCraft(enabled: boolean)
	craftConfig.AutoEnabled = enabled
	craftLoopToken += 1
	local myToken = craftLoopToken
	refreshSolverState()
	if not enabled then
		if not craftBusy and LocalPlayer:GetAttribute("Crafting") == true then
			LocalPlayer:SetAttribute("Crafting", false)
		end
		lastCraftMsg = "Idle"
		return
	end

	initInventorySync()
	refreshStash(false, false)
	hookAssemblyBench()

	task.spawn(function()
		local lastNotifiedErr = ""
		while craftConfig.AutoEnabled and myToken == craftLoopToken and not destroyed do
			local ok, msg = self:CraftOnce(craftConfig.SelectedId)
			if ok then
				lastNotifiedErr = ""
				sendNotice("Auto Craft", msg, Color3.fromRGB(52, 211, 153))
				task.wait(craftConfig.Interval)
			else
				if msg ~= "Craft already in progress..." and msg ~= lastNotifiedErr then
					lastNotifiedErr = msg
					sendNotice("Auto Craft", msg, Color3.fromRGB(251, 191, 36))
				end
				task.wait(math.max(craftConfig.Interval, 1.4))
			end
		end
	end)
end

