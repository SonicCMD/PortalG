	local dimBounds = ReplicatedStorage:FindFirstChild("DimensionBounds")
	if dimBounds and curDim ~= nil then
		local key = tostring(curDim):gsub("[^%w_]", "_"):sub(1, 88)
		local c = dimBounds:GetAttribute(key .. "_C")
		local h = dimBounds:GetAttribute(key .. "_H")
		if typeof(c) == "Vector3" and typeof(h) == "Vector3" then
			if math.abs(pos.X - c.X) > h.X + 450 or math.abs(pos.Z - c.Z) > h.Z + 450 then
				return false, "Outside dimension bounds"
			end
		end
	elseif curDim ~= nil then
		local proc = workspace:FindFirstChild("Proc_" .. tostring(curDim))
		if proc then
			local zc = proc:GetAttribute("ZoneCenter")
			local zh = proc:GetAttribute("ZoneHalf")
			if typeof(zc) == "Vector3" and typeof(zh) == "Vector3" then
				if math.abs(pos.X - zc.X) > zh.X + 450 or math.abs(pos.Z - zc.Z) > zh.Z + 450 then
					return false, "Outside world zone"
				end
			end
		end
	end

	return true, nil
end

