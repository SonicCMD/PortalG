				lbl.TextColor3 = THEME.Text
				lbl.TextSize = 13
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.Parent = card

				local valLabel = Instance.new("TextLabel")
				valLabel.BackgroundTransparency = 1
				valLabel.AnchorPoint = Vector2.new(1, 0)
				valLabel.Position = UDim2.new(1, -12, 0, 7)
				valLabel.Size = UDim2.fromOffset(92, 18)
				valLabel.Font = Enum.Font.GothamBold
				valLabel.Text = formatNumber(currentVal, inc, sldCfg.Suffix)
				valLabel.TextColor3 = THEME.Accent
				valLabel.TextSize = 12
				valLabel.TextXAlignment = Enum.TextXAlignment.Right
				valLabel.Parent = card

				local hitArea = Instance.new("TextButton")
				hitArea.Position = UDim2.new(0, 12, 0, 30)
				hitArea.Size = UDim2.new(1, -24, 0, 20)
				hitArea.BackgroundTransparency = 1
				hitArea.Text = ""
				hitArea.AutoButtonColor = false
				hitArea.Parent = card

				local barTrack = Instance.new("Frame")
				barTrack.AnchorPoint = Vector2.new(0, 0.5)
				barTrack.Position = UDim2.fromScale(0, 0.5)
				barTrack.Size = UDim2.new(1, 0, 0, 6)
				barTrack.BackgroundColor3 = THEME.ControlBg
				barTrack.BorderSizePixel = 0
				barTrack.Parent = hitArea
				makeCorner(barTrack, 3)

				local ratio0 = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)
				local barFill = Instance.new("Frame")
				barFill.Size = UDim2.fromScale(ratio0, 1)
				barFill.BackgroundColor3 = THEME.Accent
				barFill.BorderSizePixel = 0
				barFill.Parent = barTrack
				makeCorner(barFill, 3)

				local dot = Instance.new("Frame")
				dot.AnchorPoint = Vector2.new(0.5, 0.5)
				dot.Position = UDim2.fromScale(ratio0, 0.5)
				dot.Size = UDim2.fromOffset(14, 14)
				dot.BackgroundColor3 = THEME.Knob
				dot.BorderSizePixel = 0
				dot.Parent = barTrack
				makeCorner(dot, 7)
				makeStroke(dot, THEME.AccentDark, 1.5, 0)

				local function renderVal()
					local r = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)
					barFill.Size = UDim2.fromScale(r, 1)
					dot.Position = UDim2.fromScale(r, 0.5)
					valLabel.Text = formatNumber(currentVal, inc, sldCfg.Suffix)
				end

				local handle = {}
				function handle:Set(newVal: number, skipCallback: boolean?)
					local nextVal = roundToStep(newVal, minVal, maxVal, inc)
					if nextVal == currentVal then
						return
					end
					currentVal = nextVal
					renderVal()
					if not skipCallback and sldCfg.Callback then
						task.spawn(sldCfg.Callback, currentVal)
					end
				end

				function handle:Get(): number
					return currentVal
				end

				local sliding = false
				local function applyFromInputX(posX: number)
					local width = barTrack.AbsoluteSize.X
					if width <= 0 then
						return
					end
					local alpha = math.clamp((posX - barTrack.AbsolutePosition.X) / width, 0, 1)
					local rawVal = minVal + (maxVal - minVal) * alpha
					handle:Set(rawVal, false)
				end

				track(hitArea.InputBegan:Connect(function(input: InputObject)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						sliding = true
						applyFromInputX(input.Position.X)
					end
				end))

				track(UserInputService.InputChanged:Connect(function(input: InputObject)
					if not sliding then
						return
					end
					if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
						applyFromInputX(input.Position.X)
					end
				end))

				track(UserInputService.InputEnded:Connect(function(input: InputObject)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						sliding = false
					end
				end))

				return handle
			end

