SettingsTab:CreateSection("Performance & Weak Device")

local monitorInterval = 0.45
local savedGraphicsState: {
	captured: boolean,
	shadows: boolean?,
	quality: any,
	fx: { { inst: Instance, prop: string, val: boolean } },
} = {
	captured = false,
	shadows = nil,
	quality = nil,
	fx = {},
}

local function applyAllLowEndMode(enabled: boolean)
	Rayfield:SetLowEndMode(enabled)
	Esp:SetLowEndMode(enabled)
	Material:SetLowEndMode(enabled)
	Automation:SetLowEndMode(enabled)
	Combat:SetLowEndMode(enabled)
	monitorInterval = if enabled then 1.1 else 0.45
end

local function isOwnEffect(inst: Instance): boolean
	local cur: Instance? = inst
	while cur and cur ~= workspace do
		if cur.Name == "RayfieldMaterialESP" or cur.Name == "RayfieldESP" or cur.Name == "RayfieldMobESP" then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local tglLowEndMode = SettingsTab:CreateToggle({
	Name = "Low-End Device Mode (Potato / Weak Exec)",
	Description = "Disables UI Tweens, limits ESP Highlights to 4, relaxes scan intervals to maximize FPS",
	CurrentValue = false,
	Callback = function(enabled: boolean)
		applyAllLowEndMode(enabled)
		Window:Notify({
			Title = "Performance Mode",
			Content = if enabled then "Low-End Mode ON (Tweens off, Highlights <= 4, Throttled loops)." else "Low-End Mode OFF (Balanced defaults).",
			Duration = 2.5,
			Color = if enabled then Color3.fromRGB(52, 211, 153) else Color3.fromRGB(56, 189, 248),
		})
	end,
})

SettingsTab:CreateButton({
	Name = "One-Click FPS Booster (Reduce Game Lag)",
	Description = "Safely lowers client shadows, quality & extra particles in chunked steps (Reversible)",
	Callback = function()
		if not savedGraphicsState.captured then
			savedGraphicsState.captured = true
			pcall(function() savedGraphicsState.shadows = Lighting.GlobalShadows end)
			pcall(function() savedGraphicsState.quality = settings().Rendering.QualityLevel end)
		end
		pcall(function() Lighting.GlobalShadows = false end)
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

		local trimmed = 0
		local descs = workspace:GetDescendants()
		for i = 1, #descs do
			local d = descs[i]
			if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Sparkles") or d:IsA("Fire") or d:IsA("Smoke") then
				if d.Enabled and not isOwnEffect(d) then
					table.insert(savedGraphicsState.fx, { inst = d, prop = "Enabled", val = true })
					pcall(function() d.Enabled = false end)
					trimmed += 1
				end
			end
			if i % 450 == 0 then
				task.wait()
			end
		end

		Window:Notify({
			Title = "FPS Booster",
			Content = ("Boost applied: Shadows OFF, Low Quality, %d FX disabled."):format(trimmed),
			Duration = 3,
			Color = Color3.fromRGB(52, 211, 153),
		})
	end,
})

SettingsTab:CreateButton({
	Name = "Restore Game Graphics",
	Description = "Restores client shadows, render quality & particles changed by FPS Booster",
	Callback = function()
		if savedGraphicsState.shadows ~= nil then
			pcall(function() Lighting.GlobalShadows = savedGraphicsState.shadows :: boolean end)
		end
		if savedGraphicsState.quality ~= nil then
			pcall(function() settings().Rendering.QualityLevel = savedGraphicsState.quality end)
		end
		local restored = 0
		for i, entry in ipairs(savedGraphicsState.fx) do
			if entry.inst and entry.inst.Parent then
				pcall(function() (entry.inst :: any)[entry.prop] = entry.val end)
				restored += 1
			end
			if i % 450 == 0 then
				task.wait()
			end
		end
		table.clear(savedGraphicsState.fx)
		Window:Notify({
			Title = "Graphics Restored",
			Content = ("Restored %d effects & client lighting."):format(restored),
			Duration = 2.5,
		})
	end,
})

