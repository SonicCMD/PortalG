	math.rad(145),
	math.rad(-145),
	math.pi,
}

local function findBestAttackSpot(
	char: Model,
	root: BasePart,
	targetModel: Model,
	targetRoot: BasePart,
	preferredDir: Vector3,
	wantDist: number,
	isMelee: boolean
): (Vector3?, boolean, Vector3)
	local mobPos = targetRoot.Position
	local flatDiff = Vector3.new(root.Position.X - mobPos.X, 0, root.Position.Z - mobPos.Z)
	local horizDist = flatDiff.Magnitude

	-- Fast path: if already within engagement range, clear of walls, and has 2-way LOS, keep stationary aim
	local maxStand = if isMelee then 8.5 else (wantDist + 2.5)
	if horizDist <= maxStand and math.abs(root.Position.Y - mobPos.Y) <= 12 then
		if isSpotFreeOfSolidWall(root.Position, char, targetModel) and hasClearShotToTarget(root.Position, targetModel, targetRoot, char) then
			local keepDir = if horizDist > 0.4 then flatDiff.Unit else preferredDir
			return root.Position, true, keepDir
		end
	end

	local baseDir = Vector3.new(preferredDir.X, 0, preferredDir.Z)
	baseDir = if baseDir.Magnitude > 0.2 then baseDir.Unit else Vector3.new(0, 0, 1)

	local radii: { number }
	if isMelee then
		radii = { 5.2, 3.8, 2.8 }
	else
		local r2 = math.min(wantDist * 0.65, 13.5)
		radii = { wantDist }
		for _, rCand in ipairs({ r2, 9.0, 5.8, 3.8 }) do
			if rCand < wantDist - 1.5 and rCand >= 3.2 then
				table.insert(radii, rCand)
			end
		end
	end

	-- Pass 1: Search same-approach-direction first at decreasing radii (keeps straight approach whenever possible)
	for _, r in ipairs(radii) do
		local candXZ = mobPos + baseDir * r
		local safeFloor, spotY = resolveRoomFloorY(candXZ, mobPos.Y, char, targetModel)
		if safeFloor then
			local candPos = Vector3.new(candXZ.X, spotY, candXZ.Z)
			if isSpotFreeOfSolidWall(candPos, char, targetModel) and hasClearShotToTarget(candPos, targetModel, targetRoot, char) then
				return candPos, true, baseDir
			end
		end
	end

	-- Pass 2: Building/wall blocked front path -> scan perimeter angles (prioritizing inside room gaps -> elevated outside angles)
	for _, r in ipairs(radii) do
		for i = 2, #APPROACH_ANGLES_RAD do
			local ang = APPROACH_ANGLES_RAD[i]
			local cs = math.cos(ang)
			local sn = math.sin(ang)
			local dir = Vector3.new(baseDir.X * cs - baseDir.Z * sn, 0, baseDir.X * sn + baseDir.Z * cs).Unit
			local candXZ = mobPos + dir * r
			local safeFloor, spotY = resolveRoomFloorY(candXZ, mobPos.Y, char, targetModel)
			if safeFloor then
				local candPos = Vector3.new(candXZ.X, spotY, candXZ.Z)
				if isSpotFreeOfSolidWall(candPos, char, targetModel) and hasClearShotToTarget(candPos, targetModel, targetRoot, char) then
					return candPos, true, dir
				end
			end
		end
	end

	-- Pass 3: Check slightly elevated angles (windows / low fences) on closer radii
	for _, r in ipairs({ math.min(wantDist, 14), 8.0 }) do
		for i = 1, 5 do
			local ang = APPROACH_ANGLES_RAD[i]
			local cs = math.cos(ang)
			local sn = math.sin(ang)
			local dir = Vector3.new(baseDir.X * cs - baseDir.Z * sn, 0, baseDir.X * sn + baseDir.Z * cs).Unit
			local candPos = Vector3.new(mobPos.X + dir.X * r, mobPos.Y + 5.5, mobPos.Z + dir.Z * r)
			if isSafePointInWorld(candPos, true) and isSpotFreeOfSolidWall(candPos, char, targetModel) and hasClearShotToTarget(candPos, targetModel, targetRoot, char) then
				return candPos, true, dir
			end
		end
	end

	-- No clear LOS exists anywhere (mob trapped inside solid mesh/sealed box) -> try closest non-solid melee pocket if any
	for _, r in ipairs({ 4.2, 6.2 }) do
		for _, ang in ipairs(APPROACH_ANGLES_RAD) do
			local cs = math.cos(ang)
			local sn = math.sin(ang)
			local dir = Vector3.new(baseDir.X * cs - baseDir.Z * sn, 0, baseDir.X * sn + baseDir.Z * cs).Unit
			local candXZ = mobPos + dir * r
			local safeFloor, spotY = resolveRoomFloorY(candXZ, mobPos.Y, char, targetModel)
			if safeFloor then
				local candPos = Vector3.new(candXZ.X, spotY, candXZ.Z)
				if isSpotFreeOfSolidWall(candPos, char, targetModel) then
					return candPos, false, dir
				end
			end
		end
	end

	return nil, false, baseDir
end

local function applyAimToTarget(targetModel: Model, targetRoot: BasePart, aimCamera: boolean): Vector3?
	local aimPart = getMobAimPart(targetModel, targetRoot)
	if not aimPart then
		return nil
	end
	currentAimModel = targetModel
	currentAimPart = aimPart
	installAimHook()

	local aimPos = aimPart.Position
	local char, _, root = getCharParts()
	if root then
		local lookXZ = Vector3.new(aimPos.X - root.Position.X, 0, aimPos.Z - root.Position.Z)
		if lookXZ.Magnitude > 0.25 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + lookXZ)
		end
	end

	pcall(function()
		LocalPlayer:SetAttribute("AimCenter", true)
	end)

	if aimCamera then
		local cam = workspace.CurrentCamera
		if cam then
			local camPos = cam.CFrame.Position
			-- If interior wall blocks camera-to-mob view, tuck camera safely inside the room in front of wall
			if char and root then
				local camDelta = aimPos - camPos
				local camBlocked = false
				if (camPos - root.Position).Magnitude > 22 then
					camBlocked = true
				elseif camDelta.Magnitude > 1.5 then
					local rp = getLosRayParams(char)
					local hit = workspace:Raycast(camPos, camDelta, rp)
					if hit and hit.Instance and hit.Instance:IsA("BasePart") and isPartShotBlocker(hit.Instance :: BasePart, targetModel) then
						camBlocked = true
					end
				end
				if camBlocked then
					local toAimFlat = Vector3.new(aimPos.X - root.Position.X, 0, aimPos.Z - root.Position.Z)
					local backDir = if toAimFlat.Magnitude > 0.3 then toAimFlat.Unit else root.CFrame.LookVector
					local desiredCam = root.Position - backDir * 4.5 + Vector3.new(0, 2.2, 0)
					local rpBack = getLosBackParams(char, targetModel)
					local wallBehind = workspace:Raycast(root.Position + Vector3.new(0, 1.8, 0), desiredCam - (root.Position + Vector3.new(0, 1.8, 0)), rpBack)
					if wallBehind and wallBehind.Distance > 0.8 then
						camPos = (root.Position + Vector3.new(0, 1.8, 0)) + (desiredCam - (root.Position + Vector3.new(0, 1.8, 0))).Unit * math.max(0.5, wallBehind.Distance - 0.5)
					elseif not wallBehind then
						camPos = desiredCam
					else
						camPos = root.Position + Vector3.new(0, 2.0, 0)
					end
				end
			end
			if (camPos - aimPos).Magnitude > 0.5 then
				cam.CFrame = CFrame.lookAt(camPos, aimPos)
			end
			cam.Focus = CFrame.new(aimPos)
		end
	end

	return aimPos
end

local function pickBestWeaponTool(preferMelee: boolean?): (Tool?, boolean)
	local char, _, _ = getCharParts()
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	local bestMelee: Tool? = nil
	local bestMeleeScore = -1
	local bestRanged: Tool? = nil
	local bestRangedScore = -1

	local function inspectContainer(c: Instance?)
		if not c then
			return
		end
		for _, ch in ipairs(c:GetChildren()) do
			if ch:IsA("Tool") then
				local ms = MELEE_TOOLS[ch.Name]
				if ms and ms > bestMeleeScore then
					bestMeleeScore = ms
					bestMelee = ch
				end
				local rs = RANGED_TOOLS[ch.Name]
				if rs and rs > bestRangedScore then
					bestRangedScore = rs
					bestRanged = ch
				end
			end
		end
	end

	inspectContainer(char)
	inspectContainer(bp)

	if preferMelee and bestMelee then
		return bestMelee, false
	end
	if bestRanged then
		return bestRanged, true
	end
	return bestMelee, false
end

local function isPortalGunTool(tool: Tool?): boolean
	if not tool then
		return false
	end
	return tool.Name == "PortalGun" or tool.Name == "GoldenPortalGun" or tool.Name == "PortalGunJr"
end

local function performAimAndShoot(targetModel: Model, targetRoot: BasePart, preferMeleeClose: boolean?)
	local char, hum, root = getCharParts()
	if not char or not hum or not root or hum.Health <= 0 then
		return
	end

	local aimPos = applyAimToTarget(targetModel, targetRoot, true)
	if not aimPos then
		return
	end
	local dist = (targetRoot.Position - root.Position).Magnitude

	local now = os.clock()
	local held = char:FindFirstChildOfClass("Tool")
	local bestWeapon, isRanged = pickBestWeaponTool(preferMeleeClose and dist <= 10.5)

	-- Equip best weapon cleanly (prioritize Ranged Guns; keep PortalGun unequipped)
	if bestWeapon and held ~= bestWeapon then
		pcall(function()
			hum:EquipTool(bestWeapon)
		end)
		held = bestWeapon
	elseif isPortalGunTool(held) then
		pcall(function()
			hum:UnequipTools()
		end)
		held = nil
	end

	-- 1) Shoot / Swing equipped real weapon Tool
	if held and not isPortalGunTool(held) then
		local inWeaponRange = if isRanged then (dist <= 95) else (dist <= 13.5)
		if inWeaponRange and now - lastSwingClock >= 0.18 then
			lastSwingClock = now
			pcall(function()
				LocalPlayer:SetAttribute("AimCenter", true)
				held:Activate()
			end)
			task.delay(0.06, function()
				pcall(function()
					if held and held.Parent == char then
						held:Deactivate()
					end
				end)
			end)
		end
	end

	-- 2) Mech Arms Attack (CyberArm aim + strike when in strike range)
	local mechLevel = tonumber(char:GetAttribute("MechLevel")) or 0
	if mechLevel > 0 and dist <= 28 then
		local cyberArm = ReplicatedStorage:FindFirstChild("CyberArm")
		if cyberArm and cyberArm:IsA("RemoteEvent") then
			if char:GetAttribute("MechDeployed") ~= true and now - lastArmStrikeClock >= 0.6 then
				lastArmStrikeClock = now
				pcall(function()
					cyberArm:FireServer("toggle", nil)
				end)
			elseif now - lastArmStrikeClock >= 0.45 then
				lastArmStrikeClock = now
				pcall(function()
					cyberArm:FireServer("aim", aimPos)
					cyberArm:FireServer("strike", aimPos)
				end)
			end
		end
	end

	-- 3) Evil Eye Powers when equipped & off cooldown
	if LocalPlayer:GetAttribute("EyePatchOn") == true then
		local evilTech = ReplicatedStorage:FindFirstChild("EvilTech")
		local eyeLevel = tonumber(LocalPlayer:GetAttribute("EyeLevel")) or 0
		local srvNow = workspace:GetServerTimeNow()
		if evilTech and evilTech:IsA("RemoteEvent") then
			if eyeLevel >= 3 and (tonumber(LocalPlayer:GetAttribute("EvilReady_hack")) or 0) <= srvNow and dist <= 85 then
				pcall(function()
					evilTech:FireServer("hack", targetModel)
				end)
			end
			if eyeLevel >= 5 and (tonumber(LocalPlayer:GetAttribute("EvilReady_blast")) or 0) <= srvNow and dist <= 120 then
				local dir = (aimPos - root.Position).Unit
				pcall(function()
					evilTech:FireServer("blast", dir)
				end)
			end
		end
	end

	-- 4) Fallback unarmed click when completely empty-handed in close range
	if not held and mechLevel <= 0 and dist <= 8.5 and now - lastAimClickClock >= 0.35 then
		lastAimClickClock = now
		local clickFn = rawget(_G, "mouse1click")
		if type(clickFn) == "function" then
			pcall(clickFn)
		end
	end
end

local function sweepNearbyDrops(forceNow: boolean?, dropOrigin: Vector3?)
	if not mobConfig.AutoPickupDrops or not matMod then
		return
	end
	if not forceNow and os.clock() - lastDropSweepClock < dropSweepInterval then
		return
	end
	lastDropSweepClock = os.clock()

	local char, _, root = getCharParts()
	if not char or not root then
		return
	end
	local firePromptFn = rawget(_G, "fireproximityprompt")
	for _, node in ipairs(CollectionService:GetTagged("ResourceNode")) do
		if node:IsDescendantOf(workspace) then
			local pr = node:FindFirstChildWhichIsA("ProximityPrompt", true)
			if pr and pr.Enabled then
				local pPos = if pr.Parent and pr.Parent:IsA("BasePart")
					then pr.Parent.Position
					elseif pr.Parent and pr.Parent:IsA("Attachment") then pr.Parent.WorldPosition
					else nil
				if pPos then
					local dMe = (pPos - root.Position).Magnitude
					local nearDeadMob = dropOrigin ~= nil and (pPos - dropOrigin).Magnitude <= 18
					local maxCheck = if forceNow then 48 else 26
					if (dMe <= maxCheck) or nearDeadMob then
						if dMe > math.max(8, pr.MaxActivationDistance - 2) and isSafePointInWorld(pPos, false) then
							char:PivotTo(CFrame.new(pPos + Vector3.new(0, 2.8, 0)))
							task.wait(0.04)
						end
						if type(firePromptFn) == "function" then
							pcall(firePromptFn, pr)
						else
							pcall(function()
								pr:InputHoldBegin()
								task.delay(math.max(0.08, pr.HoldDuration + 0.08), function()
									pcall(function() pr:InputHoldEnd() end)
								end)
							end)
						end
					end
				end
			end
		end
	end
end

local function stepAutoAim(dt: number)
	if not mobConfig.AutoAim or mobConfig.AutoHunt then
		return
	end
	aimAcc += dt
	if aimAcc < aimInterval then
		return
	end
	aimAcc = 0

	local nearby = scanMobs(mobConfig.HuntFilter, mobConfig.AimRange, false, false)
	local char = LocalPlayer.Character
	local _, _, root = getCharParts()
	local chosen = nearby[1]
	if chosen and char and root and #nearby > 1 then
		for i = 1, math.min(5, #nearby) do
			local cand = nearby[i]
			if hasClearShotToTarget(root.Position, cand.model, cand.root, char) then
				chosen = cand
				break
			end
		end
	end
	if chosen then
		local aimPos = applyAimToTarget(chosen.model, chosen.root, true)
		local char = LocalPlayer.Character
		if aimPos and char and char:GetAttribute("MechDeployed") == true and os.clock() - lastArmAimClock >= 0.12 then
			lastArmAimClock = os.clock()
			local cyberArm = ReplicatedStorage:FindFirstChild("CyberArm")
			if cyberArm and cyberArm:IsA("RemoteEvent") then
				pcall(function()
					cyberArm:FireServer("aim", aimPos)
				end)
			end
		end
	else
		currentAimModel = nil
		currentAimPart = nil
		pcall(function()
			LocalPlayer:SetAttribute("AimCenter", nil)
		end)
	end
end

local function refreshRuntimeLoop()
	local needLoop = (not destroyed) and (guardConfig.AntiVoid or guardConfig.AutoHeal or guardConfig.AutoEscapeHome or mobConfig.AutoAim or mobConfig.MobEsp)
	if needLoop and not guardConn then
		guardConn = RunService.Heartbeat:Connect(function(dt: number)
			if destroyed then
				return
			end
			stepGuardian(dt)
			stepAutoAim(dt)
			if mobConfig.MobEsp then
				mobEspAcc += dt
				if mobEspAcc >= mobEspInterval then
					mobEspAcc = 0
					updateMobEsp()
				end
			end
		end)
	elseif not needLoop and guardConn then
		guardConn:Disconnect()
		guardConn = nil
		if not mobConfig.MobEsp then
			clearMobEsp()
		end
	end
	if not (mobConfig.AutoAim or mobConfig.AutoHunt) then
		uninstallAimHook()
	end
end

--====================================================
-- AUTO FARM MOBS (1-DIRECTION FLY + AIM & SHOOT)
--====================================================
local function markMobSkipped(targetModel: Model)
	local count = (mobSkipCounts[targetModel] or 0) + 1
	mobSkipCounts[targetModel] = count
	local skipSecs = if count == 1 then 18 elseif count == 2 then 40 else 90
	skippedMobs[targetModel] = os.clock() + skipSecs
end

local function startAutoHuntLoop(myToken: number)
	lastHuntDim = LocalPlayer:GetAttribute("CurrentDimension")
	table.clear(skippedMobs)
	table.clear(mobSkipCounts)

	task.spawn(function()
		while mobConfig.AutoHunt and myToken == huntToken and not destroyed do
			local curDimNow = LocalPlayer:GetAttribute("CurrentDimension")
			if curDimNow ~= lastHuntDim then
				lastHuntDim = curDimNow
				table.clear(skippedMobs)
				table.clear(mobSkipCounts)
			end

			local char, hum, root = getCharParts()
			if not char or not hum or not root or hum.Health <= 0 then
				currentAimModel = nil
				lastMobMsg = "Waiting for character..."
				task.wait(0.4)
				continue
			end

			local targets = scanMobs(mobConfig.HuntFilter, mobConfig.MaxHuntDist, true, true)
			if #targets == 0 then
				currentAimModel = nil
				currentAimPart = nil
				local allTargets = scanMobs(mobConfig.HuntFilter, mobConfig.MaxHuntDist, true, false)
				if #allTargets > 0 then
					lastMobMsg = ("All %d nearby mobs blocked in buildings (waiting)..."):format(#allTargets)
				else
					lastMobMsg = ("No %s nearby"):format(if mobConfig.HuntFilter == "ALL" then "mobs" else mobConfig.HuntFilter)
				end
				task.wait(0.55)
				continue
			end

			local chosen = targets[1]
			-- Prefer first nearby target (within +30m of nearest) that already has an open attack spot with LOS
			local _, isRangedBest = pickBestWeaponTool(false)
			local hasEvilBlast = LocalPlayer:GetAttribute("EyePatchOn") == true and (tonumber(LocalPlayer:GetAttribute("EyeLevel")) or 0) >= 5
			local wantDistInit = if (isRangedBest or hasEvilBlast) then math.clamp(mobConfig.EngageDist, 6, 45) else 5.2
			local chosenSpot: Vector3? = nil
			local chosenClear = false
			local singleApproachDir = Vector3.new(0, 0, 1)

			for i = 1, math.min(5, #targets) do
				local cand = targets[i]
				if cand.dist > targets[1].dist + 45 then
					break
				end
				local deltaC = Vector3.new(root.Position.X - cand.root.Position.X, 0, root.Position.Z - cand.root.Position.Z)
				local prefC = if deltaC.Magnitude > 0.4 then deltaC.Unit else Vector3.new(0, 0, 1)
				local spotC, clearC, dirC = findBestAttackSpot(char, root, cand.model, cand.root, prefC, wantDistInit, not (isRangedBest or hasEvilBlast))
				if clearC and spotC then
					chosen = cand
					chosenSpot = spotC
					chosenClear = true
					singleApproachDir = dirC
					break
				elseif i == 1 then
					chosenSpot = spotC
					chosenClear = clearC
					singleApproachDir = dirC
				end
			end

			local targetModel = chosen.model
			local targetHum = chosen.hum
			local targetRoot = chosen.root
			lastMobMsg = ("Locking %s (%.0fm)"):format(chosen.displayName, chosen.dist)

			local engageStart = os.clock()
			local lastHuntStepClock = engageStart
			local lastSeenHp = targetHum.Health
			local lastDamageClock = engageStart
			local firingStartedClock: number? = nil
			local noLosSinceClock: number? = nil
			local retargetAttempts = 0
			local lastRepositionClock = 0
			local forceMeleeClose = false
			local activeSpot: Vector3? = chosenSpot
			local activeSpotClear = chosenClear
			local lastMobPosSnapshot = targetRoot.Position

			while mobConfig.AutoHunt and myToken == huntToken and not destroyed
				and targetModel.Parent and targetHum.Health > 0 and targetRoot.Parent
				and os.clock() - engageStart < 35
			do
				local nowStep = os.clock()
				local stepDt = math.clamp(nowStep - lastHuntStepClock, 0.03, 0.25)
				lastHuntStepClock = nowStep
				char, hum, root = getCharParts()
				if not char or not hum or not root or hum.Health <= 0 then
					break
				end

				-- Track actual HP damage dealt to detect wall-blocked or invincible trapped mobs fast
				local hpNow = targetHum.Health
				if hpNow < lastSeenHp - 0.05 then
					lastSeenHp = hpNow
					lastDamageClock = nowStep
					retargetAttempts = 0
					forceMeleeClose = false
				end

				local mobPos = targetRoot.Position
				local safeOk = isSafePointInWorld(mobPos, false)
				if not safeOk then
					lastMobMsg = "Skipped unsafe Void/Space mob"
					markMobSkipped(targetModel)
					break
				end

				local _, isRangedNow = pickBestWeaponTool(false)
				local hasBlastNow = LocalPlayer:GetAttribute("EyePatchOn") == true and (tonumber(LocalPlayer:GetAttribute("EyeLevel")) or 0) >= 5
				local wantDist = if (isRangedNow or hasBlastNow) and not forceMeleeClose then math.clamp(mobConfig.EngageDist, 6, 45) else 5.0

				-- Re-evaluate vantage spot if missing, mob moved >4 studs, LOS lost while standing, or 0 damage for >0.95s
				local distToSpot = if activeSpot then (activeSpot - root.Position).Magnitude else 999
				local currentLosOk = if distToSpot <= 4.5 then hasClearShotToTarget(root.Position, targetModel, targetRoot, char) else activeSpotClear
				local stalledOnShot = (firingStartedClock ~= nil) and ((nowStep - math.max(firingStartedClock :: number, lastDamageClock)) >= 0.95)
				local mobMoved = (mobPos - lastMobPosSnapshot).Magnitude >= 4.0

				if (not activeSpot) or mobMoved or (distToSpot <= 4.5 and not currentLosOk) or (stalledOnShot and nowStep - lastRepositionClock >= 0.85) then
					lastMobPosSnapshot = mobPos
					lastRepositionClock = nowStep
					if stalledOnShot then
						retargetAttempts += 1
						-- Tighten distance gradually on retry so character steps past outer walls/pillars into the room
						wantDist = if retargetAttempts == 1 then math.min(wantDist, 9.5) else 4.8
						if retargetAttempts >= 2 then
							forceMeleeClose = true
						end
					end

					local newSpot, newClear, newDir = findBestAttackSpot(char, root, targetModel, targetRoot, singleApproachDir, wantDist, forceMeleeClose or not (isRangedNow or hasBlastNow))
					activeSpot = newSpot
					activeSpotClear = newClear
					singleApproachDir = newDir

					if newClear then
						noLosSinceClock = nil
					elseif not noLosSinceClock then
						noLosSinceClock = nowStep
					end

					-- Bail out quickly if mob has 0 clear LOS anywhere and melee/stalled checks fail
					if (not newSpot) or (not newClear and (nowStep - (noLosSinceClock :: number)) >= 1.6) or retargetAttempts >= 3 then
						markMobSkipped(targetModel)
						lastMobMsg = ("Skipped trapped mob in building: %s"):format(chosen.displayName)
						break
					end
				end

				-- Global zero-damage watchdog once in shooting phase (>3.2s with 0 HP loss)
				if firingStartedClock and (nowStep - math.max(firingStartedClock :: number, lastDamageClock)) >= 3.2 then
					markMobSkipped(targetModel)
					lastMobMsg = ("Skipped blocked mob (0 dmg): %s"):format(chosen.displayName)
					break
				end

				if not activeSpot then
					markMobSkipped(targetModel)
					lastMobMsg = ("Skipped unreachable mob: %s"):format(chosen.displayName)
					break
				end

				local toSpot = activeSpot - root.Position
				local spotDist = toSpot.Magnitude
				local didLongTeleport = false
				if spotDist > 3.2 then
					-- Check if straight travel path is blocked by building wall/roof OR is far -> Teleport cleanly to vantage spot
					local rpFwd = getLosRayParams(char)
					local pathDelta = (activeSpot + Vector3.new(0, 1.0, 0)) - (root.Position + Vector3.new(0, 1.0, 0))
					local pathHit = if pathDelta.Magnitude > 1.0 then workspace:Raycast(root.Position + Vector3.new(0, 1.0, 0), pathDelta, rpFwd) else nil
					local pathBlocked = pathHit ~= nil and pathHit.Instance ~= nil and pathHit.Instance:IsA("BasePart") and isPartShotBlocker(pathHit.Instance :: BasePart, targetModel)

					if pathBlocked or spotDist > 34 then
						if spotDist > 110 then
							local sDone = false
							task.spawn(function()
								pcall(function()
									LocalPlayer:RequestStreamAroundAsync(activeSpot :: Vector3, 1.0)
								end)
								sDone = true
							end)
							local sEnd = os.clock() + 0.30
							while not sDone and os.clock() < sEnd and mobConfig.AutoHunt and myToken == huntToken and not destroyed do
								task.wait(0.03)
							end
						end
						if not mobConfig.AutoHunt or myToken ~= huntToken or destroyed then
							break
						end
						hum.Sit = false
						hum.PlatformStand = false
						root.Anchored = false
						root.AssemblyLinearVelocity = Vector3.zero
						root.AssemblyAngularVelocity = Vector3.zero
						local lookPt = Vector3.new(mobPos.X, activeSpot.Y, mobPos.Z)
						local destCF = if (lookPt - activeSpot).Magnitude > 0.3 then CFrame.lookAt(activeSpot, lookPt) else CFrame.new(activeSpot)
						char:PivotTo(destCF)
						root.AssemblyLinearVelocity = Vector3.zero
						root.AssemblyAngularVelocity = Vector3.zero
						if spotDist > 20 then
							didLongTeleport = true
						end
					else
						local stepDist = math.min(spotDist, 115 * stepDt)
						local nextPos = root.Position + toSpot.Unit * stepDist
						if isSafePointInWorld(nextPos, true) then
							hum.Sit = false
							hum.PlatformStand = false
							root.AssemblyLinearVelocity = Vector3.zero
							root.AssemblyAngularVelocity = Vector3.zero
							local lookPt = Vector3.new(mobPos.X, nextPos.Y, mobPos.Z)
							root.CFrame = if (lookPt - nextPos).Magnitude > 0.3 then CFrame.lookAt(nextPos, lookPt) else CFrame.new(nextPos)
						else
							markMobSkipped(targetModel)
							break
						end
					end
				else
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
					if math.abs(root.Position.Y - activeSpot.Y) > 1.5 and isSpotFreeOfSolidWall(Vector3.new(root.Position.X, activeSpot.Y, root.Position.Z), char, targetModel) then
						local adjPos = Vector3.new(root.Position.X, activeSpot.Y, root.Position.Z)
						local lookPt = Vector3.new(mobPos.X, adjPos.Y, mobPos.Z)
						root.CFrame = if (lookPt - adjPos).Magnitude > 0.3 then CFrame.lookAt(adjPos, lookPt) else CFrame.new(adjPos)
					end
				end

				-- Brief replication settle after a long teleport so Server sees the new clear-LOS spot before firing
				if didLongTeleport then
					task.wait(0.14)
					if not mobConfig.AutoHunt or myToken ~= huntToken or destroyed or not targetModel.Parent or targetHum.Health <= 0 then
						break
					end
					char, hum, root = getCharParts()
					if not char or not hum or not root or hum.Health <= 0 then
						break
					end
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
				end

				-- Only start/advance damage timer once actually in weapon position with clear shot or close pocket
				if (activeSpot - root.Position).Magnitude <= 5.5 then
					if not firingStartedClock then
						firingStartedClock = os.clock()
						lastDamageClock = os.clock()
					end
				end

				performAimAndShoot(targetModel, targetRoot, forceMeleeClose)
				local liveDist = (targetRoot.Position - root.Position).Magnitude
				lastMobMsg = ("%s %s (HP %.0f | %.0fm)"):format(if activeSpotClear then "Shooting" else "Closing", chosen.displayName, math.max(0, targetHum.Health), liveDist)
				task.wait(if lowEndMode then 0.09 else 0.06)
			end

			currentAimModel = nil
			currentAimPart = nil
			if targetHum.Health <= 0 or not targetModel.Parent then
				skippedMobs[targetModel] = nil
				mobSkipCounts[targetModel] = nil
				killedCount += 1
				lastMobMsg = ("Defeated %s (#%d)"):format(chosen.displayName, killedCount)
				task.wait(0.08)
				sweepNearbyDrops(true, if targetRoot and targetRoot.Parent then targetRoot.Position else nil)
				task.wait(0.12)
			end
		end
		if not mobConfig.AutoHunt then
			lastMobMsg = "Idle"
		end
		if not (mobConfig.AutoAim or mobConfig.AutoHunt) then
			uninstallAimHook()
		end
	end)
end

--====================================================
-- MISSION TRACKER & AUTO MISSION RUNNER (VOID-SAFE)
--====================================================
function Combat:GetActiveMissionInfo(): {
	source: string,
	title: string,
	goalType: string,
	goalText: string,
	have: number,
	need: number,
	item: string?,
	enemy: string?,
	dim: string?,
	id: string?,
	requiredDim: string?,
	requiredSuit: string?,
	suitOk: boolean,
	whereText: string,
	storyBlockedLv: number?,
}
	local gd = getGameData()
	local emptyInfo = {
		source = "None",
		title = "No Active Mission",
		goalType = "none",
		goalText = "Open GameData / Quest first",
		have = 0,
		need = 1,
		item = nil,
		enemy = nil,
		dim = nil,
		id = nil,
		requiredDim = nil,
		requiredSuit = nil,
		suitOk = true,
		whereText = "",
		storyBlockedLv = nil,
	}
	if not gd then
		return emptyInfo
	end

	local quest = decodeAttrTable("Quest")
	local bonus = decodeAttrTable("Bonus")
	local bag = decodeAttrTable("Bag")
	local totalQi = tonumber(LocalPlayer:GetAttribute("TotalQI")) or 0
	local geniusLv = if gd.GeniusLevel then gd.GeniusLevel(totalQi) else (tonumber(LocalPlayer:GetAttribute("Genius")) or 1)

	local storyQ = if type(gd.Quests) == "table" then gd.Quests[quest.i or 1] else nil
	local storyBlockedLv: number? = nil
	if storyQ and type(storyQ.goal) == "table" then
		if storyQ.goal.type == "research" and gd.ResearchById and gd.ResearchById[storyQ.goal.id] then
			local reqLv = gd.ResearchById[storyQ.goal.id].level or 1
			if geniusLv < reqLv then
				storyBlockedLv = reqLv
			end
		elseif storyQ.goal.type == "level" and storyQ.goal.n and geniusLv < storyQ.goal.n then
			storyBlockedLv = storyQ.goal.n
		end
	end

	local activeDef = nil
	local source = "Story"
	local have = 0
	if storyQ and not storyBlockedLv then
		activeDef = storyQ
		source = ("Story #%d"):format(tonumber(quest.i) or 1)
		have = tonumber(quest.n) or 0
	else
		local bonusDef = bonus.id and gd.DailyById and gd.DailyById[bonus.id]
		if bonusDef then
			activeDef = bonusDef
			source = "Bonus"
			have = tonumber(bonus.n) or 0
		elseif storyQ then
			activeDef = storyQ
			source = ("Story #%d (Need Lv %d)"):format(tonumber(quest.i) or 1, storyBlockedLv or geniusLv)
			have = tonumber(quest.n) or 0
		end
	end

	if not activeDef or type(activeDef.goal) ~= "table" then
		return emptyInfo
	end

	local g = activeDef.goal
	local need = tonumber(g.n) or 1
	local item = if g.item then tostring(g.item) else nil
	local enemy = if g.enemy then tostring(g.enemy) else nil
	local dim = if g.dim then tostring(g.dim) else nil
	local gId = if g.id then tostring(g.id) else nil

	local reqDim = dim
	if not reqDim and enemy then
		reqDim = ENEMY_DEFAULT_DIM[enemy]
	elseif not reqDim and item then
		reqDim = ITEM_REQUIRED_DIM[item]
	end

	local suitMeta = if item then WILD_SUITS[item] else nil
	local reqSuit = if suitMeta then suitMeta.suit else nil
	local suitOk = true
	if reqSuit then
		suitOk = (tonumber(bag[reqSuit]) or 0) > 0
	end

	local whereText = ""
	if (g.type == "harvest" or g.type == "craft") and item and type(gd.WhereToFind) == "function" then
		local okW, wRes = pcall(gd.WhereToFind, item)
		if okW and type(wRes) == "string" then
			whereText = wRes
		end
	end

	local gText = tostring(g.type)
	if g.type == "harvest" then
		gText = "Collect " .. tostring(item or "items")
	elseif g.type == "craft" then
		gText = "Craft " .. tostring(item or "item")
	elseif g.type == "kill" then
		gText = "Defeat " .. tostring(enemy or "enemies")
	elseif g.type == "research" then
		gText = "Research " .. tostring(gId or "")
	elseif g.type == "visit" then
		gText = "Visit " .. tostring(dim or "")
	elseif g.type == "build" then
		gText = "Build " .. tostring(gId or "")
	elseif g.type == "level" then
		gText = "Reach Genius Lv " .. tostring(need)
	end

	return {
		source = source,
		title = tostring(activeDef.name or "Mission"),
		goalType = tostring(g.type),
		goalText = gText,
		have = math.min(have, need),
		need = need,
		item = item,
		enemy = enemy,
		dim = dim,
		id = gId,
		requiredDim = reqDim,
		requiredSuit = reqSuit,
		suitOk = suitOk,
		whereText = whereText,
		storyBlockedLv = storyBlockedLv,
	}
end

local function releaseMissionSubModes()
	if ownedSubMode == "harvest" and matMod then
		matMod:SetMissionSafeFilter(false)
		matMod:SetAutoCollect(false)
	elseif ownedSubMode == "hunt" then
		mobConfig.AutoHunt = false
		huntToken += 1
	end
	ownedSubMode = nil
end

local function stepAutoMissionOnce(): (boolean, string)
	local info = Combat:GetActiveMissionInfo()
	if info.goalType == "none" then
		releaseMissionSubModes()
		return false, "No active mission found"
	end

	local curDim = tostring(LocalPlayer:GetAttribute("CurrentDimension") or "")
	local homeDim = tostring(LocalPlayer:GetAttribute("HomeDimension") or curDim)
	local inOrbit = LocalPlayer:GetAttribute("InOrbit") == true

	if inOrbit and info.goalType ~= "planet" and info.goalType ~= "harvestplanet" and info.goalType ~= "orbit" then
		releaseMissionSubModes()
		return false, "In Space Orbit - Force Home or land safely first"
	end

	-- Safety gate: never blindly teleport across dimensions into Void!
	if info.requiredDim and info.requiredDim ~= "" then
		local targetDim = info.requiredDim
		local isHomeMatch = (targetDim == "C137" or targetDim == "Earth") and (curDim == homeDim)
		if not isHomeMatch and curDim ~= targetDim then
			releaseMissionSubModes()
			-- Pre-fill Portal Gun TargetDimension if UI exists so player can shoot portal safely
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			local pgui = pg and pg:FindFirstChild("PortalGunUI")
			local tdVal = pgui and pgui:FindFirstChild("TargetDimension")
			if tdVal and tdVal:IsA("StringValue") then
				tdVal.Value = targetDim
			end
			return false, ("Need Portal to [%s] first (Void-safe pause)"):format(targetDim)
		end
	end

	-- Safety gate: suit requirement for Volcano / Snow / Caves
	if info.requiredSuit and not info.suitOk and not missionConfig.AllowUnsafeBiomes then
		releaseMissionSubModes()
		if autoMod then
			local canCraftSuit, missingMat, reason, recId = autoMod:GetCraftReadinessForItem(info.requiredSuit)
			if canCraftSuit and recId then
				if missionConfig.AutoQuickBench and matMod then
					matMod:QuickInteract("workbench")
				end
				local okC, msgC = autoMod:CraftOnce(recId)
				return okC, "Crafting safety suit: " .. tostring(msgC)
			elseif missingMat and missionConfig.AutoCollectMats and matMod then
				matMod:SetMissionSafeFilter(true)
				matMod:SetSelectedItem(missingMat)
				matMod:SetAutoCollect(true)
				ownedSubMode = "harvest"
				if stateSyncCallback then task.defer(stateSyncCallback) end
				return true, ("Farming %s for %s"):format(missingMat, info.requiredSuit)
			end
			return false, ("Need %s before entering hazard (%s)"):format(info.requiredSuit, tostring(reason))
		end
		return false, ("Need %s before entering hazard"):format(info.requiredSuit)
	end

	-- Handle each Goal Type accurately
	if info.goalType == "harvest" and info.item then
		if mobConfig.AutoHunt then
			mobConfig.AutoHunt = false
			huntToken += 1
		end
		if matMod then
			matMod:SetMissionSafeFilter(true)
			matMod:SetSelectedItem(info.item)
			matMod:SetAutoCollect(true)
			ownedSubMode = "harvest"
			if stateSyncCallback then task.defer(stateSyncCallback) end
			return true, ("Harvesting %s (%d/%d)"):format(info.item, info.have, info.need)
		end
	elseif info.goalType == "kill" and info.enemy then
		if matMod then
			matMod:SetAutoCollect(false)
		end
		mobConfig.HuntFilter = info.enemy
		if not mobConfig.AutoAim then
			mobConfig.AutoAim = true
		end
		if not mobConfig.AutoHunt then
			mobConfig.AutoHunt = true
			huntToken += 1
			startAutoHuntLoop(huntToken)
		end
		refreshRuntimeLoop()
		ownedSubMode = "hunt"
		if stateSyncCallback then task.defer(stateSyncCallback) end
		return true, ("Hunting %s (%d/%d)"):format(info.enemy, info.have, info.need)
	elseif info.goalType == "craft" and info.item and autoMod then
		releaseMissionSubModes()
		local canCraft, missingMat, reason, recId = autoMod:GetCraftReadinessForItem(info.item)
		if canCraft and recId then
			autoMod:SetCraftQuantity(math.max(1, info.need - info.have))
			local okC, msgC = autoMod:CraftOnce(recId)
			return okC, msgC
		elseif reason == "Need Workbench" and missionConfig.AutoQuickBench and recId and matMod then
			local okW = matMod:QuickInteract("workbench")
			if okW then
				autoMod:SetCraftQuantity(math.max(1, info.need - info.have))
				return autoMod:CraftOnce(recId)
			end
		elseif missingMat and missionConfig.AutoCollectMats and matMod then
			matMod:SetMissionSafeFilter(true)
			matMod:SetSelectedItem(missingMat)
			matMod:SetAutoCollect(true)
			ownedSubMode = "harvest"
			if stateSyncCallback then task.defer(stateSyncCallback) end
			return true, ("Collecting missing %s for craft"):format(missingMat)
		end
		return false, tostring(reason or "Cannot craft mission item yet")
	elseif info.goalType == "research" and info.id and autoMod then
		releaseMissionSubModes()
		local okR, msgR = autoMod:RunResearchOnce(info.id)
		return okR, msgR
	elseif info.goalType == "job" and matMod then
		-- Find nearest NPC with TalkPrompt/JobPrompt in current dimension
		local _, _, root = getCharParts()
		if root then
			local bestPrompt: ProximityPrompt? = nil
			local bestPos: Vector3? = nil
			local bestDist = 450
			for _, npc in ipairs(CollectionService:GetTagged("NPC")) do
				if npc:IsDescendantOf(workspace) then
					local pr = npc:FindFirstChildWhichIsA("ProximityPrompt", true)
					if pr and pr.Enabled then
						local p = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
						if p and p:IsA("BasePart") then
							local safeOk = isSafePointInWorld(p.Position, false)
							local d = (p.Position - root.Position).Magnitude
							if safeOk and d < bestDist then
								bestDist = d
								bestPrompt = pr
								bestPos = p.Position
							end
						end
					end
				end
			end
			if bestPrompt and bestPos then
				local char = LocalPlayer.Character
				if char then
					char:PivotTo(CFrame.new(bestPos + Vector3.new(0, 2, -4)))
					task.wait(0.1)
					local fireFn = rawget(_G, "fireproximityprompt")
					if type(fireFn) == "function" then
						pcall(fireFn, bestPrompt)
					else
						pcall(function() bestPrompt:InputHoldBegin() task.wait(0.25) bestPrompt:InputHoldEnd() end)
					end
					return true, "Talked to Odd Job NPC"
				end
			end
		end
		return false, "No Odd Job NPC nearby"
	elseif info.goalType == "level" then
		if mobConfig.HuntFilter ~= "ALL" then
			mobConfig.HuntFilter = "ALL"
		end
		if not mobConfig.AutoHunt then
			mobConfig.AutoHunt = true
			huntToken += 1
			startAutoHuntLoop(huntToken)
			refreshRuntimeLoop()
			ownedSubMode = "hunt"
		end
		return true, ("Farming IQ for Genius Lv %d"):format(info.need)
	end

	releaseMissionSubModes()
	return false, ("Manual step needed: %s"):format(info.goalText)
end

