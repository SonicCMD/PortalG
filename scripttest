local monitorActive = true

local function refreshActiveTabStatus(tabName: string)
	if not monitorActive then
		return
	end
	if tabName == "Material" then
		materialStatus:Set({ Content = Material:GetStatusText() })
	elseif tabName == "Research" then
		researchStatus:Set({ Content = Automation:GetResearchStatusText() })
	elseif tabName == "Craft" then
		craftStatus:Set({ Content = Automation:GetCraftStatusText() })
	elseif tabName == "Combat" then
		combatStatus:Set({ Content = Combat:GetCombatStatusText() })
	elseif tabName == "Mission" then
		missionStatus:Set({ Content = Combat:GetMissionStatusText() })
	elseif tabName == "Home" then
		homeStatus:Set({ Content = Material:GetHomeStatusText() })
	end
end

Combat:SetStateSyncCallback(function()
	if not monitorActive then
		return
	end
	tglMatAutoCollect:Set(Material:IsAutoCollecting(), true)
	local st = Combat:GetToggleStates()
	tglAutoAim:Set(st.AutoAim, true)
	tglAutoHunt:Set(st.AutoHunt, true)
	tglAutoMission:Set(st.AutoMission, true)
	refreshActiveTabStatus(Window:GetActiveTabName())
end)

Window:OnTabChanged(refreshActiveTabStatus)

local homeKeyConn: RBXScriptConnection? = UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed or UserInputService:GetFocusedTextBox() then
		return
	end
	if input.KeyCode == Enum.KeyCode.Home then
		Material:ForceSendHomeNow()
		homeStatus:Set({ Content = Material:GetHomeStatusText() })
	end
end)

local function unloadAll()
	monitorActive = false
	if homeKeyConn then
		homeKeyConn:Disconnect()
		homeKeyConn = nil
	end
	Combat:Destroy()
	Material:Destroy()
	Esp:Destroy()
	Automation:Destroy()
	Window:Destroy()
	if rawget(_G, "__RayfieldMenuCleanup") == unloadAll then
		rawset(_G, "__RayfieldMenuCleanup", nil)
	end
	if rawget(_G, "RayfieldMenu") ~= nil then
		rawset(_G, "RayfieldMenu", nil)
	end
end

rawset(_G, "__RayfieldMenuCleanup", unloadAll)
rawset(_G, "RayfieldMenu", {
	Window = Window,
	Material = Material,
	Esp = Esp,
	Automation = Automation,
	Combat = Combat,
	Unload = unloadAll,
})

SettingsTab:CreateButton({
	Name = "Unload Menu Completely",
	Description = "Clean up all UI, Material, ESP, and Automation for this session",
	Callback = unloadAll,
})

-- Lightweight tab-aware background monitor (0% CPU when menu hidden/minimized or on static tabs)
task.spawn(function()
	while monitorActive do
		task.wait(monitorInterval)
		if monitorActive and Window:IsVisible() and not Window:IsMinimized() then
			refreshActiveTabStatus(Window:GetActiveTabName())
		end
	end
end)

