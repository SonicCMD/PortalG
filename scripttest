local monitorConn: RBXScriptConnection? = nil

local function unloadAll()
	if monitorConn then
		monitorConn:Disconnect()
		monitorConn = nil
	end
	Material:Destroy()
	Esp:Destroy()
	Automation:Destroy()
	Window:Destroy()
	if rawget(_G, "__RayfieldMenuCleanup") == unloadAll then
		rawset(_G, "__RayfieldMenuCleanup", nil)
	end
	if rawget(_G, "RayfieldMenu") ~= nil then
		rawset(_G, "RayfieldMenu", nil)
	end
end

rawset(_G, "__RayfieldMenuCleanup", unloadAll)
rawset(_G, "RayfieldMenu", {
	Window = Window,
	Material = Material,
	Esp = Esp,
	Automation = Automation,
	Unload = unloadAll,
})

SettingsTab:CreateButton({
	Name = "Unload Menu Completely",
	Description = "Clean up all UI, Material, ESP, and Automation for this session",
	Callback = unloadAll,
})

-- Live Material, Research & Craft monitor
local elapsed = 0
monitorConn = RunService.RenderStepped:Connect(function(dt: number)
	elapsed += dt
	if elapsed < 0.25 then
		return
	end
	elapsed = 0

	materialStatus:Set({
		Content = Material:GetStatusText(),
	})
	researchStatus:Set({
		Content = Automation:GetResearchStatusText(),
	})
	craftStatus:Set({
		Content = Automation:GetCraftStatusText(),
	})
end)

Window:Notify({
	Title = "Rayfield Menu Ready",
	Content = "Press RightShift to toggle the menu anytime.",
	Duration = 4,
})
