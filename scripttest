local function pivotCharacterSafely(destPos: Vector3, lookAtPos: Vector3?): boolean
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not char or not hum or not root or hum.Health <= 0 then
		return false
	end

	local cam = workspace.CurrentCamera
	local relCam: CFrame? = nil
	if cam and (cam.CFrame.Position - root.Position).Magnitude <= 35 then
		relCam = root.CFrame:ToObjectSpace(cam.CFrame)
	end

	local flatLook = false
	local destCF: CFrame
	if lookAtPos then
		local flatTarget = Vector3.new(lookAtPos.X, destPos.Y, lookAtPos.Z)
		if (flatTarget - destPos).Magnitude > 1.2 then
			destCF = CFrame.lookAt(destPos, flatTarget)
			flatLook = true
		end
	end
	if not flatLook then
		destCF = CFrame.new(destPos) * (root.CFrame - root.CFrame.Position)
	end

	hum.Sit = false
	hum.PlatformStand = false
	root.Anchored = false
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	char:PivotTo(destCF)

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	if cam then
		if relCam then
			cam.CFrame = root.CFrame * relCam
			cam.Focus = CFrame.new(destPos)
		else
			cam.CameraType = Enum.CameraType.Custom
			cam.CameraSubject = hum
			local camTarget = if lookAtPos then lookAtPos else (destPos + destCF.LookVector * 12)
			local camPos = destPos - destCF.LookVector * 12 + Vector3.new(0, 5, 0)
			if (camTarget - camPos).Magnitude > 0.25 then
				cam.CFrame = CFrame.lookAt(camPos, camTarget)
			end
			cam.Focus = CFrame.new(camTarget)
		end
	end
	pcall(function()
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
	return true
end

local function getItemWorldTarget(itemId: string): { kind: string, dimId: string?, planetId: string?, portalCode: string?, needGolden: boolean, displayName: string }?
	if itemId == "" or itemId == "ALL" then
		return nil
	end
	local gd = getGameData()
	if not gd then
		return nil
	end
	local meta = gd.Items and gd.Items[itemId]
	if type(meta) ~= "table" then
		return nil
	end

	if meta.planet and tostring(meta.planet) ~= "" then
		local pId = tostring(meta.planet)
		local pMeta = gd.PlanetById and gd.PlanetById[pId]
		if type(pMeta) == "table" and pMeta.dim and tostring(pMeta.dim) ~= "" then
			local dId = tostring(pMeta.dim)
			return {
				kind = "planet",
				planetId = pId,
				dimId = dId,
				portalCode = DIM_TO_PORTAL_CODE[dId] or string.upper(dId),
				needGolden = false,
				displayName = tostring(pMeta.name or pId),
			}
		end
		return {
			kind = "planet",
			planetId = pId,
			dimId = "PLANET_" .. pId,
			portalCode = string.upper(pId),
			needGolden = true,
			displayName = tostring((type(pMeta) == "table" and pMeta.name) or pId),
		}
	end

	if meta.dim and tostring(meta.dim) ~= "" then
		local dId = tostring(meta.dim)
		local dMeta = gd.DimensionById and gd.DimensionById[dId]
		local needGold = (gd.GoldenPlaceIds and gd.GoldenPlaceIds[dId] == true) or (type(dMeta) == "table" and dMeta.outside == true) or false
		return {
			kind = "dim",
			dimId = dId,
			portalCode = DIM_TO_PORTAL_CODE[dId] or string.upper(dId),
			needGolden = needGold,
			displayName = tostring((type(dMeta) == "table" and dMeta.name) or dId),
		}
	end

	if EARTH_ITEMS[itemId] then
		local homeDim = tostring(LocalPlayer:GetAttribute("HomeDimension") or "C137")
		return {
			kind = "home",
			dimId = homeDim,
			portalCode = "C137",
			needGolden = false,
			displayName = "Earth (" .. homeDim .. ")",
		}
	end

	return nil
end

local function isPlayerInWorldTarget(req: any): boolean
	if not req then
		return true
	end
	local curDim = tostring(LocalPlayer:GetAttribute("CurrentDimension") or "")
	local homeDim = tostring(LocalPlayer:GetAttribute("HomeDimension") or "C137")
	local inOrbit = LocalPlayer:GetAttribute("InOrbit") == true
	if inOrbit then
		return false
	end
	if req.kind == "home" then
		return curDim == "" or curDim == homeDim or curDim == "C137"
	elseif req.kind == "planet" then
		if curDim == ("PLANET_" .. tostring(req.planetId)) or curDim == tostring(req.planetId) or (req.dimId and curDim == req.dimId) then
			return true
		end
		if curDim == "" and req.planetId and workspace:FindFirstChild("Proc_PLANET_" .. tostring(req.planetId)) then
			return true
		end
		return false
	elseif req.kind == "dim" then
		return req.dimId ~= nil and curDim == req.dimId
	end
	return true
end

local function findOwnedPortalGun(requireGolden: boolean): (Tool?, string)
	local char = LocalPlayer.Character
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	local best: Tool? = nil
	local bestTier = -1

	local function scanContainer(c: Instance?)
		if not c then
			return
		end
		for _, ch in ipairs(c:GetChildren()) do
			if ch:IsA("Tool") then
				local tier = if ch.Name == "GoldenPortalGun" then 3 elseif ch.Name == "PortalGun" then 2 elseif ch.Name == "PortalGunJr" then 1 else -1
				if tier > bestTier then
					if not requireGolden or tier == 3 then
						bestTier = tier
						best = ch
					end
				end
			end
		end
	end

	scanContainer(char)
	scanContainer(bp)
	if best then
		return best, "ok"
	end
	if requireGolden then
		return nil, "Requires GoldenPortalGun"
	end
	return nil, "No PortalGun found in bag"
end

local function configurePortalGunTarget(code: string)
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return
	end
	for _, uiName in ipairs({ "PortalGunUI", "PortalGunUILegacy" }) do
		local ui = pg:FindFirstChild(uiName)
		if ui then
			local modeVal = ui:FindFirstChild("PortalMode")
			if modeVal and modeVal:IsA("StringValue") then
				modeVal.Value = "dim"
			end
			local td = ui:FindFirstChild("TargetDimension")
			if td and td:IsA("StringValue") then
				td.Value = code
			end
			local scr = ui:FindFirstChild("Screen", true)
			if scr and scr:IsA("TextBox") then
				scr.Text = code
			end
			if td and td:IsA("StringValue") then
				td.Value = code
			end
		end
	end
end

local function crossPortalInstance(portalModel: Model, side: string, targetDimId: string?): (boolean, string)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = getRootPart()
	if not char or not hum or not root or hum.Health <= 0 then
		return false, "Character not ready"
	end
	local cfAttr = portalModel:GetAttribute(side .. "CF")
	if typeof(cfAttr) ~= "CFrame" then
		return false, "Portal surface CFrame missing"
	end

	releaseLootPhysics()
	hum.Sit = false
	hum.PlatformStand = false
	root.Anchored = false
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local enterFront = cfAttr.Position + cfAttr.LookVector * 2.4
	local enterIn = cfAttr.Position + cfAttr.LookVector * 0.35
	char:PivotTo(CFrame.lookAt(enterFront, enterIn))
	task.wait(0.06)
	char:PivotTo(CFrame.lookAt(enterIn, enterIn - cfAttr.LookVector * 2))
	pcall(function()
		hum:Move(-cfAttr.LookVector, false)
	end)

	local waitDeadline = os.clock() + 8.5
	local sentManualCross = false
	local pc = ReplicatedStorage:FindFirstChild("PortalCrossed")
	while os.clock() < waitDeadline and not destroyed do
		local curDim = tostring(LocalPlayer:GetAttribute("CurrentDimension") or "")
		if targetDimId and (curDim == targetDimId or (targetDimId:sub(1, 7) == "PLANET_" and curDim == targetDimId)) then
			pcall(function() hum:Move(Vector3.zero, false) end)
			return true, ("Crossed portal to %s"):format(targetDimId)
		end
		if os.clock() > waitDeadline - 7.3 and not sentManualCross and pc and pc:IsA("RemoteEvent") and portalModel.Parent then
			sentManualCross = true
			pcall(function()
				pc:FireServer(portalModel, side)
			end)
		end
		task.wait(0.1)
	end
	pcall(function() hum:Move(Vector3.zero, false) end)
	return false, "Portal crossing timed out"
end

local function findOpenPortalTo(targetDimId: string): (Model?, string?)
	local portals = workspace:FindFirstChild("Portals")
	if not portals or not targetDimId or targetDimId == "" then
		return nil, nil
	end
	for _, p in ipairs(portals:GetChildren()) do
		if p:IsA("Model") and not p:GetAttribute("Closing") and p:GetAttribute("Linked") ~= false then
			local dimB = tostring(p:GetAttribute("DimB") or "")
			local dimA = tostring(p:GetAttribute("DimA") or "")
			if dimB == targetDimId and typeof(p:GetAttribute("ACF")) == "CFrame" then
				return p, "A"
			elseif dimA == targetDimId and typeof(p:GetAttribute("BCF")) == "CFrame" then
				return p, "B"
			end
		end
	end
	return nil, nil
end

