local function findResearchLabInputConns(signal: RBXScriptSignal): { any }
	local gc = hasGetConnections()
	if not gc then
		return {}
	end
	local ok, conns = pcall(gc, signal)
	if not ok or type(conns) ~= "table" then
		return {}
	end
	local matched = {}
	for _, conn in ipairs(conns) do
		local fn = conn and conn.Function
		if type(fn) == "function" then
			local okInfo, src = pcall(debug.info, fn, "s")
			if okInfo and type(src) == "string" and string.find(src, "ResearchLab", 1, true) then
				table.insert(matched, conn)
			end
		end
	end
	return matched
end

local function invokeSignalConns(conns: { any }, fakeInput: any, isBegan: boolean): boolean
	local fired = false
	for _, conn in ipairs(conns) do
		local fn = conn and conn.Function
		if type(fn) == "function" then
			local ok = if isBegan then pcall(fn, fakeInput, false) else pcall(fn, fakeInput)
			if ok then
				fired = true
			end
		end
	end
	return fired
end

local function makeSafeHoldScreenPoint(): (number, number)
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(800, 600)
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		local candidates = {
			{ vp.X * 0.86, vp.Y * 0.45 },
			{ vp.X * 0.5, vp.Y * 0.5 },
			{ vp.X * 0.18, vp.Y * 0.80 },
			{ vp.X * 0.85, vp.Y * 0.22 },
		}
		for _, pt in ipairs(candidates) do
			local cx, cy = math.round(pt[1]), math.round(pt[2])
			local okObjs, objs = pcall(function()
				return pg:GetGuiObjectsAtPosition(cx, cy)
			end)
			local blocked = false
			if okObjs and type(objs) == "table" then
				for _, g in ipairs(objs) do
					if g:IsA("GuiButton") and g.Visible then
						blocked = true
						break
					end
				end
			end
			if not blocked then
				return cx, cy
			end
		end
	end
	return math.round(vp.X * 0.86), math.round(vp.Y * 0.45)
end

local function releaseMixHold()
	if not mixHoldActive then
		return
