local attrRawCache: { [string]: string } = {}
local attrDecodedCache: { [string]: { [string]: any } } = {}
local cachedResDoneRaw = ""
local cachedResDoneCount = 0

local function decodeAttrTable(attrName: string): { [string]: any }
	local raw = LocalPlayer:GetAttribute(attrName)
	if type(raw) ~= "string" or raw == "" then
		attrRawCache[attrName] = ""
		attrDecodedCache[attrName] = {}
		return {}
	end
	if attrRawCache[attrName] == raw and attrDecodedCache[attrName] then
		return attrDecodedCache[attrName]
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if ok and type(decoded) == "table" then
		attrRawCache[attrName] = raw
		attrDecodedCache[attrName] = decoded
		return decoded
	end
	return {}
end

