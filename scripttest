			})
				local minVal = sldCfg.Range[1] or 0
				local maxVal = sldCfg.Range[2] or 100
				if maxVal <= minVal then
					maxVal = minVal + 1
				end
				local inc = sldCfg.Increment or 1
				if inc <= 0 then
					inc = 1
				end
				local currentVal = roundToStep(sldCfg.CurrentValue or minVal, minVal, maxVal, inc)

				local card = Instance.new("Frame")
				card.Size = UDim2.new(1, 0, 0, 56)
				card.LayoutOrder = nextOrder()
				card.BackgroundColor3 = THEME.CardBg
				card.BorderSizePixel = 0
