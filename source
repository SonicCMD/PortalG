local lastTapClock = 0
local function sendLabTap(screenPos)
	if type(ActiveLabTapQueue) == "table" then
		pcall(function()
			table.insert(ActiveLabTapQueue, screenPos)
		end)
	end

	local now = os.clock()
	if now - lastTapClock >= 0.04 and VirtualInputManager then
		lastTapClock = now
		pcall(function()
			VirtualInputManager:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
			VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, true, game, 1)
			task.delay(0.02, function()
				pcall(function()
					VirtualInputManager:SendMouseButtonEvent(screenPos.X, screenPos.Y, 0, false, game, 1)
				end)
			end)
		end)
	end
end

local isHoldingMix = false
local function setLabHold(holding, screenPos)
	local debugSetupvalue = (debug and debug.setupvalue) or setupvalue
	if ActiveLabInputFunc and ActiveLabHoldIndex and type(debugSetupvalue) == "function" then
		pcall(function()
			if holding then
				debugSetupvalue(ActiveLabInputFunc, ActiveLabHoldIndex, {
					UserInputType = Enum.UserInputType.Touch,
					KeyCode = Enum.KeyCode.Unknown,
				})
			else
				debugSetupvalue(ActiveLabInputFunc, ActiveLabHoldIndex, nil)
			end
		end)
	end

	if VirtualInputManager and isHoldingMix ~= holding then
		isHoldingMix = holding
		local pos = screenPos or Vector2.new(300, 300)
		pcall(function()
			VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y, game)
			VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, holding, game, 1)
		end)
	elseif not holding then
		isHoldingMix = false
	end
end

local function inspectCandidateFunction(fn)
	if type(fn) ~= "function" then
		return
	end
	local debugGetupvalues = (debug and debug.getupvalues) or getupvalues
	if type(debugGetupvalues) ~= "function" then
		return
	end

	local okUp, ups = pcall(debugGetupvalues, fn)
	if not okUp or type(ups) ~= "table" then
		return
	end

	local hasButtonATable = false
	local hasSpaceKey = false
	local tapQueueCandidate = nil
	local piecesCandidate = nil
	local screwsCandidate = nil
	local stageString = nil

	for _, val in pairs(ups) do
		if type(val) == "string" and (val == "pieces" or val == "screws" or val == "power") then
			stageString = val
		elseif type(val) == "table" then
			if rawget(val, Enum.KeyCode.ButtonA) == true then
				hasButtonATable = true
				if rawget(val, Enum.KeyCode.Space) == true then
					hasSpaceKey = true
				end
			elseif rawget(val, 1) ~= nil then
				local first = rawget(val, 1)
				if typeof(first) == "Vector2" then
					tapQueueCandidate = val
				elseif type(first) == "table" then
					if first.target ~= nil and (first.ghostModel ~= nil or first.parts ~= nil) then
						piecesCandidate = val
					elseif first.prog ~= nil and first.pos ~= nil then
						screwsCandidate = val
					end
				end
			elseif tapQueueCandidate == nil then
				tapQueueCandidate = val
			end
		end
	end

	if hasButtonATable and hasSpaceKey and tapQueueCandidate then
		ActiveLabTapQueue = tapQueueCandidate
		ActiveLabInputFunc = fn
		ActiveLabHoldIndex = 3
	end

	if piecesCandidate or screwsCandidate or (hasButtonATable and not hasSpaceKey and stageString) then
		if piecesCandidate then
			ActiveBenchPieces = piecesCandidate
		end
		if screwsCandidate then
			ActiveBenchScrews = screwsCandidate
		end
		if hasButtonATable and not hasSpaceKey then
			ActiveBenchInputFunc = fn
		end

		for _, val in pairs(ups) do
			if type(val) == "function" then
				local okSub, subUps = pcall(debugGetupvalues, val)
				if okSub and type(subUps) == "table" then
					local hasBenchFolder = false
					local hasTweenService = false
					local hasLabelPair = 0
					for _, sv in pairs(subUps) do
						if typeof(sv) == "Instance" then
							if sv.Name == "AssemblyBenchLocal" then
								hasBenchFolder = true
							elseif sv:IsA("TweenService") then
								hasTweenService = true
							elseif sv:IsA("TextLabel") then
								hasLabelPair += 1
							end
						end
					end
					if hasBenchFolder and hasTweenService then
						ActiveBenchSnapFunc = val
					elseif hasLabelPair >= 2 then
						ActiveBenchSetHintFunc = val
					end
				end
			end
		end
	end
end

local function hookMinigameModules()
	if not Config.AutoFastResearch and not Config.FastCraft and not Config.AutoMission then
		return
	end

	pcall(function()
		if type(getconnections) == "function" then
			for _, conn in pairs(getconnections(UserInputService.InputBegan)) do
				if conn.Function then
					inspectCandidateFunction(conn.Function)
				end
			end
			for _, conn in pairs(getconnections(RunService.RenderStepped)) do
				if conn.Function then
					inspectCandidateFunction(conn.Function)
				end
			end
		end
	end)

	pcall(function()
		if type(getgc) == "function" then
			local gc = getgc(true)
			for _, obj in pairs(gc) do
				if type(obj) == "function" then
					inspectCandidateFunction(obj)
				elseif type(obj) == "table" then
					local scanFn = rawget(obj, "scan")
					local circuitFn = rawget(obj, "circuit")
					local gyroFn = rawget(obj, "gyro")
					local mixFn = rawget(obj, "mix")
					if
						type(scanFn) == "function"
						and type(circuitFn) == "function"
						and type(gyroFn) == "function"
						and type(mixFn) == "function"
					then
						if not HookedTables[obj] then
							HookedTables[obj] = {
								scan = scanFn,
								circuit = circuitFn,
								gyro = gyroFn,
								mix = mixFn,
							}
							rawset(obj, "scan", function(...)
								if Config.AutoFastResearch or Config.AutoMission then
									return true
								end
								return scanFn(...)
							end)
							rawset(obj, "circuit", function(...)
								if Config.AutoFastResearch or Config.AutoMission then
									return true
								end
								return circuitFn(...)
							end)
							rawset(obj, "gyro", function(...)
								if Config.AutoFastResearch or Config.AutoMission then
									return true
								end
								return gyroFn(...)
							end)
							rawset(obj, "mix", function(...)
								if Config.AutoFastResearch or Config.AutoMission then
									return true
								end
								return mixFn(...)
							end)
						end
					end

					local runFn = rawget(obj, "run")
					local abortFn = rawget(obj, "abort")
					if type(runFn) == "function" and type(abortFn) == "function" and not HookedTables[obj] then
						HookedTables[obj] = { run = runFn }
						rawset(obj, "run", function(arg)
							if type(arg) == "table" then
								if arg.research ~= nil and (Config.AutoFastResearch or Config.AutoMission) then
									task.wait(Config.ResearchDelay)
									return "done"
								elseif arg.result ~= nil and (Config.FastCraft or Config.AutoMission) then
									task.wait(0.25)
									return "done"
								end
							elseif Config.AutoFastResearch or Config.AutoMission then
								task.wait(Config.ResearchDelay)
								return "done"
							end
							return runFn(arg)
						end)
					end
				end
			end
		end
	end)

	pcall(function()
		local labMod = ReplicatedStorage:FindFirstChild("ResearchLab")
		if labMod and labMod:IsA("ModuleScript") then
			local lab = require(labMod)
			if type(lab) == "table" and type(lab.run) == "function" and not HookedTables[lab] then
				local oldRun = lab.run
				HookedTables[lab] = { run = oldRun }
				lab.run = function(arg)
					if Config.AutoFastResearch or Config.AutoMission then
						task.wait(Config.ResearchDelay)
						return "done"
					end
					return oldRun(arg)
				end
			end
		end
	end)

	pcall(function()
		local benchMod = ReplicatedStorage:FindFirstChild("AssemblyBench")
		if benchMod and benchMod:IsA("ModuleScript") then
			local bench = require(benchMod)
			if type(bench) == "table" and type(bench.run) == "function" and not HookedTables[bench] then
				local oldRun = bench.run
				HookedTables[bench] = { run = oldRun }
				bench.run = function(arg)
					if Config.FastCraft or Config.AutoMission then
						task.wait(0.25)
						return "done"
					end
					return oldRun(arg)
				end
			end
		end
	end)
end

local function unhookMinigameModules()
	for tbl, saved in pairs(HookedTables) do
		pcall(function()
			for k, v in pairs(saved) do
				rawset(tbl, k, v)
			end
		end)
	end
	table.clear(HookedTables)
end

