local WildItemBiome = {
	MagmaShard = "volcano",
	FrostGem = "snow",
	DeepQuartz = "caves",
}

local function getNearestBiomePosition(biomeName)
	local hrp = getRootPart()
	local dim = tostring(LocalPlayer:GetAttribute("CurrentDimension") or "C137")
	local procFolder = hrp and workspace:FindFirstChild("Proc_" .. dim)
	if not procFolder then
		return nil
	end

	local bestPos = nil
	local bestDist = nil
	for i = 1, 4 do
		local attr = procFolder:GetAttribute(("Biome_%s_%d"):format(biomeName, i))
		if not attr and i == 1 then
			attr = procFolder:GetAttribute("Biome_" .. biomeName)
		end
		if typeof(attr) == "Vector3" then
			local diff = attr - hrp.Position
			local dx = (diff.X + 6000) % 12000 - 6000
			local dz = (diff.Z + 6000) % 12000 - 6000
			local dist = math.sqrt(dx * dx + dz * dz)
			if not bestDist or dist < bestDist then
				bestDist = dist
				bestPos = Vector3.new(hrp.Position.X + dx, math.max(hrp.Position.Y, 40), hrp.Position.Z + dz)
			end
		end
	end
	return bestPos
end

local function findNearestResourceNode(itemFilter, maxDist)
	local hrp = getRootPart()
	if not hrp then
		return nil, nil
	end

	local bestNode = nil
	local bestPrompt = nil
	local bestDist = maxDist or 8000

	for _, node in ipairs(CollectionService:GetTagged("ResourceNode")) do
		if node:IsDescendantOf(workspace) then
			if not itemFilter or itemFilter == "ALL" or node:GetAttribute("Item") == itemFilter then
				local prompt = node:FindFirstChild("HarvestPrompt", true)
				if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
					local ok, pos = pcall(function()
						return node:GetPivot().Position
					end)
					if ok and typeof(pos) == "Vector3" then
						local dist = (pos - hrp.Position).Magnitude
						if dist < bestDist then
							bestDist = dist
							bestNode = node
							bestPrompt = prompt
						end
					end
				end
			end
		end
	end

	return bestNode, bestPrompt
end

-- Travels to the required Planet, Dimension, or Earth Biome for a specific material item
local function ensureCorrectWorldForMaterial(itemId)
	if not itemId or itemId == "ALL" then
		return true
	end

	local cat = MaterialById[itemId]
	local GameData = getGameData()
	local gameItem = GameData and GameData.Items and GameData.Items[itemId]

	local planetId = (cat and cat.planet) or (gameItem and gameItem.planet)
	local dimId = (cat and cat.dim) or (gameItem and gameItem.dim)
	local biomeName = (cat and cat.biome) or WildItemBiome[itemId]

	if planetId then
		if LocalPlayer:GetAttribute("CurrentPlanet") ~= planetId then
			return travelToPlanet(planetId)
		end
		return true
	elseif dimId then
		if LocalPlayer:GetAttribute("CurrentPlanet") ~= nil then
			local PlanetTravel = ReplicatedStorage:FindFirstChild("PlanetTravel")
			if PlanetTravel then
				pcall(function()
					PlanetTravel:InvokeServer("home")
				end)
				task.wait(0.4)
			end
		end
		if LocalPlayer:GetAttribute("CurrentDimension") ~= dimId then
			return travelToDimension(dimId, cat and cat.code or dimId)
		end
		return true
	elseif biomeName or (cat and cat.locType == "home") then
		ensureAtHomeBase()
		return true
	end

	return true
end

local function harvestResourceNode(itemFilter)
	if isInActiveMinigame() then
		return false
	end

	local targetItem = (itemFilter ~= "ALL") and itemFilter or nil
	if targetItem then
		ensureCorrectWorldForMaterial(targetItem)
	end

	local node, prompt = findNearestResourceNode(targetItem, 8000)
	if node and prompt then
		local ok, pos = pcall(function()
			return node:GetPivot().Position
		end)
		if ok and typeof(pos) == "Vector3" then
			local hrp = getRootPart()
			if hrp and (pos - hrp.Position).Magnitude > 9 then
				teleportToPosition(pos + Vector3.new(0, 2.8, 0), (pos - hrp.Position).Magnitude > 220)
				task.wait(0.22)
			end
			triggerProximityPrompt(prompt)
			task.wait(0.18)
			return true
		end
	end

	-- If harvesting a wild Earth biome item and no node is streamed in yet, move to the biome center
	if targetItem and WildItemBiome[targetItem] then
		local biomePos = getNearestBiomePosition(WildItemBiome[targetItem])
		if biomePos then
			teleportToPosition(biomePos, true)
			task.wait(0.55)
			local streamedNode, streamedPrompt = findNearestResourceNode(targetItem, 1800)
			if streamedNode and streamedPrompt then
				local ok, pos = pcall(function()
					return streamedNode:GetPivot().Position
				end)
				if ok and typeof(pos) == "Vector3" then
					teleportToPosition(pos + Vector3.new(0, 2.8, 0), false)
					task.wait(0.22)
					triggerProximityPrompt(streamedPrompt)
					return true
				end
			end
		end
	end

	-- If on a planet and no node is streamed in around current spot, patrol around the planet surface
	if LocalPlayer:GetAttribute("CurrentPlanet") ~= nil then
		local hrp = getRootPart()
		if hrp then
			local offset = Vector3.new(math.random(-180, 180), 25, math.random(-180, 180))
			teleportToPosition(hrp.Position + offset, true)
			task.wait(0.4)
		end
	end

	return false
end

