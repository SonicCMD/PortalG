local function decodeAttr(attrName)
	local raw = LocalPlayer:GetAttribute(attrName)
	if type(raw) ~= "string" or raw == "" then
		return {}
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return (ok and type(data) == "table") and data or {}
end

local CachedGameData = nil
local function getGameData()
	if CachedGameData then
		return CachedGameData
	end
	local mod = ReplicatedStorage:FindFirstChild("GameData")
	if mod and mod:IsA("ModuleScript") then
		local ok, data = pcall(require, mod)
		if ok and type(data) == "table" then
			CachedGameData = data
			return data
		end
	end
	return nil
end

local function getRootPart()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function isInActiveMinigame()
	return workspace:FindFirstChild("ResearchLabLocal") ~= nil
		or workspace:FindFirstChild("AssemblyBenchLocal") ~= nil
end

local function unseatCharacter()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.SeatPart then
		pcall(function()
			hum.Sit = false
			hum.Jump = true
		end)
		task.wait(0.1)
	end
end

local function teleportToPosition(pos, streamFirst)
	if typeof(pos) ~= "Vector3" or isInActiveMinigame() then
		return false
	end
	unseatCharacter()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false
	end

	local dist = (pos - hrp.Position).Magnitude
	if streamFirst or dist > 260 then
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(pos, 4)
		end)
	end

	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		char:PivotTo(CFrame.new(pos))
	end)
	return true
end

local function triggerProximityPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then
		return false
	end
	pcall(function()
		prompt.HoldDuration = 0
		prompt.RequiresLineOfSight = false
		if prompt.MaxActivationDistance < 24 then
			prompt.MaxActivationDistance = 24
		end
	end)
	if type(fireproximityprompt) == "function" then
		pcall(fireproximityprompt, prompt)
	end
	pcall(function()
		prompt:InputHoldBegin()
		task.delay(0.06, function()
			pcall(function()
				prompt:InputHoldEnd()
			end)
		end)
	end)
	return true
end

local function getMyBase()
	local homePos = LocalPlayer:GetAttribute("HomePos")
	local fallback = nil
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Model") and child.Name:sub(1, 10) == "SmithHouse" then
			if child:GetAttribute("OwnerId") == LocalPlayer.UserId then
				return child
			end
			local members = "," .. tostring(child:GetAttribute("MemberIds") or "") .. ","
			local offset = child:GetAttribute("Offset")
			if
				members:find("," .. LocalPlayer.UserId .. ",", 1, true)
				or (
					not fallback
					and typeof(homePos) == "Vector3"
					and typeof(offset) == "Vector3"
					and (Vector3.new(139, 0, 82) + offset - homePos).Magnitude < 60
				)
			then
				fallback = child
			end
		end
	end
	return fallback
end

-- Crosses an existing portal in workspace.Portals that leads to targetDim
local function tryCrossExistingPortal(targetDim)
	local portalsFolder = workspace:FindFirstChild("Portals")
	if not portalsFolder then
		return false
	end
	local PortalCrossed = ReplicatedStorage:FindFirstChild("PortalCrossed")
	local char = LocalPlayer.Character
	if not char then
		return false
	end

	for _, p in ipairs(portalsFolder:GetChildren()) do
		local dimA = p:GetAttribute("DimA")
		local dimB = p:GetAttribute("DimB")
		local acf = p:GetAttribute("ACF")
		local bcf = p:GetAttribute("BCF")
		if acf and bcf then
			local enterSide = nil
			local exitCF = nil
			if not targetDim then
				if p:GetAttribute("Owner") == LocalPlayer.UserId then
					enterSide = "A"
					exitCF = bcf
					targetDim = dimB
				end
			elseif dimB == targetDim then
				enterSide = "A"
				exitCF = bcf
			elseif dimA == targetDim then
				enterSide = "B"
				exitCF = acf
			end

			if enterSide and exitCF then
				local enterCF = (enterSide == "A") and acf or bcf
				teleportToPosition(enterCF.Position, false)
				task.wait(0.12)
				if targetDim then
					pcall(function()
						LocalPlayer:SetAttribute("CurrentDimension", targetDim)
					end)
				end
				pcall(function()
					char:PivotTo(CFrame.new(exitCF.Position + exitCF.LookVector * 3.2))
				end)
				if PortalCrossed and PortalCrossed:IsA("RemoteEvent") then
					pcall(function()
						PortalCrossed:FireServer(p, enterSide)
					end)
				end
				task.wait(0.5)
				return true
			end
		end
	end
	return false
end

-- Travels to Orbit or a specific Space Planet using PlanetTravel RemoteFunction
local lastPlanetTravelClock = 0
local function travelToOrbit()
	if LocalPlayer:GetAttribute("InOrbit") == true and not LocalPlayer:GetAttribute("CurrentPlanet") then
		return true
	end
	local PlanetTravel = ReplicatedStorage:FindFirstChild("PlanetTravel")
	if LocalPlayer:GetAttribute("CurrentPlanet") and PlanetTravel then
		pcall(function()
			PlanetTravel:InvokeServer("leave")
		end)
		task.wait(0.3)
	end

	local base = getMyBase()
	local pad = base and base:FindFirstChild("LaunchPad", true)
	local plate = pad and (pad:FindFirstChild("LaunchPlate") or pad)
	if plate then
		local ok, pos = pcall(function()
			return plate:IsA("Model") and plate:GetPivot().Position or plate.Position
		end)
		if ok and typeof(pos) == "Vector3" then
			teleportToPosition(pos + Vector3.new(0, 3, 0), false)
			task.wait(0.18)
			local prompt = pad:FindFirstChildWhichIsA("ProximityPrompt", true)
			if prompt then
				triggerProximityPrompt(prompt)
				task.wait(0.6)
			end
		end
	end

	local hrp = getRootPart()
	if hrp then
		teleportToPosition(Vector3.new(hrp.Position.X, 5200, hrp.Position.Z), false)
		pcall(function()
			LocalPlayer:SetAttribute("InOrbit", true)
		end)
		task.wait(0.35)
		return true
	end
	return false
end

local function travelToPlanet(planetId)
	if not planetId then
		return false
	end
	if LocalPlayer:GetAttribute("CurrentPlanet") == planetId then
		return true
	end
	local now = os.clock()
	if now - lastPlanetTravelClock < 1.8 then
		return false
	end
	lastPlanetTravelClock = now

	local PlanetTravel = ReplicatedStorage:FindFirstChild("PlanetTravel")
	if not PlanetTravel or not PlanetTravel:IsA("RemoteFunction") then
		return false
	end

	if LocalPlayer:GetAttribute("CurrentPlanet") ~= nil then
		pcall(function()
			PlanetTravel:InvokeServer("leave")
		end)
		task.wait(0.3)
	end

	if LocalPlayer:GetAttribute("InOrbit") ~= true then
		travelToOrbit()
	end

	local ok, spawnPos = pcall(function()
		return PlanetTravel:InvokeServer("enter", planetId)
	end)
	if ok and typeof(spawnPos) == "Vector3" then
		pcall(function()
			LocalPlayer:SetAttribute("InOrbit", false)
			LocalPlayer:SetAttribute("CurrentPlanet", planetId)
			LocalPlayer:RequestStreamAroundAsync(spawnPos, 6)
		end)
		local landPos = spawnPos - Vector3.new(0, 55, 0)
		local ray = workspace:Raycast(spawnPos + Vector3.new(0, 80, 0), Vector3.new(0, -320, 0))
		if ray then
			landPos = ray.Position + Vector3.new(0, 3.5, 0)
		end
		teleportToPosition(landPos, false)
		task.wait(0.45)
		return true
	end
	return false
end

-- Travels to a Multiverse Dimension using PortalGun / PortalMachine / Existing Portals
local lastDimTravelClock = 0
local function travelToDimension(targetDim, portalCode)
	if not targetDim then
		return false
	end
	local code = portalCode or (targetDim == "EvilMorty" and "EVILMORTY" or string.upper(targetDim))

	-- Leave planet/orbit first if currently in space
	if LocalPlayer:GetAttribute("CurrentPlanet") ~= nil or LocalPlayer:GetAttribute("InOrbit") == true then
		local PlanetTravel = ReplicatedStorage:FindFirstChild("PlanetTravel")
		if PlanetTravel then
			pcall(function()
				PlanetTravel:InvokeServer("home")
			end)
			task.wait(0.5)
		end
	end

	if LocalPlayer:GetAttribute("CurrentDimension") == targetDim then
		return true
	end

	if tryCrossExistingPortal(targetDim) then
		return LocalPlayer:GetAttribute("CurrentDimension") == targetDim
	end

	local now = os.clock()
	if now - lastDimTravelClock < 2.2 then
		return false
	end
	lastDimTravelClock = now

	local homeDim = LocalPlayer:GetAttribute("HomeDimension") or "C137"

	-- Method 1: Use PortalMachine at base if available
	local base = getMyBase()
	local PortalMachine = ReplicatedStorage:FindFirstChild("PortalMachine")
	if base and PortalMachine and PortalMachine:IsA("RemoteEvent") then
		local machine = base:FindFirstChild("GoldenPortalMachine", true) or base:FindFirstChild("PortalMachine", true)
		if machine then
			pcall(function()
				PortalMachine:FireServer("open", machine, code)
			end)
			task.wait(0.6)
			if tryCrossExistingPortal(targetDim) then
				return true
			end
		end
	end

	-- Method 2: Equip PortalGun / GoldenPortalGun / PortalGunJr and shoot a portal
	local char = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = getRootPart()
	if char and hum and hrp then
		local gun = char:FindFirstChild("GoldenPortalGun")
			or char:FindFirstChild("PortalGun")
			or char:FindFirstChild("PortalGunJr")
		if not gun and backpack then
			gun = backpack:FindFirstChild("GoldenPortalGun")
				or backpack:FindFirstChild("PortalGun")
				or backpack:FindFirstChild("PortalGunJr")
			if gun then
				pcall(function()
					hum:EquipTool(gun)
				end)
				task.wait(0.2)
			end
		end

		if gun then
			if type(_G.PG_GunSetCode) == "function" then
				pcall(_G.PG_GunSetCode, code)
			end
			local pgui = LocalPlayer:FindFirstChild("PlayerGui")
			for _, guiName in ipairs({ "PortalGunUI", "PortalGunUILegacy" }) do
				local ui = pgui and pgui:FindFirstChild(guiName)
				if ui then
					local td = ui:FindFirstChild("TargetDimension")
					local pm = ui:FindFirstChild("PortalMode")
					local pr = ui:FindFirstChild("PortalRange")
					if td then
						td.Value = code
					end
					if pm then
						pm.Value = "dim"
					end
					if pr then
						pr.Value = 30
					end
				end
			end

			task.wait(0.1)
			pcall(function()
				gun:Activate()
			end)
			task.delay(0.12, function()
				pcall(function()
					gun:Deactivate()
				end)
			end)

			if VirtualInputManager then
				local cam = workspace.CurrentCamera
				if cam then
					local center = cam.ViewportSize / 2
					pcall(function()
						VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
						task.delay(0.05, function()
							VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
						end)
					end)
				end
			end

			task.wait(0.65)
			if tryCrossExistingPortal(targetDim) then
				return true
			end
		end
	end

	-- Fallback when returning to HomeDimension without a portal gun
	if targetDim == homeDim then
		local GoHome = ReplicatedStorage:FindFirstChild("GoHome")
		if GoHome and GoHome:IsA("RemoteEvent") then
			pcall(function()
				GoHome:FireServer("start")
			end)
			task.wait(5.2)
			return LocalPlayer:GetAttribute("CurrentDimension") == homeDim
		end
	end

	return false
end

local function ensureAtHomeBase()
	if LocalPlayer:GetAttribute("CurrentPlanet") ~= nil or LocalPlayer:GetAttribute("InOrbit") == true then
		local PlanetTravel = ReplicatedStorage:FindFirstChild("PlanetTravel")
		if PlanetTravel then
			pcall(function()
				PlanetTravel:InvokeServer("home")
			end)
			task.wait(0.5)
		end
	end
	local homeDim = LocalPlayer:GetAttribute("HomeDimension") or "C137"
	if LocalPlayer:GetAttribute("CurrentDimension") ~= homeDim then
		travelToDimension(homeDim, homeDim)
	end
	return LocalPlayer:GetAttribute("CurrentDimension") == homeDim and not LocalPlayer:GetAttribute("CurrentPlanet")
end

