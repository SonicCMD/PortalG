local isAutoResearchBusy = false

local function startResearchById(resId)
	if isAutoResearchBusy or isInActiveMinigame() then
		return false
	end
	local ProgressAction = ReplicatedStorage:FindFirstChild("ProgressAction")
	if not ProgressAction then
		return false
	end

	local known = decodeAttr("Research")
	if known[resId] then
		return true
	end

	local researching = decodeAttr("Researching")
	local researchingMore = decodeAttr("ResearchingMore")
	if researching.id == resId or (type(researchingMore) == "table" and researchingMore[resId] ~= nil) then
		return true
	end

	if researching.id ~= nil and not LocalPlayer:GetAttribute("ParallelLab") then
		return false
	end

	local GameData = getGameData()
	local resDef = GameData and GameData.ResearchById and GameData.ResearchById[resId]
	if resDef then
		local genius = LocalPlayer:GetAttribute("Genius") or 1
		local currentQI = LocalPlayer:GetAttribute("QI") or 0
		if genius < (resDef.level or 1) or currentQI < (resDef.qi or 0) then
			return false
		end
	end

	isAutoResearchBusy = true
	local completed = false
	pcall(function()
		local okStart, started, tokenOrErr = pcall(function()
			return ProgressAction:InvokeServer("labstart", resId)
		end)
		if okStart and started and tokenOrErr then
			local delays = { Config.ResearchDelay, 1.5, 3.0, 5.0 }
			for _, d in ipairs(delays) do
				task.wait(d)
				local okRes, success, msg = pcall(function()
					return ProgressAction:InvokeServer("research", resId, tokenOrErr)
				end)
				if okRes and success then
					Config.ResearchDelay = math.max(0.2, d)
					completed = true
					break
				else
					local errStr = string.lower(tostring(msg or ""))
					if errStr:find("fast") or errStr:find("wait") or errStr:find("time") or not success then
						local okRe, reStarted, newToken = pcall(function()
							return ProgressAction:InvokeServer("labstart", resId)
						end)
						if okRe and reStarted and newToken then
							tokenOrErr = newToken
						else
							break
						end
					end
				end
			end
		end
	end)
	task.wait(0.4)
	isAutoResearchBusy = false
	return completed
end

local function tryAutoStartNextResearch()
	if not (Config.AutoQueueResearch or Config.AutoMission) or isAutoResearchBusy or isInActiveMinigame() then
		return false
	end

	local GameData = getGameData()
	if not GameData or type(GameData.Research) ~= "table" then
		return false
	end

	local built = decodeAttr("Built")
	if not built.Workbench then
		return false
	end

	local researching = decodeAttr("Researching")
	local parallelLab = LocalPlayer:GetAttribute("ParallelLab")
	if researching.id ~= nil and not parallelLab then
		return false
	end

	local researchingMore = decodeAttr("ResearchingMore")
	local known = decodeAttr("Research")
	local currentQI = LocalPlayer:GetAttribute("QI") or 0
	local totalQI = LocalPlayer:GetAttribute("TotalQI") or 0
	local geniusCap = LocalPlayer:GetAttribute("GeniusCap") or 45
	local geniusLevel = LocalPlayer:GetAttribute("Genius") or 1
	pcall(function()
		geniusLevel = math.max(geniusLevel, GameData.GeniusLevel(totalQI))
	end)

	for _, res in ipairs(GameData.Research) do
		local id = res.id
		local alreadyActive = (researching.id == id) or (type(researchingMore) == "table" and researchingMore[id] ~= nil)
		if id and not known[id] and not alreadyActive then
			local reqLevel = res.level or 1
			if reqLevel <= geniusLevel and reqLevel <= geniusCap and currentQI >= (res.qi or 0) then
				local reqMet = true
				for _, preId in ipairs(res.requires or {}) do
					if not known[preId] then
						reqMet = false
						break
					end
				end

				if reqMet and type(res.items) == "table" then
					for _, cost in ipairs(res.items) do
						local have = tonumber(PlayerInventory[cost.item]) or 0
						if have < (cost.count or 1) then
							reqMet = false
							break
						end
					end
				end

				if reqMet then
					task.spawn(function()
						startResearchById(id)
					end)
					return true
				end
			end
		end
	end
	return false
end

-- Crafts a single unit of recipeId at the home workbench
local function craftRecipeAtWorkbench(recipeId)
	if isInActiveMinigame() then
		return false
	end
	local CraftItem = ReplicatedStorage:FindFirstChild("CraftItem")
	local CraftFinish = ReplicatedStorage:FindFirstChild("CraftFinish")
	if not CraftItem then
		return false
	end

	ensureAtHomeBase()

	if not isNearWorkbench() then
		local spot = getGarageSpot()
		if spot then
			teleportToPosition(spot, false)
			task.wait(0.25)
		end
	end

	local okDirect, directOk = pcall(function()
		return CraftItem:InvokeServer(recipeId, 1)
	end)
	if okDirect and directOk == true then
		return true
	end

	if CraftFinish then
		local okAsm, asmOk, token = pcall(function()
			return CraftItem:InvokeServer(recipeId, "assemble")
		end)
		if okAsm and asmOk and type(token) == "string" then
			local delays = { 0.35, 1.2, 2.5 }
			for _, d in ipairs(delays) do
				task.wait(d)
				local okFin, finSuccess = pcall(function()
					return CraftFinish:InvokeServer(token, "done")
				end)
				if okFin and finSuccess then
					return true
				end
				local okRe, reOk, newToken = pcall(function()
					return CraftItem:InvokeServer(recipeId, "assemble")
				end)
				if okRe and reOk and type(newToken) == "string" then
					token = newToken
				else
					break
				end
			end
		end
	end

	return false
end

-- Completes any active construction site pieces at the player's home
local function completeActiveConstructionSites()
	ensureAtHomeBase()
	local base = getMyBase()
	if not base then
		return false
	end

	for _, desc in ipairs(base:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled and desc.Name ~= "HarvestPrompt" then
			local actionText = string.lower(tostring(desc.ActionText or ""))
			local objText = string.lower(tostring(desc.ObjectText or ""))
			local parentName = string.lower(tostring(desc.Parent and desc.Parent.Name or ""))
			if
				actionText:find("build")
				or actionText:find("weld")
				or actionText:find("wire")
				or actionText:find("bolt")
				or actionText:find("hammer")
				or actionText:find("construct")
				or actionText:find("install")
				or actionText:find("assemble")
				or objText:find("step")
				or parentName:find("site")
				or parentName:find("piece")
			then
				local part = desc.Parent
				local ok, pos = pcall(function()
					if part:IsA("BasePart") then
						return part.Position
					elseif part:IsA("Attachment") then
						return part.WorldPosition
					elseif part:IsA("Model") then
						return part:GetPivot().Position
					end
					return nil
				end)
				if ok and typeof(pos) == "Vector3" then
					teleportToPosition(pos + Vector3.new(0, 2.5, 0), false)
					task.wait(0.18)
					triggerProximityPrompt(desc)
					task.wait(0.45)
					return true
				end
			end
		end
	end
	return false
end

