-- Real-time solver for active ResearchLabLocal & AssemblyBenchLocal stages
local lastSolverScan = 0
local lastBenchHookAttempt = 0
local padToggleState = false
local isHoldingBenchMouse = false

local function setBenchMouseHold(holding, screenPos)
	if not VirtualInputManager then
		return
	end
	if holding then
		isHoldingBenchMouse = true
		local pos = screenPos or Vector2.new(400, 300)
		pcall(function()
			VirtualInputManager:SendMouseMoveEvent(pos.X, pos.Y, game)
			VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
		end)
	elseif isHoldingBenchMouse then
		isHoldingBenchMouse = false
		local pos = screenPos or Vector2.new(400, 300)
		pcall(function()
			VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
			VirtualInputManager:SendGamepadButtonEvent(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA, false, game)
		end)
	end
end

table.insert(
	Connections,
	RunService.RenderStepped:Connect(function()
		if not Config.AutoFastResearch and not Config.FastCraft and not Config.AutoMission then
			return
		end

		local now = os.clock()
		if now - lastSolverScan < 0.05 then
			return
		end
		lastSolverScan = now

		local cam = workspace.CurrentCamera
		if not cam then
			return
		end

		-- A. Auto-Solver for ResearchLabLocal
		if Config.AutoFastResearch or Config.AutoMission then
			local labFolder = workspace:FindFirstChild("ResearchLabLocal")
			if labFolder then
				if not ActiveLabTapQueue and now - lastBenchHookAttempt > 0.6 then
					lastBenchHookAttempt = now
					hookMinigameModules()
				end

				local foundMixStage = false

				for _, inst in ipairs(labFolder:GetChildren()) do
					if inst:IsA("WedgePart") then
						local bb = inst:FindFirstChildOfClass("BillboardGui")
						if bb and bb.Enabled then
							local sp, onScreen = cam:WorldToScreenPoint(inst.Position)
							if onScreen then
								sendLabTap(Vector2.new(sp.X, sp.Y))
							else
								sendLabTap(cam.ViewportSize / 2)
							end
						end
					elseif inst:IsA("Part") then
						local bb = inst:FindFirstChildOfClass("BillboardGui")
						local lbl = bb and bb:FindFirstChildOfClass("TextLabel")
						if lbl then
							local txt = lbl.Text
							if txt == "HOLD" or txt == "POURING..." then
								foundMixStage = true
								local sp = cam:WorldToScreenPoint(inst.Position)
								setLabHold(true, Vector2.new(sp.X, sp.Y))
							elseif txt == "LET GO!" then
								foundMixStage = true
								local sp = cam:WorldToScreenPoint(inst.Position)
								setLabHold(false, Vector2.new(sp.X, sp.Y))
							end
						end

						if inst.Shape == Enum.PartType.Ball and inst.Transparency < 0.95 then
							local reticle = inst:FindFirstChild("HoloReticle")
							if reticle and not lbl then
								local sp, onScreen = cam:WorldToScreenPoint(inst.Position)
								if onScreen then
									sendLabTap(Vector2.new(sp.X, sp.Y))
								end
							end

							local c = inst.Color
							if math.abs(c.R * 255 - 255) < 8 and math.abs(c.G * 255 - 225) < 8 and math.abs(c.B * 255 - 90) < 8 then
								local sp, onScreen = cam:WorldToScreenPoint(inst.Position)
								if onScreen then
									sendLabTap(Vector2.new(sp.X, sp.Y))
								end
							end
						end
					end
				end

				if not foundMixStage and isHoldingMix then
					setLabHold(false)
				end
			elseif isHoldingMix then
				setLabHold(false)
			end
		end

		-- B. Auto-Solver for AssemblyBenchLocal (Fast Craft)
		if Config.FastCraft or Config.AutoMission then
			local benchFolder = workspace:FindFirstChild("AssemblyBenchLocal")
			if benchFolder then
				if (not ActiveBenchInputFunc or not ActiveBenchPieces) and now - lastBenchHookAttempt > 0.5 then
					lastBenchHookAttempt = now
					hookMinigameModules()
				end

				if type(ActiveBenchPieces) == "table" then
					for _, piece in ipairs(ActiveBenchPieces) do
						if piece.placed and not piece.snapT0 and piece.ghostModel and piece.ghostModel.Parent then
							piece.placed = false
						end
						if not piece.placed then
							if type(ActiveBenchSnapFunc) == "function" then
								pcall(ActiveBenchSnapFunc, piece)
							elseif type(ActiveBenchInputFunc) == "function" then
								pcall(ActiveBenchInputFunc, FakeGamepadA, false)
							end
						end
					end
				end

				if type(ActiveBenchInputFunc) == "function" then
					pcall(ActiveBenchInputFunc, FakeGamepadA, false)
				end

				if type(ActiveBenchScrews) == "table" then
					for _, sc in ipairs(ActiveBenchScrews) do
						if not sc.done then
							sc.prog = 10
						end
					end
				end

				local debugSetupvalue = (debug and debug.setupvalue) or setupvalue
				local debugGetupvalues = (debug and debug.getupvalues) or getupvalues
				if ActiveBenchSetHintFunc and type(debugSetupvalue) == "function" and type(debugGetupvalues) == "function" then
					pcall(function()
						local okU, ups = pcall(debugGetupvalues, ActiveBenchSetHintFunc)
						if okU and type(ups) == "table" and ups[5] == "power" and type(ups[9]) == "number" then
							debugSetupvalue(ActiveBenchSetHintFunc, 9, 1)
						end
					end)
				end

				if VirtualInputManager then
					local screwMarker = benchFolder:FindFirstChild("ScrewMarker", true)
					local isPowerStage = false
					for _, child in ipairs(benchFolder:GetChildren()) do
						if child:IsA("BasePart") and child:GetAttribute("Progress") ~= nil then
							isPowerStage = true
							break
						end
					end

					if screwMarker and screwMarker.Parent and screwMarker.Parent:IsA("BasePart") then
						local sp = cam:WorldToScreenPoint(screwMarker.Parent.Position)
						setBenchMouseHold(true, Vector2.new(sp.X, sp.Y))
						pcall(function()
							VirtualInputManager:SendGamepadButtonEvent(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA, true, game)
						end)
					elseif isPowerStage then
						local center = cam.ViewportSize / 2
						setBenchMouseHold(true, center)
						pcall(function()
							VirtualInputManager:SendGamepadButtonEvent(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA, true, game)
						end)
					else
						padToggleState = not padToggleState
						pcall(function()
							VirtualInputManager:SendGamepadButtonEvent(
								Enum.UserInputType.Gamepad1,
								Enum.KeyCode.ButtonA,
								padToggleState,
								game
							)
						end)
					end
				end
			elseif isHoldingBenchMouse then
				setBenchMouseHold(false)
			end
		elseif isHoldingBenchMouse then
			setBenchMouseHold(false)
		end
	end)
)

