local function findRecipeForItem(itemId)
	local GameData = getGameData()
	if not GameData or type(GameData.Recipes) ~= "table" then
		return nil
	end
	for _, r in ipairs(GameData.Recipes) do
		if (r.id or r.item) == itemId then
			return r
		end
	end
	return nil
end

local ensureItemAvailable

-- Ensures prerequisite research (and its recursive prerequisites) is completed
local function ensureResearchUnlocked(resId)
	local GameData = getGameData()
	if not GameData or not resId then
		return true
	end
	local known = decodeAttr("Research")
	if known[resId] then
		return true
	end

	local resDef = GameData.ResearchById and GameData.ResearchById[resId]
	if resDef then
		for _, reqId in ipairs(resDef.requires or {}) do
			if not known[reqId] then
				return ensureResearchUnlocked(reqId)
			end
		end

		local genius = LocalPlayer:GetAttribute("Genius") or 1
		if genius < (resDef.level or 1) then
			return false -- Requires higher Genius level; caller will farm IQ
		end

		if type(resDef.items) == "table" then
			for _, cost in ipairs(resDef.items) do
				local have = tonumber(PlayerInventory[cost.item]) or 0
				if have < (cost.count or 1) then
					ensureItemAvailable(cost.item, cost.count or 1, 1)
					return false
				end
			end
		end

		local currentQI = LocalPlayer:GetAttribute("QI") or 0
		if currentQI < (resDef.qi or 0) then
			harvestResourceNode(nil)
			return false
		end
	end

	local built = decodeAttr("Built")
	if not built.Workbench then
		local haveScrap = tonumber(PlayerInventory.Scrap) or 0
		if haveScrap < 15 then
			harvestResourceNode("Scrap")
			return false
		end
		ensureAtHomeBase()
		local spot = getGarageSpot()
		if spot then
			teleportToPosition(spot, false)
			task.wait(0.2)
		end
		local ProgressAction = ReplicatedStorage:FindFirstChild("ProgressAction")
		if ProgressAction then
			pcall(function()
				ProgressAction:InvokeServer("build", "Workbench")
			end)
		end
		return false
	end

	startResearchById(resId)
	return decodeAttr("Research")[resId] == true
end

-- Ensures the player has `neededCount` of `itemId` (harvests if raw material, crafts if craftable, equips hazard suit if needed)
ensureItemAvailable = function(itemId, neededCount, depth)
	depth = (depth or 0) + 1
	if depth > 5 then
		return false
	end
	local have = tonumber(PlayerInventory[itemId]) or 0
	if have >= neededCount then
		return true
	end

	-- If this material requires a hazard suit (HeatSuit, ThermalSuit, MinerSuit, SpaceSuit) and its research is unlocked, craft the suit first
	local cat = MaterialById[itemId]
	if cat and cat.suit and (tonumber(PlayerInventory[cat.suit]) or 0) < 1 then
		local GameData = getGameData()
		local suitRes = GameData and GameData.RecipeResearch and GameData.RecipeResearch[cat.suit]
		if not suitRes or decodeAttr("Research")[suitRes] then
			ensureItemAvailable(cat.suit, 1, depth)
			return false
		end
	end

	-- If it is a known harvestable material in MaterialById, harvest it in its world
	if MaterialById[itemId] then
		harvestResourceNode(itemId)
		return false
	end

	-- Check if it is a craftable recipe
	local GameData = getGameData()
	local recipe = findRecipeForItem(itemId)
	if recipe and GameData then
		local reqRes = GameData.RecipeResearch and GameData.RecipeResearch[itemId]
		if reqRes and not decodeAttr("Research")[reqRes] then
			ensureResearchUnlocked(reqRes)
			return false
		end
		for _, ing in ipairs(recipe.cost or recipe.ingredients or {}) do
			local ingHave = tonumber(PlayerInventory[ing.item]) or 0
			if ingHave < (ing.count or 1) then
				ensureItemAvailable(ing.item, ing.count or 1, depth)
				return false
			end
		end
		craftRecipeAtWorkbench(recipe.id or recipe.item)
		return false
	end

	harvestResourceNode(itemId)
	return false
end

-- Defeats an enemy by travelling to its world/planet and attacking
local function attackEnemyByType(enemyId)
	local loc = EnemyLocations[enemyId]
	if loc then
		if loc.locType == "planet" and LocalPlayer:GetAttribute("CurrentPlanet") ~= loc.planet then
			travelToPlanet(loc.planet)
			return true
		elseif loc.locType == "dim" and LocalPlayer:GetAttribute("CurrentDimension") ~= loc.dim then
			travelToDimension(loc.dim, loc.code)
			return true
		end
	end

	local hrp = getRootPart()
	if not hrp then
		return false
	end

	local targetEnemy = nil
	local bestDist = 6000

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj ~= LocalPlayer.Character then
			local hum = obj:FindFirstChildOfClass("Humanoid")
			local eRoot = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
			if hum and hum.Health > 0 and eRoot then
				local eType = tostring(obj:GetAttribute("EnemyType") or obj:GetAttribute("Enemy") or obj.Name)
				if not enemyId or eType:find(enemyId, 1, true) or obj.Name:find(enemyId, 1, true) then
					local dist = (eRoot.Position - hrp.Position).Magnitude
					if dist < bestDist then
						bestDist = dist
						targetEnemy = eRoot
					end
				end
			end
		end
	end

	if targetEnemy then
		teleportToPosition(targetEnemy.Position + Vector3.new(0, 5, 4), bestDist > 220)
		local char = LocalPlayer.Character
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if char and backpack then
			local tool = char:FindFirstChildOfClass("Tool")
			if not tool or tool.Name == "PortalGun" or tool.Name == "GoldenPortalGun" or tool.Name == "PortalGunJr" then
				for _, item in ipairs(backpack:GetChildren()) do
					if
						item:IsA("Tool")
						and item.Name ~= "PortalGun"
						and item.Name ~= "GoldenPortalGun"
						and item.Name ~= "PortalGunJr"
					then
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then
							pcall(function()
								hum:EquipTool(item)
							end)
							tool = item
							break
						end
					end
				end
			end
			if tool then
				pcall(function()
					tool:Activate()
				end)
			end
			local LaserGunFire = ReplicatedStorage:FindFirstChild("LaserGunFire")
			if LaserGunFire and LaserGunFire:IsA("RemoteEvent") then
				pcall(function()
					LaserGunFire:FireServer(targetEnemy.Position)
				end)
			end
		end
		return true
	end

	return false
end

-- Complete OddJob handler (uses JobAction RemoteFunction with "take" and "give")
local function handleOddJobMission()
	local JobAction = ReplicatedStorage:FindFirstChild("JobAction")
	if not JobAction or not JobAction:IsA("RemoteFunction") then
		return false
	end

	local activeJob = decodeAttr("OddJob")
	if activeJob and activeJob.kind then
		local kind = activeJob.kind
		if kind == "fetch" and activeJob.item then
			local needCount = activeJob.count or 1
			local haveCount = tonumber(PlayerInventory[activeJob.item]) or 0
			if haveCount < needCount then
				ensureItemAvailable(activeJob.item, needCount, 1)
				return true
			end
		elseif kind == "lost" and not activeJob.found then
			for _, item in ipairs(CollectionService:GetTagged("LostItem")) do
				if item:GetAttribute("Owner") == LocalPlayer.UserId and item:IsDescendantOf(workspace) then
					local ok, pos = pcall(function()
						return item:IsA("Model") and item:GetPivot().Position or item.Position
					end)
					if ok and typeof(pos) == "Vector3" then
						teleportToPosition(pos + Vector3.new(0, 2.5, 0), false)
						task.wait(0.2)
						local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
						if prompt then
							triggerProximityPrompt(prompt)
						end
						return true
					end
				end
			end
		elseif kind == "hunt" then
			local killed = (tonumber(LocalPlayer:GetAttribute("StatKills")) or 0) - (tonumber(activeJob.startKills) or 0)
			if killed < (activeJob.count or 1) then
				attackEnemyByType(activeJob.enemy)
				return true
			end
		elseif kind == "courier" and activeJob.target then
			if LocalPlayer:GetAttribute("CurrentDimension") ~= activeJob.target then
				travelToDimension(activeJob.target, activeJob.target)
				return true
			end
		end

		-- Job requirements met: find the target/giver NPC and invoke "give"
		local targetNpcName = (kind == "courier") and activeJob.npc or activeJob.giver
		local targetDim = (kind == "courier") and activeJob.target or activeJob.dim
		if targetDim and LocalPlayer:GetAttribute("CurrentDimension") ~= targetDim then
			travelToDimension(targetDim, targetDim)
			return true
		end

		for _, npc in ipairs(CollectionService:GetTagged("NPC")) do
			if npc:IsDescendantOf(workspace) then
				local npcName = npc:GetAttribute("NPCName") or npc.Name
				if not targetNpcName or npcName == targetNpcName then
					local npcRoot = npc:FindFirstChild("HumanoidRootPart")
					if npcRoot then
						teleportToPosition(npcRoot.Position + Vector3.new(0, 2.5, 3), false)
						task.wait(0.22)
						pcall(function()
							JobAction:InvokeServer("give", npc)
						end)
						return true
					end
				end
			end
		end
		return false
	end

	-- No active OddJob: find an NPC with OddJob attribute and invoke "take"
	for _, npc in ipairs(CollectionService:GetTagged("NPC")) do
		if npc:GetAttribute("OddJob") and npc:IsDescendantOf(workspace) then
			local npcRoot = npc:FindFirstChild("HumanoidRootPart")
			if npcRoot then
				teleportToPosition(npcRoot.Position + Vector3.new(0, 2.5, 3), false)
				task.wait(0.22)
				pcall(function()
					JobAction:InvokeServer("take", npc)
				end)
				return true
			end
		end
	end

	return false
end

local discoverCycleIdx = 1
local travelCycleIdx = 1
local TravelCodes = { "35C", "J197", "PRIME", "CITADEL", "WASTELAND", "C137" }
local DiscoverBiomes = { "volcano", "snow", "caves" }

local function executeMissionGoal(goalOrDef)
	if type(goalOrDef) ~= "table" or isInActiveMinigame() then
		return false
	end

	-- Unwrap .goal if a Daily/Bonus definition table was passed
	local goal = goalOrDef.goal or goalOrDef
	local gType = goal.type
	if not gType then
		return false
	end

	local GameData = getGameData()
	if not GameData then
		return false
	end

	if gType == "harvest" and goal.item then
		local cat = MaterialById[goal.item]
		if cat and cat.suit and (tonumber(PlayerInventory[cat.suit]) or 0) < 1 then
			local suitRes = GameData.RecipeResearch and GameData.RecipeResearch[cat.suit]
			if not suitRes or decodeAttr("Research")[suitRes] then
				return ensureItemAvailable(cat.suit, 1, 1)
			end
		end
		return harvestResourceNode(goal.item)

	elseif gType == "harvestplanet" then
		if not LocalPlayer:GetAttribute("CurrentPlanet") then
			return travelToPlanet("Moon")
		end
		return harvestResourceNode(nil)

	elseif gType == "research" and goal.id then
		return ensureResearchUnlocked(goal.id)

	elseif gType == "craft" and goal.item then
		local reqRes = GameData.RecipeResearch and GameData.RecipeResearch[goal.item]
		if reqRes and not decodeAttr("Research")[reqRes] then
			return ensureResearchUnlocked(reqRes)
		end

		local recipe = findRecipeForItem(goal.item)
		if recipe then
			for _, ing in ipairs(recipe.cost or recipe.ingredients or {}) do
				local have = tonumber(PlayerInventory[ing.item]) or 0
				if have < (ing.count or 1) then
					return ensureItemAvailable(ing.item, ing.count or 1, 1)
				end
			end
			return craftRecipeAtWorkbench(recipe.id or recipe.item)
		end

	elseif gType == "build" and goal.id then
		local sites = decodeAttr("Sites")
		if sites[goal.id] then
			if completeActiveConstructionSites() then
				return true
			end
		end

		local reqRes = GameData.BuildResearch and GameData.BuildResearch[goal.id]
		if reqRes and not decodeAttr("Research")[reqRes] then
			return ensureResearchUnlocked(reqRes)
		end

		local bDef = GameData.BuildingById and GameData.BuildingById[goal.id]
		if bDef and type(bDef.cost) == "table" then
			for _, cost in ipairs(bDef.cost) do
				local have = tonumber(PlayerInventory[cost.item]) or 0
				if have < (cost.count or 1) then
					return ensureItemAvailable(cost.item, cost.count or 1, 1)
				end
			end
		end

		ensureAtHomeBase()
		local spot = getGarageSpot()
		if spot then
			teleportToPosition(spot, false)
			task.wait(0.2)
		end

		local ProgressAction = ReplicatedStorage:FindFirstChild("ProgressAction")
		if ProgressAction then
			pcall(function()
				if goal.id == "BunkerEntrance" then
					ProgressAction:InvokeServer("build", goal.id, "1234")
				else
					ProgressAction:InvokeServer("build", goal.id)
				end
			end)
			task.wait(0.35)
			completeActiveConstructionSites()
			return true
		end

	elseif gType == "kill" then
		return attackEnemyByType(goal.enemy)

	elseif gType == "visit" and goal.dim then
		if (tonumber(PlayerInventory.PortalGun) or 0) < 1 and (tonumber(PlayerInventory.GoldenPortalGun) or 0) < 1 then
			local char = LocalPlayer.Character
			local bp = LocalPlayer:FindFirstChild("Backpack")
			local hasGunTool = (char and (char:FindFirstChild("PortalGun") or char:FindFirstChild("GoldenPortalGun")))
				or (bp and (bp:FindFirstChild("PortalGun") or bp:FindFirstChild("GoldenPortalGun")))
			if not hasGunTool then
				ensureItemAvailable("PortalGun", 1, 1)
				return true
			end
		end
		return travelToDimension(goal.dim, goal.dim == "EvilMorty" and "EVILMORTY" or string.upper(goal.dim))

	elseif gType == "travel" then
		local code = TravelCodes[travelCycleIdx]
		travelCycleIdx = (travelCycleIdx % #TravelCodes) + 1
		return travelToDimension(code == "PRIME" and "Prime" or (code == "CITADEL" and "Citadel" or code), code)

	elseif gType == "orbit" then
		return travelToOrbit()

	elseif gType == "planet" and goal.id then
		return travelToPlanet(goal.id)

	elseif gType == "job" then
		return handleOddJobMission()

	elseif gType == "discover" then
		ensureAtHomeBase()
		local biome = DiscoverBiomes[discoverCycleIdx]
		discoverCycleIdx = (discoverCycleIdx % #DiscoverBiomes) + 1
		local bPos = getNearestBiomePosition(biome)
		if bPos then
			teleportToPosition(bPos, true)
			task.wait(0.6)
			return true
		end
	end

	return false
end

-- Checks if the current Story Mission is locked waiting for a higher Genius Level
local function isStoryWaitingOnGeniusLevel(questDef)
	if not questDef or not questDef.goal then
		return true
	end
	local genius = LocalPlayer:GetAttribute("Genius") or 1
	local g = questDef.goal
	if g.type == "level" and genius < (g.n or 1) then
		return true
	elseif g.type == "research" and g.id then
		local GameData = getGameData()
		local resDef = GameData and GameData.ResearchById and GameData.ResearchById[g.id]
		if resDef and genius < (resDef.level or 1) then
			return true
		end
	end
	return false
end

local function stepAutoMission()
	if not Config.AutoMission or isInActiveMinigame() then
		return
	end

	local GameData = getGameData()
	if not GameData then
		return
	end

	-- 1. Finish any active construction site pieces at home
	local sites = decodeAttr("Sites")
	if next(sites) ~= nil then
		if completeActiveConstructionSites() then
			return
		end
	end

	-- 2. Main Story Mission (unless waiting for a higher Genius level)
	local questState = decodeAttr("Quest")
	local questIdx = questState.i or 1
	local currentQuest = GameData.Quests and GameData.Quests[questIdx]
	if currentQuest and currentQuest.goal and not isStoryWaitingOnGeniusLevel(currentQuest) then
		if executeMissionGoal(currentQuest.goal) then
			return
		end
	end

	-- 3. Daily Missions (High IQ reward to level up Genius quickly)
	local dailyState = decodeAttr("Daily")
	if dailyState and type(dailyState.list) == "table" and GameData.DailyById then
		for _, entry in ipairs(dailyState.list) do
			if not entry.done and entry.id then
				local dailyDef = GameData.DailyById[entry.id]
				if dailyDef and executeMissionGoal(dailyDef.goal or dailyDef) then
					return
				end
			end
		end
	end

	-- 4. Bonus Mission (Infinite repeatable missions when Story is waiting on Genius level)
	local bonusState = decodeAttr("Bonus")
	if bonusState and bonusState.id and GameData.DailyById then
		local bonusDef = GameData.DailyById[bonusState.id]
		if bonusDef then
			local bonusGoal = bonusDef.goal or bonusDef
			local needCount = bonusGoal.n or bonusDef.n or 1
			if (bonusState.n or 0) < needCount then
				if executeMissionGoal(bonusGoal) then
					return
				end
			end
		end
	end

	-- 5. Start any available Research or Odd Job or harvest materials to earn IQ
	if tryAutoStartNextResearch() then
		return
	end
	if handleOddJobMission() then
		return
	end
	harvestResourceNode(nil)
end

