-- Lấy thông tin Material ID và Tọa độ từ một HarvestPrompt
local function GetPromptInfo(prompt: ProximityPrompt): (string?, Vector3?)
    if not prompt.Parent or not prompt:IsDescendantOf(workspace) then
        return nil, nil
    end

    local pos: Vector3? = nil
    if prompt.Parent:IsA("Attachment") then
        pos = prompt.Parent.WorldPosition
    elseif prompt.Parent:IsA("BasePart") then
        pos = prompt.Parent.Position
    end

    local model = prompt:FindFirstAncestorOfClass("Model")
    local itemId = model and model:GetAttribute("Item")
    if not itemId and prompt.ObjectText ~= "" then
        itemId = prompt.ObjectText
    end

    if typeof(itemId) == "string" and pos then
        return itemId, pos
    end
    return nil, nil
end

-- Kiểm tra mỏ có hợp lệ và cùng mặt đất với nhân vật hay không (Tương thích Y = -7998)
local function IsValidTargetPrompt(prompt: ProximityPrompt, playerPos: Vector3): (boolean, Vector3?, string?)
    if not prompt.Enabled then
        return false, nil, nil
    end

    local itemId, pos = GetPromptInfo(prompt)
    if not itemId or not pos then
        return false, nil, nil
    end

    -- Kiểm tra bộ lọc người dùng chọn
    if not CollectAllMaterials and not SelectedMaterials[itemId] then
        return false, nil, nil
    end

    -- Chống bay ra vũ trụ: Chỉ nhặt các mỏ có độ cao Y chênh lệch dưới 350 studs so với nhân vật
    if math.abs(pos.Y - playerPos.Y) > 350 then
        return false, nil, nil
    end

    -- Kiểm tra ranh giới chiều ngang của khu vực hiện tại (tránh WorldBounds đẩy lên trời)
    local curDim = LocalPlayer:GetAttribute("CurrentDimension")
    if curDim then
        local procFolder = workspace:FindFirstChild("Proc_" .. tostring(curDim))
        if procFolder then
            local center = procFolder:GetAttribute("ZoneCenter")
            local half = procFolder:GetAttribute("ZoneHalf")
            if typeof(center) == "Vector3" and typeof(half) == "Vector3" then
                if math.abs(pos.X - center.X) > (half.X - 20) or math.abs(pos.Z - center.Z) > (half.Z - 20) then
                    return false, nil, nil
                end
            end
        end
    end

    return true, pos, itemId
end

-- Tìm mỏ gần nhân vật nhất
local function FindNearestHarvestPrompt(playerPos: Vector3): (ProximityPrompt?, Vector3?, string?)
    local bestDist = math.huge
    local bestPrompt: ProximityPrompt? = nil
    local bestPos: Vector3? = nil
    local bestItem: string? = nil

    for prompt in pairs(HarvestPrompts) do
        local valid, pos, itemId = IsValidTargetPrompt(prompt, playerPos)
        if valid and pos and itemId then
            local dist = (pos - playerPos).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestPrompt = prompt
                bestPos = pos
                bestItem = itemId
            end
        end
    end

    return bestPrompt, bestPos, bestItem
end

-- Thực hiện Dịch chuyển tới mỏ và Nhấn giữ nhặt chuẩn
local function HarvestTargetPrompt(prompt: ProximityPrompt, targetPos: Vector3, itemName: string)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not hum or not root or hum.Health <= 0 then return end

    if hum.Sit then
        hum.Sit = false
        task.wait(0.1)
    end

    -- Bảo vệ chống sát thương rơi tự do / GroundGuard
    LocalPlayer:SetAttribute("TravelSafeUntil", workspace:GetServerTimeNow() + 8)
    char:SetAttribute("LastPortalExit", workspace:GetServerTimeNow())

    -- Đặt nhân vật đứng ngay cạnh mỏ (cách tâm 2 studs và cao hơn 2.8 studs để không kẹt vào पार्ट)
    local standPos = targetPos + Vector3.new(0, 2.8, 1.5)
    local lookCFrame = CFrame.lookAt(standPos, targetPos)

    -- Nếu mỏ ở xa thì tải map quanh điểm đó trước
    if (root.Position - targetPos).Magnitude > 80 then
        root.Anchored = true
        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(targetPos, 3)
        end)
    end

    -- Dịch chuyển nhân vật
    if CharacterPhysics and CharacterPhysics.teleport then
        pcall(CharacterPhysics.teleport, lookCFrame, false)
    else
        char:PivotTo(lookCFrame)
    end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.Anchored = false

    -- Hướng Camera nhìn vào mỏ để ProximityPromptService luôn kích hoạt
    local cam = workspace.CurrentCamera
    if cam then
        cam.CFrame = CFrame.lookAt(standPos + Vector3.new(0, 3, 4), targetPos)
    end

    -- QUAN TRỌNG: Đợi 0.25s để Roblox ProximityPromptService nhận diện nhân vật đã đứng gần mỏ
    statusLabel.Text = "Tới mỏ: " .. itemName
    local arrivalWait = os.clock()
    while os.clock() - arrivalWait < 0.25 do
        if not States.AutoCollect then return end
        char:PivotTo(lookCFrame)
        root.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.04)
    end

    if not prompt.Parent or not prompt.Enabled then
        return
    end

    -- Bắt đầu nhấn giữ để nhặt
    statusLabel.Text = "Đang nhặt: " .. itemName
    local firePrompt = (rawget(getfenv(), "fireproximityprompt") :: any)
    if typeof(firePrompt) == "function" then
        pcall(firePrompt, prompt)
    end

    pcall(function()
        prompt:InputHoldBegin()
    end)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    end)

    -- Giữ nguyên vị trí nhân vật suốt thời gian HoldDuration (thường là 1.2s)
    local holdDuration = math.max(0.2, prompt.HoldDuration + 0.3)
    local holdStart = os.clock()
    while os.clock() - holdStart < holdDuration do
        if not States.AutoCollect or not prompt.Parent or not prompt.Enabled then
            break
        end
        char:PivotTo(lookCFrame)
        root.AssemblyLinearVelocity = Vector3.zero
        LocalPlayer:SetAttribute("TravelSafeUntil", workspace:GetServerTimeNow() + 5)
        task.wait(0.05)
    end

    -- Nhả nút kết thúc nhặt
    pcall(function()
        prompt:InputHoldEnd()
    end)
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

-- Vòng lặp Auto Nhặt
task.spawn(function()
    while true do
        if States.AutoCollect then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 and not LocalPlayer:GetAttribute("InValhalla") then
                local prompt, pos, itemName = FindNearestHarvestPrompt(root.Position)
                if prompt and pos and itemName then
                    HarvestTargetPrompt(prompt, pos, itemName)
                    task.wait(0.15)
                else
                    statusLabel.Text = "Không có mỏ khả dụng quanh đây"
                    task.wait(0.6)
                end
            else
                task.wait(0.6)
            end
        end
        task.wait(0.1)
    end
end)

