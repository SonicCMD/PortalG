local States = {
    AutoSolve = false,
    AutoHome = false,
    Smooth = false,
    NoVFX = false,
    NoShadow = false,
}

local Cache = {
    Materials = {} :: { [BasePart]: Enum.Material },
}

-- Tự động giải minigame (Circuit 1-2-3)
task.spawn(function()
    while true do
        if States.AutoSolve then
            local lab = workspace:FindFirstChild("ResearchLabLocal")
            local cam = workspace.CurrentCamera
            if lab and cam then
                local points = {}
                for _, desc in ipairs(lab:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Parent and desc.Parent:IsA("BillboardGui") then
                        local n = tonumber(desc.Text)
                        if n then
                            local part = (desc.Parent :: BillboardGui).Adornee or desc.Parent.Parent
                            if part and part:IsA("BasePart") then
                                table.insert(points, { num = n, part = part })
                            end
                        end
                    end
                end

                if #points > 0 then
                    table.sort(points, function(a, b) return a.num < b.num end)
                    for _, p in ipairs(points) do
                        if not States.AutoSolve then break end
                        local screenP, onScreen = cam:WorldToScreenPoint(p.part.Position)
                        if onScreen then
                            VirtualInputManager:SendMouseButtonEvent(screenP.X, screenP.Y, 0, true, game, 0)
                            task.wait(0.04)
                            VirtualInputManager:SendMouseButtonEvent(screenP.X, screenP.Y, 0, false, game, 0)
                            task.wait(0.18)
                        end
                    end
                end
            end
        end
        task.wait(0.4)
    end
end)

-- Tự động về Home khi ở Valhalla
local function TeleportHome()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not root then return end

    local homePos = LocalPlayer:GetAttribute("HomePos")
    local targetPos = if typeof(homePos) == "Vector3" then homePos else nil

    if not targetPos then
        local house = workspace:FindFirstChild("SmithHouse_" .. tostring(LocalPlayer.UserId))
        if house and house:IsA("Model") then targetPos = house:GetPivot().Position end
    end
    if not targetPos then
        local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
        if spawn then targetPos = spawn.Position end
    end

    if targetPos then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3.5, 0))
    end

    local goHome = ReplicatedStorage:FindFirstChild("GoHome") :: RemoteEvent?
    if goHome then goHome:FireServer("start") end
    LocalPlayer:SetAttribute("InValhalla", false)
end

task.spawn(function()
    while true do
        if States.AutoHome and LocalPlayer:GetAttribute("InValhalla") == true then
            TeleportHome()
        end
        task.wait(0.8)
    end
end)

-- Fix lag
local function SetSmooth(enable: boolean)
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") and not (LocalPlayer.Character and desc:IsDescendantOf(LocalPlayer.Character)) then
            if enable then
                if not Cache.Materials[desc] then Cache.Materials[desc] = desc.Material end
                desc.Material = Enum.Material.SmoothPlastic
            elseif Cache.Materials[desc] then
                desc.Material = Cache.Materials[desc]
            end
        elseif desc:IsA("Texture") or desc:IsA("Decal") then
            desc.Transparency = enable and 1 or 0
        end
    end
end

local function SetVFX(disable: boolean)
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") then
            (desc :: any).Enabled = not disable
        end
    end
end

local function SetLighting(disable: boolean)
    Lighting.GlobalShadows = not disable
    Lighting.FogEnd = disable and 1e6 or 100000
    for _, e in ipairs(Lighting:GetChildren()) do
        if e:IsA("PostEffect") or e:IsA("Atmosphere") then
            e.Enabled = not disable
        end
    end
end

