local function CreateSimpleToggle(name: string, onToggle: (boolean) -> ())
    local box = Instance.new("Frame")
    box.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
    box.BorderSizePixel = 1
    box.BorderColor3 = Color3.fromRGB(48, 52, 64)
    box.Parent = content

    local label = Instance.new("TextLabel")
    label.Text = name
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.Position = UDim2.new(0, 8, 0, 0)
    label.Size = UDim2.new(0.62, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = box

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 58, 0, 26)
    btn.Position = UDim2.new(1, -66, 0.5, -13)
    btn.BackgroundColor3 = Color3.fromRGB(55, 58, 70)
    btn.Text = "[ TẮT ]"
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    btn.TextColor3 = Color3.fromRGB(180, 180, 180)
    btn.BorderSizePixel = 0
    btn.Parent = box

    local isOn = false
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn
        if isOn then
            btn.Text = "[ BẬT ]"
            btn.BackgroundColor3 = Color3.fromRGB(46, 125, 50) -- Màu xanh lá đơn giản
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.Text = "[ TẮT ]"
            btn.BackgroundColor3 = Color3.fromRGB(55, 58, 70)
            btn.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        onToggle(isOn)
    end)
end

