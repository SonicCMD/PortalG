-- Hàm cập nhật và hiển thị danh sách Material
local function RefreshMaterialList(filterText: string)
    for _, child in ipairs(matScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local gameDataModule = ReplicatedStorage:FindFirstChild("GameData")
    if not gameDataModule then return end
    local ok, GameData = pcall(require, gameDataModule)
    if not ok or not GameData or not GameData.Items then return end

    local query = string.lower(filterText or "")
    local totalCount = 0

    for id, item in pairs(GameData.Items) do
        -- Lọc ra các vật phẩm là nguyên liệu / vật liệu
        if not item.gadget and not item.tool and not item.gear then
            local matName = tostring(item.name or id)
            local whereToFind = (GameData.WhereToFind and GameData.WhereToFind(id)) or item.desc or "Khai thác thế giới"

            if query == "" or string.lower(matName):find(query, 1, true) or string.lower(tostring(whereToFind)):find(query, 1, true) then
                totalCount += 1
                local owned = PlayerInventory[id] or 0

                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, -6, 0, 36)
                row.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
                row.BorderSizePixel = 1
                row.BorderColor3 = Color3.fromRGB(44, 48, 58)
                row.Parent = matScroll

                -- Tên Material & Số lượng
                local nameLabel = Instance.new("TextLabel")
                nameLabel.Text = string.format("%s  [Có: %d]", matName, owned)
                nameLabel.Font = Enum.Font.SourceSansBold
                nameLabel.TextSize = 12
                nameLabel.TextColor3 = owned > 0 and Color3.fromRGB(120, 255, 160) or Color3.fromRGB(230, 230, 230)
                nameLabel.Position = UDim2.new(0, 8, 0, 3)
                nameLabel.Size = UDim2.new(1, -16, 0, 15)
                nameLabel.BackgroundTransparency = 1
                nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                nameLabel.Parent = row

                -- Nơi tìm thấy
                local whereLabel = Instance.new("TextLabel")
                whereLabel.Text = "Nơi tìm: " .. tostring(whereToFind)
                whereLabel.Font = Enum.Font.SourceSans
                whereLabel.TextSize = 11
                whereLabel.TextColor3 = Color3.fromRGB(140, 150, 170)
                whereLabel.Position = UDim2.new(0, 8, 0, 18)
                whereLabel.Size = UDim2.new(1, -16, 0, 14)
                whereLabel.BackgroundTransparency = 1
                whereLabel.TextXAlignment = Enum.TextXAlignment.Left
                whereLabel.TextTruncate = Enum.TextTruncate.AtEnd
                whereLabel.Parent = row
            end
        end
    end

    matScroll.CanvasSize = UDim2.new(0, 0, 0, totalCount * 40)
end

