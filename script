local function CountAvailablePrompts(): { [string]: number }
    local counts: { [string]: number } = {}
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
    local playerY = root and root.Position.Y or -7998

    for prompt in pairs(HarvestPrompts) do
        if prompt.Enabled then
            local itemId, pos = GetPromptInfo(prompt)
            if itemId and pos and math.abs(pos.Y - playerY) <= 350 then
                counts[itemId] = (counts[itemId] or 0) + 1
            end
        end
    end
    return counts
end

